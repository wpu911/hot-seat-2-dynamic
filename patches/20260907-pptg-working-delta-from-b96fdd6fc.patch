+extern "C" bool ggml_backend_cuda_q122_large_pp_suspend(void) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !state.borrow_enabled || state.large_pp_suspended || state.entries.empty()) return true;
+
+    if (state.large_pp_prefetch_bytes > 0) {
+        q122_large_pp_cancel_prefetch_locked(state, "new-large-pp");
+    }
+    CUDA_CHECK(cudaSetDevice(state.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+
+    size_t free_before = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_before, &total_now);
+    size_t freed = 0;
+    std::array<bool, MAX_LAYERS> touched{};
+
+    // First publish base-only pointer tables. No compute is in flight at this server
+    // boundary, but keep a single device sync above rather than one sync per layer.
+    for (auto & kv : state.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.borrow_slices && !e.borrow_exposed) continue;
+        std::vector<const void *> table;
+        q122_dynborrow_build_table(state, e, false, table);
+        CUDA_CHECK(cudaMemcpy(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        e.borrow_exposed = false;
+        if (e.layer >= 0 && e.layer < MAX_LAYERS) touched[size_t(e.layer)] = true;
+    }
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!touched[size_t(layer)]) continue;
+        q122_publish_borrow_mask(state, layer, false);
+        q122_publish_resident_mask(state, layer, false);
+        const int base = ggml_hotexpert_q122_static_slots(layer, state.slots);
+        ggml_hotexpert_q122_set_active_slots(layer, base);
+    }
+
+    // Now release every elastic allocation. Base resident slices stay warm, so
+    // decode correctness never depends on a costly full cache rebuild.
+    for (auto & kv : state.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.borrow_slices) continue;
+        CUDA_CHECK(cudaFree(e.borrow_slices));
+        e.borrow_slices = nullptr;
+        e.borrow_retired = e.borrow_bytes > 0;
+        freed += e.borrow_bytes;
+        state.allocated -= std::min(state.allocated, e.borrow_bytes);
+        state.borrow_allocated -= std::min(state.borrow_allocated, e.borrow_bytes);
+    }
+
+    state.large_pp_suspended = true;
+    // The next explicit resume chooses a fresh high-value set from the current
+    // free-VRAM budget. Ordinary KV growth still remains repay-only.
+    size_t free_after = 0;
+    (void) cudaMemGetInfo(&free_after, &total_now);
+    std::fprintf(stderr,
+        "Q122 LARGE_PP: suspend freed=%.1fMiB free=%.1f->%.1fMiB rows=%u/%u entries=%zu\n",
+        freed/1048576.0, free_before/1048576.0, free_after/1048576.0,
+        state.dyn_rows, state.dyn_logical_rows, state.entries.size());
+    std::fflush(stderr);
+    return true;
+}
+
+extern "C" bool ggml_backend_cuda_q122_large_pp_prefetch(void) {
