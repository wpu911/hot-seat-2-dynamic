+    const layer_t & L = s.layers[layer];
+    long double score = 0.0;
+    const auto & experts = s.v2_dynkv_evicted[size_t(layer)]
+        ? s.v2_dynkv_saved_experts[size_t(layer)] : L.experts;
+    for (int e : experts) {
+        if (e < 0 || e >= s.n_experts) continue;
+        score += s.v2_predictor_loaded ? s.v2_repeat_ppm[size_t(layer)][size_t(e)] : 0;
+        if (e < int(L.long_ewma.size())) score += L.long_ewma[size_t(e)] * 1000000.0;
+    }
