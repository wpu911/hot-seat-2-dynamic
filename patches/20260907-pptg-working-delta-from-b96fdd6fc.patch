+extern "C" bool ggml_backend_cuda_q122_dynborrow_reserve_bytes(size_t bytes) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !state.borrow_enabled || bytes == 0) return true;
+
+    CUDA_CHECK(cudaSetDevice(state.device));
+    size_t free_now = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_now, &total_now);
+
+    size_t low_mib = 400;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_LOW_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    } else if (const char * v = std::getenv("Q122_DYNKV_VRAM_RESERVE_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    }
+    size_t effective_low_mib = low_mib;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_GROWTH_GUARD_MB")) {
+        const unsigned long long guard = std::strtoull(v, nullptr, 10);
+        if (guard > 0 && state.dyn_logical_rows > state.dyn_initial_rows && state.dyn_rows > state.dyn_initial_rows) {
+            const uint64_t span = uint64_t(state.dyn_logical_rows) - state.dyn_initial_rows;
+            const uint64_t grown = std::min<uint64_t>(state.dyn_rows, state.dyn_logical_rows) - state.dyn_initial_rows;
+            effective_low_mib += size_t((guard * grown) / std::max<uint64_t>(1, span));
+        }
+    }
+    const size_t low_bytes = effective_low_mib << 20;
+    // Tail-prefetch memory is speculative and not visible to decode yet. If KV growth
+    // unexpectedly needs that headroom, cancel staging first rather than risking the
+    // low-water invariant or freeing a buffer while H2D is still in flight.
+    if (free_now < bytes + low_bytes && state.large_pp_prefetch_bytes > 0) {
+        q122_large_pp_cancel_prefetch_locked(state, "kv-reserve");
+        (void) cudaMemGetInfo(&free_now, &total_now);
+    }
+    if (free_now >= bytes + low_bytes) return true;
+
+    struct victim { int layer; double utility; size_t bytes; };
+    std::vector<victim> victims;
     for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        bool physical = false;
+        size_t layer_bytes = 0;
+        for (const auto & kv : state.entries) {
+            const cache_entry & e = *kv.second;
+            if (e.layer != layer || !e.borrow_slices) continue;
+            physical = true;
+            layer_bytes += e.borrow_bytes;
+        }
+        if (physical && layer_bytes) victims.push_back({layer, q122_dynborrow_utility(state, layer), layer_bytes});
+    }
+    // Lowest-value elastic layers are repaid first. Base resident slices never
+    // move, so the operation is deterministic and decode-correct.
+    std::stable_sort(victims.begin(), victims.end(), [](const victim & a, const victim & b) {
+        if (a.utility != b.utility) return a.utility < b.utility;
+        return a.layer > b.layer;
+    });
+
+    size_t repaid = 0;
+    for (const auto & v : victims) {
+        if (free_now >= bytes + low_bytes) break;
+        if (!q122_dynborrow_set_layer(state, v.layer, false)) return false;
+        repaid += v.bytes;
+        (void) cudaMemGetInfo(&free_now, &total_now);
+    }
+
+    const bool ok = free_now >= bytes + low_bytes;
+    std::fprintf(stderr,
+        "Q122 DYNBORROW_RESERVE: need=%.1fMiB repaid=%.1fMiB free=%.1fMiB low=%zuMiB effective_low=%zuMiB ok=%d rows=%u/%u\n",
+        bytes/1048576.0, repaid/1048576.0, free_now/1048576.0, low_mib, effective_low_mib, ok ? 1 : 0,
+        state.dyn_rows, state.dyn_logical_rows);
+    std::fflush(stderr);
+    return ok;
+}
