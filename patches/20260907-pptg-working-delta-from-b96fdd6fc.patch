+static bool q122_large_pp_pipelined() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("Q122_LARGE_PP_PIPELINED");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static size_t q122_large_pp_prefetch_headroom_bytes() {
+    size_t mib = 2048;
+    if (const char * v = std::getenv("Q122_LARGE_PP_PREFETCH_HEADROOM_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) mib = size_t(x);
+    }
+    return mib << 20;
+}
+
+static cudaStream_t q122_large_pp_prefetch_stream_locked(cache_state & s) {
+    if (!s.large_pp_prefetch_stream) {
+        CUDA_CHECK(cudaSetDevice(s.device));
+        CUDA_CHECK(cudaStreamCreateWithFlags(&s.large_pp_prefetch_stream, cudaStreamNonBlocking));
+    }
+    return s.large_pp_prefetch_stream;
+}
+
+static void q122_large_pp_cancel_prefetch_locked(cache_state & s, const char * reason) {
+    if (!s.large_pp_prefetch_bytes) return;
+    CUDA_CHECK(cudaSetDevice(s.device));
+    if (s.large_pp_prefetch_stream && s.large_pp_prefetch_queued) {
+        CUDA_CHECK(cudaStreamSynchronize(s.large_pp_prefetch_stream));
+    }
+    size_t freed = 0;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.prefetch_slices) continue;
+        CUDA_CHECK(cudaFree(e.prefetch_slices));
+        e.prefetch_slices = nullptr;
+        freed += e.borrow_bytes;
+        s.allocated -= std::min(s.allocated, e.borrow_bytes);
+    }
+    s.large_pp_prefetch_layers.fill(false);
+    s.large_pp_prefetch_queued = false;
+    s.large_pp_prefetch_bytes = 0;
+    std::fprintf(stderr, "Q122 LARGE_PP: prefetch canceled reason=%s freed=%.1fMiB\n",
+        reason ? reason : "unknown", freed/1048576.0);
+    std::fflush(stderr);
+}
