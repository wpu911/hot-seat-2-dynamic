+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= e.n_experts) continue;
+            void * dst = static_cast<char *>(e.prefetch_slices) + size_t(bi) * e.slice_bytes;
+            const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+            CUDA_CHECK(cudaMemcpyAsync(dst, src, e.slice_bytes, cudaMemcpyHostToDevice, stream));
