+void * ggml_cuda_hotexpert_pp_stream_staging(size_t bytes, int device) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    CUDA_CHECK(cudaSetDevice(device));
+    if (state.pp_stream_staging && (state.pp_stream_staging_device != device || state.pp_stream_staging_bytes < bytes)) {
+        CUDA_CHECK(cudaSetDevice(state.pp_stream_staging_device));
+        CUDA_CHECK(cudaFree(state.pp_stream_staging));
+        state.pp_stream_staging = nullptr;
+        state.pp_stream_staging_bytes = 0;
+        CUDA_CHECK(cudaSetDevice(device));
+    }
+    if (!state.pp_stream_staging) {
+        CUDA_CHECK(cudaMalloc(&state.pp_stream_staging, bytes));
