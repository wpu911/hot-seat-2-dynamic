+
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp, "  \"version\": 1,\n");
+    std::fprintf(fp, "  \"type\": \"moe_hot_expert_plan\",\n");
+    std::fprintf(fp, "  \"generated_by\": \"MoE HotExperts auto plan writer inside ggml-cuda.cu\",\n");
+    std::fprintf(fp, "  \"source\": \"%s\",\n", stats_path ? stats_path : "");
+    std::fprintf(fp, "  \"expert_count\": %d,\n", expert_count_safe);
+    std::fprintf(fp, "  \"calls\": %llu,\n", (unsigned long long) moe_hot_layer_stats_calls.load());
+    std::fprintf(fp, "  \"total_hits_all\": %llu,\n", (unsigned long long) total_hits_all);
+    std::fprintf(fp, "  \"policy\": {\n");
+    std::fprintf(fp, "    \"top1_golden\": \"top1_ratio >= 0.90\",\n");
+    std::fprintf(fp, "    \"top8_golden\": \"top8_ratio >= 0.90\",\n");
+    std::fprintf(fp, "    \"top16_good\": \"top16_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"top32_ok\": \"top32_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"top64_heavy_but_useful\": \"top64_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"top128_too_broad_but_coverable\": \"top128_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"too_broad_skip\": \"top128_ratio < 0.85\"\n");
+    std::fprintf(fp, "  },\n");
+    std::fprintf(fp, "  \"layers\": [\n");
+
+    bool first_layer = true;
+
+    for (int l = 0; l < 256; ++l) {
+        const uint64_t total = moe_hot_layer_stats_total_hits[l];
+
+        if (total == 0) {
+            continue;
+        }
+
+        layers_seen++;
+
+        uint64_t top1_hits = 0;
+        int top1_expert = -1;
+        uint64_t top8_hits = 0;
+        uint64_t top16_hits = 0;
+        uint64_t top32_hits = 0;
+        uint64_t top64_hits = 0;
+        uint64_t top128_hits = 0;
+        std::vector<std::pair<int, uint64_t>> experts;
+
+        moe_hot_expert_stats_collect_layer_topk(
+            l,
+            expert_count_safe,
+            &top1_hits,
+            &top1_expert,
+            &top8_hits,
+            &top16_hits,
+            &top32_hits,
+            &top64_hits,
+            &top128_hits,
+            &experts);
+
+        const double top1_ratio = total ? (double) top1_hits / (double) total : 0.0;
+        const double top8_ratio = total ? (double) top8_hits / (double) total : 0.0;
+        const double top16_ratio = total ? (double) top16_hits / (double) total : 0.0;
+        const double top32_ratio = total ? (double) top32_hits / (double) total : 0.0;
+        const double top64_ratio = total ? (double) top64_hits / (double) total : 0.0;
+        const double top128_ratio = total ? (double) top128_hits / (double) total : 0.0;
+
+        const int recommended_k = moe_hot_expert_stats_recommend_k(
+            top1_ratio,
+            top8_ratio,
+            top16_ratio,
+            top32_ratio,
+            top64_ratio,
+            top128_ratio);
+
+        const double coverage = moe_hot_expert_stats_coverage_for_k(
+            recommended_k,
+            top1_ratio,
+            top8_ratio,
+            top16_ratio,
+            top32_ratio,
+            top64_ratio,
+            top128_ratio);
+
+        const char * category = moe_hot_expert_stats_category_for_k(recommended_k);
+
+        if (recommended_k > 0) {
+            total_recommended_experts += recommended_k;
+        }
+
+        if (!first_layer) {
+            std::fprintf(fp, ",\n");
+        }
+
+        first_layer = false;
+
+        std::fprintf(fp, "    {\n");
+        std::fprintf(fp, "      \"layer\": %d,\n", l);
+        std::fprintf(fp, "      \"category\": \"%s\",\n", category);
+        std::fprintf(fp, "      \"recommended_top_k\": %d,\n", recommended_k);
+        std::fprintf(fp, "      \"coverage\": %.6f,\n", coverage);
+        std::fprintf(fp, "      \"total_hits\": %llu,\n", (unsigned long long) total);
+        std::fprintf(fp, "      \"hit_share\": %.6f,\n", total_hits_all ? (double) total / (double) total_hits_all : 0.0);
+        std::fprintf(fp, "      \"unique_experts\": %zu,\n", experts.size());
+        std::fprintf(fp, "      \"top1_expert\": %d,\n", top1_expert);
+        std::fprintf(fp, "      \"top1_ratio\": %.6f,\n", top1_ratio);
+        std::fprintf(fp, "      \"top8_ratio\": %.6f,\n", top8_ratio);
+        std::fprintf(fp, "      \"top16_ratio\": %.6f,\n", top16_ratio);
+        std::fprintf(fp, "      \"top32_ratio\": %.6f,\n", top32_ratio);
+        std::fprintf(fp, "      \"top64_ratio\": %.6f,\n", top64_ratio);
+        std::fprintf(fp, "      \"top128_ratio\": %.6f,\n", top128_ratio);
+
+        std::fprintf(fp, "      \"experts\": [");
+
+        if (recommended_k > 0) {
+            for (size_t i = 0; i < experts.size() && i < (size_t) recommended_k; ++i) {
+                if (i) {
+                    std::fprintf(fp, ", ");
+                }
+                std::fprintf(fp, "%d", experts[i].first);
+            }
+        }
+
+        std::fprintf(fp, "],\n");
+
+        std::fprintf(fp, "      \"top_experts_preview\": [");
+
+        for (size_t i = 0; i < experts.size() && i < 16; ++i) {
+            if (i) {
+                std::fprintf(fp, ", ");
+            }
+            std::fprintf(fp, "{\"expert\": %d, \"hits\": %llu}",
+                experts[i].first,
+                (unsigned long long) experts[i].second);
+        }
+
+        std::fprintf(fp, "]\n");
+        std::fprintf(fp, "    }");
+    }
+
+    std::fprintf(fp, "\n  ],\n");
+    std::fprintf(fp, "  \"summary\": {\n");
+    std::fprintf(fp, "    \"layers_seen\": %d,\n", layers_seen);
+    std::fprintf(fp, "    \"hot_layer_18_expert_units\": %d,\n", 18 * expert_count_safe);
+    std::fprintf(fp, "    \"hot_expert_plan_expert_units\": %d,\n", total_recommended_experts);
+    std::fprintf(fp, "    \"hot_expert_vs_hot_layer18_unit_ratio\": %.6f\n",
+        (18 * expert_count_safe) ? (double) total_recommended_experts / (double) (18 * expert_count_safe) : 0.0);
+    std::fprintf(fp, "  }\n");
+    std::fprintf(fp, "}\n");
+
+    std::fclose(fp);
+
+    GGML_LOG_INFO(
+        "MoE HotExperts: auto-wrote hot expert plan to %s with %d layers and %d recommended expert units\n",
+        plan_path,
+        layers_seen,
+        total_recommended_experts);
+}
