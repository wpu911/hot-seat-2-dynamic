+// ---------------------------------------------------------------------------
+// record kernel (indexing mirrors hotexpert-profiler.cu record_kernel)
+// ---------------------------------------------------------------------------
+
+__global__ void runtime_record_kernel(
+        const int32_t * ids,
+        uint64_t * hits,
+        uint64_t * prefill_hits,
+        uint64_t * miss_rows,
+        uint64_t * prefill_rows,
+        const uint32_t * resident_bits,
+        ggml_hotexpert_v2_layer_record * v2_records,
+        v2_route_record * v2_routes,
+        uint64_t * v2_route_latest,
+        const ggml_hotexpert_v2_transit_meta * v2_transit_meta,
+        int v2_transit_slots,
+        uint64_t * v2_token_count,
+        uint64_t * v2_current_token,
+        uint64_t v2_capacity,
+        uint64_t v2_route_capacity,
+        uint64_t generation,
+        int n_layers,
+        int layer,
+        int n_experts,
+        int top_k,
+        int n_rows,
+        bool record_prefill) {
+    const int expert_slot = threadIdx.x;
+    if (expert_slot >= top_k) {
+        return;
+    }
+    ggml_hotexpert_v2_layer_record * v2_record = nullptr;
+    v2_route_record * v2_route = nullptr;
+    const bool v2_decode = !record_prefill && n_rows == 1 &&
+        (v2_records || v2_routes) && v2_token_count && v2_current_token &&
+        layer >= 0 && layer < n_layers;
+    uint64_t v2_token = 0;
+    if (v2_decode) {
+        if (layer == 0 && expert_slot == 0) {
+            const uint64_t token = atomicAdd((unsigned long long *) v2_token_count, 1ULL);
+            *v2_current_token = token;
+        }
+        __syncthreads();
+        v2_token = *v2_current_token;
+        if (v2_records && v2_capacity > 0) {
+            v2_record = &v2_records[(v2_token % v2_capacity) * size_t(n_layers) + size_t(layer)];
+        }
+        if (v2_routes && v2_route_capacity > 0) {
+            v2_route = &v2_routes[(v2_token % v2_route_capacity) * size_t(n_layers) + size_t(layer)];
+        }
+        if (expert_slot == 0) {
+            if (v2_record) {
+                v2_record->generation = generation;
+                v2_record->resident_mask = 0;
+                v2_record->route_count = uint32_t(min(top_k, GGML_HOTEXPERT_V2_PROFILE_TOP_K));
+                for (int i = 0; i < GGML_HOTEXPERT_V2_PROFILE_TOP_K; ++i) {
+                    v2_record->expert_ids[i] = -1;
+                }
+                for (int i = 0; i < GGML_HOTEXPERT_V2_PROFILE_KINDS; ++i) {
+                    v2_record->mmvq_cycles[i] = 0;
+                    v2_record->host_cycles[i] = 0;
+                    v2_record->resident_cycles[i] = 0;
+                }
+            }
+            if (v2_route) {
+                v2_route->generation = generation;
+                v2_route->token = v2_token;
+                v2_route->route_count = uint32_t(min(top_k, GGML_HOTEXPERT_V2_PROFILE_TOP_K));
+                for (int i = 0; i < GGML_HOTEXPERT_V2_PROFILE_TOP_K; ++i) {
+                    v2_route->expert_ids[i] = -1;
+                    v2_route->resident_flags[i] = 0;
+                    v2_route->transit_flags[i] = 0;
+                }
+            }
+        }
+        __syncthreads();
+    }
+    if (record_prefill && expert_slot == 0) {
+        atomicAdd((unsigned long long *) &prefill_rows[layer], (unsigned long long) n_rows);
+    }
+    for (int row = 0; row < n_rows; ++row) {
+        // ids physical layout: each row is n_experts wide (nb[1] = n_experts
+        // elements) with the first top_k entries valid; verified on-device
+        // (ne0=top_k, ne1=rows, nb1=n_experts*4). Do NOT use top_k as stride.
+        const int id = ids[row * n_experts + expert_slot];
+        if (id < 0 || id >= n_experts) {
+            continue;
+        }
+        atomicAdd((unsigned long long *) &hits[size_t(layer) * MAX_EXPERTS + id], 1ULL);
+        if (record_prefill) {
+            atomicAdd((unsigned long long *) &prefill_hits[size_t(layer) * MAX_EXPERTS + id], 1ULL);
+        } else {
+            const uint32_t word = resident_bits[size_t(layer) * (MAX_EXPERTS / 32) + (id >> 5)];
+            const bool resident = (word & (1u << (id & 31))) != 0;
+            if (!resident) {
+                atomicAdd((unsigned long long *) &miss_rows[layer], 1ULL);
+            }
+            if (expert_slot < GGML_HOTEXPERT_V2_PROFILE_TOP_K) {
+                if (v2_record) {
+                    v2_record->expert_ids[expert_slot] = id;
+                    if (resident) {
+                        atomicOr((unsigned int *) &v2_record->resident_mask, 1u << expert_slot);
+                    }
+                }
+                if (v2_route) {
+                    v2_route->expert_ids[expert_slot] = id;
+                    v2_route->resident_flags[expert_slot] = resident ? 1u : 0u;
+                    uint32_t transit_hit = 0;
+                    if (!resident && v2_transit_meta && v2_transit_slots > 0) {
+                        const auto & meta = v2_transit_meta[layer];
+                        const int slots = min(v2_transit_slots, GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS);
+                        // Search both physical banks. In legacy double-buffer
+                        // mode only one bank has ready_token==v2_token, so this
+                        // is behavior-preserving; persistent mode can carry
+                        // both cached experts forward for the same token.
+                        for (int bank = 0; bank < GGML_HOTEXPERT_V2_TRANSIT_BANKS && !transit_hit; ++bank) {
+                            if (meta.ready_token[bank] != v2_token) continue;
+                            for (int slot = 0; slot < slots; ++slot) {
+                                if (meta.expert_ids[bank][slot] == id) {
+                                    transit_hit = 1u;
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                    v2_route->transit_flags[expert_slot] = transit_hit;
+                }
+            }
+        }
+    }
+    if (v2_route) {
+        __syncthreads();
+        if (expert_slot == 0) {
+            // Publish all per-layer route writes before exposing the latest
+            // token number to the host callback.  The callback can therefore
+            // consume the mapped ring without a D2H synchronization.
+            __threadfence_system();
+            if (v2_route_latest && layer == n_layers - 1) {
+                *v2_route_latest = v2_token;
+                __threadfence_system();
+            }
+        }
+    }
+}
+
+// Stage-2 publish runs on the dedicated prefetch stream after all H2D copies
+// for one layer.  Stream ordering guarantees the weight copies are complete;
+// ready_token is written last, so decode either sees a complete generation or
+// keeps using the original resident/host pointer table.
+__global__ void v2_publish_transit_kernel(
+        ggml_hotexpert_v2_transit_meta * meta,
+        int bank,
+        uint64_t target_token,
+        int32_t e0,
+        int32_t e1,
+        int32_t e2,
+        int32_t e3) {
+    if (blockIdx.x != 0 || threadIdx.x != 0 || !meta || bank < 0 || bank >= GGML_HOTEXPERT_V2_TRANSIT_BANKS) {
+        return;
+    }
+    meta->expert_ids[bank][0] = e0;
+    meta->expert_ids[bank][1] = e1;
+    meta->expert_ids[bank][2] = e2;
+    meta->expert_ids[bank][3] = e3;
+    __threadfence();
+    atomicExch((unsigned long long *) &meta->ready_token[bank], (unsigned long long) target_token);
+}
+
+static int adaptive_eval_tokens(rt_state & s);
+
+static void token_callback(void * user_data) {
+    auto * state = static_cast<rt_state *>(user_data);
+    const uint64_t tokens = ++state->decode_tokens;
+    if (state->v2_prefetch_enabled && state->h_v2_routes && state->h_v2_route_latest) {
+        const uint64_t route_token = *state->h_v2_route_latest;
+        if (route_token != UINT64_MAX) {
+            state->v2_latest_token.store(route_token, std::memory_order_release);
+            state->v2_prefetch_cv.notify_one();
+        }
+    }
+    // stage I: rolling decode-TPS telemetry (1 s windows)
+    const uint64_t now_us = uint64_t(ggml_time_us());
+    if (state->v2_profile_enabled && !state->v2_token_times_us.empty()) {
+        if (state->v2_profile_started_us == 0) {
+            state->v2_profile_started_us = now_us;
+        }
+        state->v2_token_times_us[size_t((tokens - 1) % state->v2_profile_capacity)] = now_us;
+    }
+    const uint64_t win_start = state->window_start_us.load(std::memory_order_relaxed);
+    const uint64_t win_tokens = state->window_decode_tokens.load(std::memory_order_relaxed);
+    if (win_start == 0) {
+        state->window_start_us.store(now_us, std::memory_order_relaxed);
+        state->window_decode_tokens.store(1, std::memory_order_relaxed);
+    } else if (now_us - win_start >= 1000000) {
+        const double tps = double(win_tokens) * 1e6 / double(now_us - win_start);
+        state->window_tps.store(tps, std::memory_order_relaxed);
+        state->window_start_us.store(now_us, std::memory_order_relaxed);
+        state->window_decode_tokens.store(1, std::memory_order_relaxed);
+    } else {
+        state->window_decode_tokens.store(win_tokens + 1, std::memory_order_relaxed);
+    }
+    const int eval_tokens = state->expert_eval_auto
+        ? adaptive_eval_tokens(*state)
+        : state->expert_eval_tokens;
+    if (tokens - state->last_eval_decode.load(std::memory_order_acquire) >=
+            uint64_t(eval_tokens) &&
+        !state->eval_requested.exchange(true, std::memory_order_acq_rel)) {
+        state->worker_cv.notify_one();
+    }
+}
