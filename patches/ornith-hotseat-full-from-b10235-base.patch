new file mode 100644
index 000000000..5af8d47b2
--- /dev/null
+++ b/ggml/src/ggml-hotexpert.cpp
@@ -0,0 +1,42 @@
+#include "ggml-hotexpert.h"
+
+#include <atomic>
+#include <mutex>
+#include <string>
+
+namespace {
+std::mutex model_info_mutex;
+std::string model_architecture;
+std::atomic<int> model_layers{0};
+std::atomic<int> model_experts{0};
+std::atomic<int> model_expert_used{0};
+}
+
+void ggml_hotexpert_set_model_info(const char * architecture, int n_layers, int n_experts, int n_expert_used) {
+    if (architecture && *architecture) {
+        std::lock_guard<std::mutex> lock(model_info_mutex);
+        model_architecture = architecture;
+    }
+    if (n_layers > 0) model_layers.store(n_layers, std::memory_order_relaxed);
+    if (n_experts > 0) model_experts.store(n_experts, std::memory_order_relaxed);
+    if (n_expert_used > 0) model_expert_used.store(n_expert_used, std::memory_order_relaxed);
+}
+
+const char * ggml_hotexpert_model_architecture(void) {
+    static thread_local std::string snapshot;
+    std::lock_guard<std::mutex> lock(model_info_mutex);
+    snapshot = model_architecture;
+    return snapshot.c_str();
+}
+
+int ggml_hotexpert_model_layers(void) {
+    return model_layers.load(std::memory_order_relaxed);
+}
+
+int ggml_hotexpert_model_experts(void) {
+    return model_experts.load(std::memory_order_relaxed);
+}
+
+int ggml_hotexpert_model_expert_used(void) {
+    return model_expert_used.load(std::memory_order_relaxed);
+}
