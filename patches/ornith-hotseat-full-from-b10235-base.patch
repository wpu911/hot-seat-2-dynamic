+static void moe_hot_layer_stats_write_json_unlocked(const char * path) {
+    FILE * fp = std::fopen(path, "w");
+    if (!fp) {
+        return;
+    }
+
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp, "  \"version\": 1,\n");
+    std::fprintf(fp, "  \"type\": \"moe_hot_layer_stats\",\n");
+    std::fprintf(fp, "  \"note\": \"generated by MoE Hot Layer Stats v0 inside ggml-cuda.cu\",\n");
+    const int expert_count = moe_hot_layer_stats_get_expert_count();
+
+    std::fprintf(fp, "  \"calls\": %llu,\n", (unsigned long long) moe_hot_layer_stats_calls.load());
+    std::fprintf(fp, "  \"expert_count\": %d,\n", expert_count);
+    std::fprintf(fp, "  \"layers\": {\n");
+
+    bool first_layer = true;
+
+    for (int l = 0; l < 256; ++l) {
+        const uint64_t total = moe_hot_layer_stats_total_hits[l];
+
+        if (total == 0) {
+            continue;
+        }
+
+        uint64_t unique = 0;
+        uint64_t top1_hits = 0;
+        int top1_expert = -1;
+
+        std::vector<std::pair<int, uint64_t>> experts;
+
+        for (int e = 0; e < 1024; ++e) {
+            const uint64_t h = moe_hot_layer_stats_hits[l][e];
+            if (h == 0) {
+                continue;
+            }
+
+            unique++;
+            experts.push_back({e, h});
+
+            if (h > top1_hits) {
+                top1_hits = h;
+                top1_expert = e;
+            }
+        }
+
+        std::sort(experts.begin(), experts.end(), [](const auto & a, const auto & b) {
+            return a.second > b.second;
+        });
+
+        uint64_t top8_hits = 0;
+        uint64_t top16_hits = 0;
+        uint64_t top32_hits = 0;
+        uint64_t top64_hits = 0;
+        uint64_t top128_hits = 0;
+        for (size_t i = 0; i < experts.size() && i < 128; ++i) {
+            if (i < 8) {
+                top8_hits += experts[i].second;
+            }
+            if (i < 16) {
+                top16_hits += experts[i].second;
+            }
+            if (i < 32) {
+                top32_hits += experts[i].second;
+            }
+            if (i < 64) {
+                top64_hits += experts[i].second;
+            }
+            top128_hits += experts[i].second;
+        }
+
+        const double top1_ratio = total ? (double) top1_hits / (double) total : 0.0;
+        const double top8_ratio = total ? (double) top8_hits / (double) total : 0.0;
+        const double top16_ratio = total ? (double) top16_hits / (double) total : 0.0;
+        const double top32_ratio = total ? (double) top32_hits / (double) total : 0.0;
+        const double top64_ratio = total ? (double) top64_hits / (double) total : 0.0;
+        const double top128_ratio = total ? (double) top128_hits / (double) total : 0.0;
+
+        const int expert_count_safe = expert_count > 0 ? expert_count : 256;
+        const double unique_ratio = (double) unique / (double) expert_count_safe;
+
+        double entropy = 0.0;
+        for (const auto & item : experts) {
+            const double p = total ? (double) item.second / (double) total : 0.0;
+            if (p > 0.0) {
+                entropy -= p * std::log(p);
+            }
+        }
+
+        const double max_entropy = expert_count_safe > 1 ? std::log((double) expert_count_safe) : 1.0;
+        const double entropy_ratio = max_entropy > 0.0 ? entropy / max_entropy : 0.0;
+
+        // Breadth foundation:
+        // - unique_ratio: how many experts are touched.
+        // - entropy_ratio: how evenly the layer touches experts.
+        // A layer can be valuable if it has one extremely hot expert OR broad expert coverage.
+        const double breadth_score =
+            0.50 * unique_ratio +
+            0.50 * entropy_ratio;
+
+        // This score is only a rough online score for preview.
+        // Final layer selection should be done by Python using the raw fields below.
+        const double score =
+            0.35 * std::log1p((double) total) +
+            0.30 * top8_ratio * std::log1p((double) top8_hits) +
+            0.35 * breadth_score * std::log1p((double) unique);
+
+        if (!first_layer) {
+            std::fprintf(fp, ",\n");
+        }
+        first_layer = false;
+
+        std::fprintf(fp, "    \"%d\": {\n", l);
+        std::fprintf(fp, "      \"total_hits\": %llu,\n", (unsigned long long) total);
+        std::fprintf(fp, "      \"unique_experts\": %llu,\n", (unsigned long long) unique);
+        std::fprintf(fp, "      \"unique_ratio\": %.6f,\n", unique_ratio);
+        std::fprintf(fp, "      \"top1_expert\": %d,\n", top1_expert);
+        std::fprintf(fp, "      \"top1_hits\": %llu,\n", (unsigned long long) top1_hits);
+        std::fprintf(fp, "      \"top1_ratio\": %.6f,\n", top1_ratio);
+        std::fprintf(fp, "      \"top8_hits\": %llu,\n", (unsigned long long) top8_hits);
+        std::fprintf(fp, "      \"top8_ratio\": %.6f,\n", top8_ratio);
+        std::fprintf(fp, "      \"top16_hits\": %llu,\n", (unsigned long long) top16_hits);
+        std::fprintf(fp, "      \"top16_ratio\": %.6f,\n", top16_ratio);
+        std::fprintf(fp, "      \"top32_hits\": %llu,\n", (unsigned long long) top32_hits);
+        std::fprintf(fp, "      \"top32_ratio\": %.6f,\n", top32_ratio);
+        std::fprintf(fp, "      \"top64_hits\": %llu,\n", (unsigned long long) top64_hits);
+        std::fprintf(fp, "      \"top64_ratio\": %.6f,\n", top64_ratio);
+        std::fprintf(fp, "      \"top128_hits\": %llu,\n", (unsigned long long) top128_hits);
+        std::fprintf(fp, "      \"top128_ratio\": %.6f,\n", top128_ratio);
+        std::fprintf(fp, "      \"entropy\": %.6f,\n", entropy);
+        std::fprintf(fp, "      \"entropy_ratio\": %.6f,\n", entropy_ratio);
+        std::fprintf(fp, "      \"breadth_score\": %.6f,\n", breadth_score);
+        std::fprintf(fp, "      \"score\": %.6f,\n", score);
+        std::fprintf(fp, "      \"top_experts\": [");
+
+        for (size_t i = 0; i < experts.size() && i < 128; ++i) {
+            if (i) {
+                std::fprintf(fp, ", ");
+            }
+            std::fprintf(fp, "{\"expert\": %d, \"hits\": %llu}", experts[i].first, (unsigned long long) experts[i].second);
+        }
+
+        std::fprintf(fp, "]\n");
+        std::fprintf(fp, "    }");
+    }
+
+    std::fprintf(fp, "\n  }\n");
+    std::fprintf(fp, "}\n");
+
+    std::fclose(fp);
+    moe_hot_layer_stats_write_plan_json_unlocked(path);
+    moe_hot_expert_stats_write_plan_json_unlocked(path);
+}
+
+static void moe_hot_layer_stats_record_ids(const ggml_tensor * ids) {
+    if (!ids) {
+        return;
+    }
+
+    const char * enabled = std::getenv("HOTSEAT_STATS_ENABLE");
+    if (!enabled || std::strcmp(enabled, "1") != 0) {
+        return;
+    }
+
+    const char * name = ids->name;
+    const int layer = moe_hot_layer_stats_parse_layer_id(name);
+
+    if (layer < 0) {
+        static std::atomic<uint64_t> moe_hot_layer_stats_unmatched_names{0};
+        const uint64_t n_unmatched = ++moe_hot_layer_stats_unmatched_names;
+        if (n_unmatched <= 64) {
+            GGML_LOG_INFO("MoE HotLayerStats: unmatched ids tensor name: %s\n", name ? name : "(null)");
+        }
+        return;
+    }
+
+    if (ids->type != GGML_TYPE_I32) {
+        GGML_LOG_WARN("MoE HotLayerStats: ids tensor %s type is %s, expected I32\n", name, ggml_type_name(ids->type));
+        return;
+    }
+
+    const int64_t n = ggml_nelements(ids);
+    if (n <= 0 || n > 1048576) {
+        return;
+    }
+
+    std::vector<int32_t> host_ids((size_t) n);
+
+    // This readback is intentionally simple for v0.
+    // If it becomes too slow, later versions can sample or async-copy.
+    ggml_backend_tensor_get((ggml_tensor *) ids, host_ids.data(), 0, (size_t) n * sizeof(int32_t));
+
+    {
+        std::lock_guard<std::mutex> lock(moe_hot_layer_stats_mutex);
+
+        for (int64_t i = 0; i < n; ++i) {
+            const int expert = host_ids[(size_t) i];
+
+            if (expert < 0 || expert >= 1024) {
+                continue;
+            }
+
+            moe_hot_layer_stats_hits[layer][expert]++;
+            moe_hot_layer_stats_total_hits[layer]++;
+        }
+
+        const uint64_t calls = ++moe_hot_layer_stats_calls;
+
+        const char * path_env = std::getenv("HOTSEAT_STATS_PATH");
+        const char * path = path_env && *path_env
+            ? path_env
+            : "/app/share/llama_box/config/hot_layers_stats.json";
+
+        const char * interval_env = std::getenv("HOTSEAT_STATS_WRITE_INTERVAL");
+        uint64_t interval = 128;
+
+        if (interval_env && *interval_env) {
+            interval = std::strtoull(interval_env, nullptr, 10);
+            if (interval == 0) {
+                interval = 128;
+            }
+        }
+
+        if (calls % interval == 0) {
+            moe_hot_layer_stats_write_json_unlocked(path);
+            GGML_LOG_INFO("MoE HotLayerStats: wrote stats to %s after %llu calls\n", path, (unsigned long long) calls);
+        }
+    }
+}
