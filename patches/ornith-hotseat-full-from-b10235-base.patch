+bool hotseat_arena::init(uint64_t total_bytes, uint64_t page_bytes, const std::string & label) {
+    if (base_ || total_bytes == 0 || page_bytes == 0) {
+        return false;
+    }
+    total_bytes = (total_bytes / page_bytes) * page_bytes;   // page-align down
+    if (total_bytes == 0) {
+        return false;
+    }
+    void * ptr = nullptr;
+    if (hipMalloc(&ptr, total_bytes) != hipSuccess) {
+        GGML_LOG_WARN("HotExpert arena: hipMalloc %llu MiB failed\n",
+                      (unsigned long long) (total_bytes >> 20));
+        return false;
+    }
+    base_ = ptr;
+    total_ = total_bytes;
+    page_bytes_ = page_bytes;
+    n_pages_ = total_bytes / page_bytes;
+    label_ = label;
+    owner_.assign(n_pages_, 0);
+    free_pages_.resize(n_pages_);
+    std::iota(free_pages_.begin(), free_pages_.end(), 0);
+    GGML_LOG_INFO("HotExpert arena: %s %llu MiB (%llu x %llu KiB pages), base %p\n",
+        label.c_str(), (unsigned long long) (total_ >> 20),
+        (unsigned long long) n_pages_, (unsigned long long) (page_bytes_ >> 10), base_);
+    return true;
+}
+
+void hotseat_arena::destroy() {
+    if (base_) {
+        CUDA_CHECK(cudaFree(base_));
+        base_ = nullptr;
+        total_ = 0;
+        n_pages_ = 0;
+        owner_.clear();
+        free_pages_.clear();
+    }
+}
+
+bool hotseat_arena::allocate_pages(uint64_t n_pages, uint64_t & offset, uint64_t & bytes) {
+    if (n_pages == 0 || n_pages > free_pages_.size()) {
+        return false;
+    }
+    // first-fit over consecutive free page runs (scan the bitmap)
+    uint64_t run_start = 0;
+    uint64_t run_len = 0;
+    for (uint64_t p = 0; p < n_pages_; ++p) {
+        if (owner_[p] == 0) {
+            if (run_len == 0) {
+                run_start = p;
+            }
+            ++run_len;
+            if (run_len >= n_pages) {
+                for (uint64_t i = 0; i < n_pages; ++i) {
+                    owner_[run_start + i] = 1;
+                }
+                free_pages_.erase(
+                    std::remove_if(free_pages_.begin(), free_pages_.end(),
+                        [&](uint64_t fp) { return fp >= run_start && fp < run_start + n_pages; }),
+                    free_pages_.end());
+                offset = run_start * page_bytes_;
+                bytes = n_pages * page_bytes_;
+                return true;
+            }
+        } else {
+            run_len = 0;
+        }
+    }
+    return false;
+}
+
+bool hotseat_arena::allocate_extent(uint64_t bytes, uint64_t & offset) {
+    const uint64_t pages = (bytes + page_bytes_ - 1) / page_bytes_;
+    uint64_t b = 0;
+    if (!allocate_pages(pages, b, b)) {
+        return false;
+    }
+    offset = b;
+    return true;
+}
+
+void hotseat_arena::free_pages(uint64_t offset, uint64_t n_pages) {
+    if (offset % page_bytes_ != 0) {
+        GGML_LOG_WARN("HotExpert arena: free_pages misaligned offset %llu\n",
+                      (unsigned long long) offset);
+        return;
+    }
+    const uint64_t first = offset / page_bytes_;
+    if (first + n_pages > n_pages_) {
+        GGML_LOG_WARN("HotExpert arena: free_pages out of range\n");
+        return;
+    }
+    for (uint64_t i = 0; i < n_pages; ++i) {
+        if (owner_[first + i] == 0) {
+            continue;   // idempotent
+        }
+        owner_[first + i] = 0;
+        free_pages_.push_back(first + i);
+    }
+}
+
+uint64_t hotseat_arena::free_run_count() const {
+    uint64_t runs = 0;
+    bool in_run = false;
+    for (uint64_t p = 0; p < n_pages_; ++p) {
+        if (owner_[p] == 0) {
+            if (!in_run) {
+                ++runs;
+                in_run = true;
+            }
+        } else {
+            in_run = false;
+        }
+    }
+    return runs;
+}
+
+void hotseat_arena::coalesce_free() {
+    // paged allocator: free pages are already coalesced by the bitmap scan;
+    // nothing to do (kept for API symmetry with the fragment-management plan)
+}
diff --git a/ggml/src/ggml-cuda/hotexpert-arena.cuh b/ggml/src/ggml-cuda/hotexpert-arena.cuh
new file mode 100644
index 000000000..6834b9df5
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-arena.cuh
@@ -0,0 +1,76 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// ============================================================================
+// Stage J: fixed-address GPU arena allocator
+//
+// One (or a few) hipMalloc'ed region(s) reserved once at startup. Addresses
+// never change during normal operation; contents and logical capacity can be
+// re-arranged at runtime without unload/reload or KV resets. All objects are
+// addressed as arena-base + byte offset.
+// ============================================================================
+
+struct hotseat_arena_extent {
+    uint64_t offset = 0;
+    uint64_t bytes = 0;
+    bool valid() const { return bytes > 0; }
+};
+
+enum hotseat_object_state {
+    HOTSEAT_OBJ_FREE = 0,
+    HOTSEAT_OBJ_ALLOCATED,   // pages reserved, not yet loaded
+    HOTSEAT_OBJ_LOADING,     // async copies in flight
+    HOTSEAT_OBJ_READY,       // loaded, not referenced by the committed map
+    HOTSEAT_OBJ_ACTIVE,      // referenced by the committed map
+    HOTSEAT_OBJ_RETIRING,    // no longer referenced; pages pending release
+};
+
+// arena object bookkeeping (used by stages J3/J4)
+struct hotseat_arena_object {
+    int layer_id = -1;
+    int64_t expert_id = -1;          // -1 for full-layer objects
+    hotseat_arena_extent gate;
+    hotseat_arena_extent up;
+    hotseat_arena_extent down;
+    uint64_t total_bytes = 0;
+    uint64_t mapping_generation = 0;
+    hotseat_object_state state = HOTSEAT_OBJ_FREE;
+    uint64_t pages = 0;
+};
+
+class hotseat_arena {
+public:
+    bool init(uint64_t total_bytes, uint64_t page_bytes, const std::string & label);
+    void destroy();
+
+    bool valid() const { return base_ != nullptr; }
+    uint64_t total_bytes() const { return total_; }
+    uint64_t page_bytes() const { return page_bytes_; }
+    uint64_t free_bytes() const { return free_pages_.size() * page_bytes_; }
+    uint64_t used_bytes() const { return total_ - free_bytes(); }
+    void * base() const { return base_; }
+
+    // page-granular allocation; returns byte offset from the arena base,
+    // aligned to page_bytes. n_pages consecutive free pages are required.
+    bool allocate_pages(uint64_t n_pages, uint64_t & offset, uint64_t & bytes);
+    // contiguous extent allocation (full layers need contiguous gate/up/down)
+    bool allocate_extent(uint64_t bytes, uint64_t & offset);
+    void free_pages(uint64_t offset, uint64_t n_pages);
+    // returns the number of free runs (fragmentation indicator)
+    uint64_t free_run_count() const;
+    void coalesce_free();   // no-op for a paged allocator; kept for symmetry
+
+private:
+    void * base_ = nullptr;
+    uint64_t total_ = 0;
+    uint64_t page_bytes_ = 0;
+    uint64_t n_pages_ = 0;
+    std::vector<uint64_t> owner_;       // page -> 1 when used (simple bitmap)
+    std::vector<uint64_t> free_pages_;  // free page indices
+    std::string label_;
+};
diff --git a/ggml/src/ggml-cuda/hotexpert-cache.cu b/ggml/src/ggml-cuda/hotexpert-cache.cu
new file mode 100644
index 000000000..9b41c2fd2
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-cache.cu
@@ -0,0 +1,254 @@
+#include "hotexpert-cache.cuh"
+
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr int MAX_LAYERS  = 256;
+constexpr int MAX_EXPERTS = 1024;
+
+struct cache_entry {
+    void * device_slices = nullptr;
+    const void ** device_table = nullptr;
+    size_t bytes = 0;
+    int layer = -1;
+    int slots = 0;
+};
+
+struct cache_state {
+    bool initialized = false;
+    bool enabled = false;
+    int slots = 64;
+    size_t budget = size_t(8192) << 20;
+    size_t allocated = 0;
+    std::string profile_path;
+    std::array<std::vector<int>, MAX_LAYERS> ranked_experts;
+    std::unordered_map<const void *, std::unique_ptr<cache_entry>> entries;
+    std::mutex mutex;
+};
+
+cache_state state;
+
+static bool env_enabled() {
+    const char * value = std::getenv("HOTEXPERT_CACHE");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+static int env_positive_int(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 && parsed <= MAX_EXPERTS ? int(parsed) : fallback;
+}
+
+static size_t env_budget() {
+    const char * value = std::getenv("HOTEXPERT_CACHE_VRAM_BUDGET_MB");
+    if (!value || !*value) {
+        return size_t(8192) << 20;
+    }
+    const unsigned long long parsed = std::strtoull(value, nullptr, 10);
+    return parsed ? size_t(parsed) << 20 : size_t(8192) << 20;
+}
+
+static int parse_layer(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    const char * p = std::strstr(name, "blk.");
+    if (!p) {
+        return -1;
+    }
+    p += 4;
+    if (!std::isdigit(static_cast<unsigned char>(*p))) {
+        return -1;
+    }
+    int layer = 0;
+    while (std::isdigit(static_cast<unsigned char>(*p))) {
+        layer = layer * 10 + (*p++ - '0');
+    }
+    return layer < MAX_LAYERS ? layer : -1;
+}
+
+static bool parse_unsigned(const std::string & text, size_t & pos, uint64_t & value) {
+    while (pos < text.size() && std::isspace(static_cast<unsigned char>(text[pos]))) {
+        ++pos;
+    }
+    if (pos == text.size() || !std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        return false;
+    }
+    value = 0;
+    while (pos < text.size() && std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        value = value * 10 + uint64_t(text[pos++] - '0');
+    }
+    return true;
+}
+
+static bool load_profile(cache_state & s) {
+    std::ifstream in(s.profile_path, std::ios::binary);
+    if (!in) {
+        GGML_LOG_ERROR("HotExpert cache: cannot open profile %s\n", s.profile_path.c_str());
+        return false;
+    }
+    const std::string json((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    size_t pos = 0;
+    int loaded = 0;
+    while ((pos = json.find("\"layer\"", pos)) != std::string::npos) {
+        pos = json.find(':', pos);
+        if (pos == std::string::npos) break;
+        ++pos;
+        uint64_t layer_value = 0;
+        if (!parse_unsigned(json, pos, layer_value) || layer_value >= MAX_LAYERS) continue;
+
+        const size_t next_layer = json.find("\"layer\"", pos);
+        size_t hits = json.find("\"expert_hits\"", pos);
+        if (hits == std::string::npos || (next_layer != std::string::npos && hits > next_layer)) continue;
+        hits = json.find('[', hits);
+        if (hits == std::string::npos) continue;
+        ++hits;
+
+        std::vector<uint64_t> counts;
+        while (hits < json.size() && json[hits] != ']') {
+            uint64_t count = 0;
+            if (!parse_unsigned(json, hits, count)) break;
+            counts.push_back(count);
+            while (hits < json.size() && std::isspace(static_cast<unsigned char>(json[hits]))) ++hits;
+            if (hits < json.size() && json[hits] == ',') ++hits;
+        }
+        if (counts.empty() || counts.size() > MAX_EXPERTS) continue;
+
+        auto & ranked = s.ranked_experts[layer_value];
+        ranked.resize(counts.size());
+        std::iota(ranked.begin(), ranked.end(), 0);
+        std::stable_sort(ranked.begin(), ranked.end(), [&](int a, int b) {
+            return counts[a] > counts[b];
+        });
+        ++loaded;
+        pos = hits;
+    }
+    if (!loaded) {
+        GGML_LOG_ERROR("HotExpert cache: no layer expert_hits found in %s\n", s.profile_path.c_str());
+        return false;
+    }
+    GGML_LOG_INFO("HotExpert cache: loaded %d layers from %s, slots=%d budget=%zu MiB\n",
+                  loaded, s.profile_path.c_str(), s.slots, s.budget >> 20);
+    return true;
+}
+
+static void initialize(cache_state & s) {
+    if (s.initialized) return;
+    s.initialized = true;
+    s.enabled = env_enabled();
+    if (!s.enabled) return;
+    s.slots = env_positive_int("HOTEXPERT_CACHE_SLOTS", 64);
+    s.budget = env_budget();
+    const char * path = std::getenv("HOTEXPERT_CACHE_PROFILE");
+    s.profile_path = path && *path
+        ? path
+        : "/app/share/openclaw_tools/logs/qwen36-hotexpert-profile-1024.json";
+    s.enabled = load_profile(s);
+}
+
+} // namespace
+
+const void * const * ggml_cuda_hotexpert_cache_get(
+        const ggml_tensor * tensor, int64_t expert_stride_bytes, cudaStream_t stream) {
+    if (!tensor || tensor->ne[2] <= 0 || tensor->ne[2] > MAX_EXPERTS || expert_stride_bytes <= 0) {
+        return nullptr;
+    }
+    if (!ggml_backend_buffer_is_host(tensor->buffer)) {
+        return nullptr;
+    }
+
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled) {
+        return nullptr;
+    }
+
+    auto found = state.entries.find(tensor->data);
+    if (found != state.entries.end()) {
+        return found->second->device_table;
+    }
+
+    const int layer = parse_layer(tensor->name);
+    if (layer < 0 || state.ranked_experts[layer].empty()) {
+        return nullptr;
+    }
+    const int n_experts = int(tensor->ne[2]);
+    const int slots = std::min({state.slots, n_experts, int(state.ranked_experts[layer].size())});
+    const size_t slice_bytes = size_t(expert_stride_bytes);
+    const size_t cache_bytes = size_t(slots) * slice_bytes;
+    if (cache_bytes > state.budget - std::min(state.allocated, state.budget)) {
+        GGML_LOG_WARN("HotExpert cache: budget exhausted before %s (%zu MiB requested, %zu MiB used)\n",
+                      tensor->name, cache_bytes >> 20, state.allocated >> 20);
+        return nullptr;
+    }
+
+    auto entry = std::make_unique<cache_entry>();
+    entry->bytes = cache_bytes;
+    entry->layer = layer;
+    entry->slots = slots;
+    cudaError_t error = cudaMalloc(&entry->device_slices, cache_bytes);
+    if (error != cudaSuccess) {
+        GGML_LOG_WARN("HotExpert cache: device allocation failed for %s: %s\n",
+                      tensor->name, cudaGetErrorString(error));
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    error = cudaMalloc(reinterpret_cast<void **>(&entry->device_table), size_t(n_experts) * sizeof(void *));
+    if (error != cudaSuccess) {
+        GGML_LOG_WARN("HotExpert cache: pointer table allocation failed for %s: %s\n",
+                      tensor->name, cudaGetErrorString(error));
+        (void) cudaFree(entry->device_slices);
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+
+    std::vector<const void *> table(n_experts);
+    for (int expert = 0; expert < n_experts; ++expert) {
+        table[expert] = static_cast<const char *>(tensor->data) + size_t(expert) * slice_bytes;
+    }
+    for (int slot = 0; slot < slots; ++slot) {
+        const int expert = state.ranked_experts[layer][slot];
+        if (expert >= n_experts) continue;
+        void * destination = static_cast<char *>(entry->device_slices) + size_t(slot) * slice_bytes;
+        const void * source = static_cast<const char *>(tensor->data) + size_t(expert) * slice_bytes;
+        error = cudaMemcpyAsync(destination, source, slice_bytes, cudaMemcpyHostToDevice, stream);
+        if (error != cudaSuccess) {
+            GGML_LOG_WARN("HotExpert cache: slice copy failed for %s expert %d: %s\n",
+                          tensor->name, expert, cudaGetErrorString(error));
+            (void) cudaFree(entry->device_table);
+            (void) cudaFree(entry->device_slices);
+            (void) cudaGetLastError();
+            return nullptr;
+        }
+        table[expert] = destination;
+    }
+    CUDA_CHECK(cudaMemcpyAsync(entry->device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice, stream));
+
+    state.allocated += cache_bytes;
+    GGML_LOG_INFO("HotExpert cache: cached %s layer=%d slots=%d slice=%zu KiB total=%zu MiB\n",
+                  tensor->name, layer, slots, slice_bytes >> 10, state.allocated >> 20);
+    const void * const * result = entry->device_table;
+    state.entries.emplace(tensor->data, std::move(entry));
+    return result;
+}
