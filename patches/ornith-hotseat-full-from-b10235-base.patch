+static void moe_hot_expert_stats_write_plan_json_unlocked(const char * stats_path) {
+    const char * enabled = std::getenv("HOTSEAT_EXPERT_PLAN_AUTO_ENABLE");
+
+    if (!enabled || std::strcmp(enabled, "1") != 0) {
