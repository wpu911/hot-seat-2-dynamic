+static void v2_prefetch_worker_loop(rt_state * s);
+
+static bool initialize_runtime(rt_state & s) {
+    int max_layer = -1;
+    int n_experts = 0;
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered) continue;
+        max_layer = std::max(max_layer, layer);
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            n_experts = std::max(n_experts, L.tensors[kind].n_experts);
+        }
+    }
+    if (max_layer < 0 || n_experts <= 0) {
+        return false;
+    }
+    s.n_layers  = max_layer + 1;
+    s.n_experts = n_experts;
+    s.top_k     = std::min(s.slots, n_experts);
+    s.hybrid    = s.mode == MODE_DYNAMIC_HYBRID;
+    load_runtime_snapshot(s);
+    s.auto_layout = [] {
+        const char * auto_ = std::getenv("HOTSEAT_AUTO");
+        const char * dry   = std::getenv("HOTSEAT_AUTO_DRY_RUN");
+        return auto_ && std::strcmp(auto_, "1") == 0 &&
+               (!dry || std::strcmp(dry, "1") != 0);
+    }();
+    // default slots for layers not covered by the plan (auto mode keeps 0 =
+    // host-only; non-auto mode always uses the global top_k)
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        if (s.layers[layer].slots < 0) {
+            s.layers[layer].slots = s.top_k;
+        } else if (!s.auto_layout && s.layers[layer].slots == 0) {
+            s.layers[layer].slots = s.top_k;
+        }
+    }
+
+    // initial full layer set (from env / plan file)
+    std::set<int> full_set;
+    const char * init_env = std::getenv("HOTSEAT_RUNTIME_INIT_FULL_LAYERS");
+    if (init_env && *init_env) {
+        std::stringstream ss(init_env);
+        std::string item;
+        while (std::getline(ss, item, ',')) {
+            if (!item.empty()) full_set.insert(std::atoi(item.c_str()));
+        }
+    } else {
+        const char * plan_env = std::getenv("HOTSEAT_LAYER_PLAN_FILE");
+        if (plan_env && *plan_env) {
+            full_set = parse_layer_plan(plan_env);
+        }
+    }
+    if (s.snapshot_loaded && int(s.snapshot_full_layers.size()) == s.full_count) {
+        full_set = s.snapshot_full_layers;
+        GGML_LOG_INFO("HotExpert snapshot: restoring %zu full layers\n", full_set.size());
+    }
+    std::set<int> clamped;
+    for (int layer : full_set) {
+        if (layer >= 0 && layer < s.n_layers) clamped.insert(layer);
+    }
+    full_set.swap(clamped);
+    // auto mode: the planner decides the full-layer set; do not pad or trim
+    if (!s.auto_layout) {
+        while (int(full_set.size()) > s.full_count) full_set.erase(std::prev(full_set.end()));
+        for (int i = 0; int(full_set.size()) < s.full_count && i < s.n_layers; ++i) {
+            if (!full_set.count(i)) full_set.insert(i);
+        }
+    }
+
+    if (s.auto_layout) {
+        // per-layer slots come from the planner plan (layout-plan.json);
+        // default stays s.top_k when the plan is absent or unreadable
+        const char * dir = std::getenv("HOTSEAT_AUTO_PROFILE_DIR");
+        // fingerprint-scoped plan (fall back to the legacy layout-plan.json)
+        std::string plan_path;
+        hotseat_model_descriptor pdesc;
+        if (ggml_cuda_hotexpert_descriptor_build(pdesc)) {
+            plan_path = std::string(dir && *dir ? dir : "/app/share/openclaw_tools/hotexpert-profiles")
+                + "/" + pdesc.fingerprint + ".plan.json";
+        }
+        if (plan_path.empty()) {
+            plan_path = std::string(dir && *dir ? dir : "/app/share/openclaw_tools/hotexpert-profiles")
+                + "/layout-plan.json";
+        }
+        std::ifstream in(plan_path);
+        if (in.good()) {
+            std::stringstream ss;
+            ss << in.rdbuf();
+            const std::string s_ = ss.str();
+            size_t pos = 0;
+            while ((pos = s_.find("\"layer\"", pos)) != std::string::npos) {
+                size_t colon = s_.find(':', pos);
+                if (colon == std::string::npos) break;
+                const int layer = std::atoi(s_.c_str() + colon + 1);
+                const std::string mode_key = "\"mode\"";
+                const size_t mp = s_.find(mode_key, colon);
+                if (mp != std::string::npos && layer >= 0 && layer < s.n_layers) {
+                    const char * mode = s_.c_str() + mp + mode_key.size();
+                    while (*mode && *mode != '"') ++mode;
+                    if (*mode == '"') ++mode;
+                    const std::string m(mode, std::strchr(mode, '"') ? std::strchr(mode, '"') - mode : 0);
+                    if (m == "full") {
+                        full_set.insert(layer);
+                    } else if (m == "host_only") {
+                        s.layers[layer].slots = 0;   // fully host-resident
+                    } else {
+                        const std::string slots_key = "\"slots\"";
+                        const size_t sp = s_.find(slots_key, colon);
+                        if (sp != std::string::npos) {
+                            const int slots = std::atoi(s_.c_str() + sp + slots_key.size() + 1);
+                            if (slots > 0) {
+                                s.layers[layer].slots = std::min(slots, int(n_experts));
+                            }
+                        }
+                    }
+                }
+                pos = colon + 1;
+            }
+            GGML_LOG_INFO("HotExpert runtime: auto layout from %s (full=%zu)\n",
+                plan_path.c_str(), full_set.size());
+        }
+    }
+
+    std::vector<int> full_layers, top64_layers;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        if (!s.layers[layer].registered) continue;
+        if (s.hybrid && full_set.count(layer)) {
+            full_layers.push_back(layer);
+        } else if (!s.hybrid && full_set.count(layer)) {
+            // dynamic-experts: full layers are HotSeat device tensors; mark
+            // them full with no runtime bank so they are skipped by the
+            // top64 bookkeeping and the table hook (kernel uses the tensor).
+            s.layers[layer].full = true;
+            s.layers[layer].full_bank = -1;
+        } else if (s.layers[layer].slots > 0) {
+            top64_layers.push_back(layer);
+        }
+        // slots == 0 (auto host_only): no bank, no table; the layer keeps the
+        // original host path via get_table() == nullptr
+    }
+    if (s.hybrid) {
+        for (size_t i = 0; i < full_layers.size(); ++i) {
+            s.layers[full_layers[i]].full = true;
+            s.layers[full_layers[i]].full_bank = int(i);
+        }
+    }
+    for (size_t i = 0; i < top64_layers.size(); ++i) {
+        const int layer = top64_layers[i];
+        layer_t & L = s.layers[layer];
+        L.full = false;
+        L.top64_bank = int(i);
+        L.experts.clear();
+        const auto & ranked = s.ranked_experts[layer];
+        const int take = std::min(std::max(L.slots, 1), int(ranked.size()));
+        for (int k = 0; k < take; ++k) L.experts.push_back(ranked[k]);
+        while (int(L.experts.size()) < std::max(L.slots, 1) &&
+               int(L.experts.size()) < s.n_experts) {
+            L.experts.push_back(int(L.experts.size()));
+        }
+        std::fill(L.slot_of.begin(), L.slot_of.end(), -1);
+        std::fill(L.in_shadow.begin(), L.in_shadow.end(), false);
+        std::fill(L.shadow_slot.begin(), L.shadow_slot.end(), -1);
+        for (int slot = 0; slot < int(L.experts.size()); ++slot) {
+            L.slot_of[L.experts[slot]] = slot;
+        }
+    }
+
+    // pool capacity = max resident slot count across layers (computed AFTER
+    // the plan parse so auto layouts are honored)
+    s.pool_slots = 0;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        s.pool_slots = std::max(s.pool_slots, s.layers[layer].slots);
+    }
+    if (s.pool_slots <= 0) {
+        s.pool_slots = s.top_k;
+    }
+    allocate_banks(s, int(full_layers.size()), int(top64_layers.size()));
+    std::fprintf(stderr, "HotSeat V2 Stage2 flags: prefetch=%d transit=%d slots=%d predictor=%d min_ppm=%u persistent=%d\n",
+        int(s.v2_prefetch_enabled), int(s.v2_transit_enabled), s.v2_transit_slots,
+        int(s.v2_predictor_loaded), s.v2_predictor_min_ppm, int(s.v2_persistent_transit));
+    allocate_v2_transit(s);
+
+    // initial staging (H2D, one-time)
+    for (int layer : full_layers) {
+        layer_t & L = s.layers[layer];
+        const bank_t & bank = s.full_banks[L.full_bank];
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = L.tensors[kind];
+            if (!t.host_ptr) continue;
+            CUDA_CHECK(cudaMemcpyAsync(
+                static_cast<char *>(bank.base) + bank.offsets[kind],
+                t.host_ptr, t.bytes, cudaMemcpyHostToDevice, s.side_stream));
+        }
+    }
+    for (int layer : top64_layers) {
+        layer_t & L = s.layers[layer];
+        const bank_t & bank = s.top64_banks[L.top64_bank];
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = L.tensors[kind];
+            if (!t.host_ptr) continue;
+            for (int slot = 0; slot < int(L.experts.size()); ++slot) {
+                const int e = L.experts[slot];
+                CUDA_CHECK(cudaMemcpyAsync(
+                    static_cast<char *>(bank.base) + bank.offsets[kind] + size_t(slot) * size_t(t.stride),
+                    static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                    size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream));
+            }
+        }
+    }
+    CUDA_CHECK(cudaStreamSynchronize(s.side_stream));
+
+    // initial tables into buffer 0
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            tensor_slot & t = s.layers[layer].tensors[kind];
+            if (!t.host_ptr) continue;
+            std::vector<const void *> content;
+            build_table_content(s, layer, kind, content);
+            CUDA_CHECK(cudaMemcpyAsync(const_cast<void *>(t.tables[0]), content.data(),
+                content.size() * sizeof(const void *), cudaMemcpyHostToDevice, s.side_stream));
+            t.committed_buf = 0;
+        }
+    }
+    std::vector<uint32_t> bits;
+    build_resident_bits(s, bits);
+    CUDA_CHECK(cudaMemcpyAsync(s.d_resident, bits.data(), bits.size() * sizeof(uint32_t),
+        cudaMemcpyHostToDevice, s.side_stream));
+    CUDA_CHECK(cudaStreamSynchronize(s.side_stream));
+
+    // stage G: measure H2D bandwidth (64 MiB probe on the side stream)
+    {
+        void * dbuf = nullptr;
+        CUDA_CHECK(cudaMalloc(&dbuf, 64u << 20));
+        std::vector<char> hbuf(64u << 20, 1);
+        cudaEvent_t t0 = nullptr, t1 = nullptr;
+        CUDA_CHECK(hipEventCreate(&t0));
+        CUDA_CHECK(hipEventCreate(&t1));
+        CUDA_CHECK(cudaEventRecord(t0, s.side_stream));
+        CUDA_CHECK(cudaMemcpyAsync(dbuf, hbuf.data(), hbuf.size(), cudaMemcpyHostToDevice, s.side_stream));
+        CUDA_CHECK(cudaEventRecord(t1, s.side_stream));
+        CUDA_CHECK(cudaEventSynchronize(t1));
+        float ms = 0.0f;
+        CUDA_CHECK(hipEventElapsedTime(&ms, t0, t1));
+        s.h2d_bw_bytes_per_ns = double(hbuf.size()) / (double(ms) * 1e6);
+        CUDA_CHECK(cudaEventDestroy(t0));
+        CUDA_CHECK(cudaEventDestroy(t1));
+        CUDA_CHECK(cudaFree(dbuf));
+        GGML_LOG_INFO("HotExpert runtime: measured H2D bandwidth %.1f GB/s\n",
+            s.h2d_bw_bytes_per_ns);
+    }
+
+    // stats mirrors
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        L.decode_hits.assign(s.n_experts, 0);
+        L.prev_hits.assign(s.n_experts, 0);
+        L.prefill_hits.assign(s.n_experts, 0);
+        L.prev_prefill_hits.assign(s.n_experts, 0);
+        L.short_ewma.assign(s.n_experts, 0.0);
+        L.long_ewma.assign(s.n_experts, 0.0);
+        L.streak.assign(s.n_experts, 0);
+        if (s.snapshot_loaded) {
+            const auto & sp = s.snapshot_short_ppm[layer];
+            const auto & lp = s.snapshot_long_ppm[layer];
+            for (int e = 0; e < s.n_experts; ++e) {
+                if (e < int(sp.size())) L.short_ewma[e] = double(sp[e]) / 1000000.0;
+                if (e < int(lp.size())) L.long_ewma[e]  = double(lp[e]) / 1000000.0;
+            }
+        }
+    }
+
+    // publish the initial map
+    auto map = std::make_unique<map_t>();
+    map->generation = s.snapshot_loaded ? s.snapshot_generation : 1;
+    map->layer_to_full_bank.assign(s.n_layers, -1);
+    map->layer_to_top64_bank.assign(s.n_layers, -1);
+    map->tables.resize(s.n_layers);
+    map->full_bases.resize(s.n_layers);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        map->layer_to_full_bank[layer]  = s.layers[layer].full ? s.layers[layer].full_bank : -1;
+        map->layer_to_top64_bank[layer] = s.layers[layer].full ? -1 : s.layers[layer].top64_bank;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = s.layers[layer].tensors[kind];
+            if (!t.host_ptr) continue;
+            if (s.layers[layer].slots == 0) {
+                map->tables[layer][kind] = nullptr;
+                continue;
+            }
+            map->tables[layer][kind] = t.tables[t.committed_buf];
+            if (s.layers[layer].full && s.hybrid) {
+                const bank_t & bank = s.full_banks[s.layers[layer].full_bank];
+                map->full_bases[layer][kind] =
+                    static_cast<const char *>(bank.base) + bank.offsets[kind];
+            }
+        }
+    }
+    s.current_map = std::move(map);
+
+    // stage J2: arena reservation is deferred until the server warm-up has
+    // measured the real transient VRAM peak (see prepare_graph); the flag is
+    // read here so the sizing path knows the feature is enabled
+    s.arena_enabled = [] {
+        const char * v = std::getenv("HOTSEAT_AUTO_RESERVE_ARENA");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (s.arena_enabled) {
+        s.arena_target_free_bytes = uint64_t(env_int("HOTSEAT_ARENA_TARGET_FREE_MB", 800)) << 20;
+        GGML_LOG_INFO("HotExpert arena: enabled, target free %llu MiB (allocation after warm-up)\n",
+            (unsigned long long) (s.arena_target_free_bytes >> 20));
+    }
+
+    s.worker = std::thread(worker_loop, &s);
+    if (s.v2_prefetch_enabled) {
+        s.v2_prefetch_worker = std::thread(v2_prefetch_worker_loop, &s);
+    }
+    std::atexit([] { shutdown_runtime(g_state); });
+
+    std::fprintf(stderr,
+        "HotExpert runtime: initialized mode=%s layers=%d experts=%d top_k=%d "
+        "full=%d top_n=%d pool=%d\n",
+        s.hybrid ? "dynamic-hybrid" : "dynamic-experts", s.n_layers, s.n_experts, s.top_k,
+        int(full_layers.size()), int(top64_layers.size()), s.pool_slots);
+    // per-layer resident config summary (slots/full) for parameter auditing
+    {
+        std::string fs;
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            if (s.layers[layer].full) {
+                if (!fs.empty()) fs += ",";
+                fs += std::to_string(layer);
+            }
+        }
+        std::map<int, int> slot_counts;
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            if (!s.layers[layer].registered) continue;
+            slot_counts[s.layers[layer].slots]++;
+        }
+        std::string sc;
+        for (const auto & kv : slot_counts) {
+            if (!sc.empty()) sc += " ";
+            sc += std::to_string(kv.first) + "x" + std::to_string(kv.second);
+        }
+        std::fprintf(stderr, "HotExpert runtime: layer audit full=[%s] slots=%s\n",
+            fs.empty() ? "-" : fs.c_str(), sc.c_str());
+        // resident expert seed (first 8 ids per layer) for cold-start auditing
+        {
+            std::string rs;
+            for (int layer = 0; layer < s.n_layers; ++layer) {
+                if (!s.layers[layer].registered) continue;
+                if (!rs.empty()) rs += " ";
+                rs += "L" + std::to_string(layer) + ":";
+                const auto & ex = s.layers[layer].experts;
+                for (size_t i = 0; i < ex.size() && i < 8; ++i) {
+                    rs += (i ? "," : "") + std::to_string(ex[i]);
+                }
+            }
+            std::fprintf(stderr, "HotExpert runtime: resident audit %s\n", rs.c_str());
+        }
+        // per-bank byte accounting: full banks, top_n banks, pool slots
+        {
+            std::string fb;
+            for (size_t i = 0; i < s.full_banks.size(); ++i) {
+                const bank_t & b = s.full_banks[i];
+                if (!fb.empty()) fb += " ";
+                fb += "bank" + std::to_string(i) + "=" + std::to_string(b.total) +
+                      "B(" + std::to_string((b.total + (1u << 20) - 1) >> 20) + "MiB)";
+            }
+            std::string tb;
+            for (size_t i = 0; i < s.top64_banks.size(); ++i) {
+                const bank_t & b = s.top64_banks[i];
+                if (!tb.empty()) tb += " ";
+                tb += "bank" + std::to_string(i) + "=" + std::to_string(b.total) +
+                      "B(" + std::to_string((b.total + (1u << 20) - 1) >> 20) + "MiB)";
+            }
+            std::string fl;
+            for (int layer = 0; layer < s.n_layers; ++layer) {
+                if (!s.layers[layer].full) continue;
+                const int bi = s.layers[layer].full_bank;
+                const uint64_t bt = (bi >= 0 && bi < int(s.full_banks.size()))
+                    ? s.full_banks[bi].total : 0;
+                if (!fl.empty()) fl += " ";
+                fl += "L" + std::to_string(layer) + "->bank" + std::to_string(bi) +
+                      "(" + std::to_string(bt) + "B)";
+            }
+            std::fprintf(stderr,
+                "HotExpert runtime: bank audit full=[%s] top_n=[%s] pool_slots=%d full_shadow=%s full_layers=[%s]\n",
+                fb.empty() ? "-" : fb.c_str(), tb.empty() ? "-" : tb.c_str(),
+                s.pool_slots, s.full_shadow ? "on" : "off", fl.empty() ? "-" : fl.c_str());
+        }
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// stage J2: measured low-water based arena sizing (full-stress measurement)
+// ---------------------------------------------------------------------------
+
+// Read the physical-free low-water (bytes) recorded by a previous run's last
+// evaluation into the profile file. This is the *post-stress* low-water, not
+// the warm-up mid-run sample, so the arena is sized from what real traffic
+// actually leaves free.
+static uint64_t read_profile_low_water(const char * path) {
+    FILE * fp = std::fopen(path, "r");
+    if (!fp) {
+        return 0;
+    }
+    char buf[1 << 16];
+    size_t n = std::fread(buf, 1, sizeof(buf) - 1, fp);
+    std::fclose(fp);
+    buf[n] = 0;
+    const char * key = std::strstr(buf, "physical_free_low_water");
+    if (!key) {
+        return 0;
+    }
+    const char * colon = std::strchr(key, ':');
+    if (!colon) {
+        return 0;
+    }
+    return uint64_t(std::strtoull(colon + 1, nullptr, 10));
+}
+
+// ---------------------------------------------------------------------------
+// worker: snapshot / EWMA / scoring
+// ---------------------------------------------------------------------------
+
+static void snapshot_counters(rt_state & s) {
+    std::vector<uint64_t> hits(size_t(MAX_LAYERS) * MAX_EXPERTS);
+    std::vector<uint64_t> prefill(size_t(MAX_LAYERS) * MAX_EXPERTS);
+    std::vector<uint64_t> miss(MAX_LAYERS);
+    std::vector<uint64_t> prefill_rows(MAX_LAYERS);
+
+    CUDA_CHECK(cudaSetDevice(s.device));
+    CUDA_CHECK(cudaMemcpyAsync(hits.data(), s.d_hits, hits.size() * sizeof(uint64_t),
+        cudaMemcpyDeviceToHost, s.side_stream));
+    CUDA_CHECK(cudaMemcpyAsync(prefill.data(), s.d_prefill, prefill.size() * sizeof(uint64_t),
+        cudaMemcpyDeviceToHost, s.side_stream));
+    CUDA_CHECK(cudaMemcpyAsync(miss.data(), s.d_miss, miss.size() * sizeof(uint64_t),
+        cudaMemcpyDeviceToHost, s.side_stream));
+    CUDA_CHECK(cudaMemcpyAsync(prefill_rows.data(), s.d_prefill_rows, prefill_rows.size() * sizeof(uint64_t),
+        cudaMemcpyDeviceToHost, s.side_stream));
+    CUDA_CHECK(cudaStreamSynchronize(s.side_stream));
+
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        for (int e = 0; e < s.n_experts; ++e) {
+            L.decode_hits[e]      = hits[size_t(layer) * MAX_EXPERTS + e];
+            L.prefill_hits[e]     = prefill[size_t(layer) * MAX_EXPERTS + e];
+        }
+        L.last_miss_rows     = miss[layer];
+        L.last_prefill_rows  = prefill_rows[layer];
+    }
+}
+
+static void update_ewma(rt_state & s, const std::vector<std::vector<uint64_t>> & delta_hits) {
+    const double window = double(s.decode_tokens.load(std::memory_order_acquire) -
+                                 s.last_eval_decode.load(std::memory_order_acquire));
+    if (window <= 0.0) {
+        return;
+    }
+    const double inv = 1.0 / window;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        for (int e = 0; e < s.n_experts; ++e) {
+            const double sample = double(delta_hits[layer][e]) * inv;
+            L.short_ewma[e] = s.ewma_short * sample + (1.0 - s.ewma_short) * L.short_ewma[e];
+            L.long_ewma[e]  = s.ewma_long  * sample + (1.0 - s.ewma_long)  * L.long_ewma[e];
+        }
+        for (int e = 0; e < s.n_experts; ++e) {
+            L.prev_hits[e] = L.decode_hits[e];
+            L.prev_prefill_hits[e] = L.prefill_hits[e];
+        }
+        L.prev_miss_rows    = L.last_miss_rows;
+        L.prev_prefill_rows = L.last_prefill_rows;
+    }
+}
+
+// estimated host stall cost of the layer over the current window (bytes)
+// uses window deltas: (cumulative snapshot - previous snapshot)
+static double layer_stall_bytes(rt_state & s, int layer,
+                                const std::vector<std::vector<uint64_t>> & delta_hits,
+                                uint64_t miss_delta, uint64_t prefill_delta) {
+    const layer_t & L = s.layers[layer];
+    size_t layer_bytes = 0;
+    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+        layer_bytes += L.tensors[kind].bytes;
+    }
+    if (layer_bytes == 0) {
+        return 0.0;
+    }
+    const double per_expert = double(layer_bytes) / double(std::max(1, s.n_experts));
+    double bytes = 0.0;
+    if (L.full) {
+        // would-be cost if demoted: delta decode hits outside a virtual top-64
+        std::vector<int> order(s.n_experts);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+            return delta_hits[layer][a] > delta_hits[layer][b];
+        });
+        std::vector<bool> top64(s.n_experts, false);
+        for (int i = 0; i < s.top_k && i < s.n_experts; ++i) top64[order[i]] = true;
+        for (int e = 0; e < s.n_experts; ++e) {
+            if (!top64[e]) bytes += double(delta_hits[layer][e]) * per_expert;
+        }
+        bytes += double(prefill_delta) * double(layer_bytes);
+    } else {
+        bytes += double(miss_delta) * per_expert;
+        bytes += double(prefill_delta) * double(layer_bytes);
+    }
+    return bytes;
+}
+
+// ---------------------------------------------------------------------------
+// swap staging (worker thread; side stream)
+// ---------------------------------------------------------------------------
+
+static void stage_promotions(rt_state & s, swap_plan & plan) {
+    bank_t & pool = s.top64_banks[s.spare_bank];
+    for (const auto & p : plan.promotions) {
+        const int layer  = p[0];
+        const int expert = p[1];
+        const int slot   = p[2];
+        const layer_t & L = s.layers[layer];
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = L.tensors[kind];
+            if (!t.host_ptr) continue;
+            CUDA_CHECK(cudaMemcpyAsync(
+                static_cast<char *>(pool.base) + pool.offsets[kind] + size_t(slot) * size_t(t.stride),
+                static_cast<const char *>(t.host_ptr) + size_t(expert) * size_t(t.stride),
+                size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream));
+            plan.bytes += size_t(t.stride);
+        }
+    }
+}
+
+// move every pool-resident expert back into its own bank's freed slots
+static void flush_pool(rt_state & s, swap_plan & plan) {
+    bank_t & pool = s.top64_banks[s.spare_bank];
+    std::vector<bool> pool_used(s.pool_slots, false);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        if (L.full || L.shadow_used == 0) continue;
+        std::vector<int> staged;
+        for (int e = 0; e < s.n_experts; ++e) {
+            if (L.in_shadow[e]) staged.push_back(e);
+        }
+        if (int(staged.size()) > L.own_free) {
+            GGML_LOG_WARN("HotExpert runtime: flush pool skipped for layer %d (%zu staged, %d free)\n",
+                          layer, staged.size(), L.own_free);
+            continue;
+        }
+        // free slots of the own bank: slots not referenced by current residents
+        const int layer_slots = std::max(L.slots, 1);
+        std::vector<bool> used(layer_slots, false);
+        for (int e : L.experts) {
+            if (!L.in_shadow[e] && L.slot_of[e] >= 0 && L.slot_of[e] < layer_slots) {
+                used[L.slot_of[e]] = true;
+            }
+        }
+        std::vector<int> free_slots;
+        for (int slot = 0; slot < layer_slots; ++slot) {
+            if (!used[slot]) free_slots.push_back(slot);
+        }
+        if (int(free_slots.size()) < int(staged.size())) {
+            GGML_LOG_WARN("HotExpert runtime: flush pool insufficient slots for layer %d "
+                          "(staged=%zu own_free=%d free_slots=%zu experts=%zu full=%d)\n",
+                          layer, staged.size(), L.own_free, free_slots.size(), L.experts.size(), L.full ? 1 : 0);
+            continue;
+        }
+        for (size_t i = 0; i < staged.size(); ++i) {
+            const int e = staged[i];
+            const int dst = free_slots[i];
+            const int src_slot = L.shadow_slot[e];
+            const bank_t & own = s.top64_banks[L.top64_bank];
+            for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                const tensor_slot & t = L.tensors[kind];
+                if (!t.host_ptr) continue;
+                CUDA_CHECK(cudaMemcpyAsync(
+                    static_cast<char *>(own.base) + own.offsets[kind] + size_t(dst) * size_t(t.stride),
+                    static_cast<const char *>(pool.base) + pool.offsets[kind] + size_t(src_slot) * size_t(t.stride),
+                    size_t(t.stride), cudaMemcpyDeviceToDevice, s.side_stream));
+                plan.bytes += size_t(t.stride);
+            }
+            L.slot_of[e] = dst;
+            L.in_shadow[e] = false;
+            L.shadow_slot[e] = -1;
+            L.own_free--;
+            L.shadow_used--;
+        }
+    }
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (L.full) continue;
+        for (int e = 0; e < s.n_experts; ++e) {
+            if (L.in_shadow[e]) pool_used[L.shadow_slot[e]] = true;
+        }
+    }
+    pool.spare_slots.clear();
+    for (int slot = 0; slot < s.pool_slots; ++slot) {
+        if (!pool_used[slot]) pool.spare_slots.push_back(slot);
+    }
+}
+
+static void stage_full_swap(rt_state & s, swap_plan & plan) {
+    if (s.full_shadow_idx < 0) {
+        // full shadow disabled (HOTSEAT_FULL_SHADOW=0): no full-layer migration
+        return;
+    }
+    if (plan.promote_layer < 0) {
+        return;
+    }
+    const int promote = plan.promote_layer;
+    const int demote  = plan.demote_layer;
+    const layer_t & PB = s.layers[promote];
+    const layer_t & PA = s.layers[demote];
+
+    const bank_t & full_shadow = s.full_banks[s.full_shadow_idx];
+    const bank_t & pool = s.top64_banks[s.spare_bank];
+
+    // B: 64 hot experts D2D + 192 cold H2D into the full shadow bank
+    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+        const tensor_slot & t = PB.tensors[kind];
+        if (!t.host_ptr) continue;
+        for (int slot = 0; slot < int(PB.experts.size()); ++slot) {
+            const int e = PB.experts[slot];
+            const void * src = resident_ptr(s, PB, kind, e, size_t(t.stride));
+            CUDA_CHECK(cudaMemcpyAsync(
+                static_cast<char *>(full_shadow.base) + full_shadow.offsets[kind] + size_t(e) * size_t(t.stride),
+                src, size_t(t.stride), cudaMemcpyDeviceToDevice, s.side_stream));
+            plan.bytes += size_t(t.stride);
+        }
+        for (int e = 0; e < t.n_experts; ++e) {
+            if (PB.slot_of[e] >= 0 || PB.in_shadow[e]) continue;
+            CUDA_CHECK(cudaMemcpyAsync(
+                static_cast<char *>(full_shadow.base) + full_shadow.offsets[kind] + size_t(e) * size_t(t.stride),
+                static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream));
+            plan.bytes += size_t(t.stride);
+        }
+    }
+
+    // A: fresh Top-64 D2D from A's full bank into the pool bank
+    const bank_t & afull = s.full_banks[PA.full_bank];
+    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+        const tensor_slot & t = PA.tensors[kind];
+        if (!t.host_ptr) continue;
+        for (int slot = 0; slot < int(plan.demote_experts.size()); ++slot) {
+            const int e = plan.demote_experts[slot];
+            CUDA_CHECK(cudaMemcpyAsync(
+                static_cast<char *>(pool.base) + pool.offsets[kind] + size_t(slot) * size_t(t.stride),
+                static_cast<const char *>(afull.base) + afull.offsets[kind] + size_t(e) * size_t(t.stride),
+                size_t(t.stride), cudaMemcpyDeviceToDevice, s.side_stream));
+            plan.bytes += size_t(t.stride);
+        }
+    }
+}
+
+// apply the plan to the bookkeeping (worker thread, after staging)
+static void apply_plan(rt_state & s, const swap_plan & plan) {
+    for (const auto & p : plan.promotions) {
+        const int layer  = p[0];
+        const int expert = p[1];
+        const int slot   = p[2];
+        const int victim = p[3];
+        layer_t & L = s.layers[layer];
+        for (size_t i = 0; i < L.experts.size(); ++i) {
+            if (L.experts[i] == victim) {
+                L.experts[i] = expert;
+                break;
+            }
+        }
+        if (L.in_shadow[victim]) {
+            // victim lives in the pool: its pool slot becomes free again
+            s.top64_banks[s.spare_bank].spare_slots.push_back(L.shadow_slot[victim]);
+            L.in_shadow[victim] = false;
+            L.shadow_slot[victim] = -1;
+            L.shadow_used--;
+        } else {
+            // victim lives in the layer's own bank: that slot becomes free
+            L.slot_of[victim] = -1;
+            L.own_free++;
+        }
+        L.slot_of[expert] = -1;
+        L.in_shadow[expert] = true;
+        L.shadow_slot[expert] = slot;
+        L.shadow_used++;
+        L.streak[expert] = 0;
+    }
+    // stage J4: arena-backed full-layer promote/demote
+    if (plan.arena_full_promote >= 0) {
+        const int promote = plan.arena_full_promote;
+        const int demote  = plan.arena_full_demote;
+        layer_t & PB = s.layers[promote];
+
+        // promote B: arena full
+        PB.arena_full = true;
+        PB.arena_full_offsets[0] = plan.arena_full_gate_offset;
+        PB.arena_full_offsets[1] = plan.arena_full_gate_offset + PB.tensors[0].bytes;
+        PB.arena_full_offsets[2] = plan.arena_full_gate_offset + PB.tensors[0].bytes + PB.tensors[1].bytes;
+        PB.full = false;
+        PB.experts.clear();
+        std::fill(PB.slot_of.begin(), PB.slot_of.end(), -1);
+        std::fill(PB.in_shadow.begin(), PB.in_shadow.end(), false);
+        PB.own_free = 0;
+        PB.shadow_used = 0;
+        if (demote < 0) {
+            return;   // standalone promotion only (no victim to demote)
+        }
+        layer_t & PA = s.layers[demote];
+
+        // demote A: back to top-N (basic slots)
+        if (PA.arena_full && s.arena.valid()) {
+            // free the old arena full extent after commit (3 contiguous regions)
+            size_t full_bytes = 0;
+            for (int k = 0; k < 3; ++k) full_bytes += PA.tensors[k].bytes;
+            const uint64_t pages = (full_bytes + s.arena.page_bytes() - 1) / s.arena.page_bytes();
+            s.pending_arena_frees.emplace_back(PA.arena_full_offsets[0], pages);
+        }
+        PA.arena_full = false;
+        PA.full = false;
+        std::fill(PA.arena_full_offsets, PA.arena_full_offsets + 3, 0);
+        PA.experts = plan.arena_full_demote_experts;
+        std::fill(PA.slot_of.begin(), PA.slot_of.end(), -1);
+        std::fill(PA.in_shadow.begin(), PA.in_shadow.end(), false);
+        for (int slot = 0; slot < int(PA.experts.size()); ++slot) {
+            PA.slot_of[PA.experts[slot]] = slot;
+        }
+        PA.own_free = 0;
+        PA.shadow_used = 0;
+    }
+
+    // stage J3: apply arena expansions/retirements to the bookkeeping
+    for (const auto & ex : plan.arena_expansions) {
+        const int layer = int(ex[0]);
+        const int expert = int(ex[1]);
+        const uint64_t gate_off = ex[2];
+        layer_t & L = s.layers[layer];
+        // retire the coldest resident to make room in the resident set bookkeeping
+        int victim = -1;
+        double worst = 1e30;
+        for (int e : L.experts) {
+            if (L.short_ewma[e] < worst) { worst = L.short_ewma[e]; victim = e; }
+        }
+        if (victim >= 0) {
+            for (size_t i = 0; i < L.experts.size(); ++i) {
+                if (L.experts[i] == victim) { L.experts[i] = expert; break; }
+            }
+            L.slot_of[victim] = -1;
+            L.own_free++;
+        } else {
+            L.experts.push_back(expert);
+        }
+        L.arena_experts.emplace_back(expert, gate_off);
+    }
+    for (const auto & rt : plan.arena_retirements) {
+        const int layer = int(rt[0]);
+        const int expert = int(rt[1]);
+        auto & ae = s.layers[layer].arena_experts;
+        uint64_t gate_off = 0;
+        bool found = false;
+        for (const auto & p : ae) {
+            if (p.first == expert) { gate_off = p.second; found = true; break; }
+        }
+        ae.erase(std::remove_if(ae.begin(), ae.end(), [&](const auto & p) {
+            return p.first == expert;
+        }), ae.end());
+        if (found && s.arena.valid()) {
+            // release pages only after the commit drains old graphs
+            const size_t per_expert = [] (const rt_state & st) -> size_t {
+                size_t best = 0;
+                for (int layer = 0; layer < st.n_layers; ++layer) {
+                    size_t lb = 0; int ne = 0;
+                    for (int k = 0; k < MAX_TENSORS; ++k) {
+                        lb += st.layers[layer].tensors[k].bytes;
+                        ne = std::max(ne, st.layers[layer].tensors[k].n_experts);
+                    }
+                    if (ne > 0) best = std::max(best, lb / size_t(ne));
+                }
+                return best;
+            }(s);
+            const uint64_t pages = 3 * ((per_expert + s.arena.page_bytes() - 1) / s.arena.page_bytes());
+            s.pending_arena_frees.emplace_back(gate_off, pages);
+        }
+    }
+    if (plan.promote_layer >= 0) {
+        const int promote = plan.promote_layer;
+        const int demote  = plan.demote_layer;
+        layer_t & PB = s.layers[promote];
+        layer_t & PA = s.layers[demote];
+
+        const int old_full  = PA.full_bank;
+        const int old_top64 = PB.top64_bank;
+        const int new_full  = s.full_shadow_idx;
+        const int new_top64 = s.spare_bank;
+
+        PB.full = true;
+        PB.full_bank = new_full;
+        PB.top64_bank = -1;
+        PB.experts.clear();
+        std::fill(PB.slot_of.begin(), PB.slot_of.end(), -1);
+        std::fill(PB.in_shadow.begin(), PB.in_shadow.end(), false);
+        std::fill(PB.shadow_slot.begin(), PB.shadow_slot.end(), -1);
+        PB.own_free = 0;
+        PB.shadow_used = 0;
+        PB.full_streak = 0;
+
+        PA.full = false;
+        PA.full_bank = -1;
+        PA.top64_bank = new_top64;
+        PA.experts = plan.demote_experts;
+        std::fill(PA.slot_of.begin(), PA.slot_of.end(), -1);
+        std::fill(PA.in_shadow.begin(), PA.in_shadow.end(), false);
+        std::fill(PA.shadow_slot.begin(), PA.shadow_slot.end(), -1);
+        for (int slot = 0; slot < int(PA.experts.size()); ++slot) {
+            PA.slot_of[PA.experts[slot]] = slot;
+        }
+        PA.own_free = 0;
+        PA.shadow_used = 0;
+        PA.full_streak = 0;
+
+        s.full_banks[old_full].owner  = -1;
+        s.top64_banks[old_top64].owner = -1;
+        s.full_banks[new_full].owner  = promote;
+        s.top64_banks[new_top64].owner = demote;
+
+        // Rotate the demoted full bank into the idle shadow role.
+        // Otherwise the next full-layer swap would overwrite new_full,
+        // which is already serving the promoted layer.
+        s.full_shadow_idx = old_full;
+
+        // old B top64 bank becomes the new spare pool
+        s.spare_bank = old_top64;
+        s.top64_banks[old_top64].spare_slots.clear();
+        for (int slot = 0; slot < s.pool_slots; ++slot) {
+            s.top64_banks[old_top64].spare_slots.push_back(slot);
+        }
+
+        s.full_cooldown.store(s.layer_cooldown_requests, std::memory_order_relaxed);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// evaluation driver (worker thread)
+// ---------------------------------------------------------------------------
+
+// stage G: break-even adaptive evaluation cycle
+static int adaptive_eval_tokens(rt_state & s) {
+    size_t per_expert = 0;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        size_t layer_bytes = 0;
+        int n_experts = 0;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            layer_bytes += s.layers[layer].tensors[kind].bytes;
+            n_experts = std::max(n_experts, s.layers[layer].tensors[kind].n_experts);
+        }
+        if (n_experts > 0) {
+            per_expert = std::max(per_expert, layer_bytes / size_t(n_experts));
+        }
+    }
+    if (per_expert == 0 || s.h2d_bw_bytes_per_ns <= 0) {
+        return s.expert_eval_tokens;
+    }
+    // copy cost to stage one expert
+    const double copy_us = double(per_expert) / s.h2d_bw_bytes_per_ns * 1e3;
+    // saved cost per hit: host read vs gpu read for one expert slice
+    const double host_ns_per_byte = 1e9 / (s.bw_bytes_per_ns * 1e9);   // PCIe host read
+    const double gpu_ns_per_byte = 2.0;                                 // ~500 GB/s device
+    const double saved_us_per_hit = double(per_expert) * (host_ns_per_byte - gpu_ns_per_byte) / 1e3;
+    if (saved_us_per_hit <= 0) {
+        return s.expert_eval_min;
+    }
+    const double break_even_hits = copy_us / saved_us_per_hit;
+    const double tokens = double(s.expert_eval_safety) * break_even_hits;
+    const int clamped = int(std::min(std::max(tokens, double(s.expert_eval_min)),
+                                     double(s.expert_eval_max)));
+    return clamped;
+}
+
+static bool profile_ready(const rt_state & s) {
+    // minimum data before full-layer migration is allowed; thresholds are
+    // overridable for validation on slow models (defaults per the spec)
+    static const uint64_t min_decode = uint64_t(env_int("HOTSEAT_PROFILE_MIN_DECODE", 16384));
+    static const uint64_t min_prefill = uint64_t(env_int("HOTSEAT_PROFILE_MIN_PREFILL", 16384));
+    static const uint64_t min_requests = uint64_t(env_int("HOTSEAT_PROFILE_MIN_REQUESTS", 8));
+    return s.decode_tokens.load(std::memory_order_acquire) >= min_decode &&
+           s.prefill_tokens.load(std::memory_order_acquire) >= min_prefill &&
+           s.requests.load(std::memory_order_acquire) >= min_requests;
+}
+
+static double coverage(const layer_t & L, int n_experts, int top_k) {
+    const uint64_t * hits = L.decode_hits.data();
+    uint64_t total = 0;
+    for (int e = 0; e < n_experts; ++e) total += hits[e];
+    if (total == 0) return 0.0;
+    std::vector<uint64_t> sorted(hits, hits + n_experts);
+    const int take = std::min(top_k, n_experts);
+    std::partial_sort(sorted.begin(), sorted.begin() + take, sorted.end(),
+                      std::greater<uint64_t>());
+    uint64_t covered = 0;
+    for (int i = 0; i < take; ++i) covered += sorted[i];
+    return double(covered) / double(total);
+}
+
+static void compute_profile(rt_state & s, hotseat_profile & out) {
+    out.generation = s.current_map ? s.current_map->generation : 0;
+    out.decode_tokens = s.decode_tokens.load(std::memory_order_acquire);
+    out.prefill_tokens = s.prefill_tokens.load(std::memory_order_acquire);
+    out.requests = s.requests.load(std::memory_order_acquire);
+    out.ready = profile_ready(s);
+    out.layers.resize(s.n_layers);
+    out.expert_gain.resize(s.n_layers, std::vector<double>(s.n_experts, 0.0));
+
+    const double bw = s.bw_bytes_per_ns * 1e9;   // bytes per second
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered) continue;
+        auto & P = out.layers[layer];
+        P.layer_id = layer;
+        for (int e = 0; e < s.n_experts; ++e) {
+            P.total_routes   += L.decode_hits[e] + L.prefill_hits[e];
+            P.decode_routes  += L.decode_hits[e];
+            P.prefill_routes += L.prefill_hits[e];
+            if (L.decode_hits[e] > 0) P.unique_experts++;
+        }
+        P.coverage_top_8    = coverage(L, s.n_experts, 8);
+        P.coverage_top_16   = coverage(L, s.n_experts, 16);
+        P.coverage_top_32   = coverage(L, s.n_experts, 32);
+        P.coverage_top_48   = coverage(L, s.n_experts, 48);
+        P.coverage_top_64   = coverage(L, s.n_experts, 64);
+        P.coverage_top_96   = coverage(L, s.n_experts, 96);
+        P.coverage_top_128  = coverage(L, s.n_experts, 128);
+
+        size_t layer_bytes = 0;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) layer_bytes += L.tensors[kind].bytes;
+        if (layer_bytes == 0) continue;
+        const double per_expert = double(layer_bytes) / double(std::max(1, s.n_experts));
+
+        const uint64_t miss_delta = L.last_miss_rows >= L.prev_miss_rows
+            ? L.last_miss_rows - L.prev_miss_rows : 0;
+        const uint64_t prefill_delta = L.last_prefill_rows >= L.prev_prefill_rows
+            ? L.last_prefill_rows - L.prev_prefill_rows : 0;
+        // per-layer top expert ids by decode EWMA (cold-start seed for next run)
+        {
+            std::vector<int> order(s.n_experts);
+            std::iota(order.begin(), order.end(), 0);
+            std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+                return L.short_ewma[a] > L.short_ewma[b];
+            });
+            const int take = std::min(32, s.n_experts);
+            P.top_experts.assign(order.begin(), order.begin() + take);
+        }
+        P.miss_bytes = double(miss_delta) * per_expert;
+        P.stall_ns   = (P.miss_bytes + double(prefill_delta) * double(layer_bytes)) / bw * 1e9;
+        // full-layer gain = prefill host cost saved + decode miss cost saved
+        P.full_layer_gain = (double(prefill_delta) * double(layer_bytes) + P.miss_bytes) / bw * 1e9;
+
+        // per-expert unit gain: expected hits * host cost saved per hit / bytes
+        const double host_cost_per_byte_ns = 1e9 / bw;
+        for (int e = 0; e < s.n_experts; ++e) {
+            const double delta = double(L.decode_hits[e]) - double(L.prev_hits[e]);
+            if (delta > 0.0) {
+                out.expert_gain[layer][e] =
+                    delta * per_expert * host_cost_per_byte_ns / per_expert
+                    / double(s.n_experts);   // normalized per-expert unit
+            }
+        }
+    }
+}
+
+static void write_profile_json(rt_state & s, const hotseat_profile & p) {
+    const char * dir = std::getenv("HOTSEAT_AUTO_PROFILE_DIR");
+    if (!dir || !*dir) dir = "/app/share/openclaw_tools/hotexpert-profiles";
+    // fingerprint-scoped file so multiple models do not clobber each other
+    std::string fingerprint = "runtime";
+    hotseat_model_descriptor desc;
+    if (ggml_cuda_hotexpert_descriptor_build(desc)) {
+        fingerprint = desc.fingerprint;
+    }
+    const std::string path = std::string(dir) + "/" + fingerprint + ".profile.json";
+    FILE * fp = std::fopen(path.c_str(), "w");
+    if (!fp) return;
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp, "  \"model_fingerprint\": \"%s\",\n", fingerprint.c_str());
+    std::fprintf(fp, "  \"generation\": %llu,\n", (unsigned long long) p.generation);
+    std::fprintf(fp, "  \"decode_tokens\": %llu,\n", (unsigned long long) p.decode_tokens);
+    std::fprintf(fp, "  \"prefill_tokens\": %llu,\n", (unsigned long long) p.prefill_tokens);
+    std::fprintf(fp, "  \"requests\": %llu,\n", (unsigned long long) p.requests);
+    std::fprintf(fp, "  \"ready\": %s,\n", p.ready ? "true" : "false");
+    std::fprintf(fp, "  \"arena\": {\n");
+    std::fprintf(fp, "    \"enabled\": %s,\n", s.arena_enabled ? "true" : "false");
+    std::fprintf(fp, "    \"valid\": %s,\n", s.arena.valid() ? "true" : "false");
+    std::fprintf(fp, "    \"total_bytes\": %llu,\n", (unsigned long long) (s.arena.valid() ? s.arena.total_bytes() : 0));
+    std::fprintf(fp, "    \"used_bytes\": %llu,\n", (unsigned long long) (s.arena.valid() ? s.arena.used_bytes() : 0));
+    std::fprintf(fp, "    \"free_bytes\": %llu,\n", (unsigned long long) (s.arena.valid() ? s.arena.free_bytes() : 0));
+    std::fprintf(fp, "    \"physical_free_low_water\": %llu,\n", (unsigned long long) s.arena_min_free_seen);
+    std::fprintf(fp, "    \"frozen\": %s\n", s.arena_frozen.load(std::memory_order_relaxed) ? "true" : "false");
+    std::fprintf(fp, "  },\n");
+    std::fprintf(fp, "  \"layers\": [\n");
+    bool first = true;
+    for (const auto & L : p.layers) {
+        if (L.layer_id < 0) continue;
+        if (!first) std::fprintf(fp, ",\n");
+        first = false;
+        std::fprintf(fp,
+            "    {\"layer\": %d, \"total_routes\": %llu, \"decode_routes\": %llu,"
+            " \"prefill_routes\": %llu, \"unique\": %d,"
+            " \"top8\": %.4f, \"top16\": %.4f, \"top32\": %.4f, \"top48\": %.4f,"
+            " \"top64\": %.4f, \"top96\": %.4f, \"top128\": %.4f,"
+            " \"miss_bytes\": %.0f, \"stall_ns\": %.0f, \"full_layer_gain\": %.0f,"
+            " \"top_experts\": [",
+            L.layer_id, (unsigned long long) L.total_routes,
+            (unsigned long long) L.decode_routes, (unsigned long long) L.prefill_routes,
+            L.unique_experts,
+            L.coverage_top_8, L.coverage_top_16, L.coverage_top_32, L.coverage_top_48,
+            L.coverage_top_64, L.coverage_top_96, L.coverage_top_128,
+            L.miss_bytes, L.stall_ns, L.full_layer_gain);
+        for (size_t i = 0; i < L.top_experts.size(); ++i) {
+            std::fprintf(fp, "%s%d", i ? "," : "", L.top_experts[i]);
+        }
+        std::fprintf(fp, "]}");
+    }
+    std::fprintf(fp, "\n  ]\n}\n");
+    std::fclose(fp);
+}
+
+// stage I: circuit-breaker check; returns true when rolled back to the
+// previous generation (or fully disabled)
+static bool check_rollback(rt_state & s) {
+    if (!s.rollback_enabled || s.disabled.load(std::memory_order_relaxed)) {
+        return false;
+    }
+    // decode TPS degradation across consecutive windows
+    const double tps = s.window_tps.load(std::memory_order_relaxed);
+    const double last = s.last_tps.load(std::memory_order_relaxed);
+    if (tps > 0 && last > 0 && tps < last * (1.0 - double(s.rollback_tps_drop_pct) / 100.0)) {
+        const int drops = ++s.tps_drop_windows;
+        if (drops >= 3) {
+            s.disabled.store(true, std::memory_order_release);
+            s.disable_reason = "decode TPS dropped > " + std::to_string(s.rollback_tps_drop_pct) + "% for 3 windows";
+            GGML_LOG_WARN("HotExpert runtime: circuit breaker: %s\n", s.disable_reason.c_str());
+            return true;
+        }
+    } else {
+        s.tps_drop_windows = 0;
+    }
+    s.last_tps.store(tps, std::memory_order_relaxed);
+    return false;
+}
+
+// stage J3: stage arena capacity changes (worker; side stream)
+static void stage_arena_changes(rt_state & s, swap_plan & plan) {
+    if (!s.arena_enabled || !s.arena.valid() || s.arena_frozen.load(std::memory_order_relaxed) ||
+        plan.arena_full_promote >= 0) {
+        return;
+    }
+    const size_t per_expert = [] (const rt_state & st) -> size_t {
+        size_t best = 0;
+        for (int layer = 0; layer < st.n_layers; ++layer) {
+            size_t lb = 0; int ne = 0;
+            for (int k = 0; k < MAX_TENSORS; ++k) {
+                lb += st.layers[layer].tensors[k].bytes;
+                ne = std::max(ne, st.layers[layer].tensors[k].n_experts);
+            }
+            if (ne > 0) best = std::max(best, lb / size_t(ne));
+        }
+        return best;
+    }(s);
+    if (per_expert == 0) {
+        return;
+    }
+    const uint64_t pages_per_expert = (per_expert + s.arena.page_bytes() - 1) / s.arena.page_bytes();
+    const uint64_t gate_bytes = 3 * pages_per_expert * s.arena.page_bytes();   // gate+up+down
+
+    // ---- expansions: highest-EWMA non-resident experts ----
+    int changes = 0;
+    uint64_t budget_bytes = 0;
+    const int max_changes = env_int("HOTSEAT_ARENA_MAX_EXPERT_CHANGES", 16);
+    const uint64_t max_rebalance = uint64_t(env_int("HOTSEAT_ARENA_MAX_REBALANCE_MB", 256)) << 20;
+    std::vector<std::pair<int, int>> candidates;   // (layer, expert)
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        if (L.full || L.slots == 0) continue;
+        double worst = 1e30;
+        for (int e : L.experts) worst = std::min(worst, L.short_ewma[e]);
+        if (worst <= 0.0) continue;
+        for (const auto & ae : L.arena_experts) worst = std::min(worst, L.short_ewma[ae.first]);
+        for (int e = 0; e < s.n_experts; ++e) {
+            if (L.slot_of[e] >= 0 || L.in_shadow[e]) continue;
+            bool in_arena = false;
+            for (const auto & ae : L.arena_experts) if (ae.first == e) { in_arena = true; break; }
+            if (in_arena) continue;
+            if (L.short_ewma[e] < s.expert_ratio * worst) continue;
+            if (L.short_ewma[e] < L.long_ewma[e]) continue;
+            candidates.emplace_back(layer, e);
+        }
+    }
+    std::stable_sort(candidates.begin(), candidates.end(), [&](const auto & a, const auto & b) {
+        return s.layers[a.first].short_ewma[a.second] > s.layers[b.first].short_ewma[b.second];
+    });
+    for (const auto & c : candidates) {
+        if (changes >= max_changes) break;
+        if (budget_bytes + gate_bytes > max_rebalance) break;
+        if (s.arena.free_bytes() < gate_bytes) break;
+        const int layer = c.first;
+        const int expert = c.second;
+        layer_t & L = s.layers[layer];
+        // bound: base slots + arena slots must stay within a sane cap
+        if (int(L.experts.size()) + int(L.arena_experts.size()) >= 256) continue;
+        uint64_t offset = 0, bytes = 0;
+        if (!s.arena.allocate_pages(pages_per_expert * 3, offset, bytes)) {
+            continue;
+        }
+        const uint64_t gate_off = offset;
+        const uint64_t up_off   = offset + pages_per_expert * s.arena.page_bytes();
+        const uint64_t down_off = offset + 2 * pages_per_expert * s.arena.page_bytes();
+        bool ok = true;
+        for (int kind = 0; kind < 3; ++kind) {
+            const tensor_slot & t = L.tensors[kind];
+            if (!t.host_ptr) continue;
+            const uint64_t dst = kind == 0 ? gate_off : kind == 1 ? up_off : down_off;
+            if (cudaMemcpyAsync(
+                    static_cast<char *>(s.arena.base()) + dst,
+                    static_cast<const char *>(t.host_ptr) + size_t(expert) * size_t(t.stride),
+                    size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream) != cudaSuccess) {
+                ok = false;
+                break;
+            }
+            plan.bytes += size_t(t.stride);
+        }
+        if (!ok) {
+            s.arena.free_pages(offset, pages_per_expert * 3);
+            continue;
+        }
+        plan.arena_expansions.push_back({uint64_t(layer), uint64_t(expert), gate_off});
+        budget_bytes += gate_bytes;
+        changes++;
+    }
+
+    // ---- retirements: coldest arena experts (below a floor) ----
+    const double retire_floor = env_double("HOTSEAT_ARENA_RETIRE_FLOOR", 0.01);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        for (const auto & ae : L.arena_experts) {
+            // EWMA==0 means freshly staged (no window data yet): keep it
+            if (L.short_ewma[ae.first] > 0.0 && L.short_ewma[ae.first] < retire_floor) {
+                plan.arena_retirements.push_back({uint64_t(layer), uint64_t(ae.first)});
+            }
+        }
+    }
+}
+
+// stage J4: arena-backed full-layer promotion (one at a time)
+// Promotes the highest-stall non-full layer to a full arena extent; demotes
+// the coldest current full layer in the same commit. No second full shadow:
+// the demoted layer's extent is released after the commit drains old graphs
+// and becomes reusable by the next promotion.
+static void stage_arena_full_swap(rt_state & s, swap_plan & plan) {
+    static const bool enabled = [] {
+        const char * v = std::getenv("HOTSEAT_ARENA_FULL_LAYER_ENABLE");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (!enabled || !s.arena_enabled || !s.arena.valid() ||
+        s.arena_frozen.load(std::memory_order_relaxed) || plan.promote_layer >= 0) {
+        return;   // one structural change per commit
+    }
+    // pick the highest-stall non-full layer as the promotion candidate
+    // (window-delta approximation from the cumulative miss/prefill counters)
+    auto layer_stall = [&](int layer) -> double {
+        const layer_t & L = s.layers[layer];
+        size_t layer_bytes = 0;
+        for (int k = 0; k < MAX_TENSORS; ++k) layer_bytes += L.tensors[k].bytes;
+        if (layer_bytes == 0) return 0.0;
+        const double per_expert = double(layer_bytes) / double(std::max(1, s.n_experts));
+        // cumulative counters for ranking (prev pointers are advanced by
+        // update_ewma earlier in the same evaluation)
+        const uint64_t miss = L.last_miss_rows;
+        const uint64_t pre = L.last_prefill_rows;
+        return double(miss) * per_expert + double(pre) * double(layer_bytes);
+    };
+    int best = -1;
+    double best_score = 0.0;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered || L.full || L.arena_full) continue;
+        const double score = layer_stall(layer);
+        if (score > best_score) { best_score = score; best = layer; }
+    }
+    if (best < 0) return;
+    const layer_t & PB = s.layers[best];
+    size_t full_bytes = 0;
+    for (int k = 0; k < 3; ++k) full_bytes += PB.tensors[k].bytes;
+    if (full_bytes == 0 || s.arena.free_bytes() < full_bytes) {
+        return;   // no contiguous room: demote-then-promote would need a pass
+    }
+    // demote the coldest current full layer (arena-backed or bank-backed)
+    int demote = -1;
+    double demote_score = 1e30;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered || !(L.full || L.arena_full)) continue;
+        const double score = layer_stall(layer);
+        if (score < demote_score) { demote_score = score; demote = layer; }
+    }
+    // only swap when the gain is meaningful (no victim needed for the first
+    // promotion: the arena has room, so a standalone full layer is fine)
+    if (demote >= 0 && best_score < s.layer_ratio * std::max(demote_score, 1e-9)) {
+        return;
+    }
+    // allocate three contiguous extents (gate/up/down) in the arena
+    uint64_t gate_off = 0, up_off = 0, down_off = 0;
+    uint64_t b = 0;
+    if (!s.arena.allocate_extent(PB.tensors[0].bytes, gate_off)) return;
+    if (!s.arena.allocate_extent(PB.tensors[1].bytes, up_off)) {
+        s.arena.free_pages(gate_off, (PB.tensors[0].bytes + s.arena.page_bytes() - 1) / s.arena.page_bytes());
+        return;
+    }
+    if (!s.arena.allocate_extent(PB.tensors[2].bytes, down_off)) {
+        s.arena.free_pages(gate_off, (PB.tensors[0].bytes + s.arena.page_bytes() - 1) / s.arena.page_bytes());
+        s.arena.free_pages(up_off, (PB.tensors[1].bytes + s.arena.page_bytes() - 1) / s.arena.page_bytes());
+        return;
+    }
+    // copy: hot experts D2D from their current resident slots, cold H2D
+    const uint64_t offsets[3] = {gate_off, up_off, down_off};
+    for (int kind = 0; kind < 3; ++kind) {
+        const tensor_slot & t = PB.tensors[kind];
+        if (!t.host_ptr) continue;
+        for (int e = 0; e < t.n_experts; ++e) {
+            const void * src = nullptr;
+            bool resident = false;
+            for (int re : PB.experts) if (re == e) { resident = true; break; }
+            for (const auto & ae : PB.arena_experts) if (ae.first == e) { resident = true; break; }
+            if (resident) {
+                if (PB.slot_of[e] >= 0) {
+                    const bank_t & bank = s.top64_banks[PB.top64_bank];
+                    src = static_cast<const char *>(bank.base) + bank.offsets[kind] +
+                          size_t(PB.slot_of[e]) * size_t(t.stride);
+                } else if (PB.in_shadow[e]) {
+                    src = static_cast<const char *>(s.top64_banks[s.spare_bank].base) +
+                          s.top64_banks[s.spare_bank].offsets[kind] +
+                          size_t(PB.shadow_slot[e]) * size_t(t.stride);
+                } else {
+                    for (const auto & ae : PB.arena_experts) {
+                        if (ae.first == e) {
+                            src = static_cast<const char *>(s.arena.base()) + ae.second +
+                                  size_t(kind) * size_t(t.stride);
+                            break;
+                        }
+                    }
+                }
+            }
+            if (src) {
+                CUDA_CHECK(cudaMemcpyAsync(
+                    static_cast<char *>(s.arena.base()) + offsets[kind] + size_t(e) * size_t(t.stride),
+                    src, size_t(t.stride), cudaMemcpyDeviceToDevice, s.side_stream));
+            } else {
+                CUDA_CHECK(cudaMemcpyAsync(
+                    static_cast<char *>(s.arena.base()) + offsets[kind] + size_t(e) * size_t(t.stride),
+                    static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                    size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream));
+            }
+            plan.bytes += size_t(t.stride);
+        }
+    }
+        plan.arena_full_promote = best;
+    plan.arena_full_demote = demote;
+    plan.arena_full_gate_offset = gate_off;
+    std::fprintf(stderr, "[j4] plan set promote=%d demote=%d\n", best, demote);
+    if (demote >= 0) {
+        // demoted layer's new top-N set from its EWMA
+        const layer_t & DA = s.layers[demote];
+        std::vector<int> order(s.n_experts);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+            return DA.short_ewma[a] > DA.short_ewma[b];
+        });
+        plan.arena_full_demote_experts.assign(order.begin(),
+            order.begin() + std::min(s.top_k, s.n_experts));
+    }
+}
+
+static void run_evaluation(rt_state & s) {
+    if (!s.initialized) {
+        return;
+    }
+    if (check_rollback(s)) {
+        // J5: request the main thread to restore the previous stable mapping
+        s.rollback_requested.store(true, std::memory_order_release);
+        s.eval_requested.store(false, std::memory_order_release);
+        return;
+    }
+    CUDA_CHECK(cudaSetDevice(s.device));
+    snapshot_counters(s);
+
+    // window deltas (prev snapshot -> current snapshot)
+    std::vector<std::vector<uint64_t>> delta_hits(s.n_layers, std::vector<uint64_t>(s.n_experts, 0));
+    std::vector<uint64_t> miss_delta(s.n_layers, 0);
+    std::vector<uint64_t> prefill_delta(s.n_layers, 0);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        layer_t & L = s.layers[layer];
+        for (int e = 0; e < s.n_experts; ++e) {
+            const uint64_t cur = L.decode_hits[e];
+            delta_hits[layer][e] = cur >= L.prev_hits[e] ? cur - L.prev_hits[e] : 0;
+        }
+        miss_delta[layer]     = L.last_miss_rows >= L.prev_miss_rows ? L.last_miss_rows - L.prev_miss_rows : 0;
+        prefill_delta[layer]  = L.last_prefill_rows >= L.prev_prefill_rows ? L.last_prefill_rows - L.prev_prefill_rows : 0;
+    }
+    // stage J2: arena status in the profile
+    if (s.arena_enabled && s.arena.valid()) {
+        GGML_LOG_INFO("HotExpert arena: used=%llu MiB free=%llu MiB runs=%llu phys_free_low=%llu MiB frozen=%d\n",
+            (unsigned long long) (s.arena.used_bytes() >> 20),
+            (unsigned long long) (s.arena.free_bytes() >> 20),
+            (unsigned long long) s.arena.free_run_count(),
+            (unsigned long long) (s.arena_min_free_seen >> 20),
+            s.arena_frozen.load(std::memory_order_relaxed) ? 1 : 0);
+    }
+
+    // stage D: persist the routing profile BEFORE the EWMA prev-pointers are
+    // advanced, so window deltas stay meaningful
+    {
+        hotseat_profile profile;
+        compute_profile(s, profile);
+        write_profile_json(s, profile);
+    }
+    update_ewma(s, delta_hits);
+
+    swap_plan plan;
+    bool full_swap = false;
+
+    // ---- full-layer swap decision (hybrid only; gated on profile readiness) ----
+    if (s.hybrid && s.full_cooldown.load(std::memory_order_relaxed) <= 0 && profile_ready(s)) {
+        double best_promote_score = -1.0;
+        int    best_promote = -1;
+        double worst_full_score = 1e30;
+        int    worst_full = -1;
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            const layer_t & L = s.layers[layer];
+            if (!L.registered) continue;
+            const double score = layer_stall_bytes(s, layer, delta_hits, miss_delta[layer], prefill_delta[layer]);
+            if (L.full) {
+                if (score < worst_full_score) {
+                    worst_full_score = score;
+                    worst_full = layer;
+                }
+            } else {
+                if (score > best_promote_score) {
+                    best_promote_score = score;
+                    best_promote = layer;
+                }
+            }
+        }
+        if (best_promote >= 0 && worst_full >= 0 &&
+            best_promote_score >= s.layer_ratio * std::max(worst_full_score, 1e-9)) {
+            layer_t & PL = s.layers[best_promote];
+            PL.full_streak++;
+            if (PL.full_streak >= s.layer_confirm) {
+                full_swap = true;
+                plan.promote_layer = best_promote;
+                plan.demote_layer  = worst_full;
+                plan.promote_score = best_promote_score;
+                plan.demote_score  = worst_full_score;
+                // fresh Top-64 for the demoted layer from decode EWMA
+                const layer_t & DL = s.layers[worst_full];
+                std::vector<int> order(s.n_experts);
+                std::iota(order.begin(), order.end(), 0);
+                std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+                    return DL.short_ewma[a] > DL.short_ewma[b];
+                });
+                plan.demote_experts.assign(order.begin(), order.begin() + s.top_k);
+                PL.full_streak = 0;
+            }
+        } else {
+            for (int layer = 0; layer < s.n_layers; ++layer) {
+                s.layers[layer].full_streak = 0;
+            }
+        }
+    }
+
+    // ---- expert promotions (not together with a full-layer swap) ----
+    if (!full_swap) {
+        int budget = s.expert_max_swap;
+        std::vector<promotion_t> qualified;
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            layer_t & L = s.layers[layer];
+            if (L.full) continue;
+            if (int(L.experts.size()) < std::max(L.slots, 1)) continue;
+            double worst_resident = 1e30;
+            for (int e : L.experts) worst_resident = std::min(worst_resident, L.short_ewma[e]);
+            if (worst_resident <= 0.0) continue;
+            for (int e = 0; e < s.n_experts; ++e) {
+                if (L.slot_of[e] >= 0 || L.in_shadow[e]) continue;
+                const double sh = L.short_ewma[e];
+                if (sh <= 0.0) continue;
+                if (sh < s.expert_ratio * worst_resident) continue;
+                if (sh < L.long_ewma[e]) continue;
+                L.streak[e]++;
+                if (L.streak[e] >= s.expert_confirm) {
+                    qualified.push_back({layer, e, -1, -1});
+                }
+            }
+        }
+        std::stable_sort(qualified.begin(), qualified.end(), [&](const promotion_t & a, const promotion_t & b) {
+            return s.layers[a[0]].short_ewma[a[1]] > s.layers[b[0]].short_ewma[b[1]];
+        });
+        bank_t & pool = s.top64_banks[s.spare_bank];
+        std::vector<int> promoted_layers;   // at most one promotion per layer per eval
+        for (auto & q : qualified) {
+            if (budget <= 0) break;
+            if (pool.spare_slots.empty()) break;
+            const int layer  = q[0];
+            const int expert = q[1];
+            if (std::find(promoted_layers.begin(), promoted_layers.end(), layer) != promoted_layers.end()) {
+                continue;
+            }
+            layer_t & L = s.layers[layer];
+            int victim = -1;
+            double worst = 1e30;
+            for (int e : L.experts) {
+                if (L.short_ewma[e] < worst) {
+                    worst = L.short_ewma[e];
+                    victim = e;
+                }
+            }
+            if (victim < 0) continue;
+            const int slot = pool.spare_slots.back();
+            pool.spare_slots.pop_back();
+            plan.promotions.push_back({layer, expert, slot, victim});
+            promoted_layers.push_back(layer);
+            L.streak[expert] = 0;
+            budget--;
+        }
+    }
+
+    // stage J4: arena-backed full-layer promotion (gated by env; takes
+    // priority over expert expansions so a high-gain full layer is not
+    // starved by cheap slot additions)
+    stage_arena_full_swap(s, plan);
+    // stage J3: arena capacity operations (expansion + retirement)
+    stage_arena_changes(s, plan);
+    if (s.arena_enabled) {
+        std::lock_guard<std::mutex> lock(s.log_mutex);
+        FILE * out = s.log_file ? s.log_file : stderr;
+        std::fprintf(out,
+            "{\"ts\":%lld,\"event\":\"eval\",\"decode\":%llu,\"arena_valid\":%d,"
+            "\"arena_free_mib\":%llu,\"frozen\":%d,\"expansions\":%zu,\"retirements\":%zu}\n",
+            (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::system_clock::now().time_since_epoch()).count(),
+            (unsigned long long) s.decode_tokens.load(std::memory_order_acquire),
+            s.arena.valid() ? 1 : 0,
+            (unsigned long long) (s.arena.valid() ? (s.arena.free_bytes() >> 20) : 0),
+            s.arena_frozen.load(std::memory_order_relaxed) ? 1 : 0,
+            plan.arena_expansions.size(), plan.arena_retirements.size());
+        std::fflush(out);
+    }
+
+    if (plan.promotions.empty() && plan.promote_layer < 0 &&
+        plan.arena_expansions.empty() && plan.arena_retirements.empty() &&
+        plan.arena_full_promote < 0) {
+        // nothing to do; advance the eval watermark
+        save_runtime_snapshot(s);
+        s.last_eval_decode.store(s.decode_tokens.load(std::memory_order_acquire), std::memory_order_release);
+        s.last_eval_prefill.store(s.prefill_tokens.load(std::memory_order_acquire), std::memory_order_release);
+        s.last_eval_requests.store(s.requests.load(std::memory_order_acquire), std::memory_order_release);
+        s.eval_requested.store(false, std::memory_order_release);
+        return;
+    }
+
+    // ---- staging (reads only the current committed banks) ----
+    CUDA_CHECK(cudaEventRecord(s.copy_start, s.side_stream));
+    if (plan.promote_layer >= 0) {
+        flush_pool(s, plan);
+    }
+    stage_promotions(s, plan);
+    stage_full_swap(s, plan);
+    // stage J3 arena copies already issued by stage_arena_changes (side stream)
+
+    // ---- apply bookkeeping, then upload tables + resident bitmap ----
+    apply_plan(s, plan);
+    upload_all_tables(s);
+    std::vector<uint32_t> bits;
+    build_resident_bits(s, bits);
+    CUDA_CHECK(cudaMemcpyAsync(s.d_resident, bits.data(), bits.size() * sizeof(uint32_t),
+        cudaMemcpyHostToDevice, s.side_stream));
+
+    CUDA_CHECK(cudaEventRecord(s.ready_event, s.side_stream));
+    CUDA_CHECK(cudaEventRecord(s.copy_end, s.side_stream));
+    float copy_ms = 0.0f;
+    CUDA_CHECK(cudaEventSynchronize(s.copy_end));
+    CUDA_CHECK(hipEventElapsedTime(&copy_ms, s.copy_start, s.copy_end));
+    plan.copy_us = double(copy_ms) * 1000.0;
+
+    auto map = std::make_unique<map_t>();
+    map->generation = (s.current_map ? s.current_map->generation : 1) + 1;
+    map->layer_to_full_bank.assign(s.n_layers, -1);
+    map->layer_to_top64_bank.assign(s.n_layers, -1);
+    map->tables.resize(s.n_layers);
+    map->full_bases.resize(s.n_layers);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        map->layer_to_full_bank[layer]  = s.layers[layer].full ? s.layers[layer].full_bank : -1;
+        map->layer_to_top64_bank[layer] = s.layers[layer].full ? -1 : s.layers[layer].top64_bank;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = s.layers[layer].tensors[kind];
+            if (!t.host_ptr) continue;
+            if (s.layers[layer].slots == 0) {
+                map->tables[layer][kind] = nullptr;
+                continue;
+            }
+            map->tables[layer][kind] = t.tables[1 - t.committed_buf];
+            if (s.layers[layer].full && s.hybrid) {
+                const bank_t & bank = s.full_banks[s.layers[layer].full_bank];
+                map->full_bases[layer][kind] =
+                    static_cast<const char *>(bank.base) + bank.offsets[kind];
+            }
+        }
+    }
+
+    // stage J4 structured log
+    if (plan.arena_full_promote >= 0) {
+        std::lock_guard<std::mutex> lock(s.log_mutex);
+        FILE * out = s.log_file ? s.log_file : stderr;
+        std::fprintf(out,
+            "{\"ts\":%lld,\"event\":\"arena_full_swap\",\"generation\":%llu,"
+            "\"promote_layer\":%d,\"demote_layer\":%d,\"bytes\":%zu,\"copy_us\":%.1f}\n",
+            (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::system_clock::now().time_since_epoch()).count(),
+            (unsigned long long) map->generation, plan.arena_full_promote,
+            plan.arena_full_demote, plan.bytes, plan.copy_us);
+        std::fflush(out);
+    }
+
+    // stage J3 structured logs
+    // bytes = this event's per-expert copy size (gate+up+down); the batch
+    // totals are reported separately so per-expert accounting never gets
+    // inflated by the batch accumulator (the 8x trap in early reports)
+    size_t per_expert_bytes = 0;
+    for (const auto & ex : plan.arena_expansions) {
+        const layer_t & EL = s.layers[int(ex[0])];
+        size_t eb = 0;
+        for (int k = 0; k < 3; ++k) eb += size_t(EL.tensors[k].stride);
+        per_expert_bytes = eb;
+        std::lock_guard<std::mutex> lock(s.log_mutex);
+        FILE * out = s.log_file ? s.log_file : stderr;
+        std::fprintf(out,
+            "{\"ts\":%lld,\"event\":\"arena_expand\",\"generation\":%llu,\"layer\":%d,"
+            "\"expert\":%d,\"bytes\":%zu,\"batch_bytes\":%zu,\"batch_count\":%zu,"
+            "\"copy_us\":%.1f,\"candidate_ewma\":%.6f}\n",
+            (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::system_clock::now().time_since_epoch()).count(),
+            (unsigned long long) map->generation, int(ex[0]), int(ex[1]),
+            eb, plan.bytes, plan.arena_expansions.size(),
+            plan.copy_us, s.layers[int(ex[0])].short_ewma[int(ex[1])]);
+        std::fflush(out);
+    }
+    for (const auto & rt : plan.arena_retirements) {
+        std::lock_guard<std::mutex> lock(s.log_mutex);
+        FILE * out = s.log_file ? s.log_file : stderr;
+        std::fprintf(out,
+            "{\"ts\":%lld,\"event\":\"arena_retire\",\"generation\":%llu,\"layer\":%d,"
+            "\"expert\":%d,\"victim_ewma\":%.6f}\n",
+            (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::system_clock::now().time_since_epoch()).count(),
+            (unsigned long long) map->generation, int(rt[0]), int(rt[1]),
+            s.layers[int(rt[0])].short_ewma[int(rt[1])]);
+        std::fflush(out);
+    }
+
+    // structured logs
+    if (plan.promote_layer >= 0) {
+        log_full_swap(map->generation, plan.promote_layer, plan.demote_layer,
+                      plan.bytes, plan.copy_us, plan.promote_score, plan.demote_score);
+    }
+    for (const auto & p : plan.promotions) {
+        const int layer = p[0], expert = p[1], victim = p[3];
+        log_expert_swap(map->generation, layer, expert, victim, p[2],
+                        plan.bytes, plan.copy_us,
+                        s.layers[layer].short_ewma[expert],
+                        s.layers[layer].short_ewma[victim]);
+    }
+
+    // publish
+    s.pending_map = std::move(map);
+    s.commit_pending.store(true, std::memory_order_release);
+    s.commit_applied.store(false, std::memory_order_release);
+
+    // wait for the main thread to apply the commit before the next swap
+    {
+        std::unique_lock<std::mutex> lock(s.commit_mutex);
+        s.commit_cv.wait(lock, [&] {
+            return s.commit_applied.load(std::memory_order_acquire);
+        });
+    }
+
+    // stage J3: release retired arena pages now that old graphs are drained
+    if (s.arena.valid() && !s.pending_arena_frees.empty()) {
+        const uint64_t pages_per_expert3 = 3 * ((s.layers[0].tensors[0].stride > 0
+            ? size_t(s.layers[0].tensors[0].stride) : 1) + s.arena.page_bytes() - 1) / s.arena.page_bytes();
+        GGML_UNUSED(pages_per_expert3);
+        for (const auto & f : s.pending_arena_frees) {
+            s.arena.free_pages(f.first, f.second);
+        }
+        s.pending_arena_frees.clear();
+    }
+
+    save_runtime_snapshot(s);
+    s.last_eval_decode.store(s.decode_tokens.load(std::memory_order_acquire), std::memory_order_release);
+    s.last_eval_prefill.store(s.prefill_tokens.load(std::memory_order_acquire), std::memory_order_release);
+    s.last_eval_requests.store(s.requests.load(std::memory_order_acquire), std::memory_order_release);
+    s.eval_requested.store(false, std::memory_order_release);
+}
+
+static void v2_prefetch_worker_loop(rt_state * s) {
+    uint64_t next_token = 0;
+    CUDA_CHECK(cudaSetDevice(s->device));
+    for (;;) {
+        uint64_t latest = UINT64_MAX;
+        {
+            std::unique_lock<std::mutex> lock(s->v2_prefetch_mutex);
+            s->v2_prefetch_cv.wait(lock, [&] {
+                const uint64_t l = s->v2_latest_token.load(std::memory_order_acquire);
+                return s->v2_prefetch_stopping || (l != UINT64_MAX && l >= next_token);
+            });
+            if (s->v2_prefetch_stopping) {
+                return;
+            }
+            latest = s->v2_latest_token.load(std::memory_order_acquire);
+        }
+        if (!s->h_v2_routes || latest == UINT64_MAX || s->n_layers <= 0) {
+            continue;
+        }
+        while (next_token <= latest) {
+            const uint64_t token = next_token++;
+            uint64_t valid = 0;
+            const size_t base = size_t(token % s->v2_route_capacity) * size_t(s->n_layers);
+            for (int layer = 0; layer < s->n_layers; ++layer) {
+                const v2_route_record & r = s->h_v2_routes[base + size_t(layer)];
+                if (r.token == token && r.route_count > 0) {
+                    ++valid;
+                }
+            }
+            if (valid == uint64_t(s->n_layers)) {
+                uint64_t routed = 0, resident = 0, transit = 0;
+                for (int layer = 0; layer < s->n_layers; ++layer) {
+                    const v2_route_record & r = s->h_v2_routes[base + size_t(layer)];
+                    routed += r.route_count;
+                    for (uint32_t i = 0; i < r.route_count && i < GGML_HOTEXPERT_V2_PROFILE_TOP_K; ++i) {
+                        resident += r.resident_flags[i] ? 1u : 0u;
+                        transit += r.transit_flags[i] ? 1u : 0u;
+                    }
+                }
+                s->v2_routed_experts.fetch_add(routed, std::memory_order_relaxed);
+                s->v2_resident_hits.fetch_add(resident, std::memory_order_relaxed);
+                s->v2_transit_hits.fetch_add(transit, std::memory_order_relaxed);
+                s->v2_route_complete_tokens.fetch_add(1, std::memory_order_relaxed);
+            } else {
+                s->v2_route_missing_layers.fetch_add(uint64_t(s->n_layers) - valid, std::memory_order_relaxed);
+                continue;
+            }
+
+            if (!s->d_v2_transit_meta || !s->d_v2_transit_base || !s->v2_prefetch_stream) {
+                continue;
+            }
+
+            const uint64_t target = token + 1;
+            const int bank = int(target % GGML_HOTEXPERT_V2_TRANSIT_BANKS);
+            uint64_t token_experts = 0;
+            uint64_t token_bytes = 0;
+
+            for (int layer = 0; layer < s->n_layers; ++layer) {
+                const layer_t & L = s->layers[layer];
+                if (!L.registered || L.full || L.arena_full) continue;
+                const v2_route_record & r = s->h_v2_routes[base + size_t(layer)];
+
+                int32_t selected[GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS] = { -1, -1, -1, -1 };
+                int n_selected = 0;
+                const int routes = std::min<int>(r.route_count, GGML_HOTEXPERT_V2_PROFILE_TOP_K);
+                if (s->v2_predictor_loaded) {
+                    std::array<std::pair<uint32_t, int>, GGML_HOTEXPERT_V2_PROFILE_TOP_K> cand{};
+                    int n_cand = 0;
+                    for (int i = 0; i < routes; ++i) {
+                        const int e = r.expert_ids[i];
+                        if (e < 0 || e >= s->n_experts || r.resident_flags[i]) continue;
+                        bool duplicate = false;
+                        for (int j = 0; j < n_cand; ++j) duplicate |= cand[j].second == e;
+                        if (!duplicate) cand[n_cand++] = { s->v2_repeat_ppm[layer][e], e };
+                    }
+                    std::sort(cand.begin(), cand.begin() + n_cand,
+                        [](const auto & a, const auto & b) { return a.first > b.first; });
+                    int below_threshold = 0;
+                    for (int i = 0; i < n_cand && n_selected < s->v2_transit_slots; ++i) {
+                        if (cand[i].first < s->v2_predictor_min_ppm) {
+                            below_threshold = n_cand - i;
+                            break;
+                        }
+                        selected[n_selected++] = cand[i].second;
+                    }
+                    if (below_threshold > 0) {
+                        s->v2_predictor_skipped.fetch_add(uint64_t(below_threshold), std::memory_order_relaxed);
+                    }
+                } else {
+                    for (int i = 0; i < routes && n_selected < s->v2_transit_slots; ++i) {
+                        const int e = r.expert_ids[i];
+                        if (e < 0 || e >= s->n_experts) continue;
+                        if (r.resident_flags[i]) continue;
+                        bool duplicate = false;
+                        for (int j = 0; j < n_selected; ++j) duplicate |= selected[j] == e;
+                        if (!duplicate) selected[n_selected++] = e;
+                    }
+                }
+                if (s->v2_persistent_transit) {
+                    // The token callback is queued after the final-layer router,
+                    // before that layer's MMVQ. Earlier layers are already done
+                    // and their Transit banks can be safely reused. Keep the
+                    // last MoE layer on the original host/resident path to avoid
+                    // overwriting a bank that its current MMVQ may still read.
+                    if (layer == s->n_layers - 1) continue;
+                    auto & meta = s->h_v2_transit_meta[size_t(layer)];
+
+                    // Refresh LRU timestamps from the route that just finished.
+                    for (int pb = 0; pb < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++pb) {
+                        for (int ps = 0; ps < s->v2_transit_slots; ++ps) {
+                            const int ce = meta.expert_ids[pb][ps];
+                            if (ce < 0) continue;
+                            for (int ri = 0; ri < routes; ++ri) {
+                                if (r.expert_ids[ri] == ce) {
+                                    s->v2_persistent_last_used[size_t(layer)][pb][ps] = token;
+                                    break;
+                                }
+                            }
+                        }
+                    }
+
+                    for (int si = 0; si < n_selected; ++si) {
+                        const int e = selected[si];
+                        int hit_bank = -1, hit_slot = -1;
+                        for (int pb = 0; pb < GGML_HOTEXPERT_V2_TRANSIT_BANKS && hit_bank < 0; ++pb) {
+                            for (int ps = 0; ps < s->v2_transit_slots; ++ps) {
+                                if (meta.expert_ids[pb][ps] == e) {
+                                    hit_bank = pb; hit_slot = ps; break;
+                                }
+                            }
+                        }
+                        if (hit_bank >= 0) {
+                            s->v2_persistent_last_used[size_t(layer)][hit_bank][hit_slot] = token;
+                            s->v2_persistent_reused.fetch_add(1, std::memory_order_relaxed);
+                            continue;
+                        }
+
+                        int victim_bank = -1, victim_slot = -1;
+                        uint64_t oldest = UINT64_MAX;
+                        for (int pb = 0; pb < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++pb) {
+                            for (int ps = 0; ps < s->v2_transit_slots; ++ps) {
+                                if (meta.expert_ids[pb][ps] < 0) {
+                                    victim_bank = pb; victim_slot = ps; oldest = 0; break;
+                                }
+                                const uint64_t lu = s->v2_persistent_last_used[size_t(layer)][pb][ps];
+                                if (victim_bank < 0 || lu < oldest) {
+                                    oldest = lu; victim_bank = pb; victim_slot = ps;
+                                }
+                            }
+                            if (oldest == 0) break;
+                        }
+                        if (victim_bank < 0) continue;
+                        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                            const tensor_slot & t = L.tensors[kind];
+                            const void * dst = meta.ptrs[victim_bank][kind][victim_slot];
+                            if (!t.host_ptr || t.stride <= 0 || !dst) continue;
+                            CUDA_CHECK(cudaMemcpyAsync(
+                                const_cast<void *>(dst),
+                                static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                                size_t(t.stride), cudaMemcpyHostToDevice, s->v2_prefetch_stream));
+                            token_bytes += uint64_t(t.stride);
+                        }
+                        meta.expert_ids[victim_bank][victim_slot] = e;
+                        s->v2_persistent_last_used[size_t(layer)][victim_bank][victim_slot] = token;
+                        token_experts++;
+                    }
+
+                    // Carry both physical cache banks forward to the target
+                    // token. For a replaced bank this publish is ordered after
+                    // its H2D copy on the same side stream.
+                    for (int pb = 0; pb < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++pb) {
+                        const ggml_cuda_kernel_launch_params publish_params(
+                            dim3(1, 1, 1), dim3(1, 1, 1), 0, s->v2_prefetch_stream);
+                        ggml_cuda_kernel_launch(v2_publish_transit_kernel, publish_params,
+                            s->d_v2_transit_meta + layer, pb, target,
+                            meta.expert_ids[pb][0], meta.expert_ids[pb][1],
+                            meta.expert_ids[pb][2], meta.expert_ids[pb][3]);
+                    }
+                    continue;
+                }
+
+                if (n_selected == 0) continue;
+
+                const auto & meta = s->h_v2_transit_meta[size_t(layer)];
+                for (int slot = 0; slot < n_selected; ++slot) {
+                    const int e = selected[slot];
+                    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                        const tensor_slot & t = L.tensors[kind];
+                        const void * dst = meta.ptrs[bank][kind][slot];
+                        if (!t.host_ptr || t.stride <= 0 || !dst) continue;
+                        CUDA_CHECK(cudaMemcpyAsync(
+                            const_cast<void *>(dst),
+                            static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                            size_t(t.stride), cudaMemcpyHostToDevice, s->v2_prefetch_stream));
+                        token_bytes += uint64_t(t.stride);
+                    }
+                    token_experts++;
+                }
+
+                const ggml_cuda_kernel_launch_params publish_params(
+                    dim3(1, 1, 1), dim3(1, 1, 1), 0, s->v2_prefetch_stream);
+                ggml_cuda_kernel_launch(v2_publish_transit_kernel, publish_params,
+                    s->d_v2_transit_meta + layer, bank, target,
+                    selected[0], selected[1], selected[2], selected[3]);
+            }
+
+            if (token_experts > 0) {
+                s->v2_prefetch_tokens.fetch_add(1, std::memory_order_relaxed);
+                s->v2_prefetch_experts.fetch_add(token_experts, std::memory_order_relaxed);
+                s->v2_prefetch_bytes.fetch_add(token_bytes, std::memory_order_relaxed);
+            }
+        }
+    }
+}
+
+static void worker_loop(rt_state * s) {
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lock(s->worker_mutex);
+            s->worker_cv.wait(lock, [&] {
+                return s->stopping || s->eval_requested.load(std::memory_order_acquire);
+            });
+            if (s->stopping) {
+                return;
+            }
+        }
+        run_evaluation(*s);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// shutdown
+// ---------------------------------------------------------------------------
+
+static double v2_cycles_to_us(const rt_state & s, uint64_t cycles) {
+    return s.v2_clock_rate_khz > 0
+        ? double(cycles) * 1000.0 / double(s.v2_clock_rate_khz)
+        : 0.0;
+}
+
+static uint64_t v2_expert_bytes(const rt_state & s, int layer) {
+    uint64_t bytes = 0;
+    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+        const tensor_slot & t = s.layers[layer].tensors[kind];
+        if (t.host_ptr && t.stride > 0) {
+            bytes += uint64_t(t.stride);
+        }
+    }
+    return bytes;
+}
+
+static void dump_v2_profile(rt_state & s) {
+    if (!s.v2_profile_enabled || !s.d_v2_records || !s.d_v2_token_count ||
+        s.v2_profile_capacity == 0 || s.n_layers <= 0) {
+        return;
+    }
+
+    uint64_t total_tokens = 0;
+    CUDA_CHECK(cudaMemcpy(&total_tokens, s.d_v2_token_count, sizeof(total_tokens), cudaMemcpyDeviceToHost));
+    const uint64_t kept_tokens = std::min(total_tokens, s.v2_profile_capacity);
+    const uint64_t first_token = total_tokens - kept_tokens;
+    const size_t record_count = size_t(s.v2_profile_capacity) * size_t(s.n_layers);
+    std::vector<ggml_hotexpert_v2_layer_record> records(record_count);
+    CUDA_CHECK(cudaMemcpy(records.data(), s.d_v2_records,
+        record_count * sizeof(ggml_hotexpert_v2_layer_record), cudaMemcpyDeviceToHost));
+
+    size_t free_now = 0;
+    size_t total_vram = 0;
+    if (hipMemGetInfo(&free_now, &total_vram) != hipSuccess) {
+        free_now = 0;
+        total_vram = 0;
+    }
+    const uint64_t low_water = s.arena_min_free_seen
+        ? s.arena_min_free_seen
+        : uint64_t(free_now);
+
+    std::error_code ec;
+    std::filesystem::create_directories(s.v2_profile_dir, ec);
+    if (ec) {
+        GGML_LOG_ERROR("HotSeat V2 profiler: cannot create %s: %s\n",
+            s.v2_profile_dir.c_str(), ec.message().c_str());
+        return;
+    }
+    const std::string token_path = s.v2_profile_dir + "/v2-token-profile.jsonl";
+    const std::string layer_path = s.v2_profile_dir + "/v2-layer-profile.jsonl";
+    FILE * token_file = std::fopen(token_path.c_str(), "w");
+    FILE * layer_file = std::fopen(layer_path.c_str(), "w");
+    if (!token_file || !layer_file) {
+        GGML_LOG_ERROR("HotSeat V2 profiler: cannot open JSONL output in %s\n",
+            s.v2_profile_dir.c_str());
+        if (token_file) std::fclose(token_file);
+        if (layer_file) std::fclose(layer_file);
+        return;
+    }
+
+#if defined(GGML_USE_HIP)
+    const char * timing_method = "wall_clock64_representative_block_estimate";
+#else
+    const char * timing_method = "clock64_representative_block_estimate";
+#endif
+    std::fprintf(token_file,
+        "{\"record_type\":\"run_meta\",\"profile_version\":1,"
+        "\"timing_method\":\"%s\","
+        "\"total_decode_tokens\":%llu,\"kept_decode_tokens\":%llu,"
+        "\"dropped_decode_tokens\":%llu,\"capacity\":%llu,"
+        "\"layers\":%d,\"experts\":%d,\"top_k\":%d,"
+        "\"prompt_tokens\":%llu,\"prompt_tps\":null,"
+        "\"timing_clock_rate_khz\":%llu,\"gpu_vram_total_bytes\":%zu,"
+        "\"gpu_vram_used_bytes_at_shutdown\":%zu,"
+        "\"physical_vram_free_low_water_bytes\":%llu}\n",
+        timing_method,
+        (unsigned long long) total_tokens,
+        (unsigned long long) kept_tokens,
+        (unsigned long long) (total_tokens - kept_tokens),
+        (unsigned long long) s.v2_profile_capacity,
+        s.n_layers, s.n_experts, GGML_HOTEXPERT_V2_PROFILE_TOP_K,
+        (unsigned long long) s.prefill_tokens.load(std::memory_order_acquire),
+        (unsigned long long) s.v2_clock_rate_khz,
+        total_vram, total_vram > free_now ? total_vram - free_now : 0,
+        (unsigned long long) low_water);
+
+    uint64_t run_host_bytes = 0;
+    uint64_t run_resident_bytes = 0;
+    uint64_t run_host_misses = 0;
+    uint64_t run_resident_hits = 0;
+    uint64_t first_time_us = 0;
+    uint64_t last_time_us = 0;
+
+    for (uint64_t token = first_token; token < total_tokens; ++token) {
+        const size_t ring = size_t(token % s.v2_profile_capacity);
+        const uint64_t timestamp_us = ring < s.v2_token_times_us.size()
+            ? s.v2_token_times_us[ring]
+            : 0;
+        if (timestamp_us && !first_time_us) first_time_us = timestamp_us;
+        if (timestamp_us) last_time_us = timestamp_us;
+        uint64_t token_host_bytes = 0;
+        uint64_t token_resident_bytes = 0;
+        uint64_t token_host_misses = 0;
+        uint64_t token_resident_hits = 0;
+        double token_mmvq_us = 0.0;
+        double token_host_us = 0.0;
+        double token_resident_us = 0.0;
+        uint64_t generation = 0;
+
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            const auto & rec = records[ring * size_t(s.n_layers) + size_t(layer)];
+            generation = std::max(generation, rec.generation);
+            const uint32_t routes = std::min<uint32_t>(
+                rec.route_count, GGML_HOTEXPERT_V2_PROFILE_TOP_K);
+            const uint32_t valid_mask = routes >= 32 ? 0xffffffffu : ((1u << routes) - 1u);
+            const uint32_t resident_hits = uint32_t(__builtin_popcount(rec.resident_mask & valid_mask));
+            const uint32_t host_misses = routes - resident_hits;
+            const uint64_t expert_bytes = v2_expert_bytes(s, layer);
+            const uint64_t resident_bytes = uint64_t(resident_hits) * expert_bytes;
+            const uint64_t host_bytes = uint64_t(host_misses) * expert_bytes;
+            uint64_t mmvq_cycles = 0;
+            uint64_t host_cycles = 0;
+            uint64_t resident_cycles = 0;
+            for (int kind = 0; kind < GGML_HOTEXPERT_V2_PROFILE_KINDS; ++kind) {
+                mmvq_cycles += rec.mmvq_cycles[kind];
+                host_cycles += rec.host_cycles[kind];
+                resident_cycles += rec.resident_cycles[kind];
+            }
+            const double mmvq_us = v2_cycles_to_us(s, mmvq_cycles);
+            const double host_us = v2_cycles_to_us(s, host_cycles);
+            const double resident_us = v2_cycles_to_us(s, resident_cycles);
+
+            std::fprintf(layer_file,
+                "{\"record_type\":\"layer\",\"generation\":%llu,"
+                "\"token\":%llu,\"layer\":%d,\"expert_ids\":[",
+                (unsigned long long) rec.generation,
+                (unsigned long long) token, layer);
+            for (uint32_t i = 0; i < routes; ++i) {
+                std::fprintf(layer_file, "%s%d", i ? "," : "", rec.expert_ids[i]);
+            }
+            std::fprintf(layer_file,
+                "],\"resident_hits\":%u,\"host_misses\":%u,"
+                "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+                "\"mmvq_kernel_elapsed_us\":%.3f,"
+                "\"hostexpert_path_elapsed_us\":%.3f,"
+                "\"resident_path_elapsed_us\":%.3f,"
+                "\"timing_estimate\":true}\n",
+                resident_hits, host_misses,
+                (unsigned long long) resident_bytes,
+                (unsigned long long) host_bytes,
+                mmvq_us, host_us, resident_us);
+
+            token_host_bytes += host_bytes;
+            token_resident_bytes += resident_bytes;
+            token_host_misses += host_misses;
+            token_resident_hits += resident_hits;
+            token_mmvq_us += mmvq_us;
+            token_host_us += host_us;
+            token_resident_us += resident_us;
+        }
+
+        double decode_tps = 0.0;
+        if (token > first_token && timestamp_us && !s.v2_token_times_us.empty()) {
+            const uint64_t prev_time = s.v2_token_times_us[
+                size_t((token - 1) % s.v2_profile_capacity)];
+            if (prev_time && timestamp_us > prev_time) {
+                decode_tps = 1e6 / double(timestamp_us - prev_time);
+            }
+        }
+        const double pcie_gbps = decode_tps > 0.0
+            ? double(token_host_bytes) * decode_tps / 1e9
+            : 0.0;
+        std::fprintf(token_file,
+            "{\"record_type\":\"token\",\"generation\":%llu,"
+            "\"token\":%llu,\"timestamp_us\":%llu,"
+            "\"resident_hits\":%llu,\"host_misses\":%llu,"
+            "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+            "\"estimated_pcie_bytes\":%llu,\"estimated_pcie_gbps\":%.6f,"
+            "\"mmvq_kernel_elapsed_us\":%.3f,"
+            "\"hostexpert_path_elapsed_us\":%.3f,"
+            "\"resident_path_elapsed_us\":%.3f,\"decode_tps\":%.6f}\n",
+            (unsigned long long) generation,
+            (unsigned long long) token,
+            (unsigned long long) timestamp_us,
+            (unsigned long long) token_resident_hits,
+            (unsigned long long) token_host_misses,
+            (unsigned long long) token_resident_bytes,
+            (unsigned long long) token_host_bytes,
+            (unsigned long long) token_host_bytes,
+            pcie_gbps, token_mmvq_us, token_host_us, token_resident_us, decode_tps);
+
+        run_host_bytes += token_host_bytes;
+        run_resident_bytes += token_resident_bytes;
+        run_host_misses += token_host_misses;
+        run_resident_hits += token_resident_hits;
+    }
+
+    const double elapsed_s = last_time_us > first_time_us
+        ? double(last_time_us - first_time_us) / 1e6
+        : 0.0;
+    const double decode_tps = elapsed_s > 0.0 && kept_tokens > 1
+        ? double(kept_tokens - 1) / elapsed_s
+        : 0.0;
+    const double pcie_gbps = elapsed_s > 0.0
+        ? double(run_host_bytes) / elapsed_s / 1e9
+        : 0.0;
+    std::fprintf(token_file,
+        "{\"record_type\":\"run_summary\",\"decode_tokens\":%llu,"
+        "\"decode_tps\":%.6f,\"prompt_tokens\":%llu,\"prompt_tps\":null,"
+        "\"resident_hits\":%llu,\"host_misses\":%llu,"
+        "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+        "\"estimated_pcie_bytes_per_token\":%.3f,"
+        "\"estimated_pcie_gbps\":%.6f,"
+        "\"gpu_vram_total_bytes\":%zu,"
+        "\"gpu_vram_used_low_water_bytes\":%llu,"
+        "\"physical_vram_free_low_water_bytes\":%llu}\n",
+        (unsigned long long) kept_tokens, decode_tps,
+        (unsigned long long) s.prefill_tokens.load(std::memory_order_acquire),
+        (unsigned long long) run_resident_hits,
+        (unsigned long long) run_host_misses,
+        (unsigned long long) run_resident_bytes,
+        (unsigned long long) run_host_bytes,
+        kept_tokens ? double(run_host_bytes) / double(kept_tokens) : 0.0,
+        pcie_gbps, total_vram,
+        (unsigned long long) (total_vram > low_water ? total_vram - low_water : 0),
+        (unsigned long long) low_water);
+
+    std::fclose(layer_file);
+    std::fclose(token_file);
+    GGML_LOG_INFO("HotSeat V2 profiler: wrote %llu tokens to %s and %s\n",
+        (unsigned long long) kept_tokens, token_path.c_str(), layer_path.c_str());
+}
+
+static void shutdown_runtime(rt_state & s) {
+    if (!s.initialized) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(s.worker_mutex);
+        s.stopping = true;
+    }
+    s.worker_cv.notify_one();
+    if (s.worker.joinable()) {
+        s.worker.join();
+    }
+    if (s.v2_prefetch_worker.joinable()) {
+        {
+            std::lock_guard<std::mutex> lock(s.v2_prefetch_mutex);
+            s.v2_prefetch_stopping = true;
+        }
+        s.v2_prefetch_cv.notify_one();
+        s.v2_prefetch_worker.join();
+    }
+    save_runtime_snapshot(s);
+    CUDA_CHECK(cudaSetDevice(s.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    if (s.v2_prefetch_enabled) {
+        const uint64_t routed = s.v2_routed_experts.load(std::memory_order_relaxed);
+        const uint64_t resident = s.v2_resident_hits.load(std::memory_order_relaxed);
+        const uint64_t transit = s.v2_transit_hits.load(std::memory_order_relaxed);
+        std::fprintf(stderr,
+            "HotSeat V2 summary: complete_tokens=%llu missing_layers=%llu prefetch_tokens=%llu experts=%llu bytes=%llu routed=%llu resident_hits=%llu transit_hits=%llu transit_hit_pct=%.2f predictor_skipped=%llu persistent_reused=%llu\n",
+            (unsigned long long) s.v2_route_complete_tokens.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_route_missing_layers.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_tokens.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_experts.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_bytes.load(std::memory_order_relaxed),
+            (unsigned long long) routed,
+            (unsigned long long) resident,
+            (unsigned long long) transit,
+            routed ? 100.0 * double(transit) / double(routed) : 0.0,
+            (unsigned long long) s.v2_predictor_skipped.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_persistent_reused.load(std::memory_order_relaxed));
+    }
+    dump_v2_profile(s);
+    for (auto & bank : s.full_banks)  if (bank.base)  CUDA_CHECK(cudaFree(bank.base));
+    for (auto & bank : s.top64_banks) if (bank.base)  CUDA_CHECK(cudaFree(bank.base));
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            tensor_slot & t = s.layers[layer].tensors[kind];
+            for (int buf = 0; buf < 2; ++buf) {
+                if (t.tables[buf]) CUDA_CHECK(cudaFree(const_cast<void *>(t.tables[buf])));
+            }
+        }
+    }
+    if (s.d_hits)         CUDA_CHECK(cudaFree(s.d_hits));
+    if (s.d_prefill)      CUDA_CHECK(cudaFree(s.d_prefill));
+    if (s.d_miss)         CUDA_CHECK(cudaFree(s.d_miss));
+    if (s.d_prefill_rows) CUDA_CHECK(cudaFree(s.d_prefill_rows));
+    if (s.d_resident)     CUDA_CHECK(cudaFree(s.d_resident));
+    if (s.d_v2_records)       CUDA_CHECK(cudaFree(s.d_v2_records));
+    if (s.d_v2_token_count)   CUDA_CHECK(cudaFree(s.d_v2_token_count));
+    if (s.d_v2_current_token) CUDA_CHECK(cudaFree(s.d_v2_current_token));
+    if (s.v2_prefetch_stream) {
+        CUDA_CHECK(cudaStreamSynchronize(s.v2_prefetch_stream));
+        CUDA_CHECK(cudaStreamDestroy(s.v2_prefetch_stream));
+        s.v2_prefetch_stream = nullptr;
+    }
+    if (s.d_v2_transit_meta) {
+        CUDA_CHECK(cudaFree(s.d_v2_transit_meta));
+        s.d_v2_transit_meta = nullptr;
+    }
+    if (s.d_v2_transit_base) {
+        CUDA_CHECK(cudaFree(s.d_v2_transit_base));
+        s.d_v2_transit_base = nullptr;
+    }
+    if (s.h_v2_routes) {
+#if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipHostFree(s.h_v2_routes));
+#else
+        CUDA_CHECK(cudaFreeHost(s.h_v2_routes));
+#endif
+        s.h_v2_routes = nullptr;
+        s.d_v2_routes = nullptr;
+    }
+    if (s.h_v2_route_latest) {
+#if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipHostFree(s.h_v2_route_latest));
+#else
+        CUDA_CHECK(cudaFreeHost(s.h_v2_route_latest));
+#endif
+        s.h_v2_route_latest = nullptr;
+        s.d_v2_route_latest = nullptr;
+    }
+    s.arena.destroy();
+    if (s.side_stream)    CUDA_CHECK(cudaStreamDestroy(s.side_stream));
+    if (s.copy_start)     CUDA_CHECK(cudaEventDestroy(s.copy_start));
+    if (s.copy_end)       CUDA_CHECK(cudaEventDestroy(s.copy_end));
+    if (s.ready_event)    CUDA_CHECK(cudaEventDestroy(s.ready_event));
+    if (s.log_file && s.log_file != stderr) std::fclose(s.log_file);
+    s.initialized = false;
+}
