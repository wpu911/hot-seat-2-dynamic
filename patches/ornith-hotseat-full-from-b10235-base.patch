+static void allocate_banks(rt_state & s, int n_full_layers, int n_top64_layers) {
+    const int n_full  = s.hybrid ? n_full_layers : 0;
+    const int n_top64 = n_top64_layers;
+
+    s.full_banks.resize(n_full + (s.full_shadow ? 1 : 0));
+    for (auto & bank : s.full_banks) bank.full_size = true;
+    s.top64_banks.resize(n_top64 + 1);
+    for (auto & bank : s.top64_banks) bank.full_size = false;
+    s.full_shadow_idx = (s.full_shadow && !s.full_banks.empty()) ? int(s.full_banks.size()) - 1 : -1;
+    s.spare_bank      = int(s.top64_banks.size()) - 1;
+
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered) continue;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            const tensor_slot & t = L.tensors[kind];
+            if (!t.host_ptr) continue;
+            const size_t full_bytes = t.bytes;
+            const size_t top_bytes  = size_t(std::max(s.layers[layer].slots, 1)) * size_t(t.stride);
+            for (auto & bank : s.full_banks)  bank.sizes[kind] = std::max(bank.sizes[kind], full_bytes);
+            for (auto & bank : s.top64_banks) bank.sizes[kind] = std::max(bank.sizes[kind], top_bytes);
+        }
+    }
+
+    for (auto & bank : s.full_banks) {
+        size_t offset = 0;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            bank.offsets[kind] = offset;
+            offset += GGML_PAD(bank.sizes[kind], 4096);
+        }
+        bank.total = offset;
+        CUDA_CHECK(cudaMalloc(&bank.base, bank.total));
+        GGML_LOG_INFO("HotExpert runtime: full bank %zu MiB\n", bank.total >> 20);
+    }
+    for (auto & bank : s.top64_banks) {
+        size_t offset = 0;
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            bank.offsets[kind] = offset;
+            offset += GGML_PAD(bank.sizes[kind], 4096);
+        }
+        bank.total = offset;
+        CUDA_CHECK(cudaMalloc(&bank.base, bank.total));
+        GGML_LOG_INFO("HotExpert runtime: top64 bank %zu MiB\n", bank.total >> 20);
+    }
+    s.pool_slots = std::max(s.pool_slots, 1);
+    s.top64_banks[s.spare_bank].spare_slots.resize(s.pool_slots);
+    std::iota(s.top64_banks[s.spare_bank].spare_slots.begin(),
+              s.top64_banks[s.spare_bank].spare_slots.end(), 0);
+
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            tensor_slot & t = s.layers[layer].tensors[kind];
+            if (!t.host_ptr || t.n_experts <= 0) continue;
+            for (int buf = 0; buf < 2; ++buf) {
+                void * table_tmp = nullptr;
+                CUDA_CHECK(cudaMalloc(&table_tmp, size_t(t.n_experts) * sizeof(const void *)));
+                t.tables[buf] = table_tmp;
+            }
+        }
+    }
+
+    CUDA_CHECK(cudaMalloc(&s.d_hits,         size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc(&s.d_prefill,      size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc(&s.d_miss,         size_t(MAX_LAYERS) * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc(&s.d_prefill_rows, size_t(MAX_LAYERS) * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc(&s.d_resident,     size_t(MAX_LAYERS) * (MAX_EXPERTS / 32) * sizeof(uint32_t)));
+    CUDA_CHECK(cudaMemset(s.d_hits, 0,         size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(s.d_prefill, 0,      size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(s.d_miss, 0,         size_t(MAX_LAYERS) * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(s.d_prefill_rows, 0, size_t(MAX_LAYERS) * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(s.d_resident, 0,     size_t(MAX_LAYERS) * (MAX_EXPERTS / 32) * sizeof(uint32_t)));
+
+    if (s.v2_profile_enabled || s.v2_prefetch_enabled) {
+        CUDA_CHECK(cudaMalloc((void **) &s.d_v2_token_count, sizeof(uint64_t)));
+        CUDA_CHECK(cudaMalloc((void **) &s.d_v2_current_token, sizeof(uint64_t)));
+        CUDA_CHECK(cudaMemset(s.d_v2_token_count, 0, sizeof(uint64_t)));
+        CUDA_CHECK(cudaMemset(s.d_v2_current_token, 0, sizeof(uint64_t)));
+    }
+    if (s.v2_profile_enabled) {
+        const size_t record_count = size_t(s.v2_profile_capacity) * size_t(s.n_layers);
+        CUDA_CHECK(cudaMalloc((void **) &s.d_v2_records,
+            record_count * sizeof(ggml_hotexpert_v2_layer_record)));
+        CUDA_CHECK(cudaMemset(s.d_v2_records, 0,
+            record_count * sizeof(ggml_hotexpert_v2_layer_record)));
+        s.v2_token_times_us.assign(size_t(s.v2_profile_capacity), 0);
+        cudaDeviceProp prop{};
+        CUDA_CHECK(cudaGetDeviceProperties(&prop, s.device));
+#if defined(GGML_USE_HIP)
+        int wall_clock_rate_khz = 0;
+        CUDA_CHECK(cudaDeviceGetAttribute(
+            &wall_clock_rate_khz, hipDeviceAttributeWallClockRate, s.device));
+        s.v2_clock_rate_khz = uint64_t(std::max(wall_clock_rate_khz, 1));
+#else
+        s.v2_clock_rate_khz = uint64_t(std::max(prop.clockRate, 1));
+#endif
+        std::fprintf(stderr, "HotSeat V2 profiler: device ring=%llu tokens, %.2f MiB, clock=%llu kHz\n",
+            (unsigned long long) s.v2_profile_capacity,
+            double(record_count * sizeof(ggml_hotexpert_v2_layer_record)) / double(1u << 20),
+            (unsigned long long) s.v2_clock_rate_khz);
+    }
+
+    if (s.v2_prefetch_enabled) {
+        const size_t route_count = size_t(s.v2_route_capacity) * size_t(s.n_layers);
+        const size_t route_bytes = route_count * sizeof(v2_route_record);
+#if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipHostMalloc((void **) &s.h_v2_routes, route_bytes, hipHostMallocMapped | hipHostMallocPortable));
+        CUDA_CHECK(hipHostGetDevicePointer((void **) &s.d_v2_routes, s.h_v2_routes, 0));
+        CUDA_CHECK(hipHostMalloc((void **) &s.h_v2_route_latest, sizeof(uint64_t), hipHostMallocMapped | hipHostMallocPortable));
+        CUDA_CHECK(hipHostGetDevicePointer((void **) &s.d_v2_route_latest, s.h_v2_route_latest, 0));
+#else
+        CUDA_CHECK(cudaHostAlloc((void **) &s.h_v2_routes, route_bytes, cudaHostAllocMapped | cudaHostAllocPortable));
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &s.d_v2_routes, s.h_v2_routes, 0));
+        CUDA_CHECK(cudaHostAlloc((void **) &s.h_v2_route_latest, sizeof(uint64_t), cudaHostAllocMapped | cudaHostAllocPortable));
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &s.d_v2_route_latest, s.h_v2_route_latest, 0));
+#endif
+        *s.h_v2_route_latest = UINT64_MAX;
+        std::memset(s.h_v2_routes, 0, route_bytes);
+        for (size_t i = 0; i < route_count; ++i) s.h_v2_routes[i].token = UINT64_MAX;
+        std::fprintf(stderr, "HotSeat V2 Stage1: mapped routing ring=%llu tokens, %.2f KiB host=%p device=%p\n",
+            (unsigned long long) s.v2_route_capacity, double(route_bytes) / 1024.0,
+            (void *) s.h_v2_routes, (void *) s.d_v2_routes);
+    }
+
+    CUDA_CHECK(cudaStreamCreateWithFlags(&s.side_stream, cudaStreamNonBlocking));
+    CUDA_CHECK(hipEventCreate(&s.copy_start));
+    CUDA_CHECK(hipEventCreate(&s.copy_end));
+    CUDA_CHECK(cudaEventCreateWithFlags(&s.ready_event, cudaEventDisableTiming));
+}
+
+static void allocate_v2_transit(rt_state & s) {
+    if (!s.v2_prefetch_enabled || !s.v2_transit_enabled || s.n_layers <= 0) {
+        return;
+    }
+
+    size_t total = 0;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered || L.full || L.arena_full) continue;
+        for (int bank = 0; bank < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++bank) {
+            for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                const tensor_slot & t = L.tensors[kind];
+                if (!t.host_ptr || t.stride <= 0) continue;
+                total = GGML_PAD(total, 4096);
+                total += size_t(s.v2_transit_slots) * size_t(t.stride);
+            }
+        }
+    }
+    if (total == 0) {
+        GGML_LOG_WARN("HotSeat V2 Stage2: no transit storage required; disabling prefetch\n");
+        s.v2_prefetch_enabled = false;
+        return;
+    }
+
+    CUDA_CHECK(cudaMalloc(&s.d_v2_transit_base, total));
+    s.v2_transit_bytes = total;
+    s.h_v2_transit_meta.assign(size_t(s.n_layers), ggml_hotexpert_v2_transit_meta{});
+    for (auto & meta : s.h_v2_transit_meta) {
+        for (int bank = 0; bank < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++bank) {
+            meta.ready_token[bank] = UINT64_MAX;
+            for (int slot = 0; slot < GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS; ++slot) {
+                meta.expert_ids[bank][slot] = -1;
+            }
+        }
+    }
+    for (auto & layer_use : s.v2_persistent_last_used) {
+        for (auto & bank_use : layer_use) {
+            bank_use.fill(0);
+        }
+    }
+
+    size_t offset = 0;
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        if (!L.registered || L.full || L.arena_full) continue;
+        auto & meta = s.h_v2_transit_meta[size_t(layer)];
+        for (int bank = 0; bank < GGML_HOTEXPERT_V2_TRANSIT_BANKS; ++bank) {
+            for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                const tensor_slot & t = L.tensors[kind];
+                if (!t.host_ptr || t.stride <= 0) continue;
+                offset = GGML_PAD(offset, 4096);
+                char * base = static_cast<char *>(s.d_v2_transit_base) + offset;
+                for (int slot = 0; slot < s.v2_transit_slots; ++slot) {
+                    meta.ptrs[bank][kind][slot] = base + size_t(slot) * size_t(t.stride);
+                }
+                offset += size_t(s.v2_transit_slots) * size_t(t.stride);
+            }
+        }
+    }
+
+    CUDA_CHECK(cudaMalloc((void **) &s.d_v2_transit_meta,
+        size_t(s.n_layers) * sizeof(ggml_hotexpert_v2_transit_meta)));
+    CUDA_CHECK(cudaMemcpy(s.d_v2_transit_meta, s.h_v2_transit_meta.data(),
+        size_t(s.n_layers) * sizeof(ggml_hotexpert_v2_transit_meta), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaStreamCreateWithFlags(&s.v2_prefetch_stream, cudaStreamNonBlocking));
+
+    size_t free_now = 0, total_vram = 0;
+    hipMemGetInfo(&free_now, &total_vram);
+    std::fprintf(stderr, "HotSeat V2 Stage2: transit=%zu MiB slots/layer/bank=%d banks=%d free_after=%zu MiB\n",
+        total >> 20, s.v2_transit_slots, GGML_HOTEXPERT_V2_TRANSIT_BANKS, free_now >> 20);
+}
+
+// pointer for a resident expert of a non-full layer
+static const void * resident_ptr(rt_state & s, const layer_t & L, int kind, int expert, size_t stride) {
+    if (L.in_shadow[expert]) {
+        const bank_t & pool = s.top64_banks[s.spare_bank];
+        return static_cast<const char *>(pool.base) + pool.offsets[kind] +
+               size_t(L.shadow_slot[expert]) * stride;
+    }
+    const bank_t & own = s.top64_banks[L.top64_bank];
+    return static_cast<const char *>(own.base) + own.offsets[kind] +
+           size_t(L.slot_of[expert]) * stride;
+}
+
+// build the device table content for (layer, kind) from the current bookkeeping
+static void build_table_content(rt_state & s, int layer, int kind, std::vector<const void *> & content) {
+    const layer_t & L = s.layers[layer];
+    const tensor_slot & t = L.tensors[kind];
+    content.resize(size_t(t.n_experts));
+    if (L.arena_full && s.arena.valid()) {
+        const char * base = static_cast<const char *>(s.arena.base()) + L.arena_full_offsets[kind];
+        for (int e = 0; e < t.n_experts; ++e) {
+            content[e] = base + size_t(e) * size_t(t.stride);
+        }
+        return;
+    }
+    if (L.full && s.hybrid) {
+        const bank_t & bank = s.full_banks[L.full_bank];
+        const char * base = static_cast<const char *>(bank.base) + bank.offsets[kind];
+        for (int e = 0; e < t.n_experts; ++e) {
+            content[e] = base + size_t(e) * size_t(t.stride);
+        }
+        return;
+    }
+    for (int e = 0; e < t.n_experts; ++e) {
+        const void * ptr = static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride);
+        if (L.slot_of[e] >= 0 || L.in_shadow[e]) {
+            ptr = resident_ptr(s, L, kind, e, size_t(t.stride));
+        } else {
+            // arena extension experts: offset encodes gate-region byte offset;
+            // per-kind region = offset + kind_stride_layout (gate/up/down are
+            // stored contiguously per expert: gate, then up, then down)
+            for (const auto & ae : L.arena_experts) {
+                if (ae.first == e) {
+                    ptr = static_cast<const char *>(s.arena.base()) + ae.second +
+                          size_t(kind) * size_t(t.stride);
+                    break;
+                }
+            }
+        }
+        content[e] = ptr;
+    }
+}
+
+static void build_resident_bits(rt_state & s, std::vector<uint32_t> & bits) {
+    bits.assign(size_t(MAX_LAYERS) * (MAX_EXPERTS / 32), 0);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        const layer_t & L = s.layers[layer];
+        auto set_bit = [&](int e) {
+            bits[size_t(layer) * (MAX_EXPERTS / 32) + (e >> 5)] |= (1u << (e & 31));
+        };
+        if (L.full || L.arena_full) {
+            for (int e = 0; e < s.n_experts; ++e) set_bit(e);
+        } else {
+            for (int e : L.experts) set_bit(e);
+            for (const auto & ae : L.arena_experts) set_bit(ae.first);
+        }
+    }
+}
+
+// rebuild every table in the free buffer and upload on the side stream
+static void upload_all_tables(rt_state & s) {
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            tensor_slot & t = s.layers[layer].tensors[kind];
+            if (!t.host_ptr) continue;
+            const int free_buf = 1 - t.committed_buf;
+            std::vector<const void *> content;
+            build_table_content(s, layer, kind, content);
+            CUDA_CHECK(cudaMemcpyAsync(const_cast<void *>(t.tables[free_buf]), content.data(),
+                content.size() * sizeof(const void *), cudaMemcpyHostToDevice, s.side_stream));
+        }
+    }
+}
+
+static std::vector<uint64_t> snapshot_u64_array(
+        const std::string & json, size_t begin, size_t end, const char * key) {
+    std::vector<uint64_t> out;
+    size_t p = json.find(key, begin);
+    if (p == std::string::npos || p >= end) return out;
+    p = json.find('[', p);
+    if (p == std::string::npos || p >= end) return out;
+    ++p;
+    while (p < end && p < json.size() && json[p] != ']') {
+        uint64_t v = 0;
+        if (!parse_unsigned(json, p, v)) {
+            ++p;
+            continue;
+        }
+        out.push_back(v);
+        while (p < end && p < json.size() && json[p] != ',' && json[p] != ']') ++p;
+        if (p < json.size() && json[p] == ',') ++p;
+    }
+    return out;
+}
+
+static std::string snapshot_string_field(const std::string & json, const char * key) {
+    const size_t k = json.find(key);
+    if (k == std::string::npos) return {};
+    size_t p = json.find(':', k);
+    if (p == std::string::npos) return {};
+    p = json.find('"', p);
+    if (p == std::string::npos) return {};
+    const size_t q = json.find('"', p + 1);
+    if (q == std::string::npos) return {};
+    return json.substr(p + 1, q - p - 1);
+}
+
+static bool load_runtime_snapshot(rt_state & s) {
+    const char * env = std::getenv("HOTSEAT_RUNTIME_SNAPSHOT");
+    if (!env || !*env) return false;
+    s.snapshot_path = env;
+    std::ifstream in(s.snapshot_path, std::ios::binary);
+    if (!in.good()) {
+        GGML_LOG_INFO("HotExpert snapshot: no prior snapshot at %s\n", s.snapshot_path.c_str());
+        return false;
+    }
+    const std::string json((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::string expected = s.expected_fingerprint;
+    if (expected.empty()) {
+        hotseat_model_descriptor d;
+        if (ggml_cuda_hotexpert_descriptor_build(d)) expected = d.fingerprint;
+    }
+    const std::string got = snapshot_string_field(json, "\"model_fingerprint\"");
+    if (!expected.empty() && got != expected) {
+        GGML_LOG_WARN("HotExpert snapshot: fingerprint mismatch (snapshot=%s expected=%s), ignored\n",
+            got.c_str(), expected.c_str());
+        return false;
+    }
+    size_t gp = json.find("\"generation\"");
+    if (gp != std::string::npos) {
+        gp = json.find(':', gp);
+        if (gp != std::string::npos) {
+            ++gp; uint64_t g = 1;
+            if (parse_unsigned(json, gp, g)) s.snapshot_generation = std::max<uint64_t>(1, g);
+        }
+    }
+    const auto full = snapshot_u64_array(json, 0, json.size(), "\"full_layers\"");
+    for (uint64_t v : full) if (v < uint64_t(s.n_layers)) s.snapshot_full_layers.insert(int(v));
+
+    int loaded = 0;
+    size_t pos = json.find("\"layers\"");
+    if (pos == std::string::npos) return false;
+    while ((pos = json.find("\"layer\"", pos)) != std::string::npos) {
+        size_t c = json.find(':', pos);
+        if (c == std::string::npos) break;
+        ++c; uint64_t lv = 0;
+        if (!parse_unsigned(json, c, lv) || lv >= uint64_t(s.n_layers)) { pos = c; continue; }
+        const size_t next = json.find("\"layer\"", c);
+        const size_t end = next == std::string::npos ? json.size() : next;
+        const auto base = snapshot_u64_array(json, c, end, "\"base_experts\"");
+        if (!base.empty()) {
+            std::vector<int> ranked;
+            std::vector<bool> seen(size_t(s.n_experts), false);
+            for (uint64_t e : base) {
+                if (e < uint64_t(s.n_experts) && !seen[size_t(e)]) {
+                    ranked.push_back(int(e)); seen[size_t(e)] = true;
+                }
+            }
+            for (int e : s.ranked_experts[int(lv)]) {
+                if (e >= 0 && e < s.n_experts && !seen[size_t(e)]) {
+                    ranked.push_back(e); seen[size_t(e)] = true;
+                }
+            }
+            for (int e = 0; e < s.n_experts; ++e) if (!seen[size_t(e)]) ranked.push_back(e);
+            s.ranked_experts[int(lv)] = std::move(ranked);
+            loaded++;
+        }
+        const auto arena = snapshot_u64_array(json, c, end, "\"arena_experts\"");
+        auto & av = s.snapshot_arena_experts[int(lv)];
+        for (uint64_t e : arena) if (e < uint64_t(s.n_experts)) av.push_back(int(e));
+        s.snapshot_short_ppm[int(lv)] = snapshot_u64_array(json, c, end, "\"short_ppm\"");
+        s.snapshot_long_ppm[int(lv)]  = snapshot_u64_array(json, c, end, "\"long_ppm\"");
+        pos = end;
+        if (next == std::string::npos) break;
+    }
+    s.snapshot_loaded = loaded > 0;
+    if (s.snapshot_loaded) {
+        GGML_LOG_INFO("HotExpert snapshot: loaded %d layers generation=%llu from %s\n",
+            loaded, (unsigned long long) s.snapshot_generation, s.snapshot_path.c_str());
+    }
+    return s.snapshot_loaded;
+}
+
+static void save_runtime_snapshot(rt_state & s) {
+    if (!s.initialized) return;
+    const char * env = std::getenv("HOTSEAT_RUNTIME_SNAPSHOT");
+    if ((!env || !*env) && s.snapshot_path.empty()) return;
+    if (s.snapshot_path.empty()) s.snapshot_path = env;
+    hotseat_model_descriptor d;
+    const std::string fp = ggml_cuda_hotexpert_descriptor_build(d) ? d.fingerprint : s.expected_fingerprint;
+    if (fp.empty()) return;
+    const std::string tmp = s.snapshot_path + ".tmp";
+    FILE * f = std::fopen(tmp.c_str(), "w");
+    if (!f) return;
+    const uint64_t gen = s.current_map ? s.current_map->generation : 1;
+    std::fprintf(f, "{\n  \"version\": 1,\n  \"model_fingerprint\": \"%s\",\n", fp.c_str());
+    std::fprintf(f, "  \"generation\": %llu,\n  \"decode_tokens\": %llu,\n  \"prefill_tokens\": %llu,\n  \"requests\": %llu,\n",
+        (unsigned long long) gen,
+        (unsigned long long) s.decode_tokens.load(std::memory_order_acquire),
+        (unsigned long long) s.prefill_tokens.load(std::memory_order_acquire),
+        (unsigned long long) s.requests.load(std::memory_order_acquire));
+    std::fprintf(f, "  \"full_layers\": [");
+    bool ff = true;
+    for (int l = 0; l < s.n_layers; ++l) if (s.layers[l].full) {
+        std::fprintf(f, "%s%d", ff ? "" : ",", l); ff = false;
+    }
+    std::fprintf(f, "],\n  \"layers\": [\n");
+    bool first_layer = true;
+    for (int l = 0; l < s.n_layers; ++l) {
+        const layer_t & L = s.layers[l];
+        if (!L.registered) continue;
+        if (!first_layer) std::fprintf(f, ",\n");
+        first_layer = false;
+        std::vector<int> order;
+        std::vector<bool> seen(size_t(s.n_experts), false);
+        for (int e : L.experts) if (e >= 0 && e < s.n_experts && !seen[size_t(e)]) {
+            order.push_back(e); seen[size_t(e)] = true;
+        }
+        std::vector<int> rest;
+        for (int e = 0; e < s.n_experts; ++e) if (!seen[size_t(e)]) rest.push_back(e);
+        std::stable_sort(rest.begin(), rest.end(), [&](int a, int b) {
+            const double aa = a < int(L.short_ewma.size()) ? L.short_ewma[a] : 0.0;
+            const double bb = b < int(L.short_ewma.size()) ? L.short_ewma[b] : 0.0;
+            if (aa != bb) return aa > bb;
+            return a < b;
+        });
+        order.insert(order.end(), rest.begin(), rest.end());
+        std::fprintf(f, "    {\"layer\": %d, \"base_experts\": [", l);
+        for (size_t i = 0; i < order.size(); ++i) std::fprintf(f, "%s%d", i ? "," : "", order[i]);
+        std::fprintf(f, "], \"arena_experts\": [");
+        for (size_t i = 0; i < L.arena_experts.size(); ++i) std::fprintf(f, "%s%d", i ? "," : "", L.arena_experts[i].first);
+        std::fprintf(f, "], \"short_ppm\": [");
+        for (int e = 0; e < s.n_experts; ++e) {
+            const double v = e < int(L.short_ewma.size()) ? std::max(0.0, L.short_ewma[e]) : 0.0;
+            std::fprintf(f, "%s%llu", e ? "," : "", (unsigned long long) (v * 1000000.0 + 0.5));
+        }
+        std::fprintf(f, "], \"long_ppm\": [");
+        for (int e = 0; e < s.n_experts; ++e) {
+            const double v = e < int(L.long_ewma.size()) ? std::max(0.0, L.long_ewma[e]) : 0.0;
+            std::fprintf(f, "%s%llu", e ? "," : "", (unsigned long long) (v * 1000000.0 + 0.5));
+        }
+        std::fprintf(f, "]}");
+    }
+    std::fprintf(f, "\n  ]\n}\n");
+    std::fclose(f);
+    if (std::rename(tmp.c_str(), s.snapshot_path.c_str()) != 0) {
+        std::remove(tmp.c_str());
+        return;
+    }
+    GGML_LOG_INFO("HotExpert snapshot: saved generation=%llu to %s\n",
+        (unsigned long long) gen, s.snapshot_path.c_str());
+}
+
+static void restore_runtime_snapshot_arena(rt_state & s) {
+    if (!s.snapshot_loaded || s.snapshot_arena_restored || !s.arena.valid()) return;
+    size_t per_expert = 0;
+    for (int l = 0; l < s.n_layers; ++l) {
+        size_t lb = 0; int ne = 0;
+        for (int k = 0; k < 3; ++k) { lb += s.layers[l].tensors[k].bytes; ne = std::max(ne, s.layers[l].tensors[k].n_experts); }
+        if (ne > 0) per_expert = std::max(per_expert, lb / size_t(ne));
+    }
+    if (per_expert == 0) { s.snapshot_arena_restored = true; return; }
+    const uint64_t ppe = (per_expert + s.arena.page_bytes() - 1) / s.arena.page_bytes();
+    const uint64_t pages = 3 * ppe;
+    const uint64_t bytes = pages * s.arena.page_bytes();
+    std::vector<std::pair<int,int>> wanted;
+    std::set<std::pair<int,int>> wanted_seen;
+    auto add_wanted = [&](int l, int e) {
+        const std::pair<int,int> key{l,e};
+        if (wanted_seen.insert(key).second) wanted.push_back(key);
+    };
+    for (int l = 0; l < s.n_layers; ++l) {
+        const layer_t & L = s.layers[l];
+        if (L.full || L.slots == 0) continue;
+        for (int e : s.snapshot_arena_experts[l]) add_wanted(l,e);
+    }
+    struct cand_t { uint64_t score; int layer; int expert; };
+    std::vector<cand_t> candidates;
+    for (int l = 0; l < s.n_layers; ++l) {
+        const layer_t & L = s.layers[l];
+        if (L.full || L.slots == 0) continue;
+        const auto & ppm = s.snapshot_short_ppm[l];
+        for (int e = 0; e < s.n_experts; ++e) {
+            if (L.slot_of[e] >= 0 || L.in_shadow[e]) continue;
+            const uint64_t sc = e < int(ppm.size()) ? ppm[e] : 0;
+            if (sc) candidates.push_back({sc,l,e});
+        }
+    }
+    std::stable_sort(candidates.begin(), candidates.end(), [](const cand_t & a, const cand_t & b) {
+        if (a.score != b.score) return a.score > b.score;
+        if (a.layer != b.layer) return a.layer < b.layer;
+        return a.expert < b.expert;
+    });
+    for (const auto & c : candidates) add_wanted(c.layer,c.expert);
+
+    int restored = 0;
+    for (const auto & le : wanted) {
+        if (s.arena.free_bytes() < bytes) break;
+        const int l = le.first, e = le.second;
+        layer_t & L = s.layers[l];
+        if (L.slot_of[e] >= 0 || L.in_shadow[e]) continue;
+        bool dup = false; for (const auto & ae : L.arena_experts) if (ae.first == e) { dup = true; break; }
+        if (dup) continue;
+        uint64_t off = 0, alloc_bytes = 0;
+        if (!s.arena.allocate_pages(pages, off, alloc_bytes)) break;
+        bool ok = true;
+        for (int k = 0; k < 3; ++k) {
+            const tensor_slot & t = L.tensors[k];
+            if (!t.host_ptr) continue;
+            const uint64_t dst = off + uint64_t(k) * ppe * s.arena.page_bytes();
+            if (cudaMemcpyAsync(static_cast<char *>(s.arena.base()) + dst,
+                    static_cast<const char *>(t.host_ptr) + size_t(e) * size_t(t.stride),
+                    size_t(t.stride), cudaMemcpyHostToDevice, s.side_stream) != cudaSuccess) { ok = false; break; }
+        }
+        if (!ok) { s.arena.free_pages(off, pages); continue; }
+        L.arena_experts.emplace_back(e, off);
+        restored++;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(s.side_stream));
+    for (int l = 0; l < s.n_layers; ++l) {
+        for (int k = 0; k < MAX_TENSORS; ++k) {
+            tensor_slot & t = s.layers[l].tensors[k];
+            if (!t.host_ptr) continue;
+            std::vector<const void *> content;
+            build_table_content(s, l, k, content);
+            for (int b = 0; b < 2; ++b) CUDA_CHECK(cudaMemcpyAsync(const_cast<void *>(t.tables[b]), content.data(),
+                content.size() * sizeof(const void *), cudaMemcpyHostToDevice, s.side_stream));
+        }
+    }
+    std::vector<uint32_t> bits;
+    build_resident_bits(s, bits);
+    CUDA_CHECK(cudaMemcpyAsync(s.d_resident, bits.data(), bits.size() * sizeof(uint32_t), cudaMemcpyHostToDevice, s.side_stream));
+    CUDA_CHECK(cudaStreamSynchronize(s.side_stream));
+    s.snapshot_arena_restored = true;
+    GGML_LOG_INFO("HotExpert snapshot: restored %d arena experts, free=%llu MiB\n",
+        restored, (unsigned long long) (s.arena.free_bytes() >> 20));
+}
