+// ---------------------------------------------------------------------------
+// env helpers
+// ---------------------------------------------------------------------------
+
+static runtime_mode env_mode() {
+    const char * value = std::getenv("HOTSEAT_RUNTIME_MODE");
+    if (!value || !*value) {
+        return MODE_STATIC;
+    }
+    if (std::strcmp(value, "dynamic-experts") == 0) {
+        return MODE_DYNAMIC_EXPERTS;
+    }
+    if (std::strcmp(value, "dynamic-hybrid") == 0) {
+        return MODE_DYNAMIC_HYBRID;
+    }
+    return MODE_STATIC;
+}
+
+static int env_int(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 ? int(parsed) : fallback;
+}
+
+static double env_double(const char * name, double fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const double parsed = std::strtod(value, nullptr);
+    return parsed > 0.0 ? parsed : fallback;
+}
