+static int adaptive_eval_tokens(rt_state & s);
+
+static void token_callback(void * user_data) {
+    auto * state = static_cast<rt_state *>(user_data);
+    const uint64_t tokens = ++state->decode_tokens;
+    if (state->v2_prefetch_enabled && state->h_v2_routes && state->h_v2_route_latest) {
+        const uint64_t route_token = *state->h_v2_route_latest;
+        if (state->transit_only && tokens <= 8) {
+            std::fprintf(stderr, "Q122 V3 DBG callback decode_tokens=%llu route_token=%llu\n",
+                (unsigned long long) tokens, (unsigned long long) route_token);
+            std::fflush(stderr);
+        }
+        if (route_token != UINT64_MAX) {
+            state->v2_latest_token.store(route_token, std::memory_order_release);
+            state->v2_prefetch_cv.notify_one();
+        }
+    }
+    // stage I: rolling decode-TPS telemetry (1 s windows)
+    const uint64_t now_us = uint64_t(ggml_time_us());
+    if (state->v2_profile_enabled && !state->v2_token_times_us.empty()) {
+        if (state->v2_profile_started_us == 0) {
+            state->v2_profile_started_us = now_us;
+        }
+        state->v2_token_times_us[size_t((tokens - 1) % state->v2_profile_capacity)] = now_us;
+    }
+    const uint64_t win_start = state->window_start_us.load(std::memory_order_relaxed);
+    const uint64_t win_tokens = state->window_decode_tokens.load(std::memory_order_relaxed);
+    if (win_start == 0) {
+        state->window_start_us.store(now_us, std::memory_order_relaxed);
+        state->window_decode_tokens.store(1, std::memory_order_relaxed);
+    } else if (now_us - win_start >= 1000000) {
+        const double tps = double(win_tokens) * 1e6 / double(now_us - win_start);
+        state->window_tps.store(tps, std::memory_order_relaxed);
+        state->window_start_us.store(now_us, std::memory_order_relaxed);
+        state->window_decode_tokens.store(1, std::memory_order_relaxed);
+    } else {
+        state->window_decode_tokens.store(win_tokens + 1, std::memory_order_relaxed);
+    }
+    const int eval_tokens = state->expert_eval_auto
+        ? adaptive_eval_tokens(*state)
+        : state->expert_eval_tokens;
+    if (tokens - state->last_eval_decode.load(std::memory_order_acquire) >=
+            uint64_t(eval_tokens) &&
+        !state->eval_requested.exchange(true, std::memory_order_acq_rel)) {
+        state->worker_cv.notify_one();
+    }
+}
