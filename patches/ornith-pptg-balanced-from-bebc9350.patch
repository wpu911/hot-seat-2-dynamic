+void ggml_hotexpert_set_model_info(const char * architecture, int n_layers, int n_experts, int n_expert_used) {
+    if (const char * pin = std::getenv("Q122_V3_TARGET_LAYERS")) {
+        const int wanted = std::atoi(pin);
+        if (wanted > 0 && n_layers > 0 && n_layers != wanted) {
+            return;
+        }
+    }
+    if (architecture && *architecture) {
+        std::lock_guard<std::mutex> lock(model_info_mutex);
+        model_architecture = architecture;
+    }
+    if (n_layers > 0) model_layers.store(n_layers, std::memory_order_relaxed);
+    if (n_experts > 0) model_experts.store(n_experts, std::memory_order_relaxed);
+    if (n_expert_used > 0) model_expert_used.store(n_expert_used, std::memory_order_relaxed);
+}
+
+const char * ggml_hotexpert_model_architecture(void) {
+    static thread_local std::string snapshot;
+    std::lock_guard<std::mutex> lock(model_info_mutex);
+    snapshot = model_architecture;
+    return snapshot.c_str();
+}
+
+int ggml_hotexpert_model_layers(void) {
+    return model_layers.load(std::memory_order_relaxed);
+}
+
+int ggml_hotexpert_model_experts(void) {
+    return model_experts.load(std::memory_order_relaxed);
+}
+
+int ggml_hotexpert_model_expert_used(void) {
+    return model_expert_used.load(std::memory_order_relaxed);
+}
+
+int ggml_hotexpert_q122_static_slots(int layer, int fallback_slots) {
+    static const std::array<int, V3_MAX_LAYERS> layer_slots = [] {
+        std::array<int, V3_MAX_LAYERS> out{};
+        out.fill(-1);
+        const char * spec = std::getenv("Q122_STATIC_LAYER_SLOTS");
+        if (!spec || !*spec) return out;
+        const char * p = spec;
+        while (*p) {
+            while (*p == ' ' || *p == ',') ++p;
+            if (!*p) break;
+            char * end = nullptr;
+            long l = std::strtol(p, &end, 10);
+            if (end == p || *end != ':') break;
+            p = end + 1;
+            long n = std::strtol(p, &end, 10);
+            if (end == p) break;
+            if (l >= 0 && l < V3_MAX_LAYERS) {
+                out[size_t(l)] = int(std::max(0L, std::min(256L, n)));
+            }
+            p = end;
+        }
+        return out;
+    }();
+    if (layer >= 0 && layer < V3_MAX_LAYERS && layer_slots[size_t(layer)] >= 0) {
+        return layer_slots[size_t(layer)];
+    }
+    return std::max(0, fallback_slots);
+}
+int ggml_hotexpert_q122_active_slots(int layer, int fallback_slots) {
+    if (layer >= 0 && layer < V3_MAX_LAYERS) {
+        const int encoded = q122_active_slots_encoded[size_t(layer)].load(std::memory_order_acquire);
+        if (encoded > 0) return encoded - 1;
+    }
+    return ggml_hotexpert_q122_static_slots(layer, fallback_slots);
+}
+
+void ggml_hotexpert_q122_set_active_slots(int layer, int slots) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    slots = std::max(0, std::min(256, slots));
+    q122_active_slots_encoded[size_t(layer)].store(slots + 1, std::memory_order_release);
+}
+
+void ggml_hotexpert_q122_borrow_publish(int layer, const int32_t * experts, int n_experts) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    uint64_t mask[V3_MASK_WORDS] = {0, 0, 0, 0};
+    if (experts && n_experts > 0) {
+        for (int i = 0; i < n_experts; ++i) {
+            const int e = experts[i];
+            if (e >= 0 && e < 256) mask[e >> 6] |= uint64_t(1) << (e & 63);
+        }
+    }
+    q122_borrow_valid[size_t(layer)].store(0, std::memory_order_release);
+    for (int w = 0; w < V3_MASK_WORDS; ++w) {
+        q122_borrow_mask[size_t(layer)][size_t(w)].store(mask[w], std::memory_order_relaxed);
+    }
+    q122_borrow_valid[size_t(layer)].store(1, std::memory_order_release);
+}
+
+void ggml_hotexpert_q122_borrow_clear(int layer) {
+    ggml_hotexpert_q122_borrow_publish(layer, nullptr, 0);
+}
+
+int ggml_hotexpert_q122_borrow_valid(int layer) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return 0;
+    return q122_borrow_valid[size_t(layer)].load(std::memory_order_acquire) != 0 ? 1 : 0;
+}
+
+int ggml_hotexpert_q122_borrow_contains(int layer, int expert) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || expert < 0 || expert >= 256) return 0;
+    if (!ggml_hotexpert_q122_borrow_valid(layer)) return 0;
+    const uint64_t word = q122_borrow_mask[size_t(layer)][size_t(expert >> 6)].load(std::memory_order_relaxed);
+    return (word & (uint64_t(1) << (expert & 63))) != 0 ? 1 : 0;
+}
+
+void ggml_hotexpert_q122_resident_publish(int layer, const int32_t * experts, int n_experts) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    uint64_t mask[V3_MASK_WORDS] = {0, 0, 0, 0};
+    if (experts && n_experts > 0) {
+        for (int i = 0; i < n_experts; ++i) {
+            const int e = experts[i];
+            if (e >= 0 && e < 256) mask[e >> 6] |= uint64_t(1) << (e & 63);
+        }
+    }
+    q122_resident_valid[size_t(layer)].store(0, std::memory_order_release);
+    for (int w = 0; w < V3_MASK_WORDS; ++w) {
+        q122_resident_mask[size_t(layer)][size_t(w)].store(mask[w], std::memory_order_relaxed);
+    }
+    q122_resident_valid[size_t(layer)].store(1, std::memory_order_release);
+}
+
+void ggml_hotexpert_q122_resident_clear(int layer) {
+    ggml_hotexpert_q122_resident_publish(layer, nullptr, 0);
+}
+
+int ggml_hotexpert_q122_resident_valid(int layer) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return 0;
+    return q122_resident_valid[size_t(layer)].load(std::memory_order_acquire) != 0 ? 1 : 0;
+}
+
+int ggml_hotexpert_q122_resident_contains(int layer, int expert) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || expert < 0 || expert >= 256) return 0;
+    if (!ggml_hotexpert_q122_resident_valid(layer)) return 0;
+    const uint64_t word = q122_resident_mask[size_t(layer)][size_t(expert >> 6)].load(std::memory_order_relaxed);
+    return (word & (uint64_t(1) << (expert & 63))) != 0 ? 1 : 0;
+}
+
+void ggml_hotexpert_q122_adaptive_observe(int layer, const int32_t * experts, int n_experts) {
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_BORROW");
+        return v && std::string(v) == "1";
+    }();
+    if (!enabled || layer < 0 || layer >= V3_MAX_LAYERS || !experts || n_experts <= 0) return;
+    const int n = std::min(n_experts, V3_ROUTE_TOPK);
+    static const bool diag = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_DIAG");
+        return v && std::string(v) == "1";
+    }();
+    static std::atomic<uint64_t> diag_routed{0};
+    static std::atomic<uint64_t> diag_resident{0};
+    static std::atomic<uint64_t> diag_tokens{0};
+    static std::atomic<uint64_t> diag_prev_routed{0};
+    static std::atomic<uint64_t> diag_prev_resident{0};
+    uint64_t local_routed = 0;
+    uint64_t local_resident = 0;
+    for (int i = 0; i < n; ++i) {
+        const int e = experts[i];
+        if (e < 0 || e >= 256) continue;
+        if (diag) {
+            ++local_routed;
+            if (ggml_hotexpert_q122_resident_contains(layer, e)) ++local_resident;
+        }
+        auto & counter = q122_adaptive_hits[size_t(layer)][size_t(e)];
+        uint32_t old = counter.load(std::memory_order_relaxed);
+        while (old != UINT32_MAX && !counter.compare_exchange_weak(
+                old, old + 1, std::memory_order_relaxed, std::memory_order_relaxed)) {}
+    }
+    if (diag) {
+        diag_routed.fetch_add(local_routed, std::memory_order_relaxed);
+        diag_resident.fetch_add(local_resident, std::memory_order_relaxed);
+        if (layer == 47) {
+            const uint64_t t = diag_tokens.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (t == 1 || t == 32 || t == 64 || t == 96 || t == 128 || t == 256 || t == 384 || t == 512 || t == 768) {
+                const uint64_t r = diag_routed.load(std::memory_order_relaxed);
+                const uint64_t h = diag_resident.load(std::memory_order_relaxed);
+                const uint64_t pr = diag_prev_routed.exchange(r, std::memory_order_relaxed);
+                const uint64_t ph = diag_prev_resident.exchange(h, std::memory_order_relaxed);
+                const uint64_t wr = r - pr;
+                const uint64_t wh = h - ph;
+                std::fprintf(stderr, "Q122 ADAPT_DIAG: tokens=%llu routed=%llu resident=%llu hit=%.2f%% window_hit=%.2f%%\n",
+                    (unsigned long long) t, (unsigned long long) r, (unsigned long long) h,
+                    r ? 100.0 * double(h) / double(r) : 0.0,
+                    wr ? 100.0 * double(wh) / double(wr) : 0.0);
+                std::fflush(stderr);
+            }
+        }
+    }
+}
+
+void ggml_hotexpert_q122_adaptive_add_counts(int layer, const uint32_t * counts, int n_experts) {
+    static const bool enabled = [] {
+        const char * a = std::getenv("Q122_ADAPTIVE_BORROW");
+        const char * p = std::getenv("Q122_ADAPTIVE_PREFILL");
+        return a && std::string(a) == "1" && p && std::string(p) == "1";
+    }();
+    if (!enabled || layer < 0 || layer >= V3_MAX_LAYERS || !counts || n_experts <= 0) return;
+    const int n = std::min(n_experts, 256);
+    for (int e = 0; e < n; ++e) {
+        const uint32_t add = counts[e];
+        if (!add) continue;
+        auto & counter = q122_adaptive_hits[size_t(layer)][size_t(e)];
+        uint32_t old = counter.load(std::memory_order_relaxed);
+        for (;;) {
+            if (old == UINT32_MAX) break;
+            const uint32_t room = UINT32_MAX - old;
+            const uint32_t next = old + std::min(add, room);
+            if (counter.compare_exchange_weak(old, next, std::memory_order_relaxed, std::memory_order_relaxed)) break;
+        }
+    }
+}
+
+int ggml_hotexpert_q122_adaptive_snapshot(int layer, uint32_t * hits, int n_experts, int reset) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || !hits || n_experts <= 0) return 0;
+    const int n = std::min(n_experts, 256);
+    for (int e = 0; e < n; ++e) {
+        hits[e] = reset
+            ? q122_adaptive_hits[size_t(layer)][size_t(e)].exchange(0, std::memory_order_acq_rel)
+            : q122_adaptive_hits[size_t(layer)][size_t(e)].load(std::memory_order_relaxed);
+    }
+    return n;
+}
+
+void ggml_hotexpert_q122_adaptive_reset(void) {
+    for (auto & layer : q122_adaptive_hits) {
+        for (auto & counter : layer) counter.store(0, std::memory_order_relaxed);
+    }
+}
+
+void ggml_hotexpert_v3_set_current_token(uint64_t token) {
+    v3_current_token.store(token, std::memory_order_release);
+}
+
+uint64_t ggml_hotexpert_v3_current_token(void) {
+    return v3_current_token.load(std::memory_order_acquire);
+}
+
+void ggml_hotexpert_v3_transit_reset(void) {
+    v3_current_token.store(0, std::memory_order_release);
+    for (auto & layer : v3_transit) {
+        layer.token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+        for (auto & word : layer.mask) word.store(0, std::memory_order_relaxed);
+    }
+}
+
+void ggml_hotexpert_v3_transit_clear(int layer) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    auto & dst = v3_transit[size_t(layer)];
+    // Invalidate the epoch before changing the mask so a concurrent reader can
+    // never observe a new mask under an old valid token.
+    dst.token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+    for (auto & word : dst.mask) word.store(0, std::memory_order_relaxed);
+}
+
+void ggml_hotexpert_v3_transit_publish(int layer, uint64_t token, const int32_t * experts, int n_experts) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    uint64_t mask[V3_MASK_WORDS] = {0, 0, 0, 0};
+    if (experts && n_experts > 0) {
+        for (int i = 0; i < n_experts; ++i) {
+            const int e = experts[i];
+            if (e >= 0 && e < 256) mask[e >> 6] |= uint64_t(1) << (e & 63);
+        }
+    }
+    auto & dst = v3_transit[size_t(layer)];
+    dst.token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+    for (int i = 0; i < V3_MASK_WORDS; ++i) dst.mask[size_t(i)].store(mask[i], std::memory_order_relaxed);
+    dst.token.store(token, std::memory_order_release);
+}
+
+int ggml_hotexpert_v3_transit_contains(int layer, uint64_t token, int expert) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || expert < 0 || expert >= 256) return 0;
+    const auto & src = v3_transit[size_t(layer)];
+    const uint64_t t0 = src.token.load(std::memory_order_acquire);
+    if (t0 != token) return 0;
+    const uint64_t word = src.mask[size_t(expert >> 6)].load(std::memory_order_relaxed);
+    // Re-read the epoch after the mask. This tiny seqlock-like check makes a
+    // concurrent publication safe without putting a mutex in the CPU MMID path.
+    const uint64_t t1 = src.token.load(std::memory_order_acquire);
+    return t0 == t1 && (word & (uint64_t(1) << (expert & 63))) != 0;
+}
+
+void ggml_hotexpert_v3_route_reset(void) {
+    v3_route_counter.store(0, std::memory_order_release);
+    v3_route_latest_token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+    for (auto & layer : v3_route) {
+        layer.token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+        layer.count.store(0, std::memory_order_relaxed);
+        for (auto & e : layer.experts) e.store(-1, std::memory_order_relaxed);
+    }
+}
+
+uint64_t ggml_hotexpert_v3_route_begin(void) {
+    const uint64_t token = v3_route_counter.fetch_add(1, std::memory_order_acq_rel);
+    ggml_hotexpert_v3_set_current_token(token);
+    return token;
+}
+
+void ggml_hotexpert_v3_route_publish(int layer, uint64_t token, const int32_t * experts, int n_experts, int complete) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    auto & dst = v3_route[size_t(layer)];
+    dst.token.store(std::numeric_limits<uint64_t>::max(), std::memory_order_release);
+    const int n = n_experts > 0 ? std::min(n_experts, V3_ROUTE_TOPK) : 0;
+    dst.count.store(n, std::memory_order_relaxed);
+    for (int i = 0; i < V3_ROUTE_TOPK; ++i) {
+        dst.experts[size_t(i)].store(i < n && experts ? experts[i] : -1, std::memory_order_relaxed);
+    }
+    dst.token.store(token, std::memory_order_release);
+    if (complete) v3_route_latest_token.store(token, std::memory_order_release);
+}
+
+uint64_t ggml_hotexpert_v3_route_latest(void) {
+    return v3_route_latest_token.load(std::memory_order_acquire);
+}
+
+void ggml_hotexpert_v3_route_complete(uint64_t token) {
+    v3_route_latest_token.store(token, std::memory_order_release);
+}
+
+int ggml_hotexpert_v3_route_ready(int layer, uint64_t token) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return 0;
+    return v3_route[size_t(layer)].token.load(std::memory_order_acquire) == token ? 1 : 0;
+}
+
+int ggml_hotexpert_v3_route_copy(int layer, uint64_t token, int32_t * experts, int max_experts) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || !experts || max_experts <= 0) return 0;
+    const auto & src = v3_route[size_t(layer)];
+    const uint64_t t0 = src.token.load(std::memory_order_acquire);
+    if (t0 != token) return 0;
+    int n = src.count.load(std::memory_order_relaxed);
+    n = std::max(0, std::min({n, max_experts, V3_ROUTE_TOPK}));
+    for (int i = 0; i < n; ++i) experts[i] = src.experts[size_t(i)].load(std::memory_order_relaxed);
+    const uint64_t t1 = src.token.load(std::memory_order_acquire);
+    return t0 == t1 ? n : 0;
+}
+
+
+void ggml_hotexpert_hybrid_register(
+        ggml_hotexpert_hybrid_start_fn start_fn,
+        ggml_hotexpert_hybrid_finish_fn finish_fn,
+        void * user) {
+    std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+    hybrid_start_cb = start_fn;
+    hybrid_finish_cb = finish_fn;
+    hybrid_cb_user = user;
+}
+
+void ggml_hotexpert_hybrid_unregister(void * user) {
+    std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+    if (hybrid_cb_user != user) return;
+    hybrid_start_cb = nullptr;
+    hybrid_finish_cb = nullptr;
+    hybrid_cb_user = nullptr;
+}
+
+int ggml_hotexpert_hybrid_start(
+        const struct ggml_tensor * src0,
+        const struct ggml_tensor * src1,
+        const struct ggml_tensor * ids,
+        struct ggml_tensor * dst) {
+    ggml_hotexpert_hybrid_start_fn fn = nullptr;
+    void * user = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+        fn = hybrid_start_cb;
+        user = hybrid_cb_user;
+    }
+    return fn ? fn(user, src0, src1, ids, dst) : 0;
+}
+
+int ggml_hotexpert_hybrid_finish(struct ggml_tensor * dst) {
+    ggml_hotexpert_hybrid_finish_fn fn = nullptr;
+    void * user = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+        fn = hybrid_finish_cb;
+        user = hybrid_cb_user;
+    }
+    return fn ? fn(user, dst) : 0;
+}
+
+void ggml_hotexpert_hybrid_set_weight(int layer, int kind, const struct ggml_tensor * weight) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || kind < 0 || kind >= 5) return;
+    std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+    hybrid_weights[layer][kind] = weight;
+}
+
+const struct ggml_tensor * ggml_hotexpert_hybrid_get_weight(int layer, int kind) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || kind < 0 || kind >= 5) return nullptr;
+    std::lock_guard<std::mutex> lock(hybrid_cb_mutex);
+    return hybrid_weights[layer][kind];
+}
+
+void ggml_hotexpert_hybrid_spill_publish(int layer, int expert) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS) return;
+    hybrid_spill_expert[size_t(layer)].store(expert, std::memory_order_release);
+}
+
+int ggml_hotexpert_hybrid_spill_contains(int layer, int expert) {
+    if (layer < 0 || layer >= V3_MAX_LAYERS || expert < 0) return 0;
+    return hybrid_spill_expert[size_t(layer)].load(std::memory_order_acquire) == expert ? 1 : 0;
+}
