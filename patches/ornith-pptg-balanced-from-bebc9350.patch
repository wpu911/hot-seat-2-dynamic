+// MoE Layer Plan HotSeat v1:
+// If HOTSEAT_LAYER_PLAN_FILE points to a JSON containing:
+//   "hot_layer_plan": [3, 4, 5, ...]
+// then MoE HotSeat uses that exact layer list.
+// If the file is absent or invalid, it falls back to HOTSEAT_TENSOR_LAYERS=N.
+static std::set<int> llama_hotseat_layer_plan_load_from_env() {
+    std::set<int> plan;
+
+    const char * path = std::getenv("HOTSEAT_LAYER_PLAN_FILE");
+    if (!path || !*path) {
+        return plan;
+    }
+
+    std::ifstream in(path);
+    if (!in.good()) {
+        LLAMA_LOG_WARN("MoE LayerPlan HotSeat: cannot open HOTSEAT_LAYER_PLAN_FILE=%s, fallback to HOTSEAT_TENSOR_LAYERS\n", path);
+        return plan;
+    }
+
+    std::stringstream buffer;
+    buffer << in.rdbuf();
+    const std::string s = buffer.str();
+
+    const std::string key = "\"hot_layer_plan\"";
+    size_t pos = s.find(key);
+    if (pos == std::string::npos) {
+        LLAMA_LOG_WARN("MoE LayerPlan HotSeat: hot_layer_plan not found in %s, fallback to HOTSEAT_TENSOR_LAYERS\n", path);
+        return plan;
+    }
+
+    size_t lb = s.find('[', pos);
+    size_t rb = s.find(']', lb == std::string::npos ? pos : lb);
+
+    if (lb == std::string::npos || rb == std::string::npos || rb <= lb) {
+        LLAMA_LOG_WARN("MoE LayerPlan HotSeat: invalid hot_layer_plan array in %s, fallback to HOTSEAT_TENSOR_LAYERS\n", path);
+        return plan;
+    }
+
+    std::string arr = s.substr(lb + 1, rb - lb - 1);
+
+    int value = 0;
+    bool in_number = false;
+    bool negative = false;
+
+    for (char c : arr) {
+        if (c == '-') {
+            negative = true;
+            in_number = true;
+            value = 0;
+            continue;
+        }
+
+        if (std::isdigit((unsigned char) c)) {
+            if (!in_number) {
+                value = 0;
+                negative = false;
+                in_number = true;
+            }
+            value = value * 10 + (c - '0');
+            continue;
+        }
+
+        if (in_number) {
+            int layer = negative ? -value : value;
+            if (layer >= 0 && layer < 4096) {
+                plan.insert(layer);
+            }
+            value = 0;
+            in_number = false;
+            negative = false;
+        }
+    }
+
+    if (in_number) {
+        int layer = negative ? -value : value;
+        if (layer >= 0 && layer < 4096) {
+            plan.insert(layer);
+        }
+    }
+
+    if (!plan.empty()) {
+        std::stringstream ss;
+        bool first = true;
+        for (int layer : plan) {
+            if (!first) {
+                ss << ",";
+            }
+            first = false;
+            ss << layer;
+        }
+
+        LLAMA_LOG_INFO(
+            "MoE LayerPlan HotSeat: loaded %zu hot layers from %s: [%s]\n",
+            plan.size(),
+            path,
+            ss.str().c_str());
+    } else {
+        LLAMA_LOG_WARN("MoE LayerPlan HotSeat: empty hot_layer_plan in %s, fallback to HOTSEAT_TENSOR_LAYERS\n", path);
+    }
+
+    return plan;
+}
+
+static const std::set<int> & llama_hotseat_layer_plan_loaded() {
+    static const std::set<int> plan = llama_hotseat_layer_plan_load_from_env();
+    return plan;
+}
+
+static bool llama_hotseat_layer_plan_enabled() {
+    return !llama_hotseat_layer_plan_loaded().empty();
+}
+
+static bool llama_hotseat_layer_plan_contains(int layer) {
+    const auto & plan = llama_hotseat_layer_plan_loaded();
+    return plan.find(layer) != plan.end();
+}
