+
+static void q122_adaptive_init_layer(cache_state & s, int layer, int base_slots, int max_slots) {
+    if (layer < 0 || layer >= MAX_LAYERS || base_slots <= 0) return;
+    const auto & ranked = s.ranked_experts[size_t(layer)];
+    auto & static_base = s.adaptive_static_baseline[size_t(layer)];
+    auto & static_cur = s.adaptive_static_experts[size_t(layer)];
+    if (int(static_base.size()) != base_slots) {
+        static_base.clear();
+        for (int slot = 0; slot < base_slots && slot < int(ranked.size()); ++slot) static_base.push_back(ranked[size_t(slot)]);
+    }
+    if (int(static_cur.size()) != int(static_base.size())) static_cur = static_base;
+
+    const int n = std::max(0, max_slots - base_slots);
+    auto & cur = s.adaptive_borrow_experts[size_t(layer)];
+    auto & base = s.adaptive_borrow_baseline[size_t(layer)];
+    if (int(base.size()) != n) {
+        base.clear();
+        for (int slot = base_slots; slot < max_slots && slot < int(ranked.size()); ++slot) base.push_back(ranked[size_t(slot)]);
+    }
+    if (int(cur.size()) != int(base.size())) cur = base;
+    auto & stat_age = s.adaptive_static_install_token[size_t(layer)];
+    if (stat_age.size() != static_cur.size()) stat_age.assign(static_cur.size(), 0);
+    auto & borrow_age = s.adaptive_borrow_install_token[size_t(layer)];
+    if (borrow_age.size() != cur.size()) borrow_age.assign(cur.size(), 0);
+}
+
+static const std::vector<int> & q122_adaptive_static_list(const cache_state & s, int layer) {
+    return s.adaptive_static_experts[size_t(layer)];
+}
+
+static const std::vector<int> & q122_adaptive_borrow_list(const cache_state & s, int layer) {
+    return s.adaptive_borrow_experts[size_t(layer)];
+}
+
+static void q122_publish_borrow_mask(const cache_state & s, int layer, bool active) {
+    if (layer < 0 || layer >= MAX_LAYERS) return;
+    if (!active) {
+        ggml_hotexpert_q122_borrow_clear(layer);
+        return;
+    }
+    const auto & list = q122_adaptive_borrow_list(s, layer);
+    if (list.empty()) {
+        ggml_hotexpert_q122_borrow_clear(layer);
+        return;
+    }
+    std::vector<int32_t> ids(list.begin(), list.end());
+    ggml_hotexpert_q122_borrow_publish(layer, ids.data(), int(ids.size()));
+}
+
+static void q122_publish_resident_mask(const cache_state & s, int layer, bool borrow_active) {
+    if (layer < 0 || layer >= MAX_LAYERS) return;
+    std::vector<int32_t> ids;
+    const auto & stat = q122_adaptive_static_list(s, layer);
+    ids.insert(ids.end(), stat.begin(), stat.end());
+    if (borrow_active) {
+        const auto & borrow = q122_adaptive_borrow_list(s, layer);
+        ids.insert(ids.end(), borrow.begin(), borrow.end());
+    }
+    ggml_hotexpert_q122_resident_publish(layer, ids.data(), int(ids.size()));
+}
+
+static void parse_borrow_plan(cache_state & s) {
+    s.borrow_max_slots.fill(-1);
+    const char * spec = std::getenv("Q122_BORROW_LAYER_SLOTS");
+    if (!spec || !*spec) return;
+    const char * p = spec;
+    while (*p) {
+        while (*p == ' ' || *p == ',') ++p;
+        if (!*p) break;
+        char * end = nullptr;
+        long layer = std::strtol(p, &end, 10);
+        if (end == p || *end != ':') break;
+        p = end + 1;
+        long slots = std::strtol(p, &end, 10);
+        if (end == p) break;
+        if (layer >= 0 && layer < MAX_LAYERS) {
+            s.borrow_max_slots[size_t(layer)] = int(std::max(0L, std::min<long>(MAX_EXPERTS, slots)));
+        }
+        p = end;
+    }
+}
+
+static int q122_dynborrow_max_slots(const cache_state & s, int layer, int base_slots) {
+    if (!s.borrow_enabled || layer < 0 || layer >= MAX_LAYERS) return base_slots;
+    const int planned = s.borrow_max_slots[size_t(layer)];
+    return planned < 0 ? base_slots : std::max(base_slots, std::min(MAX_EXPERTS, planned));
+}
+
+static double q122_dynborrow_utility(const cache_state & s, int layer) {
+    const int base = ggml_hotexpert_q122_static_slots(layer, s.slots);
+    const int max_slots = q122_dynborrow_max_slots(s, layer, base);
+    if (max_slots <= base) return -1.0;
+    const auto & ranked = s.ranked_experts[size_t(layer)];
+    const auto & hits = s.expert_hits[size_t(layer)];
+    long double gain = 0.0;
+    for (int slot = base; slot < max_slots && slot < int(ranked.size()); ++slot) {
+        const int expert = ranked[size_t(slot)];
+        if (expert >= 0 && expert < int(hits.size())) gain += hits[size_t(expert)];
+    }
+    return double(gain / std::max(1, max_slots - base));
+}
+
+static std::array<bool, MAX_LAYERS> q122_dynborrow_desired_layers(const cache_state & s) {
+    // Watermark controller: experts and sparse KV share the same physical VRAM.
+    // Treat all currently allocated borrow chunks as reclaimable, then choose the
+    // highest-utility whole-layer chunks that fit while leaving the configured
+    // low-water reserve. With Ornith's ~200 MiB/layer extension and a 400 MiB
+    // low watermark this naturally settles around 400-600 MiB free.
+    struct cand { int layer; int delta; double utility; size_t bytes; };
+    std::vector<cand> cands;
+    int total_slots = 0;
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        const int base = ggml_hotexpert_q122_static_slots(layer, s.slots);
+        const int max_slots = q122_dynborrow_max_slots(s, layer, base);
+        const int delta = std::max(0, max_slots - base);
+        if (!delta) continue;
+
+        int entries = 0;
+        size_t bytes = 0;
+        for (const auto & kv : s.entries) {
+            const cache_entry & e = *kv.second;
+            if (e.layer != layer) continue;
+            ++entries;
+            bytes += e.borrow_bytes;
+        }
+        // GATE/UP/DOWN must all be registered before a layer can be borrowed.
+        if (entries < 3 || bytes == 0) continue;
+
+        cands.push_back({layer, delta, q122_dynborrow_utility(s, layer), bytes});
+        total_slots += delta;
+    }
+
+    std::stable_sort(cands.begin(), cands.end(), [](const cand & a, const cand & b) {
+        if (a.utility != b.utility) return a.utility > b.utility;
+        return a.layer < b.layer;
+    });
+
+    int cap_slots = total_slots;
+    if (const char * cap = std::getenv("Q122_DYNKV_BORROW_MAX_SLOTS")) {
+        const long v = std::strtol(cap, nullptr, 10);
+        if (v >= 0) cap_slots = std::min(total_slots, int(v));
+    }
+
+    size_t free_now = 0, total_now = 0;
+    CUDA_CHECK(cudaSetDevice(s.device));
+    (void) cudaMemGetInfo(&free_now, &total_now);
+
+    size_t low_mib = 400;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_LOW_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    } else if (const char * v = std::getenv("Q122_DYNKV_VRAM_RESERVE_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    }
+    const size_t low_bytes = low_mib << 20;
+
+    // If every elastic chunk were repaid, this is the VRAM available to split
+    // between KV and borrow experts. Rebuild the desired set from that baseline,
+    // so KV growth automatically removes experts and KV shrink re-borrows them.
+    const size_t free_if_repaid = free_now + s.borrow_allocated;
+    const size_t borrow_budget = free_if_repaid > low_bytes ? free_if_repaid - low_bytes : 0;
+
+    std::array<bool, MAX_LAYERS> desired{};
+    int kept_slots = 0;
+    size_t kept_bytes = 0;
+    for (const auto & c : cands) {
+        if (kept_slots + c.delta > cap_slots) continue;
+        if (kept_bytes + c.bytes > borrow_budget) continue;
+        desired[size_t(c.layer)] = true;
+        kept_slots += c.delta;
+        kept_bytes += c.bytes;
+    }
+
+    static size_t last_log_free = SIZE_MAX;
+    static size_t last_log_borrow = SIZE_MAX;
+    if (last_log_free == SIZE_MAX ||
+        (free_now > last_log_free ? free_now - last_log_free : last_log_free - free_now) >= (64u << 20) ||
+        kept_bytes != last_log_borrow) {
+        last_log_free = free_now;
+        last_log_borrow = kept_bytes;
+        std::fprintf(stderr,
+            "Q122 DYNBORROW_WATERMARK: free=%.1fMiB reclaimable=%.1fMiB low=%zuMiB desired=%.1fMiB slots=%d/%d rows=%u/%u\n",
+            free_now/1048576.0, s.borrow_allocated/1048576.0, low_mib,
+            kept_bytes/1048576.0, kept_slots, cap_slots, s.dyn_rows, s.dyn_logical_rows);
+        std::fflush(stderr);
+    }
+    return desired;
+}
+
+static void q122_dynborrow_build_table(
+        const cache_state & s, const cache_entry & e, bool include_borrow,
+        std::vector<const void *> & table) {
+    table.assign(size_t(e.n_experts), nullptr);
+    if (!e.resident_only) {
+        for (int expert = 0; expert < e.n_experts; ++expert) {
+            table[size_t(expert)] = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+        }
+    } else if (q122_hybrid_zerocopy_permille() > 0) {
+        for (int expert = 0; expert < e.n_experts; ++expert) {
+            if (q122_hybrid_zerocopy_gpu_owner(e.layer, expert)) {
+                table[size_t(expert)] = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+            }
+        }
+    }
+    const auto & stat = q122_adaptive_static_list(s, e.layer);
+    for (int slot = 0; slot < e.slots && slot < int(stat.size()); ++slot) {
+        const int expert = stat[size_t(slot)];
+        if (expert < 0 || expert >= e.n_experts) continue;
+        table[size_t(expert)] = static_cast<const char *>(e.device_slices) + size_t(slot) * e.slice_bytes;
+    }
+    if (include_borrow && e.borrow_slices && !e.borrow_retired) {
+        const auto & borrow = q122_adaptive_borrow_list(s, e.layer);
+        for (int bi = 0; bi < int(borrow.size()) && bi < e.max_slots - e.slots; ++bi) {
+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= e.n_experts) continue;
+            table[size_t(expert)] = static_cast<const char *>(e.borrow_slices) + size_t(bi) * e.slice_bytes;
+        }
+    }
+}
+
+static bool q122_dynborrow_layer_shape(cache_state & s, int layer, int & base_slots, int & max_slots, size_t & bytes) {
+    int entries = 0;
+    base_slots = -1;
+    max_slots = -1;
+    bytes = 0;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (e.layer != layer) continue;
+        ++entries;
+        if (base_slots < 0) { base_slots = e.slots; max_slots = e.max_slots; }
+        if (e.slots != base_slots || e.max_slots != max_slots) return false;
+        bytes += e.borrow_bytes;
+    }
+    // Q122 has GATE, UP and DOWN expert tensors per layer.
+    return entries >= 3 && max_slots > base_slots && bytes > 0;
+}
+
+static size_t q122_dynborrow_reserve_bytes() {
+    size_t mib = 512;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_RESERVE_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) mib = size_t(x);
+    }
+    return mib << 20;
+}
+
+static bool q122_dynborrow_restage_layer(cache_state & s, int layer) {
+    int base_slots = 0, max_slots = 0;
+    size_t layer_bytes = 0;
+    if (!q122_dynborrow_layer_shape(s, layer, base_slots, max_slots, layer_bytes)) return false;
+
+    bool needs = false;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (e.layer == layer && e.max_slots > e.slots && !e.borrow_slices) { needs = true; break; }
+    }
+    if (!needs) return true;
+
+    CUDA_CHECK(cudaSetDevice(s.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    size_t free_now = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_now, &total_now);
+    const size_t reserve = q122_dynborrow_reserve_bytes();
+    if (free_now <= layer_bytes + reserve) {
+        std::fprintf(stderr,
+            "Q122 DYNBORROW: reborrow-skip layer=%d need=%.1fMiB free=%.1fMiB reserve=%.1fMiB rows=%u/%u\n",
+            layer, layer_bytes/1048576.0, free_now/1048576.0, reserve/1048576.0,
+            s.dyn_rows, s.dyn_logical_rows);
+        std::fflush(stderr);
+        return false;
+    }
+
+    std::vector<cache_entry *> newly;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (e.layer != layer || e.max_slots <= e.slots || e.borrow_slices) continue;
+        cudaError_t err = cudaMalloc(&e.borrow_slices, e.borrow_bytes);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            for (cache_entry * n : newly) {
+                if (n->borrow_slices) { (void) cudaFree(n->borrow_slices); n->borrow_slices = nullptr; }
+            }
+            std::fprintf(stderr, "Q122 DYNBORROW: reborrow-allocation-failed layer=%d: %s\n",
+                         layer, cudaGetErrorString(err));
+            std::fflush(stderr);
+            return false;
+        }
+        newly.push_back(&e);
+    }
+
+    // Copy only after the whole layer has secured its memory, so ownership never
+    // points at a partially reconstructed GATE/UP/DOWN triplet.
+    for (cache_entry * ep : newly) {
+        cache_entry & e = *ep;
+        const auto & borrow = q122_adaptive_borrow_list(s, e.layer);
+        for (int bi = 0; bi < int(borrow.size()) && bi < e.max_slots - e.slots; ++bi) {
+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= e.n_experts) continue;
+            void * dst = static_cast<char *>(e.borrow_slices) + size_t(bi) * e.slice_bytes;
+            const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+            CUDA_CHECK(cudaMemcpy(dst, src, e.slice_bytes, cudaMemcpyHostToDevice));
+        }
+        e.borrow_retired = false;
+        s.allocated += e.borrow_bytes;
+        s.borrow_allocated += e.borrow_bytes;
+    }
+    CUDA_CHECK(cudaDeviceSynchronize());
+    (void) cudaMemGetInfo(&free_now, &total_now);
+    std::fprintf(stderr,
+        "Q122 DYNBORROW: reborrow-staged layer=%d slots=%d->%d bytes=%.1fMiB borrow_alloc=%.1fMiB free=%.1fMiB\n",
+        layer, base_slots, max_slots, layer_bytes/1048576.0,
+        s.borrow_allocated/1048576.0, free_now/1048576.0);
+    std::fflush(stderr);
+    return true;
+}
+
+static bool q122_dynborrow_set_layer(cache_state & s, int layer, bool active) {
+    int base_slots = 0, max_slots = 0;
+    size_t layer_bytes = 0;
+    if (!q122_dynborrow_layer_shape(s, layer, base_slots, max_slots, layer_bytes)) return false;
+
+    if (active) {
+        bool need_restage = false;
+        for (auto & kv : s.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer == layer && e.max_slots > e.slots && !e.borrow_slices) { need_restage = true; break; }
+        }
+        // Borrow is an optimization. If reserve pressure prevents re-acquisition,
+        // keep the correct base-resident path rather than failing the request.
+        if (need_restage && !q122_dynborrow_restage_layer(s, layer)) return true;
+    }
+
+    bool already = true;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (e.layer != layer) continue;
+        if (e.borrow_exposed != active) { already = false; break; }
+        // A pre-staged but hidden elastic chunk still consumes VRAM. A repay
+        // request must free it even when it was never exposed to MMID.
+        if (!active && e.borrow_slices) { already = false; break; }
+    }
+    if (already) return true;
+
+    CUDA_CHECK(cudaSetDevice(s.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (e.layer != layer) continue;
+        std::vector<const void *> table;
+        q122_dynborrow_build_table(s, e, active, table);
+        CUDA_CHECK(cudaMemcpy(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        e.borrow_exposed = active;
+    }
+    CUDA_CHECK(cudaDeviceSynchronize());
+    q122_publish_borrow_mask(s, layer, active);
+    q122_publish_resident_mask(s, layer, active);
+    ggml_hotexpert_q122_set_active_slots(layer, active ? max_slots : base_slots);
+
+    if (!active) {
+        for (auto & kv : s.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != layer || !e.borrow_slices) continue;
+            CUDA_CHECK(cudaFree(e.borrow_slices));
+            e.borrow_slices = nullptr;
+            e.borrow_retired = true;
+            s.allocated -= std::min(s.allocated, e.borrow_bytes);
+            s.borrow_allocated -= std::min(s.borrow_allocated, e.borrow_bytes);
+        }
+    }
+    size_t free_now = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_now, &total_now);
+    std::fprintf(stderr,
+        "Q122 DYNBORROW: layer=%d action=%s slots=%d->%d bytes=%.1fMiB rows=%u/%u borrow_alloc=%.1fMiB free=%.1fMiB\n",
+        layer, active ? "activate" : "repay", base_slots, active ? max_slots : base_slots,
+        layer_bytes/1048576.0, s.dyn_rows, s.dyn_logical_rows,
+        s.borrow_allocated/1048576.0, free_now/1048576.0);
+    std::fflush(stderr);
+    return true;
+}
+
+static void initialize(cache_state & s) {
+    if (s.initialized) return;
+    s.initialized = true;
+    s.enabled = env_enabled();
+    if (!s.enabled) return;
+    s.slots = env_positive_int("HOTEXPERT_CACHE_SLOTS", 64);
+    s.budget = env_budget();
+    s.borrow_enabled = q122_dynborrow_enabled();
+    parse_borrow_plan(s);
+    if (const char * initial = std::getenv("Q122_DYNKV_INITIAL_CELLS")) {
+        const long v = std::strtol(initial, nullptr, 10);
+        if (v > 0) s.dyn_initial_rows = uint32_t(v);
+    }
+    CUDA_CHECK(cudaGetDevice(&s.device));
+    const char * path = std::getenv("HOTEXPERT_CACHE_PROFILE");
+    s.profile_path = path && *path
+        ? path
+        : "/app/share/openclaw_tools/logs/qwen36-hotexpert-profile-1024.json";
+    s.enabled = load_profile(s);
+}
+
+} // namespace
+
+const void * const * ggml_cuda_hotexpert_cache_get(
+        const ggml_tensor * tensor, int64_t expert_stride_bytes, cudaStream_t stream) {
+    const char * q122_r1_dbg = std::getenv("Q122_R1");
+    if (q122_r1_dbg && std::strcmp(q122_r1_dbg, "1") == 0 && tensor && std::strstr(tensor->name, "blk.3.") != nullptr) {
+        static int q122_cache_diag = 0;
+        if (q122_cache_diag < 16) {
+            ++q122_cache_diag;
+            std::fprintf(stderr,
+                "Q122_R1_CACHE_GET name=%s ne=[%lld,%lld,%lld,%lld] nb2=%zu stride=%lld host=%d\n",
+                tensor->name,
+                (long long) tensor->ne[0], (long long) tensor->ne[1],
+                (long long) tensor->ne[2], (long long) tensor->ne[3],
+                (size_t) tensor->nb[2], (long long) expert_stride_bytes,
+                tensor->buffer ? (ggml_backend_buffer_is_host(tensor->buffer) ? 1 : 0) : -1);
+            std::fflush(stderr);
+        }
+    }
+    if (!tensor || tensor->ne[2] <= 0 || tensor->ne[2] > MAX_EXPERTS || expert_stride_bytes <= 0) {
+        return nullptr;
+    }
+    if (!ggml_backend_buffer_is_host(tensor->buffer)) {
+        return nullptr;
+    }
+
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (q122_r1_dbg && std::strcmp(q122_r1_dbg, "1") == 0) {
+        static int q122_state_diag = 0;
+        if (q122_state_diag < 12) {
+            ++q122_state_diag;
+            std::fprintf(stderr,
+                "Q122_R1_CACHE_STATE initialized=%d enabled=%d slots=%d budget_mib=%zu allocated_mib=%zu profile=%s entries=%zu\n",
+                state.initialized ? 1 : 0, state.enabled ? 1 : 0, state.slots,
+                state.budget >> 20, state.allocated >> 20, state.profile_path.c_str(), state.entries.size());
+            std::fflush(stderr);
+        }
+    }
+    if (!state.enabled) {
+        return nullptr;
+    }
+
+    auto found = state.entries.find(tensor->data);
+    if (found != state.entries.end()) {
+        return found->second->device_table;
+    }
+
+    const int layer = parse_layer(tensor->name);
+    if (q122_r1_dbg && std::strcmp(q122_r1_dbg, "1") == 0 && q122_r1_layer_enabled(layer)) {
+        std::fprintf(stderr, "Q122_R1_CACHE_LAYER layer=%d rank_count=%zu top0=%d top1=%d\n",
+            layer, state.ranked_experts[layer].size(),
+            state.ranked_experts[layer].empty() ? -1 : state.ranked_experts[layer][0],
+            state.ranked_experts[layer].size() < 2 ? -1 : state.ranked_experts[layer][1]);
+        std::fflush(stderr);
+    }
+    if (q122_r1_active() && !q122_r1_layer_enabled(layer)) {
+        return nullptr;
+    }
+    if (layer < 0 || state.ranked_experts[layer].empty()) {
+        return nullptr;
+    }
+    const int n_experts = int(tensor->ne[2]);
+    const int configured_slots = ggml_hotexpert_q122_static_slots(layer, state.slots);
+    const int slots = std::min({configured_slots, n_experts, int(state.ranked_experts[layer].size())});
+    const size_t slice_bytes = size_t(expert_stride_bytes);
+    const bool resident_only = q122_r1_resident_only(layer);
+
+    const auto desired_now = q122_dynborrow_desired_layers(state);
+    // max_slots describes the permanent *shape* of this layer's elastic plan.
+    // Physical borrow memory is optional and may be absent at construction time
+    // (for example when the first request is already long). This lets a later
+    // short session allocate the missing extension instead of being stuck at base.
+    const int max_slots = state.borrow_enabled
+        ? std::min({q122_dynborrow_max_slots(state, layer, slots), n_experts, int(state.ranked_experts[layer].size())})
+        : slots;
+    q122_adaptive_init_layer(state, layer, slots, max_slots);
+    const size_t resident_bytes = size_t(slots) * slice_bytes;
+    const size_t borrow_bytes = size_t(std::max(0, max_slots - slots)) * slice_bytes;
+    bool allocate_borrow_now = borrow_bytes > 0 && desired_now[size_t(layer)];
+    size_t cache_bytes = resident_bytes + (allocate_borrow_now ? borrow_bytes : 0);
+    const size_t remaining_budget = state.budget - std::min(state.allocated, state.budget);
+    if (resident_bytes > remaining_budget) {
+        GGML_LOG_WARN("HotExpert cache: budget exhausted before base %s (%zu MiB requested, %zu MiB used)\n",
+                      tensor->name, resident_bytes >> 20, state.allocated >> 20);
+        return nullptr;
+    }
+    if (cache_bytes > remaining_budget) {
+        // The elastic extension is optional; retain its logical shape for later
+        // re-borrow, but do not allocate it under current pressure.
+        allocate_borrow_now = false;
+        cache_bytes = resident_bytes;
+    }
+
+    auto entry = std::make_unique<cache_entry>();
+    entry->bytes = cache_bytes;
+    entry->borrow_bytes = borrow_bytes;
+    entry->slice_bytes = slice_bytes;
+    entry->host_base = tensor->data;
+    entry->n_experts = n_experts;
+    entry->layer = layer;
+    entry->slots = slots;
+    entry->max_slots = max_slots;
+    entry->resident_only = resident_only;
+    entry->borrow_retired = borrow_bytes > 0 && !allocate_borrow_now;
+    cudaError_t error = cudaMalloc(&entry->device_slices, resident_bytes);
+    if (error != cudaSuccess) {
+        GGML_LOG_WARN("HotExpert cache: base device allocation failed for %s: %s\n",
+                      tensor->name, cudaGetErrorString(error));
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    if (allocate_borrow_now) {
+        error = cudaMalloc(&entry->borrow_slices, borrow_bytes);
+        if (error != cudaSuccess) {
+            GGML_LOG_WARN("Q122 DYNBORROW: extension allocation failed for %s (%zu MiB): %s; keeping base and logical reborrow shape\n",
+                          tensor->name, borrow_bytes >> 20, cudaGetErrorString(error));
+            (void) cudaGetLastError();
+            entry->borrow_slices = nullptr;
+            entry->borrow_retired = borrow_bytes > 0;
+            cache_bytes = resident_bytes;
+            entry->bytes = cache_bytes;
+        }
+    }
+    error = cudaMalloc(reinterpret_cast<void **>(&entry->device_table), size_t(n_experts) * sizeof(void *));
+    if (error != cudaSuccess) {
+        GGML_LOG_WARN("HotExpert cache: pointer table allocation failed for %s: %s\n",
+                      tensor->name, cudaGetErrorString(error));
+        if (entry->borrow_slices) (void) cudaFree(entry->borrow_slices);
+        (void) cudaFree(entry->device_slices);
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+
+    // Copy immutable base first. Elastic slices are pre-staged but remain hidden
+    // from both CPU ownership and the GPU pointer table until the next KV safe point.
+    const auto & static_list = q122_adaptive_static_list(state, layer);
+    for (int slot = 0; slot < slots && slot < int(static_list.size()); ++slot) {
+        const int expert = static_list[size_t(slot)];
+        if (expert < 0 || expert >= n_experts) continue;
+        void * destination = static_cast<char *>(entry->device_slices) + size_t(slot) * slice_bytes;
+        const void * source = static_cast<const char *>(tensor->data) + size_t(expert) * slice_bytes;
+        error = cudaMemcpyAsync(destination, source, slice_bytes, cudaMemcpyHostToDevice, stream);
+        if (error != cudaSuccess) goto cache_copy_fail;
+    }
+    if (entry->borrow_slices) {
+        const auto & borrow = q122_adaptive_borrow_list(state, layer);
+        for (int bi = 0; bi < int(borrow.size()) && bi < entry->max_slots - slots; ++bi) {
+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= n_experts) continue;
+            void * destination = static_cast<char *>(entry->borrow_slices) + size_t(bi) * slice_bytes;
+            const void * source = static_cast<const char *>(tensor->data) + size_t(expert) * slice_bytes;
+            error = cudaMemcpyAsync(destination, source, slice_bytes, cudaMemcpyHostToDevice, stream);
+            if (error != cudaSuccess) goto cache_copy_fail;
+        }
+    }
+    {
+        std::vector<const void *> table;
+        q122_dynborrow_build_table(state, *entry, false, table);
+        CUDA_CHECK(cudaMemcpyAsync(entry->device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice, stream));
+    }
+    ggml_hotexpert_q122_borrow_clear(layer);
+    q122_publish_resident_mask(state, layer, false);
+    ggml_hotexpert_q122_set_active_slots(layer, slots);
+    state.allocated += cache_bytes;
+    state.borrow_allocated += entry->borrow_slices ? entry->borrow_bytes : 0;
+    if (entry->borrow_slices) {
+        std::fprintf(stderr,
+            "Q122 DYNBORROW: staged %s layer=%d base=%d max=%d borrow=%.1fMiB rows=%u/%u\n",
+            tensor->name, layer, slots, entry->max_slots, entry->borrow_bytes/1048576.0,
+            state.dyn_rows, state.dyn_logical_rows);
+        std::fflush(stderr);
+    }
+    GGML_LOG_INFO("HotExpert cache: cached %s layer=%d slots=%d max_slots=%d slice=%zu KiB total=%zu MiB resident_only=%d zerocopy_pm=%d\n",
+                  tensor->name, layer, slots, entry->max_slots, slice_bytes >> 10, state.allocated >> 20,
+                  resident_only ? 1 : 0, q122_hybrid_zerocopy_permille());
+    {
+        const void * const * result = entry->device_table;
+        state.entries.emplace(tensor->data, std::move(entry));
+        return result;
+    }
+
+cache_copy_fail:
+    GGML_LOG_WARN("HotExpert cache: slice copy failed for %s: %s\n", tensor->name, cudaGetErrorString(error));
+    (void) cudaFree(entry->device_table);
+    if (entry->borrow_slices) (void) cudaFree(entry->borrow_slices);
+    (void) cudaFree(entry->device_slices);
+    (void) cudaGetLastError();
+    return nullptr;
+}
+
+static bool q122_adaptive_restore_baseline_locked(cache_state & s) {
+    ggml_hotexpert_q122_adaptive_reset();
+    s.adaptive_last_token = 0;
+    for (auto & layer : s.adaptive_score) layer.fill(0);
+    for (auto & v : s.adaptive_static_install_token) std::fill(v.begin(), v.end(), uint64_t(0));
+    for (auto & v : s.adaptive_borrow_install_token) std::fill(v.begin(), v.end(), uint64_t(0));
+    if (!q122_adaptive_borrow_enabled()) return true;
+
+    std::array<bool, MAX_LAYERS> changed{};
+    bool any_copy = false;
+    CUDA_CHECK(cudaSetDevice(s.device));
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        auto & stat = s.adaptive_static_experts[size_t(layer)];
+        const auto & stat_base = s.adaptive_static_baseline[size_t(layer)];
+        auto & borrow = s.adaptive_borrow_experts[size_t(layer)];
+        const auto & borrow_base = s.adaptive_borrow_baseline[size_t(layer)];
+        const bool stat_changed = !stat.empty() && stat != stat_base;
+        const bool borrow_changed = !borrow.empty() && borrow != borrow_base;
+        if (!stat_changed && !borrow_changed) continue;
+
+        bool exposed = false;
+        for (auto & kv : s.entries) {
+            const cache_entry & e = *kv.second;
+            if (e.layer == layer && e.borrow_exposed && e.borrow_slices && !e.borrow_retired) exposed = true;
+        }
+        if (!any_copy) CUDA_CHECK(cudaDeviceSynchronize());
+        any_copy = true;
+
+        if (stat_changed) {
+            for (int si = 0; si < int(stat_base.size()); ++si) {
+                if (si < int(stat.size()) && stat[size_t(si)] == stat_base[size_t(si)]) continue;
+                const int expert = stat_base[size_t(si)];
+                for (auto & kv : s.entries) {
+                    cache_entry & e = *kv.second;
+                    if (e.layer != layer || si >= e.slots || expert < 0 || expert >= e.n_experts) continue;
+                    void * dst = static_cast<char *>(e.device_slices) + size_t(si) * e.slice_bytes;
+                    const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+                    CUDA_CHECK(cudaMemcpy(dst, src, e.slice_bytes, cudaMemcpyHostToDevice));
+                }
+            }
+            stat = stat_base;
+        }
+        if (borrow_changed) {
+            if (exposed) {
+                for (int bi = 0; bi < int(borrow_base.size()); ++bi) {
+                    if (bi < int(borrow.size()) && borrow[size_t(bi)] == borrow_base[size_t(bi)]) continue;
+                    const int expert = borrow_base[size_t(bi)];
+                    for (auto & kv : s.entries) {
+                        cache_entry & e = *kv.second;
+                        if (e.layer != layer || !e.borrow_exposed || !e.borrow_slices || e.borrow_retired) continue;
+                        if (bi >= e.max_slots - e.slots || expert < 0 || expert >= e.n_experts) continue;
+                        void * dst = static_cast<char *>(e.borrow_slices) + size_t(bi) * e.slice_bytes;
+                        const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+                        CUDA_CHECK(cudaMemcpy(dst, src, e.slice_bytes, cudaMemcpyHostToDevice));
+                    }
+                }
+            }
+            borrow = borrow_base;
+        }
+        changed[size_t(layer)] = true;
+    }
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!changed[size_t(layer)]) continue;
+        bool exposed = false;
+        for (auto & kv : s.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != layer) continue;
+            exposed = exposed || e.borrow_exposed;
+            std::vector<const void *> table;
+            q122_dynborrow_build_table(s, e, e.borrow_exposed, table);
+            CUDA_CHECK(cudaMemcpy(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        }
+        q122_publish_borrow_mask(s, layer, exposed);
+        q122_publish_resident_mask(s, layer, exposed);
+    }
+    if (any_copy) CUDA_CHECK(cudaDeviceSynchronize());
+    if (std::any_of(changed.begin(), changed.end(), [](bool v) { return v; })) {
+        std::fprintf(stderr, "Q122 ADAPT: session-reset restored historical Static/Borrow baseline\n");
+        std::fflush(stderr);
+    }
+    return true;
+}
+
+bool ggml_cuda_hotexpert_cache_adapt(uint64_t token) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !q122_adaptive_borrow_enabled()) return true;
+
+    const bool fast = token <= uint64_t(q122_adaptive_fast_until());
+    const int interval = fast ? q122_adaptive_fast_interval() : q122_adaptive_interval();
+    const int max_swaps = fast ? q122_adaptive_fast_swaps() : q122_adaptive_max_swaps();
+    if (token < uint64_t(interval) || (token % uint64_t(interval)) != 0 || state.adaptive_last_token == token) return true;
+    state.adaptive_last_token = token;
+
+    struct proposal {
+        int layer = -1;
+        bool is_static = false;
+        int index = -1;
+        int old_expert = -1;
+        int new_expert = -1;
+        uint32_t old_hits = 0;
+        uint32_t new_hits = 0;
+        uint32_t old_score = 0;
+        uint32_t new_score = 0;
+        int gain = 0;
+        size_t bytes = 0;
+    };
+    std::vector<proposal> props;
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        uint32_t hits[256] = {};
+        const int n = ggml_hotexpert_q122_adaptive_snapshot(layer, hits, 256, 1);
+        if (n <= 0) continue;
+
+        // EWMA in "window-hit" units: score = 0.75 * previous + current.
+        // During fast-start, add one extra current window when ranking so a new
+        // task can displace a stale historical hot-set within a few windows.
+        auto & score = state.adaptive_score[size_t(layer)];
+        for (int e = 0; e < n; ++e) {
+            const uint64_t decayed = (uint64_t(score[size_t(e)]) * 3u) / 4u;
+            score[size_t(e)] = uint32_t(std::min<uint64_t>(UINT32_MAX, decayed + hits[e]));
+        }
+        auto metric = [&](int e) -> uint32_t {
+            if (e < 0 || e >= n) return 0;
+            const uint64_t m = uint64_t(score[size_t(e)]) + (fast ? uint64_t(hits[e]) : 0u);
+            return uint32_t(std::min<uint64_t>(UINT32_MAX, m));
+        };
+
+        int entries = 0;
+        int base_slots = -1;
+        int max_slots = -1;
+        bool borrow_exposed = false;
+        size_t expert_bytes = 0;
+        for (auto & kv : state.entries) {
+            const cache_entry & e = *kv.second;
+            if (e.layer != layer) continue;
+            ++entries;
+            if (base_slots < 0) { base_slots = e.slots; max_slots = e.max_slots; }
+            if (e.slots != base_slots || e.max_slots != max_slots) { entries = 0; break; }
+            borrow_exposed = borrow_exposed || (e.borrow_exposed && e.borrow_slices && !e.borrow_retired);
+            expert_bytes += e.slice_bytes;
+        }
+        if (entries < 3 || base_slots <= 0) continue;
+        q122_adaptive_init_layer(state, layer, base_slots, std::max(base_slots, max_slots));
+        auto & stat = state.adaptive_static_experts[size_t(layer)];
+        auto & borrow = state.adaptive_borrow_experts[size_t(layer)];
+        auto & stat_age = state.adaptive_static_install_token[size_t(layer)];
+        auto & borrow_age = state.adaptive_borrow_install_token[size_t(layer)];
+        if (int(stat.size()) != base_slots) continue;
+
+        std::array<bool, 256> owned{};
+        for (int e : stat) if (e >= 0 && e < 256) owned[size_t(e)] = true;
+        if (borrow_exposed) for (int e : borrow) if (e >= 0 && e < 256) owned[size_t(e)] = true;
+
+        const uint64_t min_res = uint64_t(q122_adaptive_min_residency());
+        auto old_enough = [&](uint64_t installed) {
+            return installed == 0 || token >= installed + min_res;
+        };
+
+        bool victim_static = false;
+        int victim_i = -1;
+        uint32_t victim_metric = UINT32_MAX;
+        const int tail = q122_adaptive_static_tail_slots(base_slots);
+        const int static_begin = base_slots - tail;
+        for (int si = static_begin; si < base_slots; ++si) {
+            if (si >= int(stat_age.size()) || !old_enough(stat_age[size_t(si)])) continue;
+            const int e = stat[size_t(si)];
+            const uint32_t m = metric(e);
+            if (victim_i < 0 || m < victim_metric) {
+                victim_static = true; victim_i = si; victim_metric = m;
+            }
+        }
+        if (borrow_exposed) {
+            for (int bi = 0; bi < int(borrow.size()); ++bi) {
+                if (bi >= int(borrow_age.size()) || !old_enough(borrow_age[size_t(bi)])) continue;
+                const int e = borrow[size_t(bi)];
+                const uint32_t m = metric(e);
+                if (victim_i < 0 || m < victim_metric) {
+                    victim_static = false; victim_i = bi; victim_metric = m;
+                }
+            }
+        }
+        if (victim_i < 0) continue;
+
+        int cand = -1;
+        uint32_t cand_metric = 0;
+        for (int e = 0; e < n; ++e) {
+            if (owned[size_t(e)]) continue;
+            const uint32_t m = metric(e);
+            if (m > cand_metric) { cand = e; cand_metric = m; }
+        }
+        if (cand < 0 || int(hits[cand]) < q122_adaptive_min_hits()) continue;
+        if (uint64_t(cand_metric) < uint64_t(victim_metric) + uint64_t(q122_adaptive_margin())) continue;
+        const int old = victim_static ? stat[size_t(victim_i)] : borrow[size_t(victim_i)];
+        props.push_back({layer, victim_static, victim_i, old, cand,
+                         old >= 0 && old < n ? hits[old] : 0, hits[cand],
+                         victim_metric, cand_metric, int(cand_metric) - int(victim_metric), expert_bytes});
+    }
+
+    std::stable_sort(props.begin(), props.end(), [](const proposal & a, const proposal & b) {
+        if (a.gain != b.gain) return a.gain > b.gain;
+        if (a.new_score != b.new_score) return a.new_score > b.new_score;
+        return a.layer < b.layer;
+    });
+    if (props.empty()) {
+        std::fprintf(stderr, "Q122 ADAPT3: token=%llu mode=%s window=%d no-profitable-swap\n",
+            (unsigned long long) token, fast ? "fast" : "steady", interval);
+        std::fflush(stderr);
+        return true;
+    }
+    if (int(props.size()) > max_swaps) props.resize(size_t(max_swaps));
+
+    CUDA_CHECK(cudaSetDevice(state.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    std::array<bool, MAX_LAYERS> changed{};
+    uint64_t window_bytes = 0;
+    size_t applied = 0;
+    for (const proposal & pr : props) {
+        auto & stat = state.adaptive_static_experts[size_t(pr.layer)];
+        auto & borrow = state.adaptive_borrow_experts[size_t(pr.layer)];
+        auto & stat_age = state.adaptive_static_install_token[size_t(pr.layer)];
+        auto & borrow_age = state.adaptive_borrow_install_token[size_t(pr.layer)];
+        if (pr.is_static) {
+            if (pr.index < 0 || pr.index >= int(stat.size()) || stat[size_t(pr.index)] != pr.old_expert) continue;
+        } else {
+            if (pr.index < 0 || pr.index >= int(borrow.size()) || borrow[size_t(pr.index)] != pr.old_expert) continue;
+        }
+        bool copied = false;
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != pr.layer || pr.new_expert < 0 || pr.new_expert >= e.n_experts) continue;
+            void * dst = nullptr;
+            if (pr.is_static) {
+                if (pr.index >= e.slots) continue;
+                dst = static_cast<char *>(e.device_slices) + size_t(pr.index) * e.slice_bytes;
+            } else {
+                if (!e.borrow_exposed || !e.borrow_slices || e.borrow_retired || pr.index >= e.max_slots - e.slots) continue;
+                dst = static_cast<char *>(e.borrow_slices) + size_t(pr.index) * e.slice_bytes;
+            }
+            const void * src = static_cast<const char *>(e.host_base) + size_t(pr.new_expert) * e.slice_bytes;
+            CUDA_CHECK(cudaMemcpy(dst, src, e.slice_bytes, cudaMemcpyHostToDevice));
+            copied = true;
+        }
+        if (!copied) continue;
+        if (pr.is_static) {
+            stat[size_t(pr.index)] = pr.new_expert;
+            if (pr.index < int(stat_age.size())) stat_age[size_t(pr.index)] = token;
+        } else {
+            borrow[size_t(pr.index)] = pr.new_expert;
+            if (pr.index < int(borrow_age.size())) borrow_age[size_t(pr.index)] = token;
+        }
+        changed[size_t(pr.layer)] = true;
+        window_bytes += pr.bytes;
+        ++applied;
+        ++state.adaptive_swaps;
+        state.adaptive_h2d_bytes += pr.bytes;
+        std::fprintf(stderr,
+            "Q122 ADAPT3: token=%llu mode=%s layer=%d bank=%s slot=%d old=%d h=%u s=%u new=%d h=%u s=%u gain=%d h2d=%.1fMiB\n",
+            (unsigned long long) token, fast ? "fast" : "steady", pr.layer,
+            pr.is_static ? "static-tail" : "borrow", pr.index,
+            pr.old_expert, pr.old_hits, pr.old_score, pr.new_expert, pr.new_hits, pr.new_score,
+            pr.gain, pr.bytes/1048576.0);
+    }
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!changed[size_t(layer)]) continue;
+        bool exposed = false;
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != layer) continue;
+            exposed = exposed || e.borrow_exposed;
+            std::vector<const void *> table;
+            q122_dynborrow_build_table(state, e, e.borrow_exposed, table);
+            CUDA_CHECK(cudaMemcpy(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        }
+        q122_publish_borrow_mask(state, layer, exposed);
+        q122_publish_resident_mask(state, layer, exposed);
+    }
+    CUDA_CHECK(cudaDeviceSynchronize());
+    std::fprintf(stderr,
+        "Q122 ADAPT3: token=%llu mode=%s applied=%zu window=%d window_h2d=%.1fMiB total_swaps=%llu total_h2d=%.1fMiB static_tail=%d min_res=%d\n",
+        (unsigned long long) token, fast ? "fast" : "steady", applied, interval,
+        window_bytes/1048576.0, (unsigned long long) state.adaptive_swaps,
+        state.adaptive_h2d_bytes/1048576.0, q122_adaptive_static_tail_slots(32), q122_adaptive_min_residency());
+    std::fflush(stderr);
+    return true;
+}
+
+bool ggml_cuda_hotexpert_cache_seed_prefill(const uint64_t * hits, int n_layers, int n_experts, int stride) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!hits || n_layers <= 0 || n_experts <= 0 || stride < n_experts ||
+        !state.enabled || !q122_adaptive_borrow_enabled()) return true;
+
+    uint64_t observed_routes = 0;
+    const int observed_layers = std::min(n_layers, MAX_LAYERS);
+    const int observed_experts = std::min(n_experts, 256);
+    for (int layer = 0; layer < observed_layers; ++layer) {
+        const uint64_t * lh = hits + size_t(layer) * size_t(stride);
+        for (int e = 0; e < observed_experts; ++e) observed_routes += lh[e];
+    }
+    uint64_t min_routes = 16384;
+    if (const char * v = std::getenv("Q122_ADAPTIVE_PREFILL_MIN_ROUTES")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) min_routes = x;
+    }
+    if (observed_routes < min_routes) {
+        ggml_hotexpert_q122_adaptive_reset();
+        std::fprintf(stderr, "Q122 PREFILL_SEED: skipped routes=%llu min=%llu\n",
+            (unsigned long long) observed_routes, (unsigned long long) min_routes);
+        std::fflush(stderr);
+        return true;
+    }
+
+    int max_swaps = 512;
+    if (const char * v = std::getenv("Q122_ADAPTIVE_PREFILL_MAX_SWAPS")) {
+        const int x = std::atoi(v);
+        if (x > 0) max_swaps = std::clamp(x, 1, 2048);
+    }
+
+    struct seed_prop {
+        int layer = -1;
+        bool is_static = false;
+        int slot = -1;
+        int old_expert = -1;
+        int new_expert = -1;
+        uint64_t old_hits = 0;
+        uint64_t new_hits = 0;
+        size_t bytes = 0;
+        double efficiency = 0.0;
+    };
+    std::vector<seed_prop> props;
+    props.reserve(2048);
+    std::array<bool, MAX_LAYERS> borrow_exposed_by_layer{};
+    std::array<bool, MAX_LAYERS> layer_valid{};
+    uint64_t total_routes = 0, before_hits = 0;
+
+    CUDA_CHECK(cudaSetDevice(state.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+
+    const int layers = std::min(n_layers, MAX_LAYERS);
+    const int experts = std::min(n_experts, 256);
+
+    // V8: build the desired resident SET per layer first. Experts already in the
+    // desired mutable set stay exactly where they are. Only true membership
+    // changes become copy proposals. This avoids spending PCIe bandwidth merely
+    // reordering the same resident experts and makes a global swap cap meaningful.
+    for (int layer = 0; layer < layers; ++layer) {
+        int entries = 0, base_slots = -1, max_slots = -1;
+        bool borrow_exposed = false;
+        size_t expert_bytes = 0;
+        for (auto & kv : state.entries) {
+            const cache_entry & ce = *kv.second;
+            if (ce.layer != layer) continue;
+            ++entries;
+            if (base_slots < 0) { base_slots = ce.slots; max_slots = ce.max_slots; }
+            if (ce.slots != base_slots || ce.max_slots != max_slots) { entries = 0; break; }
+            borrow_exposed = borrow_exposed || (ce.borrow_exposed && ce.borrow_slices && !ce.borrow_retired);
+            expert_bytes += ce.slice_bytes;
+        }
+        if (entries < 3 || base_slots <= 0) continue;
+        q122_adaptive_init_layer(state, layer, base_slots, std::max(base_slots, max_slots));
+        auto & stat = state.adaptive_static_experts[size_t(layer)];
+        auto & borrow = state.adaptive_borrow_experts[size_t(layer)];
+        if (int(stat.size()) != base_slots) continue;
+
+        layer_valid[size_t(layer)] = true;
+        borrow_exposed_by_layer[size_t(layer)] = borrow_exposed;
+        const uint64_t * lh = hits + size_t(layer) * size_t(stride);
+        for (int e = 0; e < experts; ++e) total_routes += lh[e];
+        for (int e : stat) if (e >= 0 && e < experts) before_hits += lh[e];
+        if (borrow_exposed) for (int e : borrow) if (e >= 0 && e < experts) before_hits += lh[e];
+
+        const int tail = q122_adaptive_static_tail_slots(base_slots);
+        const int fixed_count = base_slots - tail;
+        std::array<bool, 256> fixed{};
+        for (int i = 0; i < fixed_count; ++i) {
+            const int e = stat[size_t(i)];
+            if (e >= 0 && e < experts) fixed[size_t(e)] = true;
+        }
+
+        struct pos { bool is_static; int slot; int expert; };
+        std::vector<pos> mutable_pos;
+        mutable_pos.reserve(size_t(tail) + (borrow_exposed ? borrow.size() : 0));
+        for (int si = fixed_count; si < base_slots; ++si) {
+            mutable_pos.push_back({true, si, stat[size_t(si)]});
+        }
+        if (borrow_exposed) {
+            for (int bi = 0; bi < int(borrow.size()); ++bi) {
+                mutable_pos.push_back({false, bi, borrow[size_t(bi)]});
+            }
+        }
+        const int mutable_count = int(mutable_pos.size());
+        if (mutable_count <= 0) continue;
+
+        std::array<bool, 256> current{};
+        for (const auto & p0 : mutable_pos) {
+            if (p0.expert >= 0 && p0.expert < experts) current[size_t(p0.expert)] = true;
+        }
+
+        std::vector<int> desired_list;
+        desired_list.reserve(experts);
+        for (int e = 0; e < experts; ++e) if (!fixed[size_t(e)]) desired_list.push_back(e);
+        std::stable_sort(desired_list.begin(), desired_list.end(), [&](int a, int b) {
+            if (lh[a] != lh[b]) return lh[a] > lh[b];
+            return a < b;
+        });
+        if (int(desired_list.size()) > mutable_count) desired_list.resize(size_t(mutable_count));
+
+        std::array<bool, 256> desired{};
+        for (int e : desired_list) desired[size_t(e)] = true;
+
+        std::vector<int> missing;
+        for (int e : desired_list) if (!current[size_t(e)]) missing.push_back(e);
+        std::vector<pos> evict;
+        for (const auto & p0 : mutable_pos) {
+            if (p0.expert < 0 || p0.expert >= experts || !desired[size_t(p0.expert)]) evict.push_back(p0);
+        }
+        // In a clean resident set these are equal. Be conservative if an older
+        // experimental partial seed left duplicates.
+        const size_t np = std::min(missing.size(), evict.size());
+        missing.resize(np);
+        evict.resize(np);
+        std::stable_sort(missing.begin(), missing.end(), [&](int a, int b) {
+            if (lh[a] != lh[b]) return lh[a] > lh[b];
+            return a < b;
+        });
+        std::stable_sort(evict.begin(), evict.end(), [&](const pos & a, const pos & b) {
+            const uint64_t ha = (a.expert >= 0 && a.expert < experts) ? lh[a.expert] : 0;
+            const uint64_t hb = (b.expert >= 0 && b.expert < experts) ? lh[b.expert] : 0;
+            if (ha != hb) return ha < hb;
+            // Prefer replacing elastic Borrow before persistent Static-tail on ties.
+            if (a.is_static != b.is_static) return !a.is_static;
+            return a.slot < b.slot;
+        });
+
+        for (size_t i = 0; i < np; ++i) {
+            const int ne = missing[i];
+            const int oe = evict[i].expert;
+            const uint64_t nh = lh[ne];
+            const uint64_t oh = (oe >= 0 && oe < experts) ? lh[oe] : 0;
+            if (nh <= oh) continue;
+            seed_prop pr;
+            pr.layer = layer;
+            pr.is_static = evict[i].is_static;
+            pr.slot = evict[i].slot;
+            pr.old_expert = oe;
+            pr.new_expert = ne;
+            pr.old_hits = oh;
+            pr.new_hits = nh;
+            pr.bytes = std::max<size_t>(expert_bytes, 1);
+            pr.efficiency = double(nh - oh) / double(pr.bytes);
+            props.push_back(pr);
+        }
+    }
+
+    // Global ranking: a cap of 256 now means the best 256 true membership
+    // changes across ALL layers, not "whatever layer 0..N happened to consume first".
+    std::stable_sort(props.begin(), props.end(), [](const seed_prop & a, const seed_prop & b) {
+        if (a.efficiency != b.efficiency) return a.efficiency > b.efficiency;
+        const uint64_t ga = a.new_hits - a.old_hits;
+        const uint64_t gb = b.new_hits - b.old_hits;
+        if (ga != gb) return ga > gb;
+        if (a.layer != b.layer) return a.layer < b.layer;
+        if (a.is_static != b.is_static) return !a.is_static;
+        return a.slot < b.slot;
+    });
+
+    int applied = 0;
+    uint64_t h2d_bytes = 0;
+    std::array<bool, MAX_LAYERS> changed{};
+    for (const seed_prop & pr : props) {
+        if (applied >= max_swaps) break;
+        auto & stat = state.adaptive_static_experts[size_t(pr.layer)];
+        auto & borrow = state.adaptive_borrow_experts[size_t(pr.layer)];
+        int * slot_ptr = nullptr;
+        if (pr.is_static) {
+            if (pr.slot < 0 || pr.slot >= int(stat.size())) continue;
+            slot_ptr = &stat[size_t(pr.slot)];
+        } else {
+            if (pr.slot < 0 || pr.slot >= int(borrow.size()) || !borrow_exposed_by_layer[size_t(pr.layer)]) continue;
+            slot_ptr = &borrow[size_t(pr.slot)];
+        }
+        if (*slot_ptr != pr.old_expert) continue;
+
+        size_t copied = 0;
+        for (auto & kv : state.entries) {
+            cache_entry & ce = *kv.second;
+            if (ce.layer != pr.layer || pr.new_expert < 0 || pr.new_expert >= ce.n_experts) continue;
+            if (pr.is_static) {
+                if (pr.slot >= ce.slots) continue;
+                void * dst = static_cast<char *>(ce.device_slices) + size_t(pr.slot) * ce.slice_bytes;
+                const void * src = static_cast<const char *>(ce.host_base) + size_t(pr.new_expert) * ce.slice_bytes;
+                CUDA_CHECK(cudaMemcpy(dst, src, ce.slice_bytes, cudaMemcpyHostToDevice));
+                copied += ce.slice_bytes;
+            } else {
+                if (!ce.borrow_exposed || !ce.borrow_slices || ce.borrow_retired ||
+                    pr.slot >= ce.max_slots - ce.slots) continue;
+                void * dst = static_cast<char *>(ce.borrow_slices) + size_t(pr.slot) * ce.slice_bytes;
+                const void * src = static_cast<const char *>(ce.host_base) + size_t(pr.new_expert) * ce.slice_bytes;
+                CUDA_CHECK(cudaMemcpy(dst, src, ce.slice_bytes, cudaMemcpyHostToDevice));
+                copied += ce.slice_bytes;
+            }
+        }
+        *slot_ptr = pr.new_expert;
+        ++applied;
+        h2d_bytes += copied;
+        changed[size_t(pr.layer)] = true;
+    }
+
+    for (int layer = 0; layer < layers; ++layer) {
+        if (!changed[size_t(layer)]) continue;
+        bool exposed = false;
+        for (auto & kv : state.entries) {
+            cache_entry & ce = *kv.second;
+            if (ce.layer != layer) continue;
+            exposed = exposed || ce.borrow_exposed;
+            std::vector<const void *> table;
+            q122_dynborrow_build_table(state, ce, ce.borrow_exposed, table);
+            CUDA_CHECK(cudaMemcpy(ce.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        }
+        q122_publish_borrow_mask(state, layer, exposed);
+        q122_publish_resident_mask(state, layer, exposed);
+    }
+    CUDA_CHECK(cudaDeviceSynchronize());
+
+    uint64_t after_hits = 0;
+    for (int layer = 0; layer < layers; ++layer) {
+        if (!layer_valid[size_t(layer)]) continue;
+        const uint64_t * lh = hits + size_t(layer) * size_t(stride);
+        auto & stat = state.adaptive_static_experts[size_t(layer)];
+        auto & borrow = state.adaptive_borrow_experts[size_t(layer)];
+        for (int e : stat) if (e >= 0 && e < experts) after_hits += lh[e];
+        if (borrow_exposed_by_layer[size_t(layer)]) {
+            for (int e : borrow) if (e >= 0 && e < experts) after_hits += lh[e];
+        }
+    }
+
+    ggml_hotexpert_q122_adaptive_reset();
+    for (auto & layer : state.adaptive_score) layer.fill(0);
+    for (auto & v : state.adaptive_static_install_token) std::fill(v.begin(), v.end(), uint64_t(0));
+    for (auto & v : state.adaptive_borrow_install_token) std::fill(v.begin(), v.end(), uint64_t(0));
+    state.adaptive_last_token = 0;
+
+    const double before_pct = total_routes ? 100.0 * double(before_hits) / double(total_routes) : 0.0;
+    const double after_pct  = total_routes ? 100.0 * double(after_hits) / double(total_routes) : 0.0;
+    std::fprintf(stderr,
+        "Q122 PREFILL_SEED_V8: swaps=%d proposals=%zu h2d=%.1fMiB routes=%llu resident_before=%.2f%% resident_after=%.2f%% cap=%d\n",
+        applied, props.size(), h2d_bytes/1048576.0, (unsigned long long) total_routes,
+        before_pct, after_pct, max_swaps);
+    std::fflush(stderr);
+    return true;
+}
+
+bool ggml_cuda_hotexpert_cache_seed_adaptive_counts(int n_layers, int n_experts) {
+    const int layers = std::min(n_layers, MAX_LAYERS);
+    const int experts = std::min(n_experts, 256);
+    if (layers <= 0 || experts <= 0) return true;
+    std::vector<uint64_t> hits(size_t(layers) * 256, 0);
+    for (int layer = 0; layer < layers; ++layer) {
+        uint32_t tmp[256] = {};
+        const int n = ggml_hotexpert_q122_adaptive_snapshot(layer, tmp, experts, 0);
+        for (int e = 0; e < n; ++e) hits[size_t(layer) * 256 + size_t(e)] = tmp[e];
+    }
+    return ggml_cuda_hotexpert_cache_seed_prefill(hits.data(), layers, experts, 256);
+}
+
+bool ggml_cuda_hotexpert_cache_prepare_kv_rows(uint32_t rows, uint32_t logical_rows) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    const uint32_t prev_rows = state.dyn_rows;
+    state.dyn_rows = rows;
+    state.dyn_logical_rows = logical_rows;
+    if (!state.enabled || !state.borrow_enabled) return true;
+    // A large-PP suspend owns the elastic-bank state until the final PP boundary.
+    // Context trimming/LCP changes can make rows temporarily shrink between requests;
+    // that must not be mistaken for permission to re-borrow all experts mid-prefill.
+    if (state.large_pp_suspended) return true;
+    if (rows == 0 && q122_adaptive_borrow_enabled()) {
+        if (!q122_adaptive_restore_baseline_locked(state)) return false;
+    }
+
+    const auto desired = q122_dynborrow_desired_layers(state);
+    // KV growth is monotonic within a live prompt. During growth, elastic experts
+    // are allowed to REPAY only. Re-borrowing on temporary free-VRAM spikes caused
+    // a 204 MiB layer to ping-pong 80->144->80 inside one tiny prompt, adding
+    // seconds of H2D + device-wide synchronization. Reborrow only for the initial
+    // balance, a real context shrink, or a session reset.
+    const bool allow_reborrow = !state.borrow_seeded || rows == 0 || rows < prev_rows;
+
+    // Repay first. This function is called before VMM allocates the new KV pages.
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        bool exposed = false;
+        for (auto & kv : state.entries) {
+            if (kv.second->layer == layer && kv.second->borrow_exposed) { exposed = true; break; }
+        }
+        if (exposed && !desired[size_t(layer)]) {
+            if (!q122_dynborrow_set_layer(state, layer, false)) return false;
+        }
+    }
+
+    int borrow_shapes = 0;
+    if (allow_reborrow) {
+        // Expose high-value borrow chunks only when context demand actually fell
+        // (or during the first balance). This adds hysteresis for the 400-600 MiB
+        // target despite Ornith's ~204 MiB whole-layer borrow granularity.
+        for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+            int base = 0, max_slots = 0; size_t bytes = 0;
+            if (!q122_dynborrow_layer_shape(state, layer, base, max_slots, bytes)) continue;
+            ++borrow_shapes;
+            if (!desired[size_t(layer)]) continue;
+            bool exposed = false;
+            for (auto & kv : state.entries) {
+                if (kv.second->layer != layer) continue;
+                exposed = exposed || kv.second->borrow_exposed;
+            }
+            if (!exposed) {
+                if (!q122_dynborrow_set_layer(state, layer, true)) return false;
+            }
+        }
+    }
+    if (!state.borrow_seeded && borrow_shapes > 0) {
+        state.borrow_seeded = true;
+        std::fprintf(stderr, "Q122 DYNBORROW: initial balance seeded at rows=%u\n", rows);
+        std::fflush(stderr);
+    }
+    return true;
+}
+
+
+static bool q122_large_pp_pipelined() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("Q122_LARGE_PP_PIPELINED");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static size_t q122_large_pp_prefetch_headroom_bytes() {
+    size_t mib = 2048;
+    if (const char * v = std::getenv("Q122_LARGE_PP_PREFETCH_HEADROOM_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) mib = size_t(x);
+    }
+    return mib << 20;
+}
+
+static cudaStream_t q122_large_pp_prefetch_stream_locked(cache_state & s) {
+    if (!s.large_pp_prefetch_stream) {
+        CUDA_CHECK(cudaSetDevice(s.device));
+        CUDA_CHECK(cudaStreamCreateWithFlags(&s.large_pp_prefetch_stream, cudaStreamNonBlocking));
+    }
+    return s.large_pp_prefetch_stream;
+}
+
+static void q122_large_pp_cancel_prefetch_locked(cache_state & s, const char * reason) {
+    if (!s.large_pp_prefetch_bytes) return;
+    CUDA_CHECK(cudaSetDevice(s.device));
+    if (s.large_pp_prefetch_stream && s.large_pp_prefetch_queued) {
+        CUDA_CHECK(cudaStreamSynchronize(s.large_pp_prefetch_stream));
+    }
+    size_t freed = 0;
+    for (auto & kv : s.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.prefetch_slices) continue;
+        CUDA_CHECK(cudaFree(e.prefetch_slices));
+        e.prefetch_slices = nullptr;
+        freed += e.borrow_bytes;
+        s.allocated -= std::min(s.allocated, e.borrow_bytes);
+    }
+    s.large_pp_prefetch_layers.fill(false);
+    s.large_pp_prefetch_queued = false;
+    s.large_pp_prefetch_bytes = 0;
+    std::fprintf(stderr, "Q122 LARGE_PP: prefetch canceled reason=%s freed=%.1fMiB\n",
+        reason ? reason : "unknown", freed/1048576.0);
+    std::fflush(stderr);
+}
+
+extern "C" bool ggml_backend_cuda_q122_dynborrow_reserve_bytes(size_t bytes) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !state.borrow_enabled || bytes == 0) return true;
+
+    CUDA_CHECK(cudaSetDevice(state.device));
+    size_t free_now = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_now, &total_now);
+
+    size_t low_mib = 400;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_LOW_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    } else if (const char * v = std::getenv("Q122_DYNKV_VRAM_RESERVE_MB")) {
+        const unsigned long long x = std::strtoull(v, nullptr, 10);
+        if (x > 0) low_mib = size_t(x);
+    }
+    size_t effective_low_mib = low_mib;
+    if (const char * v = std::getenv("Q122_DYNKV_VRAM_GROWTH_GUARD_MB")) {
+        const unsigned long long guard = std::strtoull(v, nullptr, 10);
+        if (guard > 0 && state.dyn_logical_rows > state.dyn_initial_rows && state.dyn_rows > state.dyn_initial_rows) {
+            const uint64_t span = uint64_t(state.dyn_logical_rows) - state.dyn_initial_rows;
+            const uint64_t grown = std::min<uint64_t>(state.dyn_rows, state.dyn_logical_rows) - state.dyn_initial_rows;
+            effective_low_mib += size_t((guard * grown) / std::max<uint64_t>(1, span));
+        }
+    }
+    const size_t low_bytes = effective_low_mib << 20;
+    // Tail-prefetch memory is speculative and not visible to decode yet. If KV growth
+    // unexpectedly needs that headroom, cancel staging first rather than risking the
+    // low-water invariant or freeing a buffer while H2D is still in flight.
+    if (free_now < bytes + low_bytes && state.large_pp_prefetch_bytes > 0) {
+        q122_large_pp_cancel_prefetch_locked(state, "kv-reserve");
+        (void) cudaMemGetInfo(&free_now, &total_now);
+    }
+    if (free_now >= bytes + low_bytes) return true;
+
+    struct victim { int layer; double utility; size_t bytes; };
+    std::vector<victim> victims;
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        bool physical = false;
+        size_t layer_bytes = 0;
+        for (const auto & kv : state.entries) {
+            const cache_entry & e = *kv.second;
+            if (e.layer != layer || !e.borrow_slices) continue;
+            physical = true;
+            layer_bytes += e.borrow_bytes;
+        }
+        if (physical && layer_bytes) victims.push_back({layer, q122_dynborrow_utility(state, layer), layer_bytes});
+    }
+    // Lowest-value elastic layers are repaid first. Base resident slices never
+    // move, so the operation is deterministic and decode-correct.
+    std::stable_sort(victims.begin(), victims.end(), [](const victim & a, const victim & b) {
+        if (a.utility != b.utility) return a.utility < b.utility;
+        return a.layer > b.layer;
+    });
+
+    size_t repaid = 0;
+    for (const auto & v : victims) {
+        if (free_now >= bytes + low_bytes) break;
+        if (!q122_dynborrow_set_layer(state, v.layer, false)) return false;
+        repaid += v.bytes;
+        (void) cudaMemGetInfo(&free_now, &total_now);
+    }
+
+    const bool ok = free_now >= bytes + low_bytes;
+    std::fprintf(stderr,
+        "Q122 DYNBORROW_RESERVE: need=%.1fMiB repaid=%.1fMiB free=%.1fMiB low=%zuMiB effective_low=%zuMiB ok=%d rows=%u/%u\n",
+        bytes/1048576.0, repaid/1048576.0, free_now/1048576.0, low_mib, effective_low_mib, ok ? 1 : 0,
+        state.dyn_rows, state.dyn_logical_rows);
+    std::fflush(stderr);
+    return ok;
+}
+
+
+bool ggml_cuda_hotexpert_pp_stream_reclaim(const ggml_tensor * weight, const ggml_tensor * ids) {
+    static const int min_tokens = [] {
+        const char * enabled = std::getenv("Q122_PP_STREAM_GPU");
+        const char * reclaim = std::getenv("Q122_PP_STREAM_RECLAIM");
+        if (!enabled || std::strcmp(enabled, "1") != 0 || !reclaim || std::strcmp(reclaim, "1") != 0) return 0;
+        const char * value = std::getenv("Q122_PP_STREAM_MIN_TOKENS");
+        return value ? std::max(2, std::atoi(value)) : 128;
+    }();
+    return min_tokens > 0 && weight && ids && ids->ne[1] >= min_tokens &&
+        weight->type == GGML_TYPE_Q8_0 && ggml_is_contiguous(weight) &&
+        weight->buffer && ggml_backend_buffer_is_host(weight->buffer);
+}
+
+void * ggml_cuda_hotexpert_pp_stream_staging(size_t bytes, int device) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    CUDA_CHECK(cudaSetDevice(device));
+    if (state.pp_stream_staging && (state.pp_stream_staging_device != device || state.pp_stream_staging_bytes < bytes)) {
+        CUDA_CHECK(cudaSetDevice(state.pp_stream_staging_device));
+        CUDA_CHECK(cudaFree(state.pp_stream_staging));
+        state.pp_stream_staging = nullptr;
+        state.pp_stream_staging_bytes = 0;
+        CUDA_CHECK(cudaSetDevice(device));
+    }
+    if (!state.pp_stream_staging) {
+        CUDA_CHECK(cudaMalloc(&state.pp_stream_staging, bytes));
+        state.pp_stream_staging_bytes = bytes;
+        state.pp_stream_staging_device = device;
+    }
+    return state.pp_stream_staging;
+}
+
+extern "C" bool ggml_backend_cuda_q122_large_pp_suspend(void) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !state.borrow_enabled || state.large_pp_suspended || state.entries.empty()) return true;
+
+    if (state.large_pp_prefetch_bytes > 0) {
+        q122_large_pp_cancel_prefetch_locked(state, "new-large-pp");
+    }
+    CUDA_CHECK(cudaSetDevice(state.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+
+    size_t free_before = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_before, &total_now);
+    size_t freed = 0;
+    std::array<bool, MAX_LAYERS> touched{};
+
+    // First publish base-only pointer tables. No compute is in flight at this server
+    // boundary, but keep a single device sync above rather than one sync per layer.
+    for (auto & kv : state.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.borrow_slices && !e.borrow_exposed) continue;
+        std::vector<const void *> table;
+        q122_dynborrow_build_table(state, e, false, table);
+        CUDA_CHECK(cudaMemcpy(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice));
+        e.borrow_exposed = false;
+        if (e.layer >= 0 && e.layer < MAX_LAYERS) touched[size_t(e.layer)] = true;
+    }
+
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!touched[size_t(layer)]) continue;
+        q122_publish_borrow_mask(state, layer, false);
+        q122_publish_resident_mask(state, layer, false);
+        const int base = ggml_hotexpert_q122_static_slots(layer, state.slots);
+        ggml_hotexpert_q122_set_active_slots(layer, base);
+    }
+
+    // Now release every elastic allocation. Base resident slices stay warm, so
+    // decode correctness never depends on a costly full cache rebuild.
+    for (auto & kv : state.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.borrow_slices) continue;
+        CUDA_CHECK(cudaFree(e.borrow_slices));
+        e.borrow_slices = nullptr;
+        e.borrow_retired = e.borrow_bytes > 0;
+        freed += e.borrow_bytes;
+        state.allocated -= std::min(state.allocated, e.borrow_bytes);
+        state.borrow_allocated -= std::min(state.borrow_allocated, e.borrow_bytes);
+    }
+
+    state.large_pp_suspended = true;
+    // The next explicit resume chooses a fresh high-value set from the current
+    // free-VRAM budget. Ordinary KV growth still remains repay-only.
+    size_t free_after = 0;
+    (void) cudaMemGetInfo(&free_after, &total_now);
+    std::fprintf(stderr,
+        "Q122 LARGE_PP: suspend freed=%.1fMiB free=%.1f->%.1fMiB rows=%u/%u entries=%zu\n",
+        freed/1048576.0, free_before/1048576.0, free_after/1048576.0,
+        state.dyn_rows, state.dyn_logical_rows, state.entries.size());
+    std::fflush(stderr);
+    return true;
+}
+
+extern "C" bool ggml_backend_cuda_q122_large_pp_prefetch(void) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    if (!state.enabled || !state.borrow_enabled || !state.large_pp_suspended || state.entries.empty()) return true;
+    if (state.large_pp_prefetch_queued || state.large_pp_prefetch_bytes > 0) return true;
+
+    CUDA_CHECK(cudaSetDevice(state.device));
+    cudaStream_t stream = q122_large_pp_prefetch_stream_locked(state);
+    const auto desired = q122_dynborrow_desired_layers(state);
+    const size_t headroom = q122_large_pp_prefetch_headroom_bytes();
+    size_t free_before = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_before, &total_now);
+
+    const int64_t t_start = ggml_time_us();
+    const bool pipelined = q122_large_pp_pipelined();
+    std::vector<cache_entry *> pending_copies;
+    size_t staged = 0;
+    int staged_layers = 0;
+    std::array<bool, MAX_LAYERS> staged_mask{};
+
+    // Stage whole GATE/UP/DOWN layer triplets only. Pointer tables remain base-only,
+    // so the next PP graph can run concurrently with these H2D copies without ever
+    // observing partially copied experts. Keep a generous PP headroom above the
+    // normal decode low-water; KV reserve can cancel staging if reality disagrees.
+    std::vector<int> layer_order;
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (desired[size_t(layer)]) layer_order.push_back(layer);
+    }
+    if (pipelined) {
+        std::stable_sort(layer_order.begin(), layer_order.end(), [](int a, int b) {
+            const double ua = q122_dynborrow_utility(state, a);
+            const double ub = q122_dynborrow_utility(state, b);
+            return ua != ub ? ua > ub : a < b;
+        });
+    }
+    auto enqueue_copy = [&](cache_entry & e) {
+        const auto & borrow = q122_adaptive_borrow_list(state, e.layer);
+        for (int bi = 0; bi < int(borrow.size()) && bi < e.max_slots - e.slots; ++bi) {
+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= e.n_experts) continue;
+            void * dst = static_cast<char *>(e.prefetch_slices) + size_t(bi) * e.slice_bytes;
+            const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+            CUDA_CHECK(cudaMemcpyAsync(dst, src, e.slice_bytes, cudaMemcpyHostToDevice, stream));
+        }
+    };
+    for (int layer : layer_order) {
+        if (!desired[size_t(layer)]) continue;
+        int base_slots = 0, max_slots = 0;
+        size_t layer_bytes = 0;
+        if (!q122_dynborrow_layer_shape(state, layer, base_slots, max_slots, layer_bytes)) continue;
+
+        size_t free_now = 0;
+        (void) cudaMemGetInfo(&free_now, &total_now);
+        if (free_now <= layer_bytes + headroom) continue;
+
+        std::vector<cache_entry *> layer_entries;
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer == layer && e.max_slots > e.slots) layer_entries.push_back(&e);
+        }
+        if (layer_entries.size() < 3) continue;
+
+        bool alloc_ok = true;
+        std::vector<cache_entry *> newly;
+        for (cache_entry * ep : layer_entries) {
+            cache_entry & e = *ep;
+            if (e.prefetch_slices || e.borrow_slices) { alloc_ok = false; break; }
+            cudaError_t err = cudaMalloc(&e.prefetch_slices, e.borrow_bytes);
+            if (err != cudaSuccess) {
+                (void) cudaGetLastError();
+                alloc_ok = false;
+                break;
+            }
+            newly.push_back(&e);
+        }
+        if (!alloc_ok) {
+            for (cache_entry * ep : newly) {
+                if (ep->prefetch_slices) {
+                    (void) cudaFree(ep->prefetch_slices);
+                    ep->prefetch_slices = nullptr;
+                }
+            }
+            continue;
+        }
+
+        for (cache_entry * ep : layer_entries) {
+            cache_entry & e = *ep;
+            if (pipelined) {
+                pending_copies.push_back(&e);
+            } else {
+                enqueue_copy(e);
+            }
+            state.allocated += e.borrow_bytes;
+            staged += e.borrow_bytes;
+        }
+        staged_mask[size_t(layer)] = true;
+        ++staged_layers;
+    }
+
+    const int64_t t_alloc_done = ggml_time_us();
+    // Allocate first so later allocations cannot serialize earlier DMA work.
+    for (cache_entry * ep : pending_copies) enqueue_copy(*ep);
+    const int64_t t_queued = ggml_time_us();
+
+    if (staged > 0) {
+        state.large_pp_prefetch_layers = staged_mask;
+        state.large_pp_prefetch_bytes = staged;
+        state.large_pp_prefetch_queued = true;
+    }
+    size_t free_after = 0;
+    (void) cudaMemGetInfo(&free_after, &total_now);
+    std::fprintf(stderr,
+        "Q122 LARGE_PP: prefetch queued layers=%d bytes=%.1fMiB free=%.1f->%.1fMiB headroom=%.1fMiB rows=%u/%u\n",
+        staged_layers, staged/1048576.0, free_before/1048576.0, free_after/1048576.0,
+        headroom/1048576.0, state.dyn_rows, state.dyn_logical_rows);
+    std::fprintf(stderr, "Q122 LARGE_PP_PHASE: prefetch pipelined=%d prepare_us=%lld enqueue_us=%lld total_us=%lld\n",
+        pipelined ? 1 : 0, (long long) (t_alloc_done - t_start),
+        (long long) (t_queued - t_alloc_done), (long long) (t_queued - t_start));
+    std::fflush(stderr);
+    return true;
+}
+
+extern "C" bool ggml_backend_cuda_q122_large_pp_resume(void) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    initialize(state);
+    // The server has finished PP. Release staging before choosing decode residents.
+    if (state.pp_stream_staging) {
+        CUDA_CHECK(cudaSetDevice(state.pp_stream_staging_device));
+        CUDA_CHECK(cudaFree(state.pp_stream_staging));
+        std::fprintf(stderr, "Q122 PP_STREAM: released staging=%.1fMiB\n", state.pp_stream_staging_bytes/1048576.0);
+        state.pp_stream_staging = nullptr;
+        state.pp_stream_staging_bytes = 0;
+    }
+    if (!state.enabled || !state.borrow_enabled || !state.large_pp_suspended || state.entries.empty()) return true;
+
+    const int64_t t_start = ggml_time_us();
+    const bool pipelined = q122_large_pp_pipelined();
+    std::vector<cache_entry *> pending_copies;
+    std::vector<std::vector<const void *>> publish_tables;
+    publish_tables.reserve(state.entries.size());
+    CUDA_CHECK(cudaSetDevice(state.device));
+    cudaStream_t stream = q122_large_pp_prefetch_stream_locked(state);
+    size_t free_before = 0, total_now = 0;
+    (void) cudaMemGetInfo(&free_before, &total_now);
+    const size_t prefetched_bytes = state.large_pp_prefetch_bytes;
+
+    // If tail prefetch was queued, most or all of this wait should already have been
+    // hidden behind the final PP batches. Promote staging only after its stream is done.
+    if (state.large_pp_prefetch_queued) {
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+    }
+    const int64_t t_wait_done = ggml_time_us();
+    for (auto & kv : state.entries) {
+        cache_entry & e = *kv.second;
+        if (!e.prefetch_slices) continue;
+        e.borrow_slices = e.prefetch_slices;
+        e.prefetch_slices = nullptr;
+        state.borrow_allocated += e.borrow_bytes;
+        e.borrow_retired = false;
+    }
+    state.large_pp_prefetch_layers.fill(false);
+    state.large_pp_prefetch_queued = false;
+    state.large_pp_prefetch_bytes = 0;
+
+    const auto desired = q122_dynborrow_desired_layers(state);
+    const size_t reserve = q122_dynborrow_reserve_bytes();
+    std::array<bool, MAX_LAYERS> activated{};
+    size_t restored = 0;
+    size_t late_h2d = 0;
+    int restored_layers = 0;
+
+    // Tail staging used a larger PP headroom than decode needs. Recompute the final
+    // desired set after the last KV growth and discard any speculative layer no longer
+    // justified by the 600 MiB decode watermark.
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (desired[size_t(layer)]) continue;
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != layer || !e.borrow_slices || e.borrow_exposed) continue;
+            CUDA_CHECK(cudaFree(e.borrow_slices));
+            e.borrow_slices = nullptr;
+            e.borrow_retired = e.borrow_bytes > 0;
+            state.allocated -= std::min(state.allocated, e.borrow_bytes);
+            state.borrow_allocated -= std::min(state.borrow_allocated, e.borrow_bytes);
+        }
+    }
+
+    auto enqueue_copy = [&](cache_entry & e) {
+        const auto & borrow = q122_adaptive_borrow_list(state, e.layer);
+        for (int bi = 0; bi < int(borrow.size()) && bi < e.max_slots - e.slots; ++bi) {
+            const int expert = borrow[size_t(bi)];
+            if (expert < 0 || expert >= e.n_experts) continue;
+            void * dst = static_cast<char *>(e.borrow_slices) + size_t(bi) * e.slice_bytes;
+            const void * src = static_cast<const char *>(e.host_base) + size_t(expert) * e.slice_bytes;
+            CUDA_CHECK(cudaMemcpyAsync(dst, src, e.slice_bytes, cudaMemcpyHostToDevice, stream));
+        }
+    };
+
+    // Expose prefetched layers immediately; allocate/copy only the remainder that is
+    // still useful for decode. All copies and pointer-table publication use the private
+    // non-blocking stream and one final stream sync, never a device-wide sync.
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!desired[size_t(layer)]) continue;
+        int base_slots = 0, max_slots = 0;
+        size_t layer_bytes = 0;
+        if (!q122_dynborrow_layer_shape(state, layer, base_slots, max_slots, layer_bytes)) continue;
+
+        std::vector<cache_entry *> layer_entries;
+        bool all_physical = true;
+        bool any_physical = false;
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer != layer || e.max_slots <= e.slots) continue;
+            layer_entries.push_back(&e);
+            any_physical = any_physical || e.borrow_slices != nullptr;
+            all_physical = all_physical && e.borrow_slices != nullptr;
+        }
+        if (layer_entries.size() < 3 || (any_physical && !all_physical)) continue;
+
+        if (!all_physical) {
+            size_t free_now = 0;
+            (void) cudaMemGetInfo(&free_now, &total_now);
+            if (free_now <= layer_bytes + reserve) continue;
+
+            bool alloc_ok = true;
+            std::vector<cache_entry *> newly;
+            for (cache_entry * ep : layer_entries) {
+                cache_entry & e = *ep;
+                cudaError_t err = cudaMalloc(&e.borrow_slices, e.borrow_bytes);
+                if (err != cudaSuccess) {
+                    (void) cudaGetLastError();
+                    alloc_ok = false;
+                    break;
+                }
+                newly.push_back(&e);
+            }
+            if (!alloc_ok) {
+                for (cache_entry * ep : newly) {
+                    if (ep->borrow_slices) { (void) cudaFree(ep->borrow_slices); ep->borrow_slices = nullptr; }
+                }
+                continue;
+            }
+            for (cache_entry * ep : layer_entries) {
+                cache_entry & e = *ep;
+                if (pipelined) {
+                    pending_copies.push_back(&e);
+                } else {
+                    enqueue_copy(e);
+                }
+                state.allocated += e.borrow_bytes;
+                state.borrow_allocated += e.borrow_bytes;
+                late_h2d += e.borrow_bytes;
+            }
+        }
+
+        for (cache_entry * ep : layer_entries) {
+            cache_entry & e = *ep;
+            if (!pipelined) {
+                publish_tables.emplace_back();
+                auto & table = publish_tables.back();
+                q122_dynborrow_build_table(state, e, true, table);
+                CUDA_CHECK(cudaMemcpyAsync(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice, stream));
+            }
+            e.borrow_exposed = true;
+            e.borrow_retired = false;
+            restored += e.borrow_bytes;
+        }
+        activated[size_t(layer)] = true;
+        ++restored_layers;
+    }
+
+    const int64_t t_alloc_done = ggml_time_us();
+    for (cache_entry * ep : pending_copies) enqueue_copy(*ep);
+    if (pipelined) {
+        for (auto & kv : state.entries) {
+            cache_entry & e = *kv.second;
+            if (e.layer < 0 || e.layer >= MAX_LAYERS || !activated[size_t(e.layer)] || !e.borrow_exposed) continue;
+            publish_tables.emplace_back();
+            auto & table = publish_tables.back();
+            q122_dynborrow_build_table(state, e, true, table);
+            CUDA_CHECK(cudaMemcpyAsync(e.device_table, table.data(), table.size() * sizeof(void *), cudaMemcpyHostToDevice, stream));
+        }
+    }
+    // Keep host tables alive until their async copies have completed.
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    const int64_t t_copy_done = ggml_time_us();
+    for (int layer = 0; layer < MAX_LAYERS; ++layer) {
+        if (!activated[size_t(layer)]) continue;
+        q122_publish_borrow_mask(state, layer, true);
+        q122_publish_resident_mask(state, layer, true);
+        const int base = ggml_hotexpert_q122_static_slots(layer, state.slots);
+        const int mx = q122_dynborrow_max_slots(state, layer, base);
+        ggml_hotexpert_q122_set_active_slots(layer, mx);
+    }
+
+    state.large_pp_suspended = false;
+    state.borrow_seeded = true;
+    size_t free_after = 0;
+    (void) cudaMemGetInfo(&free_after, &total_now);
+    std::fprintf(stderr,
+        "Q122 LARGE_PP: resume layers=%d restored=%.1fMiB prefetched=%.1fMiB late_h2d=%.1fMiB free=%.1f->%.1fMiB rows=%u/%u\n",
+        restored_layers, restored/1048576.0, prefetched_bytes/1048576.0, late_h2d/1048576.0,
+        free_before/1048576.0, free_after/1048576.0, state.dyn_rows, state.dyn_logical_rows);
+    std::fprintf(stderr, "Q122 LARGE_PP_PHASE: resume pipelined=%d wait_us=%lld prepare_us=%lld finish_us=%lld total_us=%lld\n",
+        pipelined ? 1 : 0, (long long) (t_wait_done - t_start), (long long) (t_alloc_done - t_wait_done),
+        (long long) (t_copy_done - t_alloc_done), (long long) (ggml_time_us() - t_start));
+    std::fflush(stderr);
+    return true;
+}
+
+extern "C" bool ggml_backend_cuda_q122_dynborrow_prepare(uint32_t rows, uint32_t logical_rows) {
+    // No-op unless Q122_DYNKV_BORROW=1. Keeping the hook unconditional in llama
+    // lets the experimental binary fall back cleanly to the old static cache.
+    return ggml_cuda_hotexpert_cache_prepare_kv_rows(rows, logical_rows);
+}
