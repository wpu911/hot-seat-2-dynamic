+static int q122_r0_parse_layer(const char * name) {
+    if (!name) return -1;
+    const char * p = strstr(name, "blk.");
+    if (!p) return -1;
+    p += 4;
+    if (*p < '0' || *p > '9') return -1;
+    int layer = 0;
+    while (*p >= '0' && *p <= '9') layer = layer * 10 + (*p++ - '0');
+    return layer >= 0 && layer < 48 ? layer : -1;
+}
