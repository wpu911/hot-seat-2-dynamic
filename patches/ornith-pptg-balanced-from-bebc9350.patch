+// ---------------------------------------------------------------------------
+// profile / plan parsing
+// ---------------------------------------------------------------------------
+
+static bool parse_unsigned(const std::string & text, size_t & pos, uint64_t & value) {
+    while (pos < text.size() && std::isspace(static_cast<unsigned char>(text[pos]))) {
+        ++pos;
+    }
+    if (pos == text.size() || !std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        return false;
+    }
+    value = 0;
+    while (pos < text.size() && std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        value = value * 10 + uint64_t(text[pos++] - '0');
+    }
+    return true;
+}
+
+static bool load_profile(rt_state & s, const std::string & path, const std::string & expected_fp) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        GGML_LOG_ERROR("HotExpert runtime: cannot open profile %s\n", path.c_str());
+        return false;
+    }
+    const std::string json((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    // fingerprint guard: reject profiles from a different model outright so
+    // foreign slots/full_count can never leak into layout or logs
+    if (!expected_fp.empty()) {
+        std::string prof_fp;
+        const size_t kfp = json.find("\"model_fingerprint\"");
+        if (kfp != std::string::npos) {
+            size_t colon = json.find(':', kfp);
+            if (colon != std::string::npos) {
+                ++colon;
+                while (colon < json.size() && std::isspace(static_cast<unsigned char>(json[colon]))) ++colon;
+                if (colon < json.size() && json[colon] == '"') {
+                    ++colon;
+                    const size_t endq = json.find('"', colon);
+                    if (endq != std::string::npos) prof_fp = json.substr(colon, endq - colon);
+                }
+            }
+        }
+        if (prof_fp.empty()) {
+            std::fprintf(stderr, "HotExpert runtime: profile rejected: missing fingerprint (%s)\n", path.c_str());
+            std::fflush(stderr);
+            return false;
+        }
+        if (prof_fp != expected_fp) {
+            std::fprintf(stderr, "HotExpert runtime: profile rejected: fingerprint mismatch (profile=%s expected=%s)\n",
+                prof_fp.c_str(), expected_fp.c_str());
+            std::fflush(stderr);
+            return false;
+        }
+    }
+    size_t pos = 0;
+    int loaded = 0;
+    while ((pos = json.find("\"layer\"", pos)) != std::string::npos) {
+        pos = json.find(':', pos);
+        if (pos == std::string::npos) break;
+        ++pos;
+        uint64_t layer_value = 0;
+        if (!parse_unsigned(json, pos, layer_value) || layer_value >= MAX_LAYERS) continue;
+
+        const size_t next_layer = json.find("\"layer\"", pos);
+        // source 1: legacy per-expert hit counts; source 2: top_experts seed
+        size_t hits = json.find("\"expert_hits\"", pos);
+        bool from_top = false;
+        if (hits == std::string::npos || (next_layer != std::string::npos && hits > next_layer)) {
+            hits = json.find("\"top_experts\"", pos);
+            from_top = true;
+        }
+        if (hits == std::string::npos || (next_layer != std::string::npos && hits > next_layer)) continue;
+        hits = json.find('[', hits);
+        if (hits == std::string::npos) continue;
+        ++hits;
+
+        std::vector<uint64_t> counts;
+        while (hits < json.size() && json[hits] != ']') {
+            uint64_t count = 0;
+            if (!parse_unsigned(json, hits, count)) break;
+            counts.push_back(count);
+            while (hits < json.size() && std::isspace(static_cast<unsigned char>(json[hits]))) ++hits;
+            if (hits < json.size() && json[hits] == ',') ++hits;
+        }
+        if (counts.empty() || counts.size() > MAX_EXPERTS) continue;
+
+        auto & ranked = s.ranked_experts[layer_value];
+        if (from_top) {
+            // top_experts are already ordered hot -> cold
+            ranked.assign(counts.begin(), counts.end());
+        } else {
+            ranked.resize(counts.size());
+            std::iota(ranked.begin(), ranked.end(), 0);
+            std::stable_sort(ranked.begin(), ranked.end(), [&](int a, int b) {
+                return counts[a] > counts[b];
+            });
+        }
+        ++loaded;
+        pos = hits;
+    }
+    if (!loaded) {
+        GGML_LOG_ERROR("HotExpert runtime: no layer expert_hits/top_experts found in %s\n", path.c_str());
+        return false;
+    }
+    s.profile_loaded = true;
+    GGML_LOG_INFO("HotExpert runtime: loaded %d layers from %s\n", loaded, path.c_str());
+    return true;
+}
+
+static bool load_v2_predictor(rt_state & s, const std::string & path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        GGML_LOG_WARN("HotSeat V2 predictor: cannot open %s\n", path.c_str());
+        return false;
+    }
+    const std::string json((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    size_t pos = 0;
+    int loaded = 0;
+    while ((pos = json.find("\"layer\"", pos)) != std::string::npos) {
+        size_t colon = json.find(':', pos);
+        if (colon == std::string::npos) break;
+        pos = colon + 1;
+        uint64_t layer_value = 0;
+        if (!parse_unsigned(json, pos, layer_value) || layer_value >= MAX_LAYERS) continue;
+        const size_t next_layer = json.find("\"layer\"", pos);
+        size_t scores = json.find("\"scores_ppm\"", pos);
+        if (scores == std::string::npos || (next_layer != std::string::npos && scores > next_layer)) continue;
+        scores = json.find('[', scores);
+        if (scores == std::string::npos) continue;
+        ++scores;
+        int e = 0;
+        for (; e < MAX_EXPERTS && scores < json.size() && json[scores] != ']'; ++e) {
+            uint64_t value = 0;
+            if (!parse_unsigned(json, scores, value)) break;
+            s.v2_repeat_ppm[layer_value][e] = uint32_t(std::min<uint64_t>(value, 1000000));
+            while (scores < json.size() && std::isspace(static_cast<unsigned char>(json[scores]))) ++scores;
+            if (scores < json.size() && json[scores] == ',') ++scores;
+        }
+        if (e > 0) ++loaded;
+        pos = scores;
+    }
+    if (!loaded) {
+        GGML_LOG_WARN("HotSeat V2 predictor: no scores_ppm found in %s\n", path.c_str());
+        return false;
+    }
+    s.v2_predictor_loaded = true;
+    s.v2_predictor_path = path;
+    std::fprintf(stderr, "HotSeat V2 predictor: loaded=%d min_ppm=%u path=%s\n",
+        loaded, s.v2_predictor_min_ppm, path.c_str());
+    std::fflush(stderr);
+    return true;
+}
+
+static std::set<int> parse_layer_plan(const std::string & path) {
+    std::set<int> plan;
+    std::ifstream in(path);
+    if (!in.good()) {
+        return plan;
+    }
+    std::stringstream buffer;
+    buffer << in.rdbuf();
+    const std::string s = buffer.str();
+    const std::string key = "\"hot_layer_plan\"";
+    size_t pos = s.find(key);
+    if (pos == std::string::npos) return plan;
+    size_t lb = s.find('[', pos);
+    size_t rb = s.find(']', lb == std::string::npos ? pos : lb);
+    if (lb == std::string::npos || rb == std::string::npos || rb <= lb) return plan;
+    std::string arr = s.substr(lb + 1, rb - lb - 1);
+    int value = 0;
+    bool in_number = false;
+    for (char c : arr) {
+        if (std::isdigit(static_cast<unsigned char>(c))) {
+            if (!in_number) {
+                value = 0;
+                in_number = true;
+            }
+            value = value * 10 + (c - '0');
+        } else if (in_number) {
+            if (value >= 0 && value < MAX_LAYERS) plan.insert(value);
+            value = 0;
+            in_number = false;
+        }
+    }
+    if (in_number && value >= 0 && value < MAX_LAYERS) plan.insert(value);
+    return plan;
+}
