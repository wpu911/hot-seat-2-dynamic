index 000000000..742f12348
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-cache.cu
@@ -0,0 +1,2060 @@
+#include "hotexpert-cache.cuh"
+
+#include "ggml-backend.h"
+#include "ggml-cuda.h"
+#include "ggml-hotexpert.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr int MAX_LAYERS  = 256;
+constexpr int MAX_EXPERTS = 1024;
+
+struct cache_entry {
+    void * device_slices = nullptr;       // immutable base resident bank
+    void * borrow_slices = nullptr;       // elastic extension, retired as KV grows
+    void * prefetch_slices = nullptr;     // large-PP tail staging; never exposed until resume
+    const void ** device_table = nullptr;
+    const void * host_base = nullptr;
+    size_t bytes = 0;
+    size_t borrow_bytes = 0;
+    size_t slice_bytes = 0;
+    int n_experts = 0;
+    int layer = -1;
+    int slots = 0;                        // base slots
+    int max_slots = 0;                    // base + borrow slots
+    bool resident_only = false;
+    bool borrow_exposed = false;
+    bool borrow_retired = false;
+};
+
+struct cache_state {
+    bool initialized = false;
+    bool enabled = false;
+    bool borrow_enabled = false;
+    int slots = 64;
+    int device = 0;
+    size_t budget = size_t(8192) << 20;
+    size_t allocated = 0;
+    size_t borrow_allocated = 0;
+    uint32_t dyn_rows = 0;
+    uint32_t dyn_logical_rows = 0;
+    uint32_t dyn_initial_rows = 32768;
+    std::string profile_path;
+    std::array<int, MAX_LAYERS> borrow_max_slots{};
+    std::array<std::vector<int>, MAX_LAYERS> ranked_experts;
+    std::array<std::vector<uint64_t>, MAX_LAYERS> expert_hits;
+    std::array<std::vector<int>, MAX_LAYERS> adaptive_static_experts;
+    std::array<std::vector<int>, MAX_LAYERS> adaptive_static_baseline;
+    std::array<std::vector<int>, MAX_LAYERS> adaptive_borrow_experts;
+    std::array<std::vector<int>, MAX_LAYERS> adaptive_borrow_baseline;
+    std::array<std::vector<uint64_t>, MAX_LAYERS> adaptive_static_install_token;
+    std::array<std::vector<uint64_t>, MAX_LAYERS> adaptive_borrow_install_token;
+    std::array<std::array<uint32_t, 256>, MAX_LAYERS> adaptive_score{};
+    uint64_t adaptive_last_token = 0;
+    uint64_t adaptive_swaps = 0;
+    uint64_t adaptive_h2d_bytes = 0;
+    bool borrow_seeded = false; // initial/re-shrink balance done; KV growth may only repay, never reborrow
+    void * pp_stream_staging = nullptr;
+    size_t pp_stream_staging_bytes = 0;
+    int pp_stream_staging_device = 0;
+    bool large_pp_suspended = false; // elastic expert slices retired while multi-token PP owns VRAM
+    cudaStream_t large_pp_prefetch_stream = nullptr;
+    bool large_pp_prefetch_queued = false;
+    size_t large_pp_prefetch_bytes = 0;
+    std::array<bool, MAX_LAYERS> large_pp_prefetch_layers{};
+    std::unordered_map<const void *, std::unique_ptr<cache_entry>> entries;
+    std::mutex mutex;
+};
+
+cache_state state;
+
+static bool env_enabled() {
+    const char * value = std::getenv("HOTEXPERT_CACHE");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+
+static bool q122_r1_active() {
+    static const bool active = [] {
+        const char * enabled = std::getenv("Q122_R1");
+        return enabled && std::strcmp(enabled, "1") == 0;
+    }();
+    return active;
+}
+
+static const std::array<bool, MAX_LAYERS> & q122_r1_layers() {
+    static const std::array<bool, MAX_LAYERS> mask = [] {
+        std::array<bool, MAX_LAYERS> out{};
+        if (!q122_r1_active()) return out;
+        const char * list = std::getenv("Q122_R1_SPLIT_LAYERS");
+        if (list && *list) {
+            const char * p = list;
+            while (*p) {
+                while (*p == ' ' || *p == ',') ++p;
+                if (!*p) break;
+                char * end = nullptr;
+                long layer = std::strtol(p, &end, 10);
+                if (end == p) break;
+                if (layer >= 0 && layer < MAX_LAYERS) out[size_t(layer)] = true;
+                p = end;
+            }
+        } else {
+            const char * value = std::getenv("Q122_R1_SPLIT_LAYER");
+            int layer = (value && *value) ? std::atoi(value) : 3;
+            if (layer >= 0 && layer < MAX_LAYERS) out[size_t(layer)] = true;
+        }
+        return out;
+    }();
+    return mask;
+}
+
+static bool q122_r1_layer_enabled(int layer) {
+    return q122_r1_active() && layer >= 0 && layer < MAX_LAYERS && q122_r1_layers()[size_t(layer)];
+}
+
+static bool q122_r1_resident_only(int layer) {
+    const char * value = std::getenv("Q122_R1_RESIDENT_ONLY");
+    return value && std::strcmp(value, "1") == 0 && q122_r1_layer_enabled(layer);
+}
+
+static int q122_hybrid_zerocopy_permille() {
+    static const int value = [] {
+        const char * v = std::getenv("Q122_HYBRID_ZEROCOPY_PERMILLE");
+        if (!v || !*v) return 0;
+        return std::clamp(std::atoi(v), 0, 1000);
+    }();
+    return value;
+}
+
+static bool q122_hybrid_zerocopy_gpu_owner(int layer, int expert) {
+    const int pm = q122_hybrid_zerocopy_permille();
+    if (pm <= 0 || layer < 0 || expert < 0) return false;
+    const uint32_t bucket = (uint32_t(expert) * 73u + uint32_t(layer) * 37u) & 255u;
+    return bucket * 1000u < uint32_t(pm) * 256u;
+}
+
+static int env_positive_int(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 && parsed <= MAX_EXPERTS ? int(parsed) : fallback;
+}
+
+static size_t env_budget() {
+    const char * value = std::getenv("HOTEXPERT_CACHE_VRAM_BUDGET_MB");
+    if (!value || !*value) {
+        return size_t(8192) << 20;
+    }
+    const unsigned long long parsed = std::strtoull(value, nullptr, 10);
+    return parsed ? size_t(parsed) << 20 : size_t(8192) << 20;
+}
+
+static int parse_layer(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    const char * p = std::strstr(name, "blk.");
+    if (!p) {
+        return -1;
+    }
+    p += 4;
+    if (!std::isdigit(static_cast<unsigned char>(*p))) {
+        return -1;
+    }
+    int layer = 0;
+    while (std::isdigit(static_cast<unsigned char>(*p))) {
+        layer = layer * 10 + (*p++ - '0');
+    }
+    return layer < MAX_LAYERS ? layer : -1;
+}
+
+static bool parse_unsigned(const std::string & text, size_t & pos, uint64_t & value) {
+    while (pos < text.size() && std::isspace(static_cast<unsigned char>(text[pos]))) {
+        ++pos;
+    }
+    if (pos == text.size() || !std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        return false;
+    }
+    value = 0;
+    while (pos < text.size() && std::isdigit(static_cast<unsigned char>(text[pos]))) {
+        value = value * 10 + uint64_t(text[pos++] - '0');
+    }
+    return true;
+}
+
+static bool load_profile(cache_state & s) {
+    std::ifstream in(s.profile_path, std::ios::binary);
+    if (!in) {
+        GGML_LOG_ERROR("HotExpert cache: cannot open profile %s\n", s.profile_path.c_str());
+        return false;
+    }
+    const std::string json((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    size_t pos = 0;
+    int loaded = 0;
+    while ((pos = json.find("\"layer\"", pos)) != std::string::npos) {
+        pos = json.find(':', pos);
+        if (pos == std::string::npos) break;
+        ++pos;
+        uint64_t layer_value = 0;
+        if (!parse_unsigned(json, pos, layer_value) || layer_value >= MAX_LAYERS) continue;
+
+        const size_t next_layer = json.find("\"layer\"", pos);
+        size_t hits = json.find("\"expert_hits\"", pos);
+        if (hits == std::string::npos || (next_layer != std::string::npos && hits > next_layer)) continue;
+        hits = json.find('[', hits);
+        if (hits == std::string::npos) continue;
+        ++hits;
+
+        std::vector<uint64_t> counts;
+        while (hits < json.size() && json[hits] != ']') {
+            uint64_t count = 0;
+            if (!parse_unsigned(json, hits, count)) break;
+            counts.push_back(count);
+            while (hits < json.size() && std::isspace(static_cast<unsigned char>(json[hits]))) ++hits;
+            if (hits < json.size() && json[hits] == ',') ++hits;
+        }
+        if (counts.empty() || counts.size() > MAX_EXPERTS) continue;
+
+        s.expert_hits[layer_value] = counts;
+        auto & ranked = s.ranked_experts[layer_value];
+        ranked.resize(counts.size());
+        std::iota(ranked.begin(), ranked.end(), 0);
+        std::stable_sort(ranked.begin(), ranked.end(), [&](int a, int b) {
+            return counts[a] > counts[b];
+        });
+        ++loaded;
+        pos = hits;
+    }
+    if (!loaded) {
+        GGML_LOG_ERROR("HotExpert cache: no layer expert_hits found in %s\n", s.profile_path.c_str());
+        return false;
+    }
+    GGML_LOG_INFO("HotExpert cache: loaded %d layers from %s, slots=%d budget=%zu MiB\n",
+                  loaded, s.profile_path.c_str(), s.slots, s.budget >> 20);
+    return true;
+}
+
