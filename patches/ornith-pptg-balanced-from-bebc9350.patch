+static bool q122_r0_is_resident(const struct ggml_tensor * tensor, int expert) {
+    if (!tensor || expert < 0 || expert >= 256) return false;
+    const int layer = q122_r0_parse_layer(tensor->name);
+    if (layer < 0) return false;
+    if (q122_r1_active() && !q122_r1_layer_enabled(layer)) return false;
+    if (!strstr(tensor->name, "ffn_") || !strstr(tensor->name, "_exps")) return false;
+
+    // Adaptive HotSeat may rewrite both the Static tail and elastic Borrow set.
+    // When the cache publishes an exact full-resident mask, it is authoritative.
+    if (ggml_hotexpert_q122_resident_valid(layer)) {
+        return ggml_hotexpert_q122_resident_contains(layer, expert) != 0;
+    }
+
+    // Backward-compatible ownership for caches that predate exact resident masks.
+    const int base_slots = ggml_hotexpert_q122_static_slots(layer, q122_r0_skip_slots());
+    for (int i = 0; i < base_slots; ++i) if (q122_r0_rank[layer][i] == expert) return true;
+    if (ggml_hotexpert_q122_borrow_valid(layer)) {
+        return ggml_hotexpert_q122_borrow_contains(layer, expert) != 0;
+    }
+    const int active_slots = ggml_hotexpert_q122_active_slots(layer, q122_r0_skip_slots());
+    for (int i = base_slots; i < active_slots; ++i) if (q122_r0_rank[layer][i] == expert) return true;
+    return false;
+}
