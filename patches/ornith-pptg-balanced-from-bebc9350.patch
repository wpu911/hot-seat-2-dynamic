+#pragma once
+
+#include "common.cuh"
+#include "ggml.h"
+
+// Records selected expert ids without changing the graph or the routed values.
+// The implementation is a no-op unless HOTEXPERT_PROFILE=1.
+void ggml_cuda_hotexpert_record(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor *         ids,
+        int                         n_experts,
+        int                         n_expert_used,
+        int                         n_rows);
+
+// Records routed ids from the multi-token MMQ path. This is separate from
+// topk-moe because its tensor shape does not always expose the full token row
+// count, while MMQ's ne12 does.
+void ggml_cuda_hotexpert_record_prefill(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor *         ids,
+        int                         n_experts,
+        int                         n_expert_used,
+        int                         n_rows);
+
+// Discovers the highest MoE layer before execution so graph capture embeds
+// exactly one lightweight per-token host notification.
+void ggml_cuda_hotexpert_prepare_graph(
+        ggml_backend_cuda_context & ctx,
+        const ggml_cgraph *         graph);
+
+// Captures the per-expert weight footprint used for byte-weighted hit rates.
+// Registration is idempotent for gate/up/down tensors.
+void ggml_cuda_hotexpert_register_weight(const ggml_tensor * weight);
diff --git a/ggml/src/ggml-cuda/hotexpert-runtime.cu b/ggml/src/ggml-cuda/hotexpert-runtime.cu
new file mode 100644
index 000000000..1b6db1795
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-runtime.cu
@@ -0,0 +1,5861 @@
+#include "hotexpert-runtime.cuh"
+#include "hotexpert-descriptor.cuh"
+#include "hotexpert-arena.cuh"
+#include "hotexpert-cache.cuh"
+#include "ggml-hotexpert.h"
+
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cctype>
+#include <map>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <glob.h>
+#include <sys/stat.h>
+#include <fstream>
+#include <filesystem>
+#include <mutex>
+#include <numeric>
+#include <set>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+// ============================================================================
+// Runtime dynamic HotSeat / Hot Expert adjustment
+//
+// Memory model (allocated exactly once, never freed at runtime):
+//   full_banks  : full_count + 1 banks of one full MoE layer each (816 MiB);
+//                 the last one is the full shadow bank used to stage the
+//                 promoted layer.
+//   top64_banks : (n_layers - full_count) + 1 banks of one Top-64 set each
+//                 (204 MiB); the last one is the shared spare-slot pool used
+//                 to stage single-expert promotions and the demoted layer's
+//                 fresh Top-64 set.
+//
+// Mapping model:
+//   Every (layer, tensor-kind) has a double-buffered device pointer table
+//   indexed by expert id. Kernels only read the buffer referenced by the
+//   committed immutable map. The worker stages the other buffer. A commit
+//   atomically publishes a new map at a graph boundary after draining the
+//   compute stream and waiting for the side-stream copies.
+//
+// Expert promotion (single expert, ~3.19 MiB):
+//   candidate E -> spare slot of the pool bank; the new table maps E to that
+//   slot and the evicted V back to host. Slot counts are conserved: each
+//   promotion consumes one pool slot and frees one slot of the layer's own
+//   bank. When the pool is full (or before a full-layer swap), pool-resident
+//   experts are flushed back into their own banks (1:1 with freed slots).
+//
+// Full-layer swap (dynamic-hybrid only, slow path):
+//   promote B: 64 hot experts D2D from B's current slots + 192 cold H2D from
+//              host into the full shadow bank;
+//   demote A:   A's fresh Top-64 D2D from A's full bank into the pool bank
+//              (the pool is flushed first);
+//   one atomic commit flips B -> full, A -> top64; the old banks become the
+//   new shadows.
+//
+// Correctness rules:
+//   - kernels always use the committed immutable map;
+//   - the worker only writes banks/tables that are NOT referenced by the
+//     committed map (writes go to the shadow banks / free table buffers);
+//   - commits happen at prepare_graph (start of graph compute): compute
+//     stream drained, side-stream event waited on, map published before any
+//     op of the new graph is enqueued;
+//   - dynamic modes disable CUDA/HIP graph capture (captured graphs would
+//     bake the table pointers).
+// ============================================================================
+
+namespace {
+
+constexpr int MAX_LAYERS  = 256;
+constexpr int MAX_EXPERTS = 1024;
+constexpr int MAX_TOP_K   = 64;
+constexpr int MAX_TENSORS = 4;    // gate(0), up(1), down(2), gate_up(3)
+constexpr int TENSOR_GATE = 0;
+constexpr int TENSOR_UP   = 1;
+constexpr int TENSOR_DOWN = 2;
+constexpr int TENSOR_GU   = 3;
+constexpr int SLOTS_PER_BANK = 64;
+
+enum runtime_mode {
+    MODE_STATIC = 0,
+    MODE_DYNAMIC_EXPERTS,
+    MODE_DYNAMIC_HYBRID,
+};
+
+struct tensor_slot {
+    const void * host_ptr = nullptr;
+    int64_t      stride   = 0;    // bytes per expert (nb[2])
+    int          n_experts = 0;
+    size_t       bytes    = 0;
+    const void * tables[2] = { nullptr, nullptr };   // double-buffered device tables
+    int          committed_buf = 0;
+};
+
+struct layer_t {
+    bool registered = false;
+    bool full = false;
+    int  full_bank  = -1;   // index into full_banks, -1 when not full
+    int  top64_bank = -1;   // index into top64_banks, -1 when full
+    std::vector<int> experts;                       // current resident expert ids (non-full)
+    int slots = 0;                                  // resident slot capacity of this layer
+    // stage J3: arena-backed extension experts (expert_id -> byte offsets in the arena)
+    std::vector<std::pair<int, uint64_t>> arena_experts;   // {expert_id, arena offset (gate region)}
+    bool arena_full = false;                    // full layer backed by the arena
+    uint64_t arena_full_offsets[3] = {0, 0, 0}; // gate/up/down offsets (bytes)
+    std::array<int,  MAX_EXPERTS> slot_of{};        // slot in own bank for resident experts
+    std::array<bool, MAX_EXPERTS> in_shadow{};      // expert staged in the pool bank
+    std::array<int,  MAX_EXPERTS> shadow_slot{};    // pool slot holding a staged expert
+    int  own_free    = 0;                           // free slots in own bank
+    int  shadow_used = 0;                           // pool slots held by this layer
+    std::array<tensor_slot, MAX_TENSORS> tensors{};
+
+    // host-side profile mirrors
+    std::vector<uint64_t> decode_hits;              // cumulative per-expert snapshot
+    std::vector<uint64_t> prev_hits;                // previous snapshot (for deltas)
+    std::vector<uint64_t> prefill_hits;
+    std::vector<uint64_t> prev_prefill_hits;
+    std::vector<double>   short_ewma;
+    std::vector<double>   long_ewma;
+    std::vector<int>      streak;                   // expert confirmation streak
+    uint64_t last_miss_rows = 0;                    // cumulative device mirrors
+    uint64_t prev_miss_rows = 0;
+    uint64_t last_prefill_rows = 0;
+    uint64_t prev_prefill_rows = 0;
+    int full_streak = 0;
+};
+
+struct bank_t {
+    int  owner = -1;          // layer id, -1 when free
+    bool full_size = false;
+    void * base = nullptr;
+    size_t total = 0;
+    std::array<size_t, MAX_TENSORS> offsets{};
+    std::array<size_t, MAX_TENSORS> sizes{};
+    std::vector<int> spare_slots;   // only for the pool bank
+};
+
+struct map_t {
+    uint64_t generation = 0;
+    std::vector<int> layer_to_full_bank;    // -1 when not full
+    std::vector<int> layer_to_top64_bank;   // -1 when full
+    std::vector<std::array<const void *, MAX_TENSORS>> tables;        // device table addresses
+    std::vector<std::array<const void *, MAX_TENSORS>> full_bases;
+};
+
+// promotion record: (layer, expert, pool_slot, victim)
+using promotion_t = std::array<int, 4>;
+
+struct swap_plan {
+    std::vector<promotion_t> promotions;
+    int promote_layer = -1;
+    int demote_layer  = -1;
+    std::vector<int> demote_experts;
+    // stage J3: arena capacity operations
+    std::vector<std::array<uint64_t, 3>> arena_expansions;   // {layer, expert, arena_gate_offset}
+    std::vector<std::array<uint64_t, 2>> arena_retirements;  // {layer, expert}
+    int arena_full_promote = -1;              // layer to promote to arena-backed full
+    int arena_full_demote = -1;               // layer to demote from arena-backed full
+    uint64_t arena_full_gate_offset = 0;      // arena gate offset for the promoted layer
+    std::vector<int> arena_full_demote_experts;  // new top-N set for the demoted layer
+    std::vector<uint32_t> resident_bits;
+    size_t bytes = 0;
+    double copy_us = 0.0;
+    double promote_score = 0.0;
+    double demote_score  = 0.0;
+};
+
+// ---------------------------------------------------------------------------
+// Stage D: model-independent routing profile
+// ---------------------------------------------------------------------------
+
+struct hotseat_profile_layer {
+    int layer_id = -1;
+    uint64_t total_routes = 0;        // decode + prefill routed expert hits
+    uint64_t decode_routes = 0;
+    uint64_t prefill_routes = 0;
+    int unique_experts = 0;
+    double coverage_top_8 = 0.0;
+    double coverage_top_16 = 0.0;
+    double coverage_top_32 = 0.0;
+    double coverage_top_48 = 0.0;
+    double coverage_top_64 = 0.0;
+    double coverage_top_96 = 0.0;
+    double coverage_top_128 = 0.0;
+    double miss_bytes = 0.0;          // window decode miss bytes
+    double stall_ns = 0.0;            // estimated host stall
+    double full_layer_gain = 0.0;     // estimated gain if the layer were full
+    std::vector<int> top_experts;     // top-N expert ids by decode EWMA (cold-start seed)
+};
+
+struct hotseat_profile {
+    uint64_t generation = 0;
+    uint64_t decode_tokens = 0;
+    uint64_t prefill_tokens = 0;
+    uint64_t requests = 0;
+    bool ready = false;               // minimum data collected
+    std::vector<hotseat_profile_layer> layers;
+    // per-layer per-expert unit gain: expected_hits * host_cost_saved / bytes
+    std::vector<std::vector<double>> expert_gain;
+};
+
+// HotSeat V2 Stage 1: tiny mapped-host routing history written directly by
+// the GPU record kernel.  A token callback can consume the previous token's
+// Top-K IDs without a D2H copy or compute-stream synchronization.
+struct v2_route_record {
+    uint64_t generation = 0;
+    uint64_t token = UINT64_MAX;
+    int32_t expert_ids[GGML_HOTEXPERT_V2_PROFILE_TOP_K] = {};
+    // Mapped host memory on HIP is reliable for ordinary per-thread stores,
+    // but atomics to it are not a portable coherence primitive.  Give each
+    // routing lane its own word and avoid cross-thread atomics entirely.
+    uint32_t resident_flags[GGML_HOTEXPERT_V2_PROFILE_TOP_K] = {};
+    uint32_t transit_flags[GGML_HOTEXPERT_V2_PROFILE_TOP_K] = {};
+    uint32_t route_count = 0;
+};
+
+struct rt_state {
+    runtime_mode mode = MODE_STATIC;
+    bool enabled = false;
+    bool initialized = false;
+    bool hybrid = false;
+    bool transit_only = false; // Q122 V3 P1: R1 static resident + transit sidecar only
+    int  device = 0;
+
+    cudaStream_t side_stream = nullptr;
+    cudaEvent_t  copy_start = nullptr;   // timing events
+    cudaEvent_t  copy_end   = nullptr;
+    cudaEvent_t  ready_event = nullptr;  // disableTiming
+
+    std::vector<bank_t> full_banks;     // full_count + 1 (or full_count when shadow off)
+    std::vector<bank_t> top64_banks;    // (n_layers - full_count) + 1
+    int full_shadow_idx = -1;
+    int spare_bank      = -1;
+    bool full_shadow    = true;         // HOTSEAT_FULL_SHADOW=0: no idle full shadow bank
+    std::string expected_fingerprint;   // model fingerprint for profile validation
+
+    std::array<layer_t, MAX_LAYERS> layers;
+    int n_layers  = 0;
+    int n_experts = 0;
+    int top_k     = 0;
+    int pool_slots = 0;                             // spare-pool capacity (max layer slots)
+    bool auto_layout = false;                       // stage F: layout from planner
+
+    // device counters
+    uint64_t * d_hits         = nullptr;  // [MAX_LAYERS * MAX_EXPERTS]
+    uint64_t * d_prefill      = nullptr;  // [MAX_LAYERS * MAX_EXPERTS]
+    uint64_t * d_miss         = nullptr;  // [MAX_LAYERS]
+    uint64_t * d_prefill_rows = nullptr;  // [MAX_LAYERS]
+    uint32_t * d_resident     = nullptr;  // [MAX_LAYERS * MAX_EXPERTS/32]
+
+    // HotSeat V2 Stage 0: finite device ring, copied only when the runtime is
+    // shut down. This keeps JSON serialization and D2H traffic off the decode
+    // hot path while preserving per-token/per-layer records for benchmarks.
+    bool v2_profile_enabled = false;
+    uint64_t v2_profile_capacity = 2048;
+    std::string v2_profile_dir;
+    ggml_hotexpert_v2_layer_record * d_v2_records = nullptr;
+    uint64_t * d_v2_token_count = nullptr;
+    uint64_t * d_v2_current_token = nullptr;
+    uint64_t v2_clock_rate_khz = 0;
+    uint64_t v2_profile_started_us = 0;
+    std::vector<uint64_t> v2_token_times_us;
+
+    // Stage 1 routing history.  h_v2_routes is CPU-visible pinned memory and
+    // d_v2_routes is its device alias (on ROCm they may be numerically equal).
+    bool v2_prefetch_enabled = false;
+    uint64_t v2_route_capacity = 64;
+    v2_route_record * h_v2_routes = nullptr;
+    v2_route_record * d_v2_routes = nullptr;
+    uint64_t * h_v2_route_latest = nullptr;
+    uint64_t * d_v2_route_latest = nullptr;
+    std::atomic<uint64_t> v2_route_complete_tokens{0};
+    std::atomic<uint64_t> v2_route_missing_layers{0};
+
+    // Stage 2: fixed-address double-buffered predictive transit storage.
+    // The per-layer metadata is device-resident and graph-safe; only its
+    // contents change.  A dedicated stream copies the predicted misses.
+    bool v2_transit_enabled = false;
+    int v2_transit_slots = 2;
+    void * d_v2_transit_base = nullptr;
+    size_t v2_transit_bytes = 0;
+    ggml_hotexpert_v2_transit_meta * d_v2_transit_meta = nullptr;
+    std::vector<ggml_hotexpert_v2_transit_meta> h_v2_transit_meta;
+    cudaStream_t v2_prefetch_stream = nullptr;
+    std::atomic<uint64_t> v2_prefetch_tokens{0};
+    std::atomic<uint64_t> v2_prefetch_experts{0};
+    std::atomic<uint64_t> v2_prefetch_bytes{0};
+    std::atomic<uint64_t> v2_routed_experts{0};
+    std::atomic<uint64_t> v2_resident_hits{0};
+    std::atomic<uint64_t> v2_transit_hits{0};
+
+    // Stage 2.4 persistent Transit: treat the two physical banks as a tiny
+    // two-entry per-layer cache instead of overwriting one bank every token.
+    // A predicted expert already present in either bank is carried forward
+    // with metadata only, eliminating the H2D copy.
+    bool v2_persistent_transit = false;
+    std::array<std::array<std::array<uint64_t, GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS>,
+        GGML_HOTEXPERT_V2_TRANSIT_BANKS>, MAX_LAYERS> v2_persistent_last_used{};
+    std::atomic<uint64_t> v2_persistent_reused{0};
+
+    // Stage 2.1 confidence-gated self-repeat predictor.  Scores are stored in
+    // parts-per-million so the decode worker never needs floating-point JSON
+    // parsing or model-specific code.
+    bool v2_predictor_loaded = false;
+    uint32_t v2_predictor_min_ppm = 0;
+    std::string v2_predictor_path;
+    std::array<std::array<uint32_t, MAX_EXPERTS>, MAX_LAYERS> v2_repeat_ppm{};
+    std::atomic<uint64_t> v2_predictor_skipped{0};
+
+    std::thread v2_prefetch_worker;
+    std::mutex v2_prefetch_mutex;
+    std::condition_variable v2_prefetch_cv;
+    bool v2_prefetch_stopping = false;
+    std::atomic<uint64_t> v2_latest_token{UINT64_MAX};
+
+    // Q122 V3 P1 exact barrier. The prefetch worker marks a target token done
+    // only after every H2D copy and device metadata publish has completed.
+    std::atomic<uint64_t> v3_prefetch_done_token{UINT64_MAX};
+    bool v3_prefill_adapt = false;
+    bool v3_prefill_pending = false;      // GPU counter path has data
+    bool v3_prefill_collecting = false;   // current request has prefill route data
+    std::mutex v3_ready_mutex;
+    std::condition_variable v3_ready_cv;
+
+    // Q122 V3 CPU-route predictor state. P1 uses the simplest high-precision
+    // confidence signal: an expert must appear in two consecutive cold routes
+    // for the same layer before a new H2D admission is allowed.
+    std::array<std::array<int32_t, GGML_HOTEXPERT_V2_PROFILE_TOP_K>, MAX_LAYERS> v3_prev_route{};
+    std::array<int, MAX_LAYERS> v3_prev_route_count{};
+    std::array<bool, MAX_LAYERS> v3_prev_route_valid{};
+
+    // Q122 V3 P5 TinyLFU-style admission. A tiny saturating frequency table
+    // keeps recurring experts resident and prevents one-off route noise from
+    // spending PCIe bandwidth or evicting useful Transit entries.
+    std::array<std::array<uint16_t, MAX_EXPERTS>, MAX_LAYERS> v3_freq{};
+    uint64_t v3_last_freq_decay_token = UINT64_MAX;
+    std::atomic<uint64_t> v3_admit_candidates{0};
+    std::atomic<uint64_t> v3_admit_rejected{0};
+
+    // Q122 V3 P4: async CPU-route staging. The worker may overwrite only
+    // Transit slots not selected by the current token; device metadata is not
+    // published until the next graph boundary.
+    std::thread v3_stage_worker;
+    std::atomic<bool> v3_stage_stopping{false};
+    std::mutex v3_stage_mutex;
+    cudaEvent_t v3_stage_event = nullptr;
+    std::atomic<uint64_t> v3_staged_target_token{UINT64_MAX};
+    std::atomic<uint64_t> v3_committed_target_token{UINT64_MAX};
+    std::atomic<uint64_t> v3_stage_wait_us{0};
+
+    // Q122 streamed per-layer staging. H2D for target token is enqueued as
+    // soon as each source-token layer route becomes available; device metadata
+    // remains unpublished until every split layer has been staged.
+    uint64_t v3_stream_source_token = UINT64_MAX;
+    std::array<bool, MAX_LAYERS> v3_stream_layer_done{};
+    int v3_stream_layers_done = 0;
+    int v3_stream_last_copy_ready = -1;
+    uint64_t v3_stream_copied_experts = 0;
+    uint64_t v3_stream_copied_bytes = 0;
+    uint64_t v3_stream_reused = 0;
+
+    // Q122 V3 P4 telemetry. These counters are observation-only and do not
+    // participate in cache admission or execution decisions.
+    std::atomic<uint64_t> v3_route_tokens{0};
+    std::atomic<uint64_t> v3_cold_routes{0};
+    std::atomic<uint64_t> v3_transit_route_hits{0};
+    std::atomic<uint64_t> v3_stage_copied_experts{0};
+    std::atomic<uint64_t> v3_stage_copied_bytes{0};
+    std::atomic<uint64_t> v3_commit_count{0};
+    std::array<std::atomic<uint64_t>, MAX_LAYERS> v3_layer_cold_routes{};
+    std::array<std::atomic<uint64_t>, MAX_LAYERS> v3_layer_transit_hits{};
+
+    // cross-thread counters
+    std::atomic<uint64_t> decode_tokens{0};
+    std::atomic<uint64_t> prefill_tokens{0};
+    std::atomic<uint64_t> requests{0};
+    std::atomic<bool>     eval_requested{false};
+    std::atomic<uint64_t> last_eval_decode{0};
+    std::atomic<uint64_t> last_eval_prefill{0};
+    std::atomic<uint64_t> last_eval_requests{0};
+
+    // pending commit (worker -> main)
+    std::unique_ptr<map_t> pending_map;
+    std::atomic<bool> commit_pending{false};
+    std::atomic<bool> commit_applied{false};
+    std::atomic<bool> commit_happened{false};   // set when a commit was applied this graph
+    std::mutex  commit_mutex;
+    std::condition_variable commit_cv;
+
+    // config
+    int    slots = SLOTS_PER_BANK;
+    int    full_count = 10;
+    int    expert_eval_tokens = 4096;
+    bool   expert_eval_auto = false;      // stage G: break-even adaptive cycle
+    double h2d_bw_bytes_per_ns = 12.0;    // measured H2D bandwidth
+    int    expert_eval_min = 1024;
+    int    expert_eval_max = 16384;
+    int    expert_eval_safety = 2;
+    int    expert_confirm = 2;
+    double expert_ratio = 1.25;
+    int    expert_max_swap = 8;
+    int    layer_eval_requests = 8;
+    int    layer_eval_prefill_tokens = 16384;
+    int    layer_confirm = 3;
+    double layer_ratio = 1.25;
+    int    layer_cooldown_requests = 8;
+    double bw_bytes_per_ns = 12.0;      // PCIe bandwidth estimate (GB/s)
+    double ewma_short = 0.25;
+    double ewma_long  = 0.05;
+    bool   eval_at_request = true;
+    std::atomic<int> full_cooldown{0};
+
+    // worker
+    std::thread worker;
+    std::mutex  worker_mutex;
+    std::condition_variable worker_cv;
+    bool stopping = false;
+
+    // logging
+    std::string log_path;
+    FILE * log_file = nullptr;
+    std::mutex log_mutex;
+
+    // tensor registry: host ptr -> (layer, kind)
+    std::unordered_map<const void *, std::pair<int, int>> registry;
+    std::mutex reg_mutex;
+
+    // initial Top-64 sets from the routing profile
+    std::array<std::vector<int>, MAX_LAYERS> ranked_experts;
+    bool profile_loaded = false;
+
+    // committed immutable map (main thread only)
+    std::unique_ptr<map_t> current_map;
+    std::unique_ptr<map_t> previous_map;   // stage I: rollback target
+
+    // stage I: circuit breaker / rollback telemetry
+    std::atomic<uint64_t> window_decode_tokens{0};
+    std::atomic<uint64_t> window_start_us{0};
+    std::atomic<double>   window_tps{0.0};
+    std::atomic<double>   last_tps{0.0};
+    std::atomic<int>      tps_drop_windows{0};
+    bool rollback_enabled = true;
+    int  rollback_tps_drop_pct = 5;
+    uint64_t rollback_min_free_bytes = 0;
+    std::atomic<bool> disabled{false};     // breaker tripped -> original path
+    std::string disable_reason;
+    std::string profile_path;                     // auto-picked profile (fingerprint-scoped)
+    std::atomic<bool> rollback_requested{false};   // J5: restore previous map
+
+    // V2 + DynamicKV elastic whole-bank balancing. Unlike R1 slice borrowing,
+    // the legacy V2 fast path owns fixed per-layer banks. We can still make it
+    // elastic by retiring the coldest complete bank at a graph-safe KV boundary
+    // and recreating it when VRAM comes back. The model pointers in the device
+    // tables are rebuilt synchronously, so no kernel can observe freed VRAM.
+    bool v2_dynkv_balance = false;
+    uint64_t v2_dynkv_low_bytes = 400u << 20;
+    uint64_t v2_dynkv_high_bytes = 600u << 20;
+    std::array<bool, MAX_LAYERS> v2_dynkv_evicted{};
+    std::array<std::vector<int>, MAX_LAYERS> v2_dynkv_saved_experts;
+    std::mutex v2_dynkv_mutex;
+
+    // Large-PP tail prefetch for the generic HotSeat V2 bank layout. During a
+    // large prompt all non-full banks may be retired. Near the tail, hot banks
+    // are allocated and filled on a non-blocking side stream but stay hidden
+    // from pointer tables until the final PP graph has completed.
+    bool v2_large_pp_suspended = false;
+    cudaStream_t v2_large_pp_stream = nullptr;
+    bool v2_large_pp_prefetch_queued = false;
+    size_t v2_large_pp_prefetch_bytes = 0;
+    std::array<bool, MAX_LAYERS> v2_large_pp_prefetch_layers{};
+
+    // stage K: persistent runtime snapshot across unload/reload
+    std::string snapshot_path;
+    bool snapshot_loaded = false;
+    bool snapshot_arena_restored = false;
+    uint64_t snapshot_generation = 1;
+    std::set<int> snapshot_full_layers;
+    std::array<std::vector<int>, MAX_LAYERS> snapshot_arena_experts;
+    std::array<std::vector<uint64_t>, MAX_LAYERS> snapshot_short_ppm;
+    std::array<std::vector<uint64_t>, MAX_LAYERS> snapshot_long_ppm;
+
+    // stage J: dynamic arena
+    hotseat_arena arena;
+    bool arena_enabled = false;
+    uint64_t arena_target_free_bytes = 800u << 20;
+    uint64_t arena_min_free_seen = 0;      // physical free low-water (bytes)
+    std::atomic<bool> arena_frozen{false}; // low-water breach -> no new capacity
+    std::vector<std::pair<uint64_t, uint64_t>> pending_arena_frees;   // {gate offset, pages}
+};
