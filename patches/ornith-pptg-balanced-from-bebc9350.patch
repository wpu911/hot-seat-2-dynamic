+        const char * v = std::getenv("Q122_HYBRID_FAST_WAIT");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    return enabled;
+}
+
+static bool q122_hybrid_lookahead_up_requested() {
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_HYBRID_LOOKAHEAD_UP");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    return enabled;
+}
+
+static bool q122_hybrid_compact_requested() {
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_HYBRID_COMPACT");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    return enabled;
+}
+
+static int q122_hybrid_static_fallback_slots() {
+    static const int slots = [] {
+        const char * v = std::getenv("Q122_R0_SKIP_SLOTS");
+        return std::clamp(v && *v ? std::atoi(v) : 21, 0, 256);
+    }();
+    return slots;
+}
+
+static bool q122_hybrid_gpu_owns_expert(int layer, int expert) {
+    if (layer < 0 || layer >= 48 || expert < 0 || expert >= 256) return false;
+    if (ggml_hotexpert_q122_resident_valid(layer)) {
+        if (ggml_hotexpert_q122_resident_contains(layer, expert)) return true;
+    } else {
+        const int base_slots = std::clamp(
+            ggml_hotexpert_q122_static_slots(layer, q122_hybrid_static_fallback_slots()), 0, 256);
+        for (int i = 0; i < base_slots; ++i) {
+            if (q122_r0_rank[layer][i] == expert) return true;
+        }
+        if (ggml_hotexpert_q122_borrow_valid(layer)) {
+            if (ggml_hotexpert_q122_borrow_contains(layer, expert)) return true;
+        } else {
+            const int active_slots = std::clamp(
+                ggml_hotexpert_q122_active_slots(layer, q122_hybrid_static_fallback_slots()), 0, 256);
+            for (int i = base_slots; i < active_slots; ++i) {
+                if (q122_r0_rank[layer][i] == expert) return true;
+            }
+        }
+    }
+    const uint64_t token = ggml_hotexpert_v3_current_token();
+    return ggml_hotexpert_v3_transit_contains(layer, token, expert) != 0;
+}
+
+static bool q122_hybrid_ensure_device_buffer(void ** ptr, size_t * cap, size_t need) {
+    if (*cap >= need && *ptr) return true;
+    if (*ptr) {
+        CUDA_CHECK(cudaFree(*ptr));
+        *ptr = nullptr;
+        *cap = 0;
+    }
+    CUDA_CHECK(cudaMalloc(ptr, need));
+    *cap = need;
+    return true;
+}
+
+static bool q122_hybrid_ensure_host_buffer(float ** ptr, size_t * cap, size_t need) {
+    if (*cap >= need && *ptr) return true;
+    if (*ptr) {
+        CUDA_CHECK(cudaFreeHost(*ptr));
+        *ptr = nullptr;
+        *cap = 0;
+    }
+    CUDA_CHECK(cudaMallocHost((void **) ptr, need));
+    *cap = need;
+    return true;
+}
+
+static void q122_hybrid_make_contig_f32(ggml_tensor & t, void * data, int64_t ne0, int64_t ne1 = 1) {
+    t.data = data;
+    t.type = GGML_TYPE_F32;
+    t.ne[0] = ne0; t.ne[1] = ne1; t.ne[2] = 1; t.ne[3] = 1;
+    t.nb[0] = sizeof(float);
+    t.nb[1] = size_t(ne0) * sizeof(float);
+    t.nb[2] = t.nb[1] * size_t(ne1);
+    t.nb[3] = t.nb[2];
+}
+
+static void q122_hybrid_make_single_q8_weight(ggml_tensor & t, const ggml_tensor * src, void * data) {
+    t = *src;
+    t.data = data;
+    t.ne[2] = 1;
+    t.ne[3] = 1;
+}
+
+static bool q122_hybrid_launch_current_spill(
+        ggml_backend_cuda_context * ctx,
+        q122_hybrid_cuda_state & st,
+        int layer,
+        const ggml_tensor * gate_w,
+        const ggml_tensor * gate_src1,
+        const ggml_tensor * ids,
+        const ggml_tensor * gate_dst) {
+    st.spill_active = false;
+    st.spill_layer = layer;
+    st.spill_expert = -1;
+    st.spill_pos = -1;
+    ggml_hotexpert_hybrid_spill_publish(layer, -1);
+
+    if (!q122_hybrid_current_spill_requested() || !q122_hybrid_full_layer_requested() ||
+        !q122_hybrid_spill_layer_allowed(layer) ||
+        q122_hybrid_full_compact_requested() || q122_hybrid_full_par_up_requested() ||
+        q122_hybrid_full_fused_gu_requested() || q122_hybrid_compact_requested() ||
+        q122_hybrid_zerocopy_permille_local() > 0) {
+        return false;
+    }
+    if (!gate_w || !gate_src1 || !ids || !gate_dst || ids->ne[0] <= 0) return false;
+
+    const ggml_tensor * up_w = ggml_hotexpert_hybrid_get_weight(layer, GGML_HOTEXPERT_HYBRID_KIND_UP);
+    const ggml_tensor * down_w = ggml_hotexpert_hybrid_get_weight(layer, GGML_HOTEXPERT_HYBRID_KIND_DOWN);
+    if (!up_w || !down_w || gate_w->type != GGML_TYPE_Q8_0 || up_w->type != GGML_TYPE_Q8_0 || down_w->type != GGML_TYPE_Q8_0) return false;
+
+    int cold_count = 0;
+    int spill_expert = -1;
+    int spill_pos = -1;
+    const int n_ids = std::min<int>(ids->ne[0], 8);
+    for (int i = 0; i < n_ids; ++i) {
+        const int e = *reinterpret_cast<const int32_t *>(static_cast<const char *>(ids->data) + size_t(i) * ids->nb[0]);
+        if (e < 0 || e >= 256) continue;
+        if (!q122_hybrid_gpu_owns_expert(layer, e)) {
+            if (spill_expert < 0) { spill_expert = e; spill_pos = i; }
+            ++cold_count;
+        }
+    }
+    if (cold_count < q122_hybrid_spill_min_cold() || spill_expert < 0 || spill_pos < 0) return false;
+
+    const size_t gate_slice = gate_w->nb[2];
+    const size_t up_slice = up_w->nb[2];
+    const size_t down_slice = down_w->nb[2];
+    const size_t max_slice = std::max({gate_slice, up_slice, down_slice});
+    const size_t in_bytes = size_t(gate_src1->ne[0]) * sizeof(float);
+    const int64_t mid_dim = gate_w->ne[1];
+    const int64_t out_dim = down_w->ne[1];
+    const size_t mid_bytes = size_t(mid_dim) * sizeof(float);
+    const size_t out_bytes = size_t(out_dim) * sizeof(float);
+    if (up_w->ne[1] != mid_dim || down_w->ne[0] != mid_dim || gate_src1->ne[0] != gate_w->ne[0]) return false;
+
+    q122_hybrid_ensure_device_buffer(&st.d_spill_w, &st.spill_w_cap, max_slice);
+    q122_hybrid_ensure_device_buffer(&st.d_spill_src, &st.spill_src_cap, in_bytes);
+    q122_hybrid_ensure_device_buffer(&st.d_spill_gate, &st.spill_gate_cap, mid_bytes);
+    q122_hybrid_ensure_device_buffer(&st.d_spill_up, &st.spill_up_cap, mid_bytes);
+    q122_hybrid_ensure_device_buffer(&st.d_spill_act, &st.spill_act_cap, mid_bytes);
+    q122_hybrid_ensure_device_buffer(&st.d_spill_out, &st.spill_out_cap, out_bytes);
+    q122_hybrid_ensure_host_buffer(&st.h_spill_out, &st.h_spill_out_cap, out_bytes);
+    if (!st.spill_done) CUDA_CHECK(cudaEventCreateWithFlags(&st.spill_done, cudaEventDisableTiming));
+
+    constexpr int spill_stream_no = GGML_CUDA_MAX_STREAMS - 2;
+    cudaStream_t spill_stream = ctx->stream(ctx->device, spill_stream_no);
+    const int saved_stream_no = ctx->curr_stream_no;
+    ctx->curr_stream_no = spill_stream_no;
+
+    // Copy the tiny activation once. The one reusable weight buffer is filled
+    // gate -> up -> down in stream order, so only one expert slice of VRAM is needed.
+    CUDA_CHECK(cudaMemcpyAsync(st.d_spill_src, gate_src1->data, in_bytes, cudaMemcpyHostToDevice, spill_stream));
+
+    ggml_tensor x_gate = *gate_src1;
+    q122_hybrid_make_contig_f32(x_gate, st.d_spill_src, gate_w->ne[0], 1);
+    ggml_tensor out_gate = *gate_dst;
+    q122_hybrid_make_contig_f32(out_gate, st.d_spill_gate, mid_dim, 1);
+    ggml_tensor w_gate{};
+    q122_hybrid_make_single_q8_weight(w_gate, gate_w, st.d_spill_w);
+    CUDA_CHECK(cudaMemcpyAsync(st.d_spill_w,
+        static_cast<const char *>(gate_w->data) + size_t(spill_expert) * gate_slice,
+        gate_slice, cudaMemcpyHostToDevice, spill_stream));
+    ggml_cuda_mul_mat_vec_q(*ctx, &w_gate, &x_gate, nullptr, &out_gate, nullptr);
+
+    ggml_tensor out_up = out_gate;
+    out_up.data = st.d_spill_up;
+    ggml_tensor w_up{};
+    q122_hybrid_make_single_q8_weight(w_up, up_w, st.d_spill_w);
+    CUDA_CHECK(cudaMemcpyAsync(st.d_spill_w,
+        static_cast<const char *>(up_w->data) + size_t(spill_expert) * up_slice,
+        up_slice, cudaMemcpyHostToDevice, spill_stream));
+    ggml_cuda_mul_mat_vec_q(*ctx, &w_up, &x_gate, nullptr, &out_up, nullptr);
+
+    const int threads = 256;
+    const int blocks = int((size_t(mid_dim) + threads - 1) / threads);
+    q122_hybrid_swiglu_f32_kernel<<<blocks, threads, 0, spill_stream>>>(
+        static_cast<const float *>(st.d_spill_gate), static_cast<const float *>(st.d_spill_up),
+        static_cast<float *>(st.d_spill_act), size_t(mid_dim));
+    CUDA_CHECK(cudaGetLastError());
+
+    ggml_tensor x_down = x_gate;
+    q122_hybrid_make_contig_f32(x_down, st.d_spill_act, mid_dim, 1);
+    ggml_tensor out_down = out_gate;
+    q122_hybrid_make_contig_f32(out_down, st.d_spill_out, out_dim, 1);
+    ggml_tensor w_down{};
+    q122_hybrid_make_single_q8_weight(w_down, down_w, st.d_spill_w);
+    CUDA_CHECK(cudaMemcpyAsync(st.d_spill_w,
+        static_cast<const char *>(down_w->data) + size_t(spill_expert) * down_slice,
+        down_slice, cudaMemcpyHostToDevice, spill_stream));
+    ggml_cuda_mul_mat_vec_q(*ctx, &w_down, &x_down, nullptr, &out_down, nullptr);
+    CUDA_CHECK(cudaMemcpyAsync(st.h_spill_out, st.d_spill_out, out_bytes, cudaMemcpyDeviceToHost, spill_stream));
+    CUDA_CHECK(cudaEventRecord(st.spill_done, spill_stream));
+    ctx->curr_stream_no = saved_stream_no;
+
+    st.spill_active = true;
+    st.spill_layer = layer;
+    st.spill_expert = spill_expert;
+    st.spill_pos = spill_pos;
+    ++st.spill_layers;
+    st.spill_bytes += uint64_t(gate_slice + up_slice + down_slice);
+    ggml_hotexpert_hybrid_spill_publish(layer, spill_expert);
+    return true;
+}
+
+static int q122_hybrid_cuda_start_cb(
+        void * user,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * ids,
+        ggml_tensor * dst) {
+    if (!q122_hybrid_requested() || !user || !src0 || !src1 || !ids || !dst) return 0;
+    if ((src0->type != GGML_TYPE_Q8_0 && src0->type != GGML_TYPE_Q4_K) || src1->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || dst->type != GGML_TYPE_F32) return 0;
+    if (ids->ne[1] != 1 || dst->ne[2] != 1) return 0;
+
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(user);
+    auto & st = g_q122_hybrid_cuda;
+    const int kind = dst->op_params[GGML_HOTEXPERT_HYBRID_KIND_INDEX];
+    const int layer = dst->op_params[GGML_HOTEXPERT_HYBRID_LAYER_INDEX];
+    const bool pair = q122_hybrid_pair_requested();
+    const uint64_t prof_t0 = q122_hybrid_profile_requested() ? uint64_t(ggml_time_us()) : 0;
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (st.pending || (st.ctx && st.ctx != ctx)) return 0;
+    const bool lookahead = q122_hybrid_lookahead_up_requested() && !q122_hybrid_pair_requested();
+    if (st.lookahead_up_valid) {
+        if (!lookahead || kind != GGML_HOTEXPERT_HYBRID_KIND_UP || layer != st.lookahead_layer) return 0;
+        st.pending = true;
+        st.pending_dst = dst;
+        st.pending_kind = kind;
+        st.pending_layer = layer;
+        st.pending_lookahead = true;
+        ++st.starts;
+        if (st.starts <= 12) {
+            std::fprintf(stderr, "Q122 HYBRID GPU adopt-lookahead name=%s layer=%d\n", dst->name, layer);
+            std::fflush(stderr);
+        }
+        return 1;
+    }
+    st.pending_lookahead = false;
+    // Runtime scheduler order for this Qwen3.5 graph is GATE -> UP -> DOWN.
+    // A deferred GATE is therefore only legal immediately before matching UP.
+    // No expert scale/bias node consumes GATE between these two MMIDs.
+    if (st.deferred_gate && (!pair || kind != GGML_HOTEXPERT_HYBRID_KIND_UP || layer != st.deferred_layer)) return 0;
+
+    ggml_cuda_set_device(ctx->device);
+
+    // Q122 Full-Layer Hybrid: keep resident GATE/UP intermediates on device and
+    // synchronize only once at DOWN. Optional FULL_COMPACT determines GPU-owned
+    // selected experts once at GATE, then reuses that compact ordering for the
+    // entire GATE -> UP -> SwiGLU -> DOWN device path. This is safe for DOWN
+    // because the device activation is itself produced in compact order.
+    if (q122_hybrid_full_layer_requested()) {
+        if (pair || lookahead || q122_hybrid_compact_requested()) return 0;
+        const bool full_compact = q122_hybrid_full_compact_requested();
+        cudaStream_t stream = ctx->stream();
+        const size_t full_ids_bytes = ggml_nbytes(ids);
+        const size_t full_dst_bytes = ggml_nbytes(dst);
+
+        if (kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) {
+            st.full_gate_valid = false;
+            st.full_up_valid = false;
+            st.full_up_parallel = false;
+            st.full_fused_gu = false;
+            st.full_layer = layer;
+            // Publish/enqueue one extra cold expert before CPU threads leave the
+            // start-callback barrier. The temporary path is independent of P5 Transit.
+            (void) q122_hybrid_launch_current_spill(ctx, st, layer, src0, src1, ids, dst);
+
+            int compact_count = int(ids->ne[0]);
+            if (full_compact) {
+                compact_count = 0;
+                const int n_ids = std::min<int>(ids->ne[0], 8);
+                for (int i = 0; i < n_ids; ++i) {
+                    const int expert = *reinterpret_cast<const int32_t *>(
+                        static_cast<const char *>(ids->data) + size_t(i) * ids->nb[0]);
+                    if (q122_hybrid_gpu_owns_expert(layer, expert)) {
+                        st.compact_pos[compact_count] = i;
+                        // Keep IDs in persistent state memory: the H2D copy is async.
+                        reinterpret_cast<int32_t *>(st.compact_ids_host)[compact_count] = expert;
+                        ++compact_count;
+                    }
+                }
+                for (int i = compact_count; i < 8; ++i) st.compact_pos[i] = -1;
+            }
+            st.compact_active = full_compact;
+            st.compact_count = compact_count;
+
+            const size_t mid_row_bytes = size_t(dst->ne[0]) * sizeof(float);
+            const size_t ids_bytes = full_compact ? size_t(compact_count) * sizeof(int32_t) : full_ids_bytes;
+            const size_t dst_bytes = full_compact ? size_t(compact_count) * mid_row_bytes : full_dst_bytes;
+            st.compact_row_bytes = mid_row_bytes;
+            st.full_mid_bytes = dst_bytes;
+
+            if (compact_count == 0) {
+                st.full_gate_valid = true;
+                st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+                ++st.starts;
+                return 1;
+            }
+
+            const size_t src1_bytes = ggml_nbytes(src1);
+            q122_hybrid_ensure_device_buffer(&st.d_src1, &st.src1_cap, src1_bytes);
+            q122_hybrid_ensure_device_buffer(&st.d_ids, &st.ids_cap, std::max<size_t>(ids_bytes, sizeof(int32_t)));
+            q122_hybrid_ensure_device_buffer(&st.d_full_gate, &st.full_gate_cap, dst_bytes);
+            CUDA_CHECK(cudaMemcpyAsync(st.d_src1, src1->data, src1_bytes, cudaMemcpyHostToDevice, stream));
+            const void * ids_src = full_compact ? static_cast<const void *>(st.compact_ids_host) : ids->data;
+            CUDA_CHECK(cudaMemcpyAsync(st.d_ids, ids_src, ids_bytes, cudaMemcpyHostToDevice, stream));
+            const bool par_up = q122_hybrid_full_par_up_requested() && !full_compact;
+            if (par_up) {
+                if (!st.full_input_ready) CUDA_CHECK(cudaEventCreateWithFlags(&st.full_input_ready, cudaEventDisableTiming));
+                if (!st.full_up_done) CUDA_CHECK(cudaEventCreateWithFlags(&st.full_up_done, cudaEventDisableTiming));
+                CUDA_CHECK(cudaEventRecord(st.full_input_ready, stream));
+            }
+            CUDA_CHECK(cudaMemsetAsync(st.d_full_gate, 0, dst_bytes, stream));
+            ggml_tensor src1_d = *src1, ids_d = *ids, dst_d = *dst;
+            src1_d.data = st.d_src1; ids_d.data = st.d_ids; dst_d.data = st.d_full_gate;
+            if (full_compact) {
+                ids_d.ne[0] = compact_count;
+                ids_d.nb[1] = size_t(compact_count) * sizeof(int32_t);
+                dst_d.ne[1] = compact_count;
+                dst_d.nb[1] = mid_row_bytes;
+                dst_d.nb[2] = mid_row_bytes * size_t(compact_count);
+            }
+
+            const bool fused_gu = q122_hybrid_full_fused_gu_requested() && !full_compact && !par_up;
+            if (fused_gu) {
+                const ggml_tensor * up_w = ggml_hotexpert_hybrid_get_weight(layer, GGML_HOTEXPERT_HYBRID_KIND_UP);
+                if (up_w && up_w->type == GGML_TYPE_Q8_0 &&
+                    up_w->ne[0] == src0->ne[0] && up_w->ne[1] == src0->ne[1] && up_w->ne[2] == src0->ne[2]) {
+                    q122_hybrid_ensure_device_buffer(&st.d_full_act, &st.full_act_cap, dst_bytes);
+                    CUDA_CHECK(cudaMemsetAsync(st.d_full_act, 0, dst_bytes, stream));
+                    ggml_tensor fused_dst = dst_d;
+                    fused_dst.data = st.d_full_act;
+                    ggml_cuda_mm_fusion_args_host fusion_data{};
+                    fusion_data.gate = src0;
+                    fusion_data.glu_op = GGML_GLU_OP_SWIGLU;
+                    ggml_cuda_mul_mat_vec_q(*ctx, up_w, &src1_d, &ids_d, &fused_dst, &fusion_data);
+                    st.full_gate_valid = true;
+                    st.full_up_valid = true;
+                    st.full_fused_gu = true;
+                }
+            }
+            if (!st.full_fused_gu) {
+                ggml_cuda_mul_mat_vec_q(*ctx, src0, &src1_d, &ids_d, &dst_d, nullptr);
+                st.full_gate_valid = true;
+            }
+
+            if (par_up) {
+                const ggml_tensor * up_w = ggml_hotexpert_hybrid_get_weight(layer, GGML_HOTEXPERT_HYBRID_KIND_UP);
+                if (up_w && up_w->type == GGML_TYPE_Q8_0 &&
+                    up_w->ne[0] == src0->ne[0] && up_w->ne[1] == src0->ne[1] && up_w->ne[2] == src0->ne[2]) {
+                    q122_hybrid_ensure_device_buffer(&st.d_full_up, &st.full_up_cap, dst_bytes);
+                    constexpr int aux_stream_no = GGML_CUDA_MAX_STREAMS - 1;
+                    cudaStream_t aux = ctx->stream(ctx->device, aux_stream_no);
+                    CUDA_CHECK(cudaStreamWaitEvent(aux, st.full_input_ready, 0));
+                    CUDA_CHECK(cudaMemsetAsync(st.d_full_up, 0, dst_bytes, aux));
+                    ggml_tensor up_dst = dst_d;
+                    up_dst.data = st.d_full_up;
+                    const int saved_stream_no = ctx->curr_stream_no;
+                    ctx->curr_stream_no = aux_stream_no;
+                    ggml_cuda_mul_mat_vec_q(*ctx, up_w, &src1_d, &ids_d, &up_dst, nullptr);
+                    ctx->curr_stream_no = saved_stream_no;
+                    CUDA_CHECK(cudaEventRecord(st.full_up_done, aux));
+                    st.full_up_valid = true;
+                    st.full_up_parallel = true;
+                }
+            }
+            st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+            ++st.starts;
+            return 1;
+        }
+
+        if (kind == GGML_HOTEXPERT_HYBRID_KIND_UP) {
+            if (!st.full_gate_valid || st.full_layer != layer) return 0;
+            const int compact_count = st.compact_count;
+            if (compact_count == 0) {
+                st.full_up_valid = true;
+                st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+                ++st.starts;
+                return 1;
+            }
+            const size_t mid_row_bytes = size_t(dst->ne[0]) * sizeof(float);
+            const size_t dst_bytes = st.compact_active ? size_t(compact_count) * mid_row_bytes : full_dst_bytes;
+            if (dst_bytes != st.full_mid_bytes) return 0;
+            if (st.full_fused_gu && st.full_up_valid) {
+                st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+                ++st.starts;
+                return 1;
+            }
+            if (st.full_up_parallel && st.full_up_valid) {
+                st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+                ++st.starts;
+                return 1;
+            }
+            q122_hybrid_ensure_device_buffer(&st.d_full_up, &st.full_up_cap, dst_bytes);
+            CUDA_CHECK(cudaMemsetAsync(st.d_full_up, 0, dst_bytes, stream));
+            ggml_tensor src1_d = *src1, ids_d = *ids, dst_d = *dst;
+            src1_d.data = st.d_src1; ids_d.data = st.d_ids; dst_d.data = st.d_full_up;
+            if (st.compact_active) {
+                ids_d.ne[0] = compact_count;
+                ids_d.nb[1] = size_t(compact_count) * sizeof(int32_t);
+                dst_d.ne[1] = compact_count;
+                dst_d.nb[1] = mid_row_bytes;
+                dst_d.nb[2] = mid_row_bytes * size_t(compact_count);
+            }
+            ggml_cuda_mul_mat_vec_q(*ctx, src0, &src1_d, &ids_d, &dst_d, nullptr);
+            st.full_up_valid = true;
+            st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+            ++st.starts;
+            return 1;
+        }
+
+        if (kind == GGML_HOTEXPERT_HYBRID_KIND_DOWN) {
+            if (!st.full_gate_valid || !st.full_up_valid || st.full_layer != layer) return 0;
+            const int compact_count = st.compact_count;
+            if (compact_count == 0) {
+                st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+                ++st.starts;
+                return 1;
+            }
+            const size_t mid_row_bytes = size_t(src1->ne[0]) * sizeof(float);
+            const size_t act_bytes = st.compact_active ? size_t(compact_count) * mid_row_bytes : ggml_nbytes(src1);
+            if (act_bytes != st.full_mid_bytes) return 0;
+            const size_t out_row_bytes = size_t(dst->ne[0]) * sizeof(float);
+            const size_t dst_bytes = st.compact_active ? size_t(compact_count) * out_row_bytes : full_dst_bytes;
+            q122_hybrid_ensure_device_buffer(&st.d_full_act, &st.full_act_cap, act_bytes);
+            q122_hybrid_ensure_device_buffer(&st.d_dst, &st.dst_cap, std::max<size_t>(dst_bytes, out_row_bytes));
+            q122_hybrid_ensure_host_buffer(&st.h_dst, &st.h_dst_cap, std::max<size_t>(dst_bytes, out_row_bytes));
+            if (!st.done) CUDA_CHECK(cudaEventCreateWithFlags(&st.done, cudaEventDisableTiming));
+            if (st.full_up_parallel && st.full_up_done) {
+                CUDA_CHECK(cudaStreamWaitEvent(stream, st.full_up_done, 0));
+            }
+            if (!st.full_fused_gu) {
+                const size_t nf = act_bytes / sizeof(float);
+                const int threads = 256;
+                const int blocks = int((nf + threads - 1) / threads);
+                q122_hybrid_swiglu_f32_kernel<<<blocks, threads, 0, stream>>>(
+                    static_cast<const float *>(st.d_full_gate), static_cast<const float *>(st.d_full_up),
+                    static_cast<float *>(st.d_full_act), nf);
+                CUDA_CHECK(cudaGetLastError());
+            }
+            CUDA_CHECK(cudaMemsetAsync(st.d_dst, 0, dst_bytes, stream));
+            ggml_tensor src1_d = *src1, ids_d = *ids, dst_d = *dst;
+            src1_d.data = st.d_full_act; ids_d.data = st.d_ids; dst_d.data = st.d_dst;
+            if (st.compact_active) {
+                src1_d.ne[1] = compact_count;
+                src1_d.nb[1] = mid_row_bytes;
+                src1_d.nb[2] = mid_row_bytes * size_t(compact_count);
+                ids_d.ne[0] = compact_count;
+                ids_d.nb[1] = size_t(compact_count) * sizeof(int32_t);
+                dst_d.ne[1] = compact_count;
+                dst_d.nb[1] = out_row_bytes;
+                dst_d.nb[2] = out_row_bytes * size_t(compact_count);
+                st.compact_row_bytes = out_row_bytes;
+            }
+            ggml_cuda_mul_mat_vec_q(*ctx, src0, &src1_d, &ids_d, &dst_d, nullptr);
+            CUDA_CHECK(cudaMemcpyAsync(st.h_dst, st.d_dst, dst_bytes, cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaEventRecord(st.done, stream));
+            st.ctx = ctx; st.pending = true; st.pending_dst = dst; st.pending_kind = kind; st.pending_layer = layer;
+            ++st.starts;
+            return 1;
+        }
+        return 0;
+    }
+
+    const bool compact = q122_hybrid_compact_requested() && !pair && !lookahead;
+    int32_t compact_ids[8] = {-1,-1,-1,-1,-1,-1,-1,-1};
+    int compact_pos[8] = {-1,-1,-1,-1,-1,-1,-1,-1};
+    int compact_count = 0;
+    if (compact) {
+        const int n_ids = std::min<int>(ids->ne[0], 8);
+        for (int i = 0; i < n_ids; ++i) {
+            const int expert = *reinterpret_cast<const int32_t *>(static_cast<const char *>(ids->data) + size_t(i) * ids->nb[0]);
+            if (q122_hybrid_gpu_owns_expert(layer, expert)) {
+                compact_ids[compact_count] = expert;
+                compact_pos[compact_count] = i;
+                ++compact_count;
+            }
+        }
+    }
+    const size_t src1_bytes = ggml_nbytes(src1);
+    const size_t full_ids_bytes = ggml_nbytes(ids);
+    const size_t full_dst_bytes = ggml_nbytes(dst);
+    const size_t row_bytes = size_t(dst->ne[0]) * sizeof(float);
+    const size_t ids_bytes = compact ? size_t(compact_count) * sizeof(int32_t) : full_ids_bytes;
+    const size_t dst_bytes = compact ? size_t(compact_count) * row_bytes : full_dst_bytes;
+    st.compact_active = compact;
+    st.compact_count = compact_count;
+    st.compact_row_bytes = row_bytes;
+    for (int i = 0; i < 8; ++i) st.compact_pos[i] = compact_pos[i];
+    if (compact && compact_count == 0) {
+        st.ctx = ctx;
+        st.pending = true;
+        st.pending_dst = dst;
+        st.pending_kind = kind;
+        st.pending_layer = layer;
+        ++st.starts;
+        return 1;
+    }
+    q122_hybrid_ensure_device_buffer(&st.d_src1, &st.src1_cap, src1_bytes);
+    q122_hybrid_ensure_device_buffer(&st.d_ids, &st.ids_cap, std::max<size_t>(ids_bytes, sizeof(int32_t)));
+    q122_hybrid_ensure_device_buffer(&st.d_dst, &st.dst_cap, std::max<size_t>(dst_bytes, row_bytes));
+    if (pair && kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) {
+        q122_hybrid_ensure_host_buffer(&st.h_deferred, &st.h_deferred_cap, dst_bytes);
+        // Preallocate the normal buffer as well, so UP start never allocates
+        // pinned memory while the deferred GATE is still in flight.
+        q122_hybrid_ensure_host_buffer(&st.h_dst, &st.h_dst_cap, dst_bytes);
+    } else {
+        q122_hybrid_ensure_host_buffer(&st.h_dst, &st.h_dst_cap, dst_bytes);
+    }
+    if (!st.done) CUDA_CHECK(cudaEventCreateWithFlags(&st.done, cudaEventDisableTiming));
+    if (lookahead && kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) {
+        q122_hybrid_ensure_host_buffer(&st.h_lookahead, &st.h_lookahead_cap, dst_bytes);
+        if (!st.lookahead_done) CUDA_CHECK(cudaEventCreateWithFlags(&st.lookahead_done, cudaEventDisableTiming));
+    }
+    st.ctx = ctx;
+
+    cudaStream_t stream = ctx->stream();
+    if (q122_hybrid_profile_requested()) {
+        if (!st.prof_begin) CUDA_CHECK(cudaEventCreateWithFlags(&st.prof_begin, 0));
+        if (!st.prof_end) CUDA_CHECK(cudaEventCreateWithFlags(&st.prof_end, 0));
+        CUDA_CHECK(cudaEventRecord(st.prof_begin, stream));
+    }
+    CUDA_CHECK(cudaMemcpyAsync(st.d_src1, src1->data, src1_bytes, cudaMemcpyHostToDevice, stream));
+    const void * ids_source = compact ? static_cast<const void *>(compact_ids) : ids->data;
+    CUDA_CHECK(cudaMemcpyAsync(st.d_ids, ids_source, ids_bytes, cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaMemsetAsync(st.d_dst, 0, dst_bytes, stream));
+
+    ggml_tensor src1_d = *src1;
+    ggml_tensor ids_d = *ids;
+    ggml_tensor dst_d = *dst;
+    src1_d.data = st.d_src1;
+    ids_d.data = st.d_ids;
+    dst_d.data = st.d_dst;
+    if (compact) {
+        ids_d.ne[0] = compact_count;
+        ids_d.nb[1] = size_t(compact_count) * sizeof(int32_t);
+        dst_d.ne[1] = compact_count;
+        dst_d.nb[1] = row_bytes;
+        dst_d.nb[2] = row_bytes * size_t(compact_count);
+    }
+
+    ggml_cuda_mul_mat_vec_q(*ctx, src0, &src1_d, &ids_d, &dst_d, nullptr);
+    float * host_target = (pair && kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) ? st.h_deferred : st.h_dst;
+    CUDA_CHECK(cudaMemcpyAsync(host_target, st.d_dst, dst_bytes, cudaMemcpyDeviceToHost, stream));
+    if (q122_hybrid_profile_requested() && st.prof_end) CUDA_CHECK(cudaEventRecord(st.prof_end, stream));
+    CUDA_CHECK(cudaEventRecord(st.done, stream));
+    if (lookahead && kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) {
+        const ggml_tensor * up_w = ggml_hotexpert_hybrid_get_weight(layer, GGML_HOTEXPERT_HYBRID_KIND_UP);
+        if (up_w && up_w->type == GGML_TYPE_Q8_0 && up_w->ne[0] == src0->ne[0] && up_w->ne[1] == src0->ne[1] && up_w->ne[2] == src0->ne[2]) {
+            CUDA_CHECK(cudaMemsetAsync(st.d_dst, 0, dst_bytes, stream));
+            ggml_tensor look_dst = dst_d;
+            look_dst.data = st.d_dst;
+            ggml_cuda_mul_mat_vec_q(*ctx, up_w, &src1_d, &ids_d, &look_dst, nullptr);
+            CUDA_CHECK(cudaMemcpyAsync(st.h_lookahead, st.d_dst, dst_bytes, cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaEventRecord(st.lookahead_done, stream));
+            st.lookahead_up_valid = true;
+            st.lookahead_layer = layer;
+        }
+    }
+    st.pending = true;
+    st.pending_dst = dst;
+    st.pending_kind = kind;
+    st.pending_layer = layer;
+    ++st.starts;
+    if (q122_hybrid_profile_requested()) {
+        st.prof_start_us += uint64_t(ggml_time_us()) - prof_t0;
+    }
+    if (st.starts <= 12) {
+        std::fprintf(stderr, "Q122 HYBRID GPU start name=%s src=%zu ids=%zu dst=%zu\n",
+            dst->name, src1_bytes, ids_bytes, dst_bytes);
+        std::fflush(stderr);
+    }
+    return 1;
+}
+
+static int q122_hybrid_cuda_finish_cb(void * user, ggml_tensor * dst) {
+    if (!user || !dst) return 0;
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(user);
+    auto & st = g_q122_hybrid_cuda;
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.pending || st.ctx != ctx || st.pending_dst != dst) return 0;
+    const int kind = st.pending_kind;
+    const int layer = st.pending_layer;
+    if (q122_hybrid_full_layer_requested() &&
+        (kind == GGML_HOTEXPERT_HYBRID_KIND_GATE || kind == GGML_HOTEXPERT_HYBRID_KIND_UP)) {
+        // Device work stays ordered on the same stream. Do not wait or merge;
+        // the CPU graph continues with zero resident rows and DOWN will join.
+        st.pending = false;
+        st.pending_dst = nullptr;
+        st.pending_kind = 0;
+        st.pending_layer = -1;
+        return 1;
+    }
+    if (q122_hybrid_pair_requested() && kind == GGML_HOTEXPERT_HYBRID_KIND_GATE) {
+        st.deferred_gate = true;
+        st.deferred_dst = dst;
+        st.deferred_layer = layer;
+        st.pending = false;
+        st.pending_dst = nullptr;
+        st.pending_kind = 0;
+        st.pending_layer = -1;
+        return 1;
+    }
+
+    if (st.compact_active && st.compact_count == 0) {
+        st.compact_active = false;
+        st.compact_count = 0;
+        st.pending = false;
+        st.pending_dst = nullptr;
+        st.pending_kind = 0;
+        st.pending_layer = -1;
+        return 1;
+    }
+    ggml_cuda_set_device(ctx->device);
+    const bool use_lookahead = st.pending_lookahead;
+    cudaEvent_t finish_event = use_lookahead ? st.lookahead_done : st.done;
+    float * finish_host = use_lookahead ? st.h_lookahead : st.h_dst;
+    uint64_t wait_t0 = 0;
+    bool prof_ready = false;
+    if (q122_hybrid_profile_requested()) {
+        ++st.prof_calls;
+        if (layer >= 0 && layer < 48 && kind >= 0 && kind < 5) ++st.prof_calls_lk[layer][kind];
+#if defined(GGML_USE_HIP)
+        const hipError_t q = hipEventQuery(finish_event);
+        if (q == hipSuccess) { ++st.prof_ready_at_finish; prof_ready = true; }
+        else if (q != hipErrorNotReady) CUDA_CHECK(q);
+#else
+        const cudaError_t q = cudaEventQuery(finish_event);
+        if (q == cudaSuccess) { ++st.prof_ready_at_finish; prof_ready = true; }
+        else if (q != cudaErrorNotReady) CUDA_CHECK(q);
+#endif
+        if (prof_ready && layer >= 0 && layer < 48 && kind >= 0 && kind < 5) ++st.prof_ready_lk[layer][kind];
+        wait_t0 = uint64_t(ggml_time_us());
+    }
+    bool event_ready = false;
+    if (q122_hybrid_fast_wait_requested()) {
+#if defined(GGML_USE_HIP)
+        const hipError_t q = hipEventQuery(finish_event);
+        if (q == hipSuccess) event_ready = true;
+        else if (q != hipErrorNotReady) CUDA_CHECK(q);
+#else
+        const cudaError_t q = cudaEventQuery(finish_event);
+        if (q == cudaSuccess) event_ready = true;
+        else if (q != cudaErrorNotReady) CUDA_CHECK(q);
+#endif
+    }
+    if (!event_ready) CUDA_CHECK(cudaEventSynchronize(finish_event));
+    if (q122_hybrid_profile_requested() && !use_lookahead && st.prof_begin && st.prof_end &&
+        layer >= 0 && layer < 48 && kind >= 0 && kind < 5) {
+        float gpu_ms = 0.0f;
+        #if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipEventElapsedTime(&gpu_ms, st.prof_begin, st.prof_end));
+#else
+        CUDA_CHECK(cudaEventElapsedTime(&gpu_ms, st.prof_begin, st.prof_end));
+#endif
+        st.prof_gpu_us_lk[layer][kind] += (uint64_t) (gpu_ms * 1000.0f + 0.5f);
+    }
+    if (q122_hybrid_current_spill_requested() && kind == GGML_HOTEXPERT_HYBRID_KIND_DOWN &&
+        st.spill_active && st.spill_layer == layer && st.spill_done) {
+        const uint64_t spill_wait_t0 = uint64_t(ggml_time_us());
+        CUDA_CHECK(cudaEventSynchronize(st.spill_done));
+        st.spill_wait_us += uint64_t(ggml_time_us()) - spill_wait_t0;
+        if ((st.spill_layers & 255u) == 0u && st.spill_layers > 0) {
+            std::fprintf(stderr,
+                "Q122 HYBRID SPILL live layers=%llu h2d_mib=%.2f wait_us_per=%.2f\n",
+                (unsigned long long) st.spill_layers,
+                double(st.spill_bytes) / (1024.0 * 1024.0),
+                double(st.spill_wait_us) / double(st.spill_layers));
+            std::fflush(stderr);
+        }
+    }
+    const uint64_t merge_t0 = q122_hybrid_profile_requested() ? uint64_t(ggml_time_us()) : 0;
+    if (q122_hybrid_profile_requested()) {
+        const uint64_t wait_us = merge_t0 - wait_t0;
+        st.prof_wait_us += wait_us;
+        if (layer >= 0 && layer < 48 && kind >= 0 && kind < 5) st.prof_wait_us_lk[layer][kind] += wait_us;
+    }
+    if (st.compact_active) {
+        char * outb = static_cast<char *>(dst->data);
+        const char * inb = reinterpret_cast<const char *>(finish_host);
+        for (int j = 0; j < st.compact_count; ++j) {
+            const int pos = st.compact_pos[j];
+            if (pos >= 0) std::memcpy(outb + size_t(pos) * dst->nb[1], inb + size_t(j) * st.compact_row_bytes, st.compact_row_bytes);
+        }
+    } else {
+        const size_t n = ggml_nelements(dst);
+        float * out = static_cast<float *>(dst->data);
+        for (size_t i = 0; i < n; ++i) out[i] += finish_host[i];
+    }
+    if (q122_hybrid_current_spill_requested() && kind == GGML_HOTEXPERT_HYBRID_KIND_DOWN &&
+        st.spill_active && st.spill_layer == layer && st.spill_pos >= 0 && st.h_spill_out) {
+        float * spill_row = reinterpret_cast<float *>(
+            static_cast<char *>(dst->data) + size_t(st.spill_pos) * dst->nb[1]);
+        const size_t nspill = size_t(dst->ne[0]);
+        for (size_t i = 0; i < nspill; ++i) spill_row[i] += st.h_spill_out[i];
+        ggml_hotexpert_hybrid_spill_publish(layer, -1);
+        st.spill_active = false;
+        st.spill_layer = -1;
+        st.spill_expert = -1;
+        st.spill_pos = -1;
+    }
+    if (q122_hybrid_pair_requested() && kind == GGML_HOTEXPERT_HYBRID_KIND_UP &&
+        st.deferred_gate && st.deferred_layer == layer && st.deferred_dst) {
+        const size_t un = ggml_nelements(st.deferred_dst);
+        float * uout = static_cast<float *>(st.deferred_dst->data);
+        for (size_t i = 0; i < un; ++i) uout[i] += st.h_deferred[i];
+        st.deferred_gate = false;
+        st.deferred_dst = nullptr;
+        st.deferred_layer = -1;
+    }
+    if (q122_hybrid_profile_requested()) st.prof_merge_us += uint64_t(ggml_time_us()) - merge_t0;
+    if (use_lookahead) {
+        st.lookahead_up_valid = false;
+        st.lookahead_layer = -1;
+    }
+    st.pending_lookahead = false;
+    if (q122_hybrid_full_layer_requested() && kind == GGML_HOTEXPERT_HYBRID_KIND_DOWN) {
+        st.full_gate_valid = false;
+        st.full_up_valid = false;
+        st.full_up_parallel = false;
+        st.full_fused_gu = false;
+        st.full_layer = -1;
+        st.full_mid_bytes = 0;
+    }
+    st.compact_active = false;
+    st.compact_count = 0;
+    st.pending = false;
+    st.pending_dst = nullptr;
+    st.pending_kind = 0;
+    st.pending_layer = -1;
+    return 1;
+}
+
+static void q122_hybrid_cuda_cleanup(ggml_backend_cuda_context * ctx) {
+    auto & st = g_q122_hybrid_cuda;
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (st.ctx != ctx) return;
+    if (q122_hybrid_profile_requested() && st.prof_calls) {
+        std::fprintf(stderr,
+            "Q122 HYBRID PROFILE calls=%llu ready_at_finish=%llu ready_pct=%.2f start_us_per=%.2f wait_us_per=%.2f merge_us_per=%.2f\n",
+            (unsigned long long) st.prof_calls, (unsigned long long) st.prof_ready_at_finish,
+            100.0 * double(st.prof_ready_at_finish) / double(st.prof_calls),
+            double(st.prof_start_us) / double(st.prof_calls),
+            double(st.prof_wait_us) / double(st.prof_calls),
+            double(st.prof_merge_us) / double(st.prof_calls));
+        std::fflush(stderr);
+        if (const char * vv = std::getenv("Q122_HYBRID_PROFILE_VERBOSE"); vv && std::strcmp(vv, "1") == 0) {
+            for (int l = 0; l < 48; ++l) {
+                for (int k = 1; k < 5; ++k) {
+                    const uint64_t c = st.prof_calls_lk[l][k];
+                    if (!c) continue;
+                    std::fprintf(stderr,
+                        "Q122 HYBRID PROFILE_LK layer=%d kind=%d calls=%llu ready_pct=%.2f wait_us_per=%.2f gpu_us_per=%.2f\n",
+                        l, k, (unsigned long long)c,
+                        100.0 * double(st.prof_ready_lk[l][k]) / double(c),
+                        double(st.prof_wait_us_lk[l][k]) / double(c),
+                        double(st.prof_gpu_us_lk[l][k]) / double(c));
+                }
+            }
+            std::fflush(stderr);
+        }
+    }
+    if (q122_hybrid_current_spill_requested() && st.spill_layers) {
+        std::fprintf(stderr,
+            "Q122 HYBRID SPILL summary layers=%llu h2d_mib=%.2f wait_us_per=%.2f\n",
+            (unsigned long long) st.spill_layers,
+            double(st.spill_bytes) / (1024.0 * 1024.0),
+            double(st.spill_wait_us) / double(st.spill_layers));
+        std::fflush(stderr);
+    }
+    ggml_cuda_set_device(ctx->device);
+    if (st.pending && st.done) (void) cudaEventSynchronize(st.done);
+    if (st.done) CUDA_CHECK(cudaEventDestroy(st.done));
+    if (st.lookahead_done) CUDA_CHECK(cudaEventDestroy(st.lookahead_done));
+    if (st.full_input_ready) CUDA_CHECK(cudaEventDestroy(st.full_input_ready));
+    if (st.full_up_done) CUDA_CHECK(cudaEventDestroy(st.full_up_done));
+    if (st.spill_done) CUDA_CHECK(cudaEventDestroy(st.spill_done));
+    if (st.prof_begin) CUDA_CHECK(cudaEventDestroy(st.prof_begin));
+    if (st.prof_end) CUDA_CHECK(cudaEventDestroy(st.prof_end));
+    if (st.d_src1) CUDA_CHECK(cudaFree(st.d_src1));
+    if (st.d_ids) CUDA_CHECK(cudaFree(st.d_ids));
+    if (st.d_dst) CUDA_CHECK(cudaFree(st.d_dst));
+    if (st.d_full_gate) CUDA_CHECK(cudaFree(st.d_full_gate));
+    if (st.d_full_up) CUDA_CHECK(cudaFree(st.d_full_up));
+    if (st.d_full_act) CUDA_CHECK(cudaFree(st.d_full_act));
+    if (st.d_spill_w) CUDA_CHECK(cudaFree(st.d_spill_w));
+    if (st.d_spill_src) CUDA_CHECK(cudaFree(st.d_spill_src));
+    if (st.d_spill_gate) CUDA_CHECK(cudaFree(st.d_spill_gate));
+    if (st.d_spill_up) CUDA_CHECK(cudaFree(st.d_spill_up));
+    if (st.d_spill_act) CUDA_CHECK(cudaFree(st.d_spill_act));
+    if (st.d_spill_out) CUDA_CHECK(cudaFree(st.d_spill_out));
+    if (st.h_spill_out) CUDA_CHECK(cudaFreeHost(st.h_spill_out));
+    if (st.h_dst) CUDA_CHECK(cudaFreeHost(st.h_dst));
+    if (st.h_lookahead) CUDA_CHECK(cudaFreeHost(st.h_lookahead));
+    if (st.h_deferred) CUDA_CHECK(cudaFreeHost(st.h_deferred));
