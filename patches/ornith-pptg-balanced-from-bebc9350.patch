 #define MMID_MATRIX_ROW(row_id, i1) matrix_rows[(row_id)*ids->ne[0]*ids->ne[1] + (i1)]
 
+
+// Qwen3.5-122B Resident/Miss Split R0 upper-bound experiment.
+// Q122_R0_SKIP_SLOTS=N pretends the long-profile top-N experts are already
+// computed by a zero-cost GPU resident path. CPU MMID skips them and clears
+// their output slice. This intentionally changes model output and is disabled
+// by default; it exists only in the isolated q122 worktree.
+#include "q122-r0-rank.inc"
+
+static atomic_ullong q122_r0_rows_total = 0;
+static atomic_ullong q122_r0_rows_skipped = 0;
+
+
+// HotSeat V3 Q122 P0 telemetry/planner. Profile-only: this code never changes
+// the R1 execution path. It observes the real routed expert set on the CPU miss
+// branch and computes an advisory FreeToken-style CPU/H2D split for later P3.
+// P0's contract is bit-for-bit identical execution behavior to Q122 R1.
+struct q122_v3_layer_stats {
+    atomic_ullong steps;
+    atomic_ullong routed;
+    atomic_ullong resident_hits;
+    atomic_ullong true_misses;
+    atomic_ullong advisory_gpu_fetch;
+    atomic_ullong advisory_cpu_overflow;
+    atomic_ullong lru2_hits;
+    atomic_ullong lru4_hits;
+    atomic_ullong lru6_hits;
+    atomic_ullong lru8_hits;
+};
+
+struct q122_v3_lru_state {
+    int experts[8];
+    int count;
+};
+
+static struct q122_v3_layer_stats q122_v3_stats[48];
+static struct q122_v3_lru_state q122_v3_lru[48];
+static atomic_ullong q122_v3_steps_total = 0;
+static atomic_ullong q122_v3_routed_total = 0;
+static atomic_ullong q122_v3_resident_total = 0;
+static atomic_ullong q122_v3_miss_total = 0;
+static atomic_ullong q122_v3_gpu_fetch_total = 0;
+static atomic_ullong q122_v3_cpu_overflow_total = 0;
+static atomic_ullong q122_v3_lru2_total = 0;
+static atomic_ullong q122_v3_lru4_total = 0;
+static atomic_ullong q122_v3_lru6_total = 0;
+static atomic_ullong q122_v3_lru8_total = 0;
+
+static int q122_v3_lru_find(const struct q122_v3_lru_state * lru, int expert) {
+    for (int i = 0; i < lru->count; ++i) {
+        if (lru->experts[i] == expert) return i;
+    }
+    return -1;
+}
+
+static void q122_v3_lru_touch(struct q122_v3_lru_state * lru, int expert) {
+    int pos = q122_v3_lru_find(lru, expert);
+    if (pos < 0) {
+        pos = lru->count < 8 ? lru->count++ : 7;
+    }
+    for (int i = pos; i > 0; --i) lru->experts[i] = lru->experts[i - 1];
+    lru->experts[0] = expert;
+}
+
+static bool q122_v3_enabled(void) {
+    static int initialized = 0;
+    static bool enabled = false;
+    if (!initialized) {
+        const char * v = getenv("Q122_V3");
+        enabled = v && strcmp(v, "1") == 0;
+        initialized = 1;
+    }
+    return enabled;
+}
+
+static bool q122_v3_profile_mode(void) {
+    if (!q122_v3_enabled()) return false;
+    const char * v = getenv("Q122_V3_MODE");
+    return !v || !*v || strcmp(v, "profile") == 0;
+}
+
+static bool q122_v3_transit_mode_cpu(void) {
+    if (!q122_v3_enabled()) return false;
+    const char * v = getenv("Q122_V3_MODE");
+    return v && (strcmp(v, "transit") == 0 || strcmp(v, "predictive") == 0 ||
+                 strcmp(v, "hybrid") == 0 || strcmp(v, "adaptive") == 0);
+}
+
+static double q122_v3_env_double(const char * name, double fallback) {
+    const char * v = getenv(name);
+    if (!v || !*v) return fallback;
+    char * end = NULL;
+    const double x = strtod(v, &end);
+    return end != v && x > 0.0 ? x : fallback;
+}
+
+static double q122_v3_fetch_fraction(void) {
+    // Prefer overlap measurements because simultaneous RAM/CPU and PCIe traffic
+    // is the workload we actually care about. Defaults are conservative seeds
+    // only; P3 will replace these with startup calibration/profile loading.
+    const double cpu = q122_v3_env_double("Q122_V3_CPU_OVERLAP_GBS", 40.0);
+    const double h2d = q122_v3_env_double("Q122_V3_H2D_OVERLAP_GBS", 24.0);
+    double safety = q122_v3_env_double("Q122_V3_FETCH_SAFETY", 0.90);
+    if (safety > 1.0) safety = 1.0;
+    double f = h2d / (cpu + h2d);
+    f *= safety;
+    if (f < 0.0) f = 0.0;
+    if (f > 1.0) f = 1.0;
+    return f;
+}
+
+static int q122_v3_advisory_fetch_count(int misses) {
+    if (misses <= 0) return 0;
+    // Round to nearest expert, but never consume the entire miss set in P0's
+    // advisory model unless the fraction is effectively 1.0.
+    const double f = q122_v3_fetch_fraction();
+    int n = (int) (misses * f + 0.5);
+    if (n < 0) n = 0;
+    if (n > misses) n = misses;
+    return n;
+}
+
+static void q122_v3_report(void) {
+    if (!q122_v3_enabled()) return;
+    const uint64_t steps = atomic_load_explicit(&q122_v3_steps_total, memory_order_relaxed);
+    const uint64_t routed = atomic_load_explicit(&q122_v3_routed_total, memory_order_relaxed);
+    const uint64_t resident = atomic_load_explicit(&q122_v3_resident_total, memory_order_relaxed);
+    const uint64_t misses = atomic_load_explicit(&q122_v3_miss_total, memory_order_relaxed);
+    const uint64_t gpu = atomic_load_explicit(&q122_v3_gpu_fetch_total, memory_order_relaxed);
+    const uint64_t cpu = atomic_load_explicit(&q122_v3_cpu_overflow_total, memory_order_relaxed);
+    const uint64_t lru2 = atomic_load_explicit(&q122_v3_lru2_total, memory_order_relaxed);
+    const uint64_t lru4 = atomic_load_explicit(&q122_v3_lru4_total, memory_order_relaxed);
+    const uint64_t lru6 = atomic_load_explicit(&q122_v3_lru6_total, memory_order_relaxed);
+    const uint64_t lru8 = atomic_load_explicit(&q122_v3_lru8_total, memory_order_relaxed);
