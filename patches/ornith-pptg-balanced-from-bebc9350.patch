+static bool ggml_backend_cuda_vmm_map_tensor_rows(ggml_backend_buffer_t buffer, ggml_tensor * tensor, uint32_t rows) {
+    auto * ctx = (ggml_backend_cuda_vmm_buffer_context *) buffer->context;
+    if (tensor->view_src != nullptr) return true;
+    const size_t tensor_off = (size_t) ((char *) tensor->data - (char *) ctx->dev_ptr);
+
+    if ((uint64_t) tensor->ne[1] != ctx->logical_rows) {
+        const size_t full = ggml_backend_buft_get_alloc_size(buffer->buft, tensor);
+        return ctx->map_range(tensor_off, full);
+    }
+
+    rows = std::min<uint32_t>(rows, ctx->logical_rows);
+    const size_t prefix = rows == ctx->logical_rows
+        ? ggml_backend_buft_get_alloc_size(buffer->buft, tensor)
+        : size_t(rows) * tensor->nb[1];
+
+    const uint64_t n_streams = std::max<int64_t>(1, tensor->ne[2]) * std::max<int64_t>(1, tensor->ne[3]);
+    for (uint64_t sidx = 0; sidx < n_streams; ++sidx) {
+        const size_t stream_off = tensor_off + size_t(sidx) * tensor->nb[2];
+        if (!ctx->map_range(stream_off, prefix)) return false;
+    }
+    return true;
+}
