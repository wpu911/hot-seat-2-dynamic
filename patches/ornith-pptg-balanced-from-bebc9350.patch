+// ---------------------------------------------------------------------------
+// name parsing (mirrors hotexpert-profiler.cu)
+// ---------------------------------------------------------------------------
+
+static int parse_layer(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    const char * prefixes[] = { "ffn_moe_topk-", "ffn_moe_argsort-", "ffn_moe_selected_experts_l", "blk." };
+    for (const char * prefix : prefixes) {
+        const char * p = std::strstr(name, prefix);
+        if (!p) {
+            continue;
+        }
+        p += std::strlen(prefix);
+        if (*p < '0' || *p > '9') {
+            continue;
+        }
+        int layer = 0;
+        while (*p >= '0' && *p <= '9') {
+            layer = layer * 10 + (*p++ - '0');
+        }
+        return layer < MAX_LAYERS ? layer : -1;
+    }
+    return -1;
+}
+
+static int tensor_kind(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    if (std::strstr(name, "ffn_gate_up_exps") != nullptr) return TENSOR_GU;
+    if (std::strstr(name, "ffn_gate_exps")    != nullptr) return TENSOR_GATE;
+    if (std::strstr(name, "ffn_up_exps")      != nullptr) return TENSOR_UP;
+    if (std::strstr(name, "ffn_down_exps")    != nullptr) return TENSOR_DOWN;
+    return -1;
+}
