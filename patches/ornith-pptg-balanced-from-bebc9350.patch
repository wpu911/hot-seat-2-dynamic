+std::array<std::atomic<int>, V3_MAX_LAYERS> q122_active_slots_encoded{};
+std::array<std::array<std::atomic<uint64_t>, V3_MASK_WORDS>, V3_MAX_LAYERS> q122_borrow_mask{};
+std::array<std::atomic<int>, V3_MAX_LAYERS> q122_borrow_valid{};
+std::array<std::array<std::atomic<uint64_t>, V3_MASK_WORDS>, V3_MAX_LAYERS> q122_resident_mask{};
