+ggml_backend_buffer_t ggml_backend_cuda_vmm_alloc_buffer(
+        ggml_backend_buffer_type_t buft, size_t size, uint32_t logical_rows, uint32_t initial_rows) {
+#if defined(GGML_USE_HIP)
+    const bool is_cuda_buft = buft && ggml_backend_buft_is_cuda(buft);
+    std::fprintf(stderr, "Q122_DYNKV_ALLOC_STDERR buft=%s is_cuda=%d size=%.2fMiB logical_rows=%u initial=%u\n",
+                 buft ? ggml_backend_buft_name(buft) : "null", is_cuda_buft ? 1 : 0, size/1048576.0, logical_rows, initial_rows);
+    std::fflush(stderr);
+    if (!buft || !is_cuda_buft || size == 0 || logical_rows == 0) return nullptr;
+    auto * buft_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    ggml_cuda_set_device(buft_ctx->device);
+
+    hipMemAllocationProp prop{};
+    prop.type = hipMemAllocationTypePinned;
+    prop.requestedHandleType = hipMemHandleTypeNone;
+    prop.location.type = hipMemLocationTypeDevice;
+    prop.location.id = ggml_cuda_get_physical_device(buft_ctx->device);
+    size_t gran = 0;
+    if (hipMemGetAllocationGranularity(&gran, &prop, hipMemAllocationGranularityMinimum) != hipSuccess || gran == 0) return nullptr;
+    const size_t reserve_size = ((size + gran - 1)/gran)*gran;
+    void * base = nullptr;
+    hipError_t err = hipMemAddressReserve(&base, reserve_size, gran, nullptr, 0);
+    std::fprintf(stderr, "Q122_DYNKV_RESERVE_STDERR err=%d base=%p reserve=%.2fMiB gran=%zu device=%d\n", (int)err, base, reserve_size/1048576.0, gran, buft_ctx->device); std::fflush(stderr);
+    if (err != hipSuccess) {
+        GGML_LOG_WARN("Q122 DYNKV VMM: reserve %.2f MiB failed: %s\n", reserve_size/1048576.0, hipGetErrorString(err));
+        return nullptr;
+    }
+    auto * ctx = new ggml_backend_cuda_vmm_buffer_context();
+    ctx->device = buft_ctx->device;
+    ctx->dev_ptr = base;
+    ctx->reserve_size = reserve_size;
+    ctx->logical_size = size;
+    ctx->granularity = gran;
+    ctx->logical_rows = logical_rows;
+    ctx->initial_rows = std::min(initial_rows, logical_rows);
+    ctx->page_mapped.assign(reserve_size/gran, 0);
+    GGML_LOG_INFO("Q122 DYNKV VMM: reserved %.2f MiB VA, initial_rows=%u/%u gran=%zu\n",
+                  reserve_size/1048576.0, ctx->initial_rows, logical_rows, gran);
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_vmm_buffer_interface, ctx, size);
+#else
+    GGML_UNUSED(buft); GGML_UNUSED(size); GGML_UNUSED(logical_rows); GGML_UNUSED(initial_rows);
+    return nullptr;
+#endif
+}
