+static bool tensor_registry_find(const void * host_ptr, int & layer, int & kind) {
+    std::lock_guard<std::mutex> lock(g_state.reg_mutex);
+    auto found = g_state.registry.find(host_ptr);
+    if (found == g_state.registry.end()) {
+        return false;
+    }
+    layer = found->second.first;
+    kind  = found->second.second;
+    return true;
+}
