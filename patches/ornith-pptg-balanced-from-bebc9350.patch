+static runtime_mode env_mode() {
+    const char * value = std::getenv("HOTSEAT_RUNTIME_MODE");
+    if (!value || !*value) {
+        return MODE_STATIC;
+    }
+    if (std::strcmp(value, "dynamic-experts") == 0) {
+        return MODE_DYNAMIC_EXPERTS;
+    }
+    if (std::strcmp(value, "dynamic-hybrid") == 0) {
+        return MODE_DYNAMIC_HYBRID;
+    }
+    return MODE_STATIC;
+}
+
+static bool q122_v3_transit_mode() {
+    const char * enabled = std::getenv("Q122_V3");
+    const char * mode = std::getenv("Q122_V3_MODE");
+    return enabled && std::strcmp(enabled, "1") == 0 && mode &&
+        (std::strcmp(mode, "transit") == 0 || std::strcmp(mode, "predictive") == 0 ||
+         std::strcmp(mode, "hybrid") == 0 || std::strcmp(mode, "adaptive") == 0);
+}
+
+static const std::array<bool, MAX_LAYERS> & q122_v3_split_layers() {
+    static const std::array<bool, MAX_LAYERS> mask = [] {
+        std::array<bool, MAX_LAYERS> out{};
+        const char * list = std::getenv("Q122_R1_SPLIT_LAYERS");
+        if (list && *list) {
+            const char * q = list;
+            while (*q) {
+                while (*q == ' ' || *q == ',') ++q;
+                if (!*q) break;
+                char * end = nullptr;
+                const long layer = std::strtol(q, &end, 10);
+                if (end == q) break;
+                if (layer >= 0 && layer < MAX_LAYERS) out[size_t(layer)] = true;
+                q = end;
+            }
+        } else {
+            const char * one = std::getenv("Q122_R1_SPLIT_LAYER");
+            const int layer = one && *one ? std::atoi(one) : 3;
+            if (layer >= 0 && layer < MAX_LAYERS) out[size_t(layer)] = true;
+        }
+        return out;
+    }();
+    return mask;
+}
+
+static bool q122_v3_split_layer(int layer) {
+    return layer >= 0 && layer < MAX_LAYERS && q122_v3_split_layers()[size_t(layer)];
+}
+
+
+// V3 per-layer Transit capacity hook. P5 defaults to the measured 3 slots/bank
+// across all split layers. Q122_V3_BASE_SLOTS_PER_BANK can lower the base and
+// Q122_V3_ELASTIC_LAYERS can selectively retain the max capacity when VRAM is tight.
+static int q122_v3_base_transit_slots() {
+    static const int slots = [] {
+        const char * v = std::getenv("Q122_V3_BASE_SLOTS_PER_BANK");
+        const int parsed = (v && *v) ? std::atoi(v) : 3;
+        return std::clamp(parsed, 1, GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS);
+    }();
+    return slots;
+}
+
+static const std::array<bool, MAX_LAYERS> & q122_v3_elastic_layers() {
+    static const std::array<bool, MAX_LAYERS> mask = [] {
+        std::array<bool, MAX_LAYERS> out{};
+        const char * list = std::getenv("Q122_V3_ELASTIC_LAYERS");
+        if (!list || !*list) list = "22,26,29,44";
+        const char * q = list;
+        while (*q) {
+            while (*q == ' ' || *q == ',') ++q;
+            if (!*q) break;
+            char * end = nullptr;
+            const long layer = std::strtol(q, &end, 10);
+            if (end == q) break;
+            if (layer >= 0 && layer < MAX_LAYERS) out[size_t(layer)] = true;
+            q = end;
+        }
+        return out;
+    }();
+    return mask;
+}
+
+static int q122_v3_layer_transit_slots(const rt_state & s, int layer) {
+    if (!s.transit_only) return s.v2_transit_slots;
+    static const std::array<int, MAX_LAYERS> planned = [] {
+        std::array<int, MAX_LAYERS> out{};
+        out.fill(-1);
+        const char * spec = std::getenv("Q122_TRANSIT_LAYER_SLOTS");
+        if (!spec || !*spec) return out;
+        const char * p = spec;
+        while (*p) {
+            while (*p == ' ' || *p == ',') ++p;
+            if (!*p) break;
+            char * end = nullptr;
+            const long l = std::strtol(p, &end, 10);
+            if (end == p || *end != ':') break;
+            p = end + 1;
+            const long n = std::strtol(p, &end, 10);
+            if (end == p) break;
+            if (l >= 0 && l < MAX_LAYERS) out[size_t(l)] = int(n);
+            p = end;
+        }
+        return out;
+    }();
+    if (layer >= 0 && layer < MAX_LAYERS && planned[size_t(layer)] >= 0) {
+        return std::clamp(planned[size_t(layer)], 1, s.v2_transit_slots);
+    }
+    const int base = std::min(q122_v3_base_transit_slots(), s.v2_transit_slots);
+    if (layer >= 0 && layer < MAX_LAYERS && q122_v3_elastic_layers()[size_t(layer)]) {
+        return s.v2_transit_slots;
+    }
+    return base;
+}
+
+static int q122_v3_static_slots() {
+    const char * v = std::getenv("Q122_R0_SKIP_SLOTS");
+    int slots = v && *v ? std::atoi(v) : 21;
+    return std::clamp(slots, 0, MAX_EXPERTS);
+}
