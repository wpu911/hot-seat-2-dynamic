+#if defined(GGML_USE_HIP)
+struct ggml_backend_cuda_vmm_extent {
+    size_t off = 0;
+    size_t size = 0;
+    hipMemGenericAllocationHandle_t handle{};
+};
+
+struct ggml_backend_cuda_vmm_range {
+    size_t off = 0;
+    size_t size = 0;
+};
+
+struct ggml_backend_cuda_vmm_buffer_context {
+    int device = 0;
+    void * dev_ptr = nullptr;
+    size_t reserve_size = 0;
+    size_t logical_size = 0;
+    size_t granularity = 0;
+    uint32_t logical_rows = 0;
+    uint32_t initial_rows = 0;
+    std::vector<uint8_t> page_mapped;
+    std::vector<ggml_backend_cuda_vmm_extent> extents;
+    std::vector<ggml_backend_cuda_vmm_range> initial_ranges;
+    std::mutex mutex;
+
+    bool map_range(size_t off, size_t len) {
+        if (len == 0) return true;
+        if (off >= logical_size || len > logical_size - off) {
+            GGML_LOG_ERROR("Q122 DYNKV VMM: invalid map range off=%zu len=%zu logical=%zu\n", off, len, logical_size);
+            return false;
+        }
+        const size_t p0 = off / granularity;
+        const size_t p1 = (off + len + granularity - 1) / granularity;
+        std::lock_guard<std::mutex> lock(mutex);
+        ggml_cuda_set_device(device);
+
+        hipMemAllocationProp prop{};
+        prop.type = hipMemAllocationTypePinned;
+        prop.requestedHandleType = hipMemHandleTypeNone;
+        prop.location.type = hipMemLocationTypeDevice;
+        prop.location.id = ggml_cuda_get_physical_device(device);
+
+        hipMemAccessDesc acc{};
+        acc.location.type = hipMemLocationTypeDevice;
+        acc.location.id = ggml_cuda_get_physical_device(device);
+        acc.flags = hipMemAccessFlagsProtReadWrite;
+
+        size_t i = p0;
+        while (i < p1) {
+            while (i < p1 && page_mapped[i]) ++i;
+            if (i >= p1) break;
+            const size_t run0 = i;
+            while (i < p1 && !page_mapped[i]) ++i;
+            const size_t run1 = i;
+            const size_t run_off = run0 * granularity;
+            const size_t run_size = (run1 - run0) * granularity;
+            // Before sparse KV commits new physical VRAM, repay elastic expert
+            // chunks until the configured low-water reserve can survive this
+            // exact allocation. This is the real KV<->expert see-saw.
+            // Let both elastic expert implementations make room before the
+            // sparse KV page is committed. Q122 R1 uses slice borrowing; HotSeat
+            // V2 uses whole per-layer expert banks so its fast V2 path stays intact.
+            if (!ggml_backend_cuda_hotseat_v2_reserve_bytes(run_size)) {
+                GGML_LOG_ERROR("HOTSEAT V2 DYNKV: cannot reserve %.2f MiB while preserving VRAM watermark\n",
+                               run_size/1048576.0);
+                return false;
+            }
+            if (!ggml_backend_cuda_q122_dynborrow_reserve_bytes(run_size)) {
+                GGML_LOG_ERROR("Q122 DYNKV VMM: cannot reserve %.2f MiB while preserving VRAM watermark\n",
+                               run_size/1048576.0);
+                return false;
+            }
+            hipMemGenericAllocationHandle_t handle{};
+            hipError_t err = hipMemCreate(&handle, run_size, &prop, 0);
+            if (err != hipSuccess) {
+                GGML_LOG_ERROR("Q122 DYNKV VMM: hipMemCreate %.2f MiB failed: %s\n", run_size/1048576.0, hipGetErrorString(err));
+                return false;
+            }
+            err = hipMemMap((char *) dev_ptr + run_off, run_size, 0, handle, 0);
+            if (err != hipSuccess) {
+                hipMemRelease(handle);
+                GGML_LOG_ERROR("Q122 DYNKV VMM: hipMemMap failed: %s\n", hipGetErrorString(err));
+                return false;
+            }
+            err = hipMemSetAccess((char *) dev_ptr + run_off, run_size, &acc, 1);
+            if (err != hipSuccess) {
+                hipMemUnmap((char *) dev_ptr + run_off, run_size);
+                hipMemRelease(handle);
+                GGML_LOG_ERROR("Q122 DYNKV VMM: hipMemSetAccess failed: %s\n", hipGetErrorString(err));
+                return false;
+            }
+            for (size_t p = run0; p < run1; ++p) page_mapped[p] = 1;
+            extents.push_back({run_off, run_size, handle});
+        }
+        return true;
+    }
+
+    bool reset_to_initial(uint8_t value) {
+        ggml_cuda_set_device(device);
+        CUDA_CHECK(cudaDeviceSynchronize());
+
+        size_t before_pages = 0;
+        size_t before_extents = 0;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            for (uint8_t v : page_mapped) before_pages += v ? 1 : 0;
+            before_extents = extents.size();
+            for (auto it = extents.rbegin(); it != extents.rend(); ++it) {
+                const hipError_t u = hipMemUnmap((char *) dev_ptr + it->off, it->size);
+                if (u != hipSuccess) {
+                    GGML_LOG_ERROR("Q122 DYNKV VMM: reset unmap failed off=%zu size=%zu: %s\n",
+                                   it->off, it->size, hipGetErrorString(u));
+                    return false;
+                }
+                const hipError_t r = hipMemRelease(it->handle);
+                if (r != hipSuccess) {
+                    GGML_LOG_ERROR("Q122 DYNKV VMM: reset release failed: %s\n", hipGetErrorString(r));
+                    return false;
+                }
+            }
+            extents.clear();
+            std::fill(page_mapped.begin(), page_mapped.end(), uint8_t(0));
+        }
+
+        // Recreate only the immutable startup footprint. This includes full-size
+        // metadata tensors and the initial KV prefix for every K/V stream.
+        for (const auto & r : initial_ranges) {
+            if (!map_range(r.off, r.size)) return false;
+        }
+
+        size_t after_pages = 0;
+        size_t after_extents = 0;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            for (uint8_t v : page_mapped) after_pages += v ? 1 : 0;
+            after_extents = extents.size();
+            for (const auto & e : extents) {
+                CUDA_CHECK(cudaMemsetAsync((char *) dev_ptr + e.off, value, e.size, cudaStreamPerThread));
+            }
+        }
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        std::fprintf(stderr,
+            "Q122_DYNKV_SHRINK_STDERR before=%.2fMiB after=%.2fMiB extents=%zu->%zu initial_rows=%u ranges=%zu\n",
+            before_pages*granularity/1048576.0, after_pages*granularity/1048576.0,
+            before_extents, after_extents, initial_rows, initial_ranges.size());
+        std::fflush(stderr);
+        return true;
+    }
+
+    ~ggml_backend_cuda_vmm_buffer_context() {
+        ggml_cuda_set_device(device);
+        for (auto it = extents.rbegin(); it != extents.rend(); ++it) {
+            (void) hipMemUnmap((char *) dev_ptr + it->off, it->size);
+            (void) hipMemRelease(it->handle);
+        }
+        if (dev_ptr) (void) hipMemAddressFree(dev_ptr, reserve_size);
+    }
+};
