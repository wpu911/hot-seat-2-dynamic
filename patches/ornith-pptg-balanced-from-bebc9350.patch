+// shutdown
+// ---------------------------------------------------------------------------
+
+static double v2_cycles_to_us(const rt_state & s, uint64_t cycles) {
+    return s.v2_clock_rate_khz > 0
+        ? double(cycles) * 1000.0 / double(s.v2_clock_rate_khz)
+        : 0.0;
+}
+
+static uint64_t v2_expert_bytes(const rt_state & s, int layer) {
+    uint64_t bytes = 0;
+    for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+        const tensor_slot & t = s.layers[layer].tensors[kind];
+        if (t.host_ptr && t.stride > 0) {
+            bytes += uint64_t(t.stride);
+        }
+    }
+    return bytes;
+}
+
+static void dump_v2_profile(rt_state & s) {
+    if (!s.v2_profile_enabled || !s.d_v2_records || !s.d_v2_token_count ||
+        s.v2_profile_capacity == 0 || s.n_layers <= 0) {
+        return;
+    }
+
+    uint64_t total_tokens = 0;
+    CUDA_CHECK(cudaMemcpy(&total_tokens, s.d_v2_token_count, sizeof(total_tokens), cudaMemcpyDeviceToHost));
+    const uint64_t kept_tokens = std::min(total_tokens, s.v2_profile_capacity);
+    const uint64_t first_token = total_tokens - kept_tokens;
+    const size_t record_count = size_t(s.v2_profile_capacity) * size_t(s.n_layers);
+    std::vector<ggml_hotexpert_v2_layer_record> records(record_count);
+    CUDA_CHECK(cudaMemcpy(records.data(), s.d_v2_records,
+        record_count * sizeof(ggml_hotexpert_v2_layer_record), cudaMemcpyDeviceToHost));
+
+    size_t free_now = 0;
+    size_t total_vram = 0;
+    if (hipMemGetInfo(&free_now, &total_vram) != hipSuccess) {
+        free_now = 0;
+        total_vram = 0;
+    }
+    const uint64_t low_water = s.arena_min_free_seen
+        ? s.arena_min_free_seen
+        : uint64_t(free_now);
+
+    std::error_code ec;
+    std::filesystem::create_directories(s.v2_profile_dir, ec);
+    if (ec) {
+        GGML_LOG_ERROR("HotSeat V2 profiler: cannot create %s: %s\n",
+            s.v2_profile_dir.c_str(), ec.message().c_str());
+        return;
+    }
+    const std::string token_path = s.v2_profile_dir + "/v2-token-profile.jsonl";
+    const std::string layer_path = s.v2_profile_dir + "/v2-layer-profile.jsonl";
+    FILE * token_file = std::fopen(token_path.c_str(), "w");
+    FILE * layer_file = std::fopen(layer_path.c_str(), "w");
+    if (!token_file || !layer_file) {
+        GGML_LOG_ERROR("HotSeat V2 profiler: cannot open JSONL output in %s\n",
+            s.v2_profile_dir.c_str());
+        if (token_file) std::fclose(token_file);
+        if (layer_file) std::fclose(layer_file);
+        return;
+    }
+
+#if defined(GGML_USE_HIP)
+    const char * timing_method = "wall_clock64_representative_block_estimate";
+#else
+    const char * timing_method = "clock64_representative_block_estimate";
+#endif
+    std::fprintf(token_file,
+        "{\"record_type\":\"run_meta\",\"profile_version\":1,"
+        "\"timing_method\":\"%s\","
+        "\"total_decode_tokens\":%llu,\"kept_decode_tokens\":%llu,"
+        "\"dropped_decode_tokens\":%llu,\"capacity\":%llu,"
+        "\"layers\":%d,\"experts\":%d,\"top_k\":%d,"
+        "\"prompt_tokens\":%llu,\"prompt_tps\":null,"
+        "\"timing_clock_rate_khz\":%llu,\"gpu_vram_total_bytes\":%zu,"
+        "\"gpu_vram_used_bytes_at_shutdown\":%zu,"
+        "\"physical_vram_free_low_water_bytes\":%llu}\n",
+        timing_method,
+        (unsigned long long) total_tokens,
+        (unsigned long long) kept_tokens,
+        (unsigned long long) (total_tokens - kept_tokens),
+        (unsigned long long) s.v2_profile_capacity,
+        s.n_layers, s.n_experts, GGML_HOTEXPERT_V2_PROFILE_TOP_K,
+        (unsigned long long) s.prefill_tokens.load(std::memory_order_acquire),
+        (unsigned long long) s.v2_clock_rate_khz,
+        total_vram, total_vram > free_now ? total_vram - free_now : 0,
+        (unsigned long long) low_water);
+
+    uint64_t run_host_bytes = 0;
+    uint64_t run_resident_bytes = 0;
+    uint64_t run_host_misses = 0;
+    uint64_t run_resident_hits = 0;
+    uint64_t first_time_us = 0;
+    uint64_t last_time_us = 0;
+
+    for (uint64_t token = first_token; token < total_tokens; ++token) {
+        const size_t ring = size_t(token % s.v2_profile_capacity);
+        const uint64_t timestamp_us = ring < s.v2_token_times_us.size()
+            ? s.v2_token_times_us[ring]
+            : 0;
+        if (timestamp_us && !first_time_us) first_time_us = timestamp_us;
+        if (timestamp_us) last_time_us = timestamp_us;
+        uint64_t token_host_bytes = 0;
+        uint64_t token_resident_bytes = 0;
+        uint64_t token_host_misses = 0;
+        uint64_t token_resident_hits = 0;
+        double token_mmvq_us = 0.0;
+        double token_host_us = 0.0;
+        double token_resident_us = 0.0;
+        uint64_t generation = 0;
+
+        for (int layer = 0; layer < s.n_layers; ++layer) {
+            const auto & rec = records[ring * size_t(s.n_layers) + size_t(layer)];
+            generation = std::max(generation, rec.generation);
+            const uint32_t routes = std::min<uint32_t>(
+                rec.route_count, GGML_HOTEXPERT_V2_PROFILE_TOP_K);
+            const uint32_t valid_mask = routes >= 32 ? 0xffffffffu : ((1u << routes) - 1u);
+            const uint32_t resident_hits = uint32_t(__builtin_popcount(rec.resident_mask & valid_mask));
+            const uint32_t host_misses = routes - resident_hits;
+            const uint64_t expert_bytes = v2_expert_bytes(s, layer);
+            const uint64_t resident_bytes = uint64_t(resident_hits) * expert_bytes;
+            const uint64_t host_bytes = uint64_t(host_misses) * expert_bytes;
+            uint64_t mmvq_cycles = 0;
+            uint64_t host_cycles = 0;
+            uint64_t resident_cycles = 0;
+            for (int kind = 0; kind < GGML_HOTEXPERT_V2_PROFILE_KINDS; ++kind) {
+                mmvq_cycles += rec.mmvq_cycles[kind];
+                host_cycles += rec.host_cycles[kind];
+                resident_cycles += rec.resident_cycles[kind];
+            }
+            const double mmvq_us = v2_cycles_to_us(s, mmvq_cycles);
+            const double host_us = v2_cycles_to_us(s, host_cycles);
+            const double resident_us = v2_cycles_to_us(s, resident_cycles);
+
+            std::fprintf(layer_file,
+                "{\"record_type\":\"layer\",\"generation\":%llu,"
+                "\"token\":%llu,\"layer\":%d,\"expert_ids\":[",
+                (unsigned long long) rec.generation,
+                (unsigned long long) token, layer);
+            for (uint32_t i = 0; i < routes; ++i) {
+                std::fprintf(layer_file, "%s%d", i ? "," : "", rec.expert_ids[i]);
+            }
+            std::fprintf(layer_file,
+                "],\"resident_hits\":%u,\"host_misses\":%u,"
+                "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+                "\"mmvq_kernel_elapsed_us\":%.3f,"
+                "\"hostexpert_path_elapsed_us\":%.3f,"
+                "\"resident_path_elapsed_us\":%.3f,"
+                "\"timing_estimate\":true}\n",
+                resident_hits, host_misses,
+                (unsigned long long) resident_bytes,
+                (unsigned long long) host_bytes,
+                mmvq_us, host_us, resident_us);
+
+            token_host_bytes += host_bytes;
+            token_resident_bytes += resident_bytes;
+            token_host_misses += host_misses;
+            token_resident_hits += resident_hits;
+            token_mmvq_us += mmvq_us;
+            token_host_us += host_us;
+            token_resident_us += resident_us;
+        }
+
+        double decode_tps = 0.0;
+        if (token > first_token && timestamp_us && !s.v2_token_times_us.empty()) {
+            const uint64_t prev_time = s.v2_token_times_us[
+                size_t((token - 1) % s.v2_profile_capacity)];
+            if (prev_time && timestamp_us > prev_time) {
+                decode_tps = 1e6 / double(timestamp_us - prev_time);
+            }
+        }
+        const double pcie_gbps = decode_tps > 0.0
+            ? double(token_host_bytes) * decode_tps / 1e9
+            : 0.0;
+        std::fprintf(token_file,
+            "{\"record_type\":\"token\",\"generation\":%llu,"
+            "\"token\":%llu,\"timestamp_us\":%llu,"
+            "\"resident_hits\":%llu,\"host_misses\":%llu,"
+            "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+            "\"estimated_pcie_bytes\":%llu,\"estimated_pcie_gbps\":%.6f,"
+            "\"mmvq_kernel_elapsed_us\":%.3f,"
+            "\"hostexpert_path_elapsed_us\":%.3f,"
+            "\"resident_path_elapsed_us\":%.3f,\"decode_tps\":%.6f}\n",
+            (unsigned long long) generation,
+            (unsigned long long) token,
+            (unsigned long long) timestamp_us,
+            (unsigned long long) token_resident_hits,
+            (unsigned long long) token_host_misses,
+            (unsigned long long) token_resident_bytes,
+            (unsigned long long) token_host_bytes,
+            (unsigned long long) token_host_bytes,
+            pcie_gbps, token_mmvq_us, token_host_us, token_resident_us, decode_tps);
+
+        run_host_bytes += token_host_bytes;
+        run_resident_bytes += token_resident_bytes;
+        run_host_misses += token_host_misses;
+        run_resident_hits += token_resident_hits;
+    }
+
+    const double elapsed_s = last_time_us > first_time_us
+        ? double(last_time_us - first_time_us) / 1e6
+        : 0.0;
+    const double decode_tps = elapsed_s > 0.0 && kept_tokens > 1
+        ? double(kept_tokens - 1) / elapsed_s
+        : 0.0;
+    const double pcie_gbps = elapsed_s > 0.0
+        ? double(run_host_bytes) / elapsed_s / 1e9
+        : 0.0;
+    std::fprintf(token_file,
+        "{\"record_type\":\"run_summary\",\"decode_tokens\":%llu,"
+        "\"decode_tps\":%.6f,\"prompt_tokens\":%llu,\"prompt_tps\":null,"
+        "\"resident_hits\":%llu,\"host_misses\":%llu,"
+        "\"estimated_resident_bytes\":%llu,\"estimated_host_bytes\":%llu,"
+        "\"estimated_pcie_bytes_per_token\":%.3f,"
+        "\"estimated_pcie_gbps\":%.6f,"
+        "\"gpu_vram_total_bytes\":%zu,"
+        "\"gpu_vram_used_low_water_bytes\":%llu,"
+        "\"physical_vram_free_low_water_bytes\":%llu}\n",
+        (unsigned long long) kept_tokens, decode_tps,
+        (unsigned long long) s.prefill_tokens.load(std::memory_order_acquire),
+        (unsigned long long) run_resident_hits,
+        (unsigned long long) run_host_misses,
+        (unsigned long long) run_resident_bytes,
+        (unsigned long long) run_host_bytes,
+        kept_tokens ? double(run_host_bytes) / double(kept_tokens) : 0.0,
+        pcie_gbps, total_vram,
+        (unsigned long long) (total_vram > low_water ? total_vram - low_water : 0),
+        (unsigned long long) low_water);
+
+    std::fclose(layer_file);
+    std::fclose(token_file);
+    GGML_LOG_INFO("HotSeat V2 profiler: wrote %llu tokens to %s and %s\n",
+        (unsigned long long) kept_tokens, token_path.c_str(), layer_path.c_str());
+}
+
+static void q122_v3_report_telemetry(const rt_state & s) {
+    if (!s.transit_only) return;
+    const uint64_t tokens = s.v3_route_tokens.load(std::memory_order_relaxed);
+    const uint64_t cold = s.v3_cold_routes.load(std::memory_order_relaxed);
+    const uint64_t hits = s.v3_transit_route_hits.load(std::memory_order_relaxed);
+    const uint64_t copied = s.v3_stage_copied_experts.load(std::memory_order_relaxed);
+    const uint64_t bytes = s.v3_stage_copied_bytes.load(std::memory_order_relaxed);
+    const uint64_t commits = s.v3_commit_count.load(std::memory_order_relaxed);
+    const uint64_t wait_us = s.v3_stage_wait_us.load(std::memory_order_relaxed);
+    const uint64_t admit_candidates = s.v3_admit_candidates.load(std::memory_order_relaxed);
+    const uint64_t admit_rejected = s.v3_admit_rejected.load(std::memory_order_relaxed);
+    std::fprintf(stderr,
+        "Q122 V3 P5 summary: route_tokens=%llu cold_routes=%llu transit_hits=%llu hit_pct=%.2f copied_experts=%llu h2d_total_mib=%.2f h2d_mib_per_token=%.3f commits=%llu boundary_wait_total_us=%llu boundary_wait_us_per_commit=%.2f admit_candidates=%llu admit_rejected=%llu reject_pct=%.2f\n",
+        (unsigned long long) tokens,
+        (unsigned long long) cold,
+        (unsigned long long) hits,
+        cold ? 100.0 * double(hits) / double(cold) : 0.0,
+        (unsigned long long) copied,
+        double(bytes) / double(1u << 20),
+        tokens ? double(bytes) / double(1u << 20) / double(tokens) : 0.0,
+        (unsigned long long) commits,
+        (unsigned long long) wait_us,
+        commits ? double(wait_us) / double(commits) : 0.0,
+        (unsigned long long) admit_candidates,
+        (unsigned long long) admit_rejected,
+        admit_candidates ? 100.0 * double(admit_rejected) / double(admit_candidates) : 0.0);
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        if (!q122_v3_split_layer(layer)) continue;
+        const uint64_t lcold = s.v3_layer_cold_routes[size_t(layer)].load(std::memory_order_relaxed);
+        const uint64_t lhit = s.v3_layer_transit_hits[size_t(layer)].load(std::memory_order_relaxed);
+        std::fprintf(stderr,
+            "Q122 V3 P5 layer=%d cold_routes=%llu transit_hits=%llu hit_pct=%.2f\n",
+            layer, (unsigned long long) lcold, (unsigned long long) lhit,
+            lcold ? 100.0 * double(lhit) / double(lcold) : 0.0);
+    }
+    std::fflush(stderr);
+}
+
+static void shutdown_runtime(rt_state & s) {
+    if (!s.initialized) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(s.worker_mutex);
+        s.stopping = true;
+    }
+    s.worker_cv.notify_one();
+    if (s.worker.joinable()) {
+        s.worker.join();
+    }
+    if (s.v2_prefetch_worker.joinable()) {
+        {
+            std::lock_guard<std::mutex> lock(s.v2_prefetch_mutex);
+            s.v2_prefetch_stopping = true;
+        }
+        s.v2_prefetch_cv.notify_one();
+        s.v2_prefetch_worker.join();
+    }
+    if (s.v3_stage_worker.joinable()) {
+        s.v3_stage_stopping.store(true, std::memory_order_release);
+        s.v3_stage_worker.join();
+    }
+    q122_v3_report_telemetry(s);
+    save_runtime_snapshot(s);
+    CUDA_CHECK(cudaSetDevice(s.device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    if (s.v2_prefetch_enabled) {
+        const uint64_t routed = s.v2_routed_experts.load(std::memory_order_relaxed);
+        const uint64_t resident = s.v2_resident_hits.load(std::memory_order_relaxed);
+        const uint64_t transit = s.v2_transit_hits.load(std::memory_order_relaxed);
+        std::fprintf(stderr,
+            "HotSeat V2 summary: complete_tokens=%llu missing_layers=%llu prefetch_tokens=%llu experts=%llu bytes=%llu routed=%llu resident_hits=%llu transit_hits=%llu transit_hit_pct=%.2f predictor_skipped=%llu persistent_reused=%llu\n",
+            (unsigned long long) s.v2_route_complete_tokens.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_route_missing_layers.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_tokens.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_experts.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_prefetch_bytes.load(std::memory_order_relaxed),
+            (unsigned long long) routed,
+            (unsigned long long) resident,
+            (unsigned long long) transit,
+            routed ? 100.0 * double(transit) / double(routed) : 0.0,
+            (unsigned long long) s.v2_predictor_skipped.load(std::memory_order_relaxed),
+            (unsigned long long) s.v2_persistent_reused.load(std::memory_order_relaxed));
+    }
+    dump_v2_profile(s);
+    if (s.v2_large_pp_stream) {
+        CUDA_CHECK(cudaStreamSynchronize(s.v2_large_pp_stream));
+        CUDA_CHECK(cudaStreamDestroy(s.v2_large_pp_stream));
+        s.v2_large_pp_stream = nullptr;
+    }
+    for (auto & bank : s.full_banks)  if (bank.base)  CUDA_CHECK(cudaFree(bank.base));
+    for (auto & bank : s.top64_banks) if (bank.base)  CUDA_CHECK(cudaFree(bank.base));
+    for (int layer = 0; layer < s.n_layers; ++layer) {
+        for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+            tensor_slot & t = s.layers[layer].tensors[kind];
+            for (int buf = 0; buf < 2; ++buf) {
+                if (t.tables[buf]) CUDA_CHECK(cudaFree(const_cast<void *>(t.tables[buf])));
+            }
+        }
+    }
+    if (s.d_hits)         CUDA_CHECK(cudaFree(s.d_hits));
+    if (s.d_prefill)      CUDA_CHECK(cudaFree(s.d_prefill));
+    if (s.d_miss)         CUDA_CHECK(cudaFree(s.d_miss));
+    if (s.d_prefill_rows) CUDA_CHECK(cudaFree(s.d_prefill_rows));
+    if (s.d_resident)     CUDA_CHECK(cudaFree(s.d_resident));
+    if (s.d_v2_records)       CUDA_CHECK(cudaFree(s.d_v2_records));
+    if (s.d_v2_token_count)   CUDA_CHECK(cudaFree(s.d_v2_token_count));
+    if (s.d_v2_current_token) CUDA_CHECK(cudaFree(s.d_v2_current_token));
+    if (s.v3_stage_event) {
+        CUDA_CHECK(cudaEventDestroy(s.v3_stage_event));
+        s.v3_stage_event = nullptr;
+    }
+    if (s.v2_prefetch_stream) {
+        CUDA_CHECK(cudaStreamSynchronize(s.v2_prefetch_stream));
+        CUDA_CHECK(cudaStreamDestroy(s.v2_prefetch_stream));
+        s.v2_prefetch_stream = nullptr;
+    }
+    if (s.d_v2_transit_meta) {
+        CUDA_CHECK(cudaFree(s.d_v2_transit_meta));
+        s.d_v2_transit_meta = nullptr;
+    }
+    if (s.d_v2_transit_base) {
+        CUDA_CHECK(cudaFree(s.d_v2_transit_base));
+        s.d_v2_transit_base = nullptr;
+    }
+    if (s.h_v2_routes) {
+#if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipHostFree(s.h_v2_routes));
+#else
+        CUDA_CHECK(cudaFreeHost(s.h_v2_routes));
+#endif
+        s.h_v2_routes = nullptr;
+        s.d_v2_routes = nullptr;
+    }
+    if (s.h_v2_route_latest) {
+#if defined(GGML_USE_HIP)
+        CUDA_CHECK(hipHostFree(s.h_v2_route_latest));
+#else
+        CUDA_CHECK(cudaFreeHost(s.h_v2_route_latest));
+#endif
+        s.h_v2_route_latest = nullptr;
+        s.d_v2_route_latest = nullptr;
+    }
+    s.arena.destroy();
+    if (s.side_stream)    CUDA_CHECK(cudaStreamDestroy(s.side_stream));
+    if (s.copy_start)     CUDA_CHECK(cudaEventDestroy(s.copy_start));
+    if (s.copy_end)       CUDA_CHECK(cudaEventDestroy(s.copy_end));
+    if (s.ready_event)    CUDA_CHECK(cudaEventDestroy(s.ready_event));
+    if (s.log_file && s.log_file != stderr) std::fclose(s.log_file);
+    s.initialized = false;
+}
