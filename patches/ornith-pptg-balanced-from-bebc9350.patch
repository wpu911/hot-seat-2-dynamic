+// Hot Experts Plan v1:
+// This does NOT change the existing hot_layers_stats.json format.
+// It reads the same in-memory MoE expert hit counters and writes a separate:
+//   hot_expert_plan.json
+// The plan is for analysis / future Hot Expert cache design.
+// It does not currently change runtime expert placement.
+static void moe_hot_expert_stats_collect_layer_topk(
+        int layer,
+        int expert_count,
+        uint64_t * out_top1_hits,
+        int * out_top1_expert,
+        uint64_t * out_top8_hits,
+        uint64_t * out_top16_hits,
+        uint64_t * out_top32_hits,
+        uint64_t * out_top64_hits,
+        uint64_t * out_top128_hits,
+        std::vector<std::pair<int, uint64_t>> * out_experts) {
+    *out_top1_hits = 0;
+    *out_top1_expert = -1;
+    *out_top8_hits = 0;
+    *out_top16_hits = 0;
+    *out_top32_hits = 0;
+    *out_top64_hits = 0;
+    *out_top128_hits = 0;
+
+    out_experts->clear();
+
+    const int max_expert_scan = expert_count > 0 && expert_count <= 1024 ? expert_count : 1024;
+
+    for (int e = 0; e < max_expert_scan; ++e) {
+        const uint64_t h = moe_hot_layer_stats_hits[layer][e];
+
+        if (h == 0) {
+            continue;
+        }
+
+        out_experts->push_back({e, h});
+
+        if (h > *out_top1_hits) {
+            *out_top1_hits = h;
+            *out_top1_expert = e;
+        }
+    }
+
+    std::sort(out_experts->begin(), out_experts->end(), [](const auto & a, const auto & b) {
+        return a.second > b.second;
+    });
+
+    for (size_t i = 0; i < out_experts->size() && i < 128; ++i) {
+        const uint64_t h = (*out_experts)[i].second;
+
+        if (i < 8) {
+            *out_top8_hits += h;
+        }
+        if (i < 16) {
+            *out_top16_hits += h;
+        }
+        if (i < 32) {
+            *out_top32_hits += h;
+        }
+        if (i < 64) {
+            *out_top64_hits += h;
+        }
+
+        *out_top128_hits += h;
+    }
+}
+
+static int moe_hot_expert_stats_recommend_k(
+        double top1_ratio,
+        double top8_ratio,
+        double top16_ratio,
+        double top32_ratio,
+        double top64_ratio,
+        double top128_ratio) {
+    if (top1_ratio >= 0.90) {
+        return 1;
+    }
+    if (top8_ratio >= 0.90) {
+        return 8;
+    }
+    if (top16_ratio >= 0.85) {
+        return 16;
+    }
+    if (top32_ratio >= 0.85) {
+        return 32;
+    }
+    if (top64_ratio >= 0.85) {
+        return 64;
+    }
+    if (top128_ratio >= 0.85) {
+        return 128;
+    }
+
+    return 0;
+}
+
+static const char * moe_hot_expert_stats_category_for_k(int k) {
+    switch (k) {
+        case 1:
+            return "top1_golden";
+        case 8:
+            return "top8_golden";
+        case 16:
+            return "top16_good";
+        case 32:
+            return "top32_ok";
+        case 64:
+            return "top64_heavy_but_useful";
+        case 128:
+            return "top128_too_broad_but_coverable";
+        default:
+            return "too_broad_skip";
+    }
+}
+
+static double moe_hot_expert_stats_coverage_for_k(
+        int k,
+        double top1_ratio,
+        double top8_ratio,
+        double top16_ratio,
+        double top32_ratio,
+        double top64_ratio,
+        double top128_ratio) {
+    switch (k) {
+        case 1:
+            return top1_ratio;
+        case 8:
+            return top8_ratio;
+        case 16:
+            return top16_ratio;
+        case 32:
+            return top32_ratio;
+        case 64:
+            return top64_ratio;
+        case 128:
+            return top128_ratio;
+        default:
+            return 0.0;
+    }
+}
