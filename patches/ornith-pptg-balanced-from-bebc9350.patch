+static void log_expert_swap(uint64_t generation, int layer, int candidate, int victim,
+                            int slot, size_t bytes, double copy_us,
+                            double cand_ewma, double vict_ewma) {
+    std::lock_guard<std::mutex> lock(g_state.log_mutex);
+    FILE * out = g_state.log_file ? g_state.log_file : stderr;
+    const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    std::fprintf(out,
+        "{\"ts\":%lld,\"event\":\"expert_swap\",\"generation\":%llu,\"layer\":%d,"
+        "\"candidate\":%d,\"victim\":%d,\"pool_slot\":%d,\"bytes\":%zu,\"copy_us\":%.1f,"
+        "\"candidate_ewma\":%.6f,\"victim_ewma\":%.6f}\n",
+        (long long) now, (unsigned long long) generation, layer,
+        candidate, victim, slot, bytes, copy_us, cand_ewma, vict_ewma);
+    std::fflush(out);
+}
+
+static void log_full_swap(uint64_t generation, int promote, int demote, size_t bytes,
+                          double copy_us, double promote_score, double demote_score) {
+    std::lock_guard<std::mutex> lock(g_state.log_mutex);
