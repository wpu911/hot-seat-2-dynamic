+    std::fprintf(fp, "    \"top64_heavy_but_useful\": \"top64_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"top128_too_broad_but_coverable\": \"top128_ratio >= 0.85\",\n");
+    std::fprintf(fp, "    \"too_broad_skip\": \"top128_ratio < 0.85\"\n");
