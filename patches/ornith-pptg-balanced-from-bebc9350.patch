diff --git a/ggml/src/ggml-cuda/hotexpert-descriptor.cu b/ggml/src/ggml-cuda/hotexpert-descriptor.cu
new file mode 100644
index 000000000..711f913ca
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-descriptor.cu
@@ -0,0 +1,708 @@
+#include "hotexpert-descriptor.cuh"
+#include "hotexpert-planner.cuh"
+
+#include "ggml-cuda/common.cuh"
+#include "ggml-hotexpert.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cerrno>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <unordered_map>
+
+namespace {
+
+constexpr int MAX_LAYERS  = 256;
+constexpr int MAX_EXPERTS = 4096;
+
+struct desc_tensor_entry {
+    int layer = -1;
+    int kind  = -1;        // 0 gate, 1 up, 2 down, 3 gate_up
+    const void * host_ptr = nullptr;
+    int64_t n_experts = 0;
+    size_t bytes = 0;
+    ggml_type type = GGML_TYPE_F32;
+    std::string name;
+    bool is_shared = false;
+    std::array<int64_t, GGML_MAX_DIMS> axis_extents{};
+    std::array<int64_t, GGML_MAX_DIMS> axis_strides{};
+};
+
+struct desc_state {
+    std::vector<desc_tensor_entry> entries;
+    std::mutex mutex;
+    bool has_shared = false;
+    std::atomic<int> routed_count{0};
+    std::atomic<bool> probe_done{false};
+    std::atomic<uint64_t> min_free{0};
+};
+
+desc_state g_desc;
+
+// ---------------------------------------------------------------------------
+// name helpers (mirror hotexpert-runtime.cu; kept local for independence)
+// ---------------------------------------------------------------------------
+
+static int parse_layer(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    const char * prefixes[] = { "blk.", "ffn_moe_topk-", "ffn_moe_selected_experts_l" };
+    for (const char * prefix : prefixes) {
+        const char * p = std::strstr(name, prefix);
+        if (!p) {
+            continue;
+        }
+        p += std::strlen(prefix);
+        if (*p < '0' || *p > '9') {
+            continue;
+        }
+        int layer = 0;
+        while (*p >= '0' && *p <= '9') {
+            layer = layer * 10 + (*p++ - '0');
+        }
+        return layer < MAX_LAYERS ? layer : -1;
+    }
+    return -1;
+}
+
+static int tensor_kind(const char * name) {
+    if (!name) {
+        return -1;
+    }
+    if (std::strstr(name, "ffn_gate_up_exps") != nullptr) return 3;
+    if (std::strstr(name, "ffn_gate_exps")    != nullptr) return 0;
+    if (std::strstr(name, "ffn_up_exps")      != nullptr) return 1;
+    if (std::strstr(name, "ffn_down_exps")    != nullptr) return 2;
+    return -1;
+}
+
+static bool is_shared_name(const char * name) {
+    if (!name) {
+        return false;
+    }
+    // Qwen3.5/3.6 shared expert tensors use "shexp"/"chexps" suffixes
+    return std::strstr(name, "shexp") != nullptr || std::strstr(name, "chexps") != nullptr;
+}
+
+static std::string env_string(const char * name, const std::string & fallback) {
+    const char * value = std::getenv(name);
+    return value && *value ? std::string(value) : fallback;
+}
+
+static uint64_t fnv1a64(const std::string & value) {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    for (unsigned char c : value) {
+        hash ^= c;
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+static std::string json_escape(const std::string & value) {
+    std::ostringstream out;
+    for (unsigned char c : value) {
+        switch (c) {
+            case '\\': out << "\\\\"; break;
+            case '"':  out << "\\\""; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+                        << int(c) << std::dec;
+                } else {
+                    out << char(c);
+                }
+        }
+    }
+    return out.str();
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// public API
+// ---------------------------------------------------------------------------
+
+void ggml_cuda_hotexpert_descriptor_collect(const ggml_tensor * weight) {
+    if (!weight || !weight->data || !weight->name) {
+        return;
+    }
+    const char * name = weight->name;
+    const int layer = parse_layer(name);
+
+    if (is_shared_name(name)) {
+        std::lock_guard<std::mutex> lock(g_desc.mutex);
+        g_desc.has_shared = true;
+        return;
+    }
+    const int kind = tensor_kind(name);
+    if (layer < 0 || kind < 0) {
+        return;
+    }
+
+    desc_tensor_entry entry;
+    entry.layer   = layer;
+    entry.kind    = kind;
+    entry.host_ptr = weight->data;
+    entry.n_experts = 0;
+    entry.bytes   = ggml_nbytes(weight);
+    entry.type    = weight->type;
+    entry.name    = name;
+
+    // discover the expert axis by cross-tensor voting: the expert extent must
+    // appear on the SAME axis in every routed tensor of the layer (embedding
+    // dims appear on different axes in gate vs down). We store per-axis
+    // candidates here and resolve the vote in build() once all tensors of the
+    // layer are known.
+    for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        const int64_t extent = weight->ne[axis];
+        entry.axis_extents[axis] = extent;
+        entry.axis_strides[axis] = weight->nb[axis];
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(g_desc.mutex);
+        // dedupe: a tensor may be registered from several paths
+        for (const auto & e : g_desc.entries) {
+            if (e.host_ptr == entry.host_ptr) {
+                return;
+            }
+        }
+        g_desc.entries.push_back(entry);
+        ++g_desc.routed_count;
+    }
+}
+
+bool ggml_cuda_hotexpert_descriptor_build(hotseat_model_descriptor & out) {
+    std::vector<desc_tensor_entry> entries;
+    bool has_shared = false;
+    {
+        std::lock_guard<std::mutex> lock(g_desc.mutex);
+        entries = g_desc.entries;
+        has_shared = g_desc.has_shared;
+    }
+    if (entries.empty()) {
+        return false;
+    }
+
+    out = hotseat_model_descriptor{};
+    out.has_shared_experts = has_shared;
+    out.architecture = ggml_hotexpert_model_architecture();
+    if (out.architecture.empty()) {
+        out.architecture = "runtime_moe";
+    }
+
+    // group by layer
+    std::map<int, hotseat_moe_layer_descriptor> by_layer;
+    std::map<int, std::vector<desc_tensor_entry>> tensors_by_layer;
+    int max_layer = -1;
+    std::set<int> expert_counts;
+    for (const auto & e : entries) {
+        max_layer = std::max(max_layer, e.layer);
+        tensors_by_layer[e.layer].push_back(e);
+    }
+    for (auto & kv : tensors_by_layer) {
+        const int layer_id = kv.first;
+        auto & L = by_layer[layer_id];
+        L.layer_id = layer_id;
+        // expert-axis vote: an extent value that appears on the same axis in
+        // every routed tensor of this layer is the expert dimension
+        std::map<int64_t, std::set<int>> axis_of_extent;   // extent -> axes
+        for (const auto & e : kv.second) {
+            for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                if (e.axis_extents[axis] > 1) {
+                    axis_of_extent[e.axis_extents[axis]].insert(axis);
+                }
+            }
+        }
+        int64_t n_experts = 0;
+        int expert_axis = -1;
+        int64_t expert_stride = 0;
+        for (const auto & ae : axis_of_extent) {
+            if (ae.second.size() == 1) {
+                // extent appears on exactly one axis across all layer tensors
+                if (ae.first > n_experts) {
+                    n_experts = ae.first;
+                    expert_axis = *ae.second.begin();
+                }
+            }
+        }
+        L.n_experts = n_experts;
+        L.expert_axis = expert_axis;
+        expert_counts.insert(int(n_experts));
+        for (const auto & e : kv.second) {
+            const size_t stride_ = expert_axis >= 0
+                ? size_t(e.axis_strides[expert_axis]) : 0;
+            switch (e.kind) {
+                case 0:
+                    L.gate_ptr   = e.host_ptr;
+                    L.gate_bytes = e.bytes;
+                    L.gate_stride = stride_;
+                    break;
+                case 1:
+                    L.up_ptr     = e.host_ptr;
+                    L.up_bytes   = e.bytes;
+                    L.up_stride  = stride_;
+                    break;
+                case 2:
+                    L.down_ptr   = e.host_ptr;
+                    L.down_bytes = e.bytes;
+                    L.down_stride = stride_;
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+    out.n_layers  = max_layer + 1;
+    out.n_experts = expert_counts.size() == 1 ? *expert_counts.begin() : 0;
+    out.n_experts_used = ggml_hotexpert_model_expert_used();
+    out.has_routed_experts = !by_layer.empty();
+
+    // per-layer verification
+    int verified = 0;
+    for (auto & kv : by_layer) {
+        auto & L = kv.second;
+        if (L.gate_ptr && L.up_ptr && L.down_ptr) {
+            const int64_t ne = L.n_experts;
+            // slice range: stride * n_experts must fit in the tensor bytes
+            const bool gate_ok = L.gate_stride * size_t(ne) <= L.gate_bytes;
+            const bool up_ok   = L.up_stride   * size_t(ne) <= L.up_bytes;
+            const bool down_ok = L.down_stride * size_t(ne) <= L.down_bytes;
+            // expert counts agree across gate/up/down (checked by grouping)
+            L.bytes_per_expert = (L.gate_bytes + L.up_bytes + L.down_bytes) / size_t(ne);
+            L.full_layer_bytes = L.gate_bytes + L.up_bytes + L.down_bytes;
+            L.layout_verified = gate_ok && up_ok && down_ok && ne > 0;
+            if (L.layout_verified) {
+                verified++;
+            }
+        }
+        out.moe_layers.push_back(L);
+    }
+
+    const int n_moe_layers = int(by_layer.size());
+    if (n_moe_layers == 0 || !out.has_routed_experts) {
+        out.unsupported_reason = "no routed experts";
+        out.supports_expert_slicing = false;
+        out.supports_id_remap = false;
+        out.supports_runtime_cache = false;
+    } else if (verified != n_moe_layers) {
+        out.unsupported_reason = "expert slice verification failed";
+        out.supports_expert_slicing = false;
+        out.supports_id_remap = false;
+        out.supports_runtime_cache = false;
+    } else {
+        out.supports_expert_slicing = true;
+        out.supports_id_remap = true;
+        out.supports_runtime_cache = true;
+        // variable structure: layers may have different n_experts / missing tensors
+        out.variable_layers = 0;
+        for (const auto & L : out.moe_layers) {
+            if (L.n_experts != out.n_experts) {
+                out.variable_layers++;
+            }
+        }
+    }
+
+    // ---- capability classification ----
+    out.category = hotseat_model_category::DENSE;
+    if (!out.has_routed_experts) {
+        out.category = hotseat_model_category::DENSE;
+        out.unsupported_reason = "no routed experts";
+        out.supports_expert_slicing = false;
+        out.supports_id_remap = false;
+        out.supports_runtime_cache = false;
+    } else if (verified != n_moe_layers) {
+        out.category = hotseat_model_category::UNSUPPORTED_MOE;
+        out.unsupported_reason = "expert slice verification failed";
+        out.supports_expert_slicing = false;
+        out.supports_id_remap = false;
+        out.supports_runtime_cache = false;
+    } else {
+        // quantization support: every routed tensor must use a quantized type
+        // that the MMVQ/MMQ slice path can copy and compute (Q8_0 family etc.)
+        bool types_ok = true;
+        for (const auto & e : entries) {
+            switch (e.type) {
+                case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K:
+                case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K: case GGML_TYPE_Q8_0:
+                case GGML_TYPE_Q4_0: case GGML_TYPE_Q4_1: case GGML_TYPE_Q5_0:
+                case GGML_TYPE_Q5_1:
+                    break;
+                default:
+                    types_ok = false;
+                    break;
+            }
+        }
+        if (!types_ok) {
+            out.category = hotseat_model_category::UNSUPPORTED_MOE;
+            out.unsupported_reason = "unsupported expert quantization";
+            out.supports_expert_slicing = false;
+            out.supports_id_remap = false;
+            out.supports_runtime_cache = false;
+        } else if (out.variable_layers > 0) {
+            out.category = hotseat_model_category::VARIABLE_MOE;
+            out.unsupported_reason = "variable per-layer expert structure";
+            out.supports_expert_slicing = true;
+            out.supports_id_remap = true;
+            out.supports_runtime_cache = false;   // safe fallback until proven
+        } else {
+            out.supports_expert_slicing = true;
+            out.supports_id_remap = true;
+            out.supports_runtime_cache = true;
+            out.category = out.has_shared_experts
+                ? hotseat_model_category::MOE_WITH_SHARED_EXPERT
+                : hotseat_model_category::STANDARD_MOE;
+        }
+    }
+
+    // fingerprint: architecture + dimensions + per-layer layout hash
+    std::ostringstream fp;
+    fp << out.architecture << "|L=" << out.n_layers << "|E=" << out.n_experts
+       << "|K=" << out.n_experts_used;
+    for (const auto & L : out.moe_layers) {
+        fp << "|" << L.layer_id << ":" << L.n_experts << ":" << L.gate_bytes
+           << ":" << L.up_bytes << ":" << L.down_bytes;
+    }
+    out.fingerprint = "fnv1a64:" + std::to_string(fnv1a64(fp.str()));
+    return true;
+}
+
+
+static double env_double(const char * name, double fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const double parsed = std::strtod(value, nullptr);
+    return parsed > 0.0 ? parsed : fallback;
+}
+
+static int env_int(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 ? int(parsed) : fallback;
+}
+
+// Parses HOTEXPERT_VRAM_RESERVE_MIB: positive integer MiB value with overflow
+// guard. Returns 0 when unset/invalid (caller falls back to auto policy).
+static uint64_t env_reserve_mib(const char * name) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return 0;
+    }
+    errno = 0;
+    char * end = nullptr;
+    const long long parsed = std::strtoll(value, &end, 10);
+    if (errno == ERANGE || parsed <= 0 || (end && *end != '\0')) {
+        std::fprintf(stderr,
+            "HotExpert runtime: %s=%s invalid (positive integer MiB required), "
+            "falling back to auto reserve policy\n", name, value);
+        std::fflush(stderr);
+        return 0;
+    }
+    // overflow guard: value << 20 must fit in uint64_t
+    if (uint64_t(parsed) > (UINT64_MAX >> 20)) {
+        std::fprintf(stderr,
+            "HotExpert runtime: %s=%s overflows reserve_bytes, "
+            "falling back to auto reserve policy\n", name, value);
+        std::fflush(stderr);
+        return 0;
+    }
+    // sanity floor: reject absurdly small values (< 256 MiB) to protect safety
+    if (parsed < 256) {
+        std::fprintf(stderr,
+            "HotExpert runtime: %s=%s below minimum 256 MiB, "
+            "falling back to auto reserve policy\n", name, value);
+        std::fflush(stderr);
+        return 0;
+    }
+    return uint64_t(parsed);
+}
+
+
+bool ggml_cuda_hotexpert_vram_budget_measure(hotseat_vram_budget & out) {
+    size_t free_bytes = 0;
+    size_t total_bytes = 0;
+    if (hipMemGetInfo(&free_bytes, &total_bytes) != hipSuccess) {
+        out.rejected = true;
+        out.reject_reason = "hipMemGetInfo failed";
+        return false;
+    }
+    out.total_bytes = uint64_t(total_bytes);
+    out.free_bytes  = uint64_t(free_bytes);
+    out.used_bytes  = out.total_bytes - out.free_bytes;
+
+    // reserve priority: per-model fixed MiB override (env) > manual MB > auto
+    const uint64_t reserve_mib = env_reserve_mib("HOTEXPERT_VRAM_RESERVE_MIB");
+    const char * manual = std::getenv("HOTSEAT_VRAM_RESERVE_MB");
+    uint64_t reserve = 0;
+    if (reserve_mib > 0) {
+        reserve = reserve_mib << 20;
+        out.reserve_mode = "fixed_env";
+        std::fprintf(stderr,
+            "HotExpert runtime: HOTEXPERT_VRAM_RESERVE_MIB=%llu "
+            "reserve_source=fixed_env reserve_bytes=%llu\n",
+            (unsigned long long) reserve_mib, (unsigned long long) reserve);
+        std::fflush(stderr);
+    } else if (manual && *manual && std::strcmp(manual, "auto") != 0) {
+        reserve = uint64_t(std::strtoull(manual, nullptr, 10)) << 20;
+        out.reserve_mode = "manual";
+    } else {
+        const double percent = env_double("HOTSEAT_VRAM_RESERVE_PERCENT", 5.0);
+        const uint64_t min_reserve = uint64_t(env_int("HOTSEAT_VRAM_MIN_RESERVE_MB", 1024)) << 20;
+        reserve = std::max(uint64_t(double(out.total_bytes) * percent / 100.0), min_reserve);
+        out.reserve_mode = "auto";
+    }
+    out.reserve_bytes = reserve;
+
+    const uint64_t min_free = g_desc.min_free.load(std::memory_order_relaxed);
+    out.min_free_bytes = min_free > 0 ? min_free : out.free_bytes;
+    if (out.free_bytes < reserve) {
+        out.rejected = true;
+        out.reject_reason = "free VRAM below reserve";
+        out.cache_budget_bytes = 0;
+        return false;
+    }
+    out.cache_budget_bytes = out.free_bytes - reserve;
+    if (out.cache_budget_bytes == 0) {
+        out.rejected = true;
+        out.reject_reason = "zero cache budget";
+        return false;
+    }
+    return true;
+}
+
+void ggml_cuda_hotexpert_vram_sample() {
+    size_t free_bytes = 0;
+    size_t total_bytes = 0;
+    if (hipMemGetInfo(&free_bytes, &total_bytes) != hipSuccess) {
+        return;
+    }
+    uint64_t cur = uint64_t(free_bytes);
+    uint64_t prev = g_desc.min_free.load(std::memory_order_relaxed);
+    while ((prev == 0 || cur < prev) &&
+           !g_desc.min_free.compare_exchange_weak(prev, cur, std::memory_order_relaxed)) {}
+}
+
+const char * hotseat_model_category_name(hotseat_model_category c) {
+    switch (c) {
+        case hotseat_model_category::UNKNOWN:                return "UNKNOWN";
+        case hotseat_model_category::DENSE:                  return "DENSE";
+        case hotseat_model_category::STANDARD_MOE:           return "STANDARD_MOE";
+        case hotseat_model_category::MOE_WITH_SHARED_EXPERT: return "MOE_WITH_SHARED_EXPERT";
+        case hotseat_model_category::VARIABLE_MOE:           return "VARIABLE_MOE";
+        case hotseat_model_category::UNSUPPORTED_MOE:        return "UNSUPPORTED_MOE";
+    }
+    return "UNKNOWN";
+}
+
+void ggml_cuda_hotexpert_descriptor_write_report(const hotseat_model_descriptor & desc) {
+    const std::string dir = env_string("HOTSEAT_AUTO_PROFILE_DIR",
+        "/app/share/openclaw_tools/hotexpert-profiles");
+    const std::string path = dir + "/" + desc.fingerprint + ".json";
+
+    std::ofstream out(path, std::ios::trunc);
+    if (!out) {
+        GGML_LOG_ERROR("HotExpert descriptor: cannot write %s\n", path.c_str());
+        return;
+    }
+    out << "{\n";
+    out << "  \"version\": 1,\n";
+    out << "  \"stage\": \"C_vram_budget\",\n";
+    out << "  \"category\": \"" << hotseat_model_category_name(desc.category) << "\",\n";
+    out << "  \"architecture\": \"" << json_escape(desc.architecture) << "\",\n";
+    out << "  \"fingerprint\": \"" << json_escape(desc.fingerprint) << "\",\n";
+    out << "  \"n_layers\": " << desc.n_layers << ",\n";
+    out << "  \"n_experts\": " << desc.n_experts << ",\n";
+    out << "  \"n_experts_used\": " << desc.n_experts_used << ",\n";
+    out << "  \"variable_layers\": " << desc.variable_layers << ",\n";
+    out << "  \"has_routed_experts\": " << (desc.has_routed_experts ? "true" : "false") << ",\n";
+    out << "  \"has_shared_experts\": " << (desc.has_shared_experts ? "true" : "false") << ",\n";
+    out << "  \"supports_expert_slicing\": " << (desc.supports_expert_slicing ? "true" : "false") << ",\n";
+    out << "  \"supports_id_remap\": " << (desc.supports_id_remap ? "true" : "false") << ",\n";
+    out << "  \"supports_runtime_cache\": " << (desc.supports_runtime_cache ? "true" : "false") << ",\n";
+    out << "  \"unsupported_reason\": \"" << json_escape(desc.unsupported_reason) << "\",\n";
+
+    hotseat_vram_budget budget;
+    if (ggml_cuda_hotexpert_vram_budget_measure(budget)) {
+        out << "  \"vram\": {\n";
+        out << "    \"total_bytes\": " << budget.total_bytes << ",\n";
+        out << "    \"used_bytes\": " << budget.used_bytes << ",\n";
+        out << "    \"free_bytes\": " << budget.free_bytes << ",\n";
+        out << "    \"min_free_bytes\": " << budget.min_free_bytes << ",\n";
+        out << "    \"reserve_bytes\": " << budget.reserve_bytes << ",\n";
+        out << "    \"reserve_mode\": \"" << budget.reserve_mode << "\",\n";
+        out << "    \"cache_budget_bytes\": " << budget.cache_budget_bytes << ",\n";
+        out << "    \"rejected\": " << (budget.rejected ? "true" : "false") << ",\n";
+        out << "    \"reject_reason\": \"" << json_escape(budget.reject_reason) << "\"\n";
+        out << "  },\n";
+    }
+    out << "  \"layers\": [\n";
+    bool first = true;
+    for (const auto & L : desc.moe_layers) {
+        if (!first) out << ",\n";
+        first = false;
+        out << "    {\"layer_id\": " << L.layer_id
+            << ", \"n_experts\": " << L.n_experts
+            << ", \"expert_axis\": " << L.expert_axis
+            << ", \"gate_bytes\": " << L.gate_bytes
+            << ", \"up_bytes\": " << L.up_bytes
+            << ", \"down_bytes\": " << L.down_bytes
+            << ", \"gate_stride\": " << L.gate_stride
+            << ", \"up_stride\": " << L.up_stride
+            << ", \"down_stride\": " << L.down_stride
+            << ", \"bytes_per_expert\": " << L.bytes_per_expert
+            << ", \"full_layer_bytes\": " << L.full_layer_bytes
+            << ", \"layout_verified\": " << (L.layout_verified ? "true" : "false") << "}";
+    }
+    out << "\n  ]\n}\n";
+    out.close();
+
+    GGML_LOG_INFO("HotExpert descriptor: wrote %s (%zu layers, %d experts, verified=%s)\n",
+        path.c_str(), desc.moe_layers.size(), desc.n_experts,
+        desc.supports_expert_slicing ? "yes" : "no");
+}
+
+void ggml_cuda_hotexpert_descriptor_probe(const ggml_cgraph * graph) {
+    GGML_UNUSED(graph);
+    static const bool auto_enabled = [] {
+        const char * value = std::getenv("HOTSEAT_AUTO");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (!auto_enabled) {
+        return;
+    }
+    // build + report once the collection is complete (all layers seen)
+    if (g_desc.probe_done.load(std::memory_order_acquire)) {
+        return;
+    }
+    const int model_layers = ggml_hotexpert_model_layers();
+    if (model_layers > 0 && g_desc.routed_count.load(std::memory_order_acquire) < model_layers * 3) {
+        return;   // partial registration (layered graphs): keep waiting
+    }
+    hotseat_model_descriptor desc;
+    if (!ggml_cuda_hotexpert_descriptor_build(desc)) {
+        // nothing collected yet: if this graph has no MoE matmul at all, the
+        // model is dense (or the graph pipeline is not MoE-driven) -> report
+        // a DENSE classification instead of staying silent forever
+        bool has_moe_matmul = false;
+        if (graph) {
+            for (int i = 0; i < graph->n_nodes; ++i) {
+                if (graph->nodes[i] && graph->nodes[i]->op == GGML_OP_MUL_MAT_ID) {
+                    has_moe_matmul = true;
+                    break;
+                }
+            }
+        }
+        if (!has_moe_matmul) {
+            desc.architecture = ggml_hotexpert_model_architecture();
+            if (desc.architecture.empty()) desc.architecture = "runtime";
+            desc.category = hotseat_model_category::DENSE;
+            desc.unsupported_reason = "no routed experts";
+            desc.has_routed_experts = false;
+            desc.supports_expert_slicing = false;
+            desc.supports_id_remap = false;
+            desc.supports_runtime_cache = false;
+            desc.n_layers = ggml_hotexpert_model_layers();
+            desc.fingerprint = "dense:" + desc.architecture;
+            g_desc.probe_done.store(true, std::memory_order_release);
+            ggml_cuda_hotexpert_descriptor_write_report(desc);
+            GGML_LOG_INFO("HotSeat Auto: disabled, reason: %s (category DENSE)\n",
+                desc.unsupported_reason.c_str());
+        }
+        return;
+    }
+    ggml_cuda_hotexpert_vram_sample();
+    g_desc.probe_done.store(true, std::memory_order_release);
+    ggml_cuda_hotexpert_descriptor_write_report(desc);
+
+    // stage E: dry-run layout planner (HOTSEAT_AUTO_DRY_RUN=1 -> plan only)
+    static const bool dry_run = [] {
+        const char * value = std::getenv("HOTSEAT_AUTO_DRY_RUN");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (dry_run && desc.supports_runtime_cache) {
+        hotseat_vram_budget budget;
+        if (ggml_cuda_hotexpert_vram_budget_measure(budget) && !budget.rejected) {
+            // stage J1: arena sizing dry-run (measure-only, no allocation)
+            size_t per_expert_bytes = 0;
+            for (const auto & L : desc.moe_layers) {
+                if (L.n_experts > 0) {
+                    per_expert_bytes = std::max(per_expert_bytes,
+                        L.full_layer_bytes / size_t(L.n_experts));
+                }
+            }
+            hotseat_arena_plan arena = ggml_cuda_hotexpert_arena_plan(
+                budget.min_free_bytes, budget.free_bytes, per_expert_bytes);
+            const std::string dir2 = env_string("HOTSEAT_AUTO_PROFILE_DIR",
+                "/app/share/openclaw_tools/hotexpert-profiles");
+            const std::string arena_path = dir2 + "/" + desc.fingerprint + ".arena.json";
+            FILE * af = std::fopen(arena_path.c_str(), "w");
+            if (af) {
+                std::fprintf(af, "{\n");
+                std::fprintf(af, "  \"stage\": \"J1_arena_dry_run\",\n");
+                std::fprintf(af, "  \"enabled\": %s,\n", arena.enabled ? "true" : "false");
+                std::fprintf(af, "  \"page_bytes\": %llu,\n", (unsigned long long) arena.page_bytes);
+                std::fprintf(af, "  \"internal_reserve_bytes\": %llu,\n", (unsigned long long) arena.internal_reserve_bytes);
+                std::fprintf(af, "  \"target_free_bytes\": %llu,\n", (unsigned long long) arena.target_free_bytes);
+                std::fprintf(af, "  \"grow_step_bytes\": %llu,\n", (unsigned long long) arena.grow_step_bytes);
+                std::fprintf(af, "  \"free_after_load\": %llu,\n", (unsigned long long) arena.free_after_load);
+                std::fprintf(af, "  \"min_free_warmup\": %llu,\n", (unsigned long long) arena.min_free_warmup);
+                std::fprintf(af, "  \"transient_peak\": %llu,\n", (unsigned long long) arena.transient_peak);
+                std::fprintf(af, "  \"arena_bytes\": %llu,\n", (unsigned long long) arena.arena_bytes);
+                std::fprintf(af, "  \"expert_bytes\": %llu,\n", (unsigned long long) arena.expert_bytes);
+                std::fprintf(af, "  \"expert_pages\": %llu,\n", (unsigned long long) arena.expert_pages);
+                std::fprintf(af, "  \"estimated_extra_slots\": %llu,\n", (unsigned long long) arena.estimated_extra_slots);
+                std::fprintf(af, "  \"rejected\": %s,\n", arena.rejected ? "true" : "false");
+                std::fprintf(af, "  \"reject_reason\": \"%s\"\n", arena.reject_reason.c_str());
+                std::fprintf(af, "}\n");
+                std::fclose(af);
+                GGML_LOG_INFO("HotExpert arena: %s arena_bytes=%llu MiB slots=%llu\n",
+                    arena.rejected ? "rejected" : "planned",
+                    (unsigned long long) (arena.arena_bytes >> 20),
+                    (unsigned long long) arena.estimated_extra_slots);
+            }
+            const std::string dir = env_string("HOTSEAT_AUTO_PROFILE_DIR",
+                "/app/share/openclaw_tools/hotexpert-profiles");
+            const std::string profile_path = dir + "/" + desc.fingerprint + ".profile.json";
+            hotseat_plan plan = ggml_cuda_hotexpert_plan(desc, budget.cache_budget_bytes,
+                budget.reserve_bytes, profile_path);
+            // fingerprint-scoped plan so multiple models never clobber each other
+            const std::string plan_path = dir + "/" + desc.fingerprint + ".plan.json";
+            FILE * fp = std::fopen(plan_path.c_str(), "w");
+            if (fp) { std::fclose(fp); }   // touch (write_json appends nothing); write below
+            ggml_cuda_hotexpert_plan_write_json_to(plan, plan_path);
+            GGML_LOG_INFO("HotExpert planner: %s (%s, budget %llu MiB)\n",
+                plan.rejected ? "rejected" : "plan written",
+                plan.reject_reason.empty() ? "ok" : plan.reject_reason.c_str(),
+                (unsigned long long) (budget.cache_budget_bytes >> 20));
+        }
+    }
+    if (!desc.supports_runtime_cache) {
+        GGML_LOG_INFO("HotSeat Auto: disabled, reason: %s (category %s)\n",
+            desc.unsupported_reason.c_str(), hotseat_model_category_name(desc.category));
+    } else {
+        GGML_LOG_INFO("HotSeat Auto: enabled (category %s, fingerprint %s)\n",
+            hotseat_model_category_name(desc.category), desc.fingerprint.c_str());
+    }
+}
diff --git a/ggml/src/ggml-cuda/hotexpert-descriptor.cuh b/ggml/src/ggml-cuda/hotexpert-descriptor.cuh
new file mode 100644
index 000000000..5bb5dc60a
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-descriptor.cuh
@@ -0,0 +1,117 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <string>
+#include <vector>
+
+// ============================================================================
+// Model-independent MoE descriptor (Stage A)
+//
+// Read-only probe: discovers the MoE structure of the loaded model from the
+// tensors that flow through the CUDA backend. Nothing here allocates banks,
+// changes tensor placement or alters the compute path. It exists to prove
+// that the layout can be derived automatically (no model-name branches, no
+// hard-coded layer/expert/top-k counts).
+// ============================================================================
+
+struct hotseat_moe_layer_descriptor {
+    int layer_id = -1;
+    int64_t n_experts = 0;
+    int64_t n_experts_used = 0;      // from model info / runtime observation
+    int expert_axis = -1;            // tensor axis holding the expert dimension
+
+    // routed expert tensors (host-visible pointers; may be device tensors)
+    const void * gate_ptr = nullptr;
+    const void * up_ptr   = nullptr;
+    const void * down_ptr = nullptr;
+
+    size_t gate_bytes = 0;
+    size_t up_bytes   = 0;
+    size_t down_bytes = 0;
+
+    size_t gate_stride = 0;          // bytes per expert (nb[axis])
+    size_t up_stride   = 0;
+    size_t down_stride = 0;
+
+    size_t bytes_per_expert  = 0;    // gate+up+down combined per expert
+    size_t full_layer_bytes  = 0;    // all three tensors combined
+
+    bool layout_verified = false;
+};
+
+enum class hotseat_model_category {
+    UNKNOWN = 0,
+    DENSE,
+    STANDARD_MOE,
+    MOE_WITH_SHARED_EXPERT,
+    VARIABLE_MOE,
+    UNSUPPORTED_MOE,
+};
+
+const char * hotseat_model_category_name(hotseat_model_category c);
+
+struct hotseat_model_descriptor {
+    std::string architecture;
+    std::string fingerprint;
+    hotseat_model_category category = hotseat_model_category::UNKNOWN;
+
+    int n_layers       = 0;
+    int n_experts      = 0;
+    int n_experts_used = 0;
+    int variable_layers = 0;         // layers whose structure differs from the majority
+
+    std::vector<hotseat_moe_layer_descriptor> moe_layers;
+
+    bool has_routed_experts = false;
+    bool has_shared_experts = false;
+    bool supports_expert_slicing = false;
+    bool supports_id_remap = false;
+    bool supports_runtime_cache = false;
+
+    std::string unsupported_reason;
+};
+
+// Registers an MoE expert tensor for the descriptor probe. Called from the
+// existing weight-registration paths; cheap and unconditional.
+void ggml_cuda_hotexpert_descriptor_collect(const ggml_tensor * weight);
+
+// Builds the model descriptor from everything collected so far. Idempotent;
+// returns false when the collection is not complete yet.
+bool ggml_cuda_hotexpert_descriptor_build(hotseat_model_descriptor & out);
+
+// Writes the structured JSON report for the current descriptor.
+void ggml_cuda_hotexpert_descriptor_write_report(const hotseat_model_descriptor & desc);
+
+// Called once per graph compute; performs the Stage-A probe when HOTSEAT_AUTO=1.
+void ggml_cuda_hotexpert_descriptor_probe(const ggml_cgraph * graph);
+
+// ---------------------------------------------------------------------------
+// Stage C: runtime VRAM budget measurement
+// ---------------------------------------------------------------------------
+
+struct hotseat_vram_budget {
+    uint64_t total_bytes = 0;
+    uint64_t used_bytes  = 0;   // model base + KV + compute at measurement time
+    uint64_t free_bytes  = 0;
+    uint64_t min_free_bytes = 0;   // lowest free seen since the probe started
+    uint64_t reserve_bytes = 0;
+    uint64_t cache_budget_bytes = 0;
+    std::string reserve_mode;    // "auto" | "manual"
+    bool rejected = false;
+    std::string reject_reason;
+};
+
+// Measures current VRAM and derives the automatic cache budget.
+//   reserve = max(total * reserve_percent, min_reserve_mb, 0)
+//   cache_budget = free - reserve
+// Reserve priority:
+//   1. HOTEXPERT_VRAM_RESERVE_MIB (per-model fixed MiB override, mode "fixed_env")
+//   2. HOTSEAT_VRAM_RESERVE_MB   (manual MB override, mode "manual")
+//   3. auto formula (mode "auto")
+// HOTEXPERT_VRAM_RESERVE_MIB requires a positive integer >= 256; invalid values
+// print an error and fall back to the auto policy. reserve_bytes = value << 20.
+bool ggml_cuda_hotexpert_vram_budget_measure(hotseat_vram_budget & out);
+
+// Samples free VRAM (called from the probe); tracks the running minimum.
+void ggml_cuda_hotexpert_vram_sample();
diff --git a/ggml/src/ggml-cuda/hotexpert-planner.cu b/ggml/src/ggml-cuda/hotexpert-planner.cu
new file mode 100644
index 000000000..c94784ced
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-planner.cu
@@ -0,0 +1,333 @@
+#include "hotexpert-planner.cuh"
+
+#include "hotexpert-descriptor.cuh"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+constexpr int MAX_EXPERTS = 4096;
+
+// neutral coverage curve used when no profile exists yet (explicitly marked
+// as an assumption in the plan notes)
+static double neutral_coverage(int slots) {
+    const double x = double(slots);
+    return std::min(1.0, 0.05 + 0.0105 * x);   // ~0.72 at 64, saturating
+}
+
+struct profile_layer {
+    int layer = -1;
+    double top8 = 0, top16 = 0, top32 = 0, top48 = 0, top64 = 0, top96 = 0, top128 = 0;
+    double full_layer_gain = 0.0;
+    double decode_routes = 0;
+};
+
+static double coverage_at(const profile_layer & p, int slots, bool have_profile) {
+    if (!have_profile || slots <= 0) {
+        return neutral_coverage(slots);
+    }
+    // piecewise-linear interpolation over the observed points
+    const struct { int k; double v; } pts[] = {
+        {8, p.top8}, {16, p.top16}, {32, p.top32}, {48, p.top48},
+        {64, p.top64}, {96, p.top96}, {128, p.top128},
+    };
+    if (slots <= 8) {
+        return slots <= 0 ? 0.0 : p.top8 * double(slots) / 8.0;
+    }
+    for (size_t i = 1; i < sizeof(pts) / sizeof(pts[0]); ++i) {
+        if (slots <= pts[i].k) {
+            const double t = double(slots - pts[i - 1].k) / double(pts[i].k - pts[i - 1].k);
+            return pts[i - 1].v + t * (pts[i].v - pts[i - 1].v);
+        }
+    }
+    return p.top128;
+}
+
+static int env_int(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    const long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 ? int(parsed) : fallback;
+}
+
+} // namespace
+
+hotseat_arena_plan ggml_cuda_hotexpert_arena_plan(uint64_t min_free_bytes,
+                                                  uint64_t free_now_bytes,
+                                                  uint64_t expert_bytes) {
+    hotseat_arena_plan plan;
+    plan.enabled = [] {
+        const char * v = std::getenv("HOTSEAT_AUTO_RESERVE_ARENA");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    plan.page_bytes = uint64_t(env_int("HOTSEAT_ARENA_PAGE_MB", 2)) << 20;
+    plan.internal_reserve_bytes = uint64_t(env_int("HOTSEAT_ARENA_INTERNAL_RESERVE_MB", 128)) << 20;
+    plan.target_free_bytes = uint64_t(env_int("HOTSEAT_ARENA_TARGET_FREE_MB", 800)) << 20;
+    plan.grow_step_bytes = uint64_t(env_int("HOTSEAT_ARENA_GROW_STEP_MB", 256)) << 20;
+    plan.free_after_load = free_now_bytes;
+    plan.min_free_warmup = min_free_bytes > 0 ? min_free_bytes : free_now_bytes;
+    plan.transient_peak = plan.free_after_load > plan.min_free_warmup
+        ? plan.free_after_load - plan.min_free_warmup : 0;
+    plan.expert_bytes = expert_bytes;
+    plan.expert_pages = expert_bytes > 0
+        ? (expert_bytes + plan.page_bytes - 1) / plan.page_bytes : 0;
+
+    if (!plan.enabled) {
+        return plan;
+    }
+    if (plan.min_free_warmup <= plan.target_free_bytes) {
+        plan.rejected = true;
+        plan.reject_reason = "measured low-water free VRAM below the 800 MiB target";
+        return plan;
+    }
+    const uint64_t raw = plan.min_free_warmup - plan.target_free_bytes;
+    plan.arena_bytes = (raw / plan.grow_step_bytes) * plan.grow_step_bytes;
+    if (plan.arena_bytes < (512u << 20)) {
+        plan.rejected = true;
+        plan.reject_reason = "arena below 512 MiB minimum; keep fixed-capacity mode";
+        return plan;
+    }
+    if (expert_bytes > 0) {
+        plan.estimated_extra_slots = plan.arena_bytes / expert_bytes;
+    }
+    return plan;
+}
+
+hotseat_plan ggml_cuda_hotexpert_plan(
+        const hotseat_model_descriptor & desc,
+        uint64_t cache_budget_bytes,
+        uint64_t reserve_bytes,
+        const std::string & profile_path) {
+    hotseat_plan plan;
+    plan.model_fingerprint = desc.fingerprint;
+    plan.category = hotseat_model_category_name(desc.category);
+    plan.vram_total_mib = 0;
+    plan.vram_reserve_mib = reserve_bytes >> 20;
+    plan.cache_budget_mib = cache_budget_bytes >> 20;
+
+    if (!desc.supports_runtime_cache) {
+        plan.rejected = true;
+        plan.reject_reason = desc.unsupported_reason;
+        return plan;
+    }
+    if (desc.moe_layers.empty()) {
+        plan.rejected = true;
+        plan.reject_reason = "no MoE layers";
+        return plan;
+    }
+
+    // ---- load profile (optional) ----
+    bool have_profile = false;
+    std::vector<profile_layer> prof(desc.moe_layers.size());
+    if (!profile_path.empty()) {
+        std::ifstream in(profile_path);
+        if (in.good()) {
+            std::stringstream ss;
+            ss << in.rdbuf();
+            const std::string s = ss.str();
+            // minimal JSON scan for the layers array entries
+            size_t pos = 0;
+            int idx = 0;
+            while ((pos = s.find("\"layer\"", pos)) != std::string::npos &&
+                   idx < int(prof.size())) {
+                const size_t colon = s.find(':', pos);
+                if (colon == std::string::npos) break;
+                pos = colon + 1;
+                const int layer = std::atoi(s.c_str() + pos);
+                auto find_num = [&](const char * key) -> double {
+                    const std::string k = std::string("\"") + key + "\"";
+                    const size_t p = s.find(k, colon);
+                    if (p == std::string::npos) return 0.0;
+                    const size_t c = s.find(':', p);
+                    if (c == std::string::npos) return 0.0;
+                    return std::strtod(s.c_str() + c + 1, nullptr);
+                };
+                prof[idx].layer = layer;
+                prof[idx].top8   = find_num("top8");
+                prof[idx].top16  = find_num("top16");
+                prof[idx].top32  = find_num("top32");
+                prof[idx].top48  = find_num("top48");
+                prof[idx].top64  = find_num("top64");
+                prof[idx].top96  = find_num("top96");
+                prof[idx].top128 = find_num("top128");
+                prof[idx].full_layer_gain = find_num("full_layer_gain");
+                prof[idx].decode_routes = find_num("decode_routes");
+                have_profile = true;
+                idx++;
+            }
+        }
+    }
+
+    // ---- budget ----
+    const uint64_t budget = cache_budget_bytes;
+    // shadow banks: one full layer + one top-N expert bank
+    size_t max_full_layer = 0;
+    size_t per_expert = 0;
+    for (const auto & L : desc.moe_layers) {
+        max_full_layer = std::max(max_full_layer, L.full_layer_bytes);
+        per_expert = std::max(per_expert, L.bytes_per_expert);
+    }
+    const uint64_t shadow_cost = uint64_t(max_full_layer) + 64ull * uint64_t(per_expert);
+    if (budget < shadow_cost) {
+        plan.rejected = true;
+        plan.reject_reason = "cache budget below shadow-bank cost";
+        plan.full_shadow = false;
+        return plan;
+    }
+    uint64_t avail = budget - shadow_cost;
+    plan.full_shadow = true;
+    plan.expert_shadow_slots = 64;
+
+    // ---- unified top-N slot count ----
+    // Every top64 bank is sized identically (banks swap roles at runtime), so
+    // all top_n layers share one slot count S, derived from the budget:
+    //   S = floor(avail / (per_expert * n_moe)), capped at n_experts
+    // Continuous value (not coarse steps) so the full cache budget is used
+    // while every layer stays within budget (whole experts only).
+    const int n_moe = int(desc.moe_layers.size());
+    const uint64_t per_layer_cost = uint64_t(per_expert) * uint64_t(std::max(1, n_moe));
+    int S = 8;
+    if (per_layer_cost > 0) {
+        const uint64_t max_s = avail / per_layer_cost;
+        S = int(std::min<uint64_t>(max_s, uint64_t(desc.n_experts)));
+        S = std::max(S, 1);
+    }
+    plan.expert_shadow_slots = S;
+
+    // ---- per-layer candidates ----
+    struct cand {
+        int layer;
+        std::string mode;
+        int slots;
+        uint64_t cost;
+        double gain;          // estimated ms saved per 1k decode tokens
+        double gain_per_byte;
+    };
+    std::vector<cand> candidates;
+
+    const double ns_per_byte = 80.0;   // 12.5 GB/s -> 80 ns/byte (assumption)
+    for (size_t i = 0; i < desc.moe_layers.size(); ++i) {
+        const auto & L = desc.moe_layers[i];
+        const profile_layer & P = prof[i];
+        const double decode_routes_1k = P.decode_routes > 0 ? P.decode_routes / 1000.0 : 8.0;
+        // full layer
+        const double full_gain_ms = have_profile
+            ? P.full_layer_gain / 1e6
+            : (decode_routes_1k * double(L.full_layer_bytes) * ns_per_byte) / 1e6;
+        candidates.push_back({int(L.layer_id), "full", 0,
+            uint64_t(L.full_layer_bytes), full_gain_ms,
+            full_gain_ms / std::max(1.0, double(L.full_layer_bytes))});
+        // top-N (unified S)
+        const double cov = coverage_at(P, S, have_profile);
+        const double saved_bytes_per_1k = decode_routes_1k * cov *
+            double(L.bytes_per_expert);
+        const double gain_ms = saved_bytes_per_1k * ns_per_byte / 1e6;
+        const uint64_t cost = uint64_t(S) * L.bytes_per_expert;
+        candidates.push_back({int(L.layer_id), "top_n", S, cost, gain_ms,
+            gain_ms / std::max(1.0, double(cost))});
+    }
+
+    // ---- greedy allocation by marginal gain per byte ----
+    std::sort(candidates.begin(), candidates.end(), [](const cand & a, const cand & b) {
+        return a.gain_per_byte > b.gain_per_byte;
+    });
+    std::vector<bool> layer_done(desc.moe_layers.size(), false);
+    plan.layers.resize(desc.moe_layers.size());
+    uint64_t spent = 0;
+    double total_gain = 0.0;
+    double weighted_decode_hits = 0.0;
+    double weighted_coverage = 0.0;
+    for (const auto & c : candidates) {
+        const size_t idx = size_t(c.layer);
+        if (layer_done[idx]) continue;
+        if (c.cost > avail) continue;
+        layer_done[idx] = true;
+        spent += c.cost;
+        avail -= c.cost;
+        total_gain += c.gain;
+        auto & pl = plan.layers[idx];
+        pl.layer_id = c.layer;
+        pl.mode = c.mode;
+        pl.slots = c.slots;   // unified S for top_n layers
+        pl.expected_gain_ms_per_1k_tokens = c.gain;
+        if (c.mode == "full") {
+            plan.full_count++;
+        } else if (c.mode == "top_n") {
+            plan.top_n_layers++;
+            const double cov = coverage_at(prof[idx], c.slots, have_profile);
+            weighted_decode_hits += prof[idx].decode_routes > 0 ? prof[idx].decode_routes : 8.0;
+            weighted_coverage += cov * (prof[idx].decode_routes > 0 ? prof[idx].decode_routes : 8.0);
+        } else {
+            plan.host_only_layers++;
+        }
+    }
+    // remaining layers are host-only
+    for (size_t i = 0; i < plan.layers.size(); ++i) {
+        if (!layer_done[i]) {
+            plan.layers[i].layer_id = desc.moe_layers[i].layer_id;
+            plan.layers[i].mode = "host_only";
+            plan.host_only_layers++;
+        }
+    }
+    if (weighted_decode_hits > 0) {
+        plan.expected_decode_hit_rate = weighted_coverage / weighted_decode_hits;
+    }
+    if (!have_profile) {
+        plan.reject_reason = "plan based on neutral assumptions (no profile yet)";
+    }
+
+    // sanity: spent must stay inside the cache budget
+    if (spent > budget) {
+        plan.rejected = true;
+        plan.reject_reason = "internal budget overflow";
+        return plan;
+    }
+    return plan;
+}
+
+void ggml_cuda_hotexpert_plan_write_json(const hotseat_plan & plan,
+                                         const std::string & dir) {
+    ggml_cuda_hotexpert_plan_write_json_to(plan, dir + "/layout-plan.json");
+}
+
+void ggml_cuda_hotexpert_plan_write_json_to(const hotseat_plan & plan,
+                                            const std::string & path) {
+    FILE * fp = std::fopen(path.c_str(), "w");
+    if (!fp) {
+        return;
+    }
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp, "  \"stage\": \"E_planner_dry_run\",\n");
+    std::fprintf(fp, "  \"model_fingerprint\": \"%s\",\n", plan.model_fingerprint.c_str());
+    std::fprintf(fp, "  \"category\": \"%s\",\n", plan.category.c_str());
+    std::fprintf(fp, "  \"rejected\": %s,\n", plan.rejected ? "true" : "false");
+    std::fprintf(fp, "  \"reject_reason\": \"%s\",\n", plan.reject_reason.c_str());
+    std::fprintf(fp, "  \"vram\": {\"reserve_mib\": %llu, \"cache_budget_mib\": %llu},\n",
+        (unsigned long long) plan.vram_reserve_mib, (unsigned long long) plan.cache_budget_mib);
+    std::fprintf(fp, "  \"shadow\": {\"full_bank\": %s, \"expert_slots\": %d},\n",
+        plan.full_shadow ? "true" : "false", plan.expert_shadow_slots);
+    std::fprintf(fp, "  \"expected_decode_hit_rate\": %.4f,\n", plan.expected_decode_hit_rate);
+    std::fprintf(fp, "  \"layers\": [\n");
+    bool first = true;
+    for (const auto & L : plan.layers) {
+        if (L.layer_id < 0) continue;
+        if (!first) std::fprintf(fp, ",\n");
+        first = false;
+        std::fprintf(fp,
+            "    {\"layer\": %d, \"mode\": \"%s\", \"slots\": %d,"
+            " \"expected_gain_ms_per_1k_tokens\": %.3f}",
+            L.layer_id, L.mode.c_str(), L.slots, L.expected_gain_ms_per_1k_tokens);
+    }
+    std::fprintf(fp, "\n  ]\n}\n");
+    std::fclose(fp);
+}
diff --git a/ggml/src/ggml-cuda/hotexpert-planner.cuh b/ggml/src/ggml-cuda/hotexpert-planner.cuh
new file mode 100644
index 000000000..f52ee51d0
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-planner.cuh
@@ -0,0 +1,89 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <string>
+#include <vector>
+
+// ============================================================================
+// Stage E: automatic layout planner (dry-run)
+//
+// Produces a per-layer cache layout plan from the model descriptor, the
+// measured VRAM budget and the routing profile. It never applies anything:
+// it only computes and reports the plan (and the reasons a layout would be
+// rejected).
+// ============================================================================
+
+struct hotseat_plan_layer {
+    int layer_id = -1;
+    std::string mode;          // "host_only" | "top_n" | "full"
+    int slots = 0;             // experts resident for top_n
+    double expected_gain_ms_per_1k_tokens = 0.0;
+    std::string note;
+};
+
+// ---------------------------------------------------------------------------
+// Stage J: dynamic GPU arena sizing (dry-run plan only)
+// ---------------------------------------------------------------------------
+
+struct hotseat_arena_plan {
+    bool enabled = false;          // HOTSEAT_AUTO_RESERVE_ARENA=1
+    uint64_t page_bytes = 2u << 20;
+    uint64_t internal_reserve_bytes = 128u << 20;
+    uint64_t target_free_bytes = 800u << 20;    // low-water mark
+    uint64_t grow_step_bytes = 256u << 20;
+
+    uint64_t free_after_load = 0;          // measured
+    uint64_t min_free_warmup = 0;          // measured low during warm-up
+    uint64_t transient_peak = 0;           // free_after_load - min_free
+    uint64_t arena_bytes = 0;              // floor((min_free - target) / step) * step
+    uint64_t expert_bytes = 0;             // per-expert (gate+up+down)
+    uint64_t expert_pages = 0;             // ceil(expert_bytes / page)
+    uint64_t estimated_extra_slots = 0;    // arena / expert_bytes (logical)
+    bool rejected = false;
+    std::string reject_reason;
+};
+
+// Derives the arena size from the measured VRAM low-water mark (dry-run).
+hotseat_arena_plan ggml_cuda_hotexpert_arena_plan(uint64_t min_free_bytes,
+                                                  uint64_t free_now_bytes,
+                                                  uint64_t expert_bytes);
+
+struct hotseat_plan {
+    std::string model_fingerprint;
+    std::string category;
+
+    uint64_t vram_total_mib = 0;
+    uint64_t vram_base_used_mib = 0;
+    uint64_t vram_reserve_mib = 0;
+    uint64_t cache_budget_mib = 0;
+
+    std::vector<hotseat_plan_layer> layers;
+    int full_count = 0;
+    int top_n_layers = 0;
+    int host_only_layers = 0;
+
+    bool full_shadow = false;
+    int expert_shadow_slots = 0;
+
+    double expected_prefill_hit_rate = 0.0;   // estimates, may be 0 without profile
+    double expected_decode_hit_rate = 0.0;
+
+    bool rejected = false;
+    std::string reject_reason;
+};
+
+// Builds the plan. `profile_path` may be empty (no profile yet): the planner
+// then falls back to neutral assumptions and marks them as such.
+hotseat_plan ggml_cuda_hotexpert_plan(
+        const struct hotseat_model_descriptor & desc,
+        uint64_t cache_budget_bytes,
+        uint64_t reserve_bytes,
+        const std::string & profile_path);
+
+// Writes the plan as JSON next to the profile.
+void ggml_cuda_hotexpert_plan_write_json(const hotseat_plan & plan,
+                                         const std::string & dir);
+// Writes the plan JSON to an explicit path (fingerprint-scoped).
+void ggml_cuda_hotexpert_plan_write_json_to(const hotseat_plan & plan,
+                                            const std::string & path);
diff --git a/ggml/src/ggml-cuda/hotexpert-profiler.cu b/ggml/src/ggml-cuda/hotexpert-profiler.cu
new file mode 100644
index 000000000..f3f341cbe
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-profiler.cu
@@ -0,0 +1,738 @@
+#include "hotexpert-profiler.cuh"
+#include "ggml-hotexpert.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <functional>
+#include <iomanip>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <sys/stat.h>
+
+namespace {
+
+constexpr int MAX_LAYERS  = 256;
+constexpr int MAX_EXPERTS = 1024;
+constexpr int MAX_TOP_K   = 64;
+
+struct hotexpert_snapshot {
+    uint64_t * data = nullptr;
+    size_t     count = 0;
+    std::atomic<bool> busy{false};
+    uint64_t sequence = 0;
+};
+
+struct hotexpert_window {
+    uint64_t sequence = 0;
+    uint64_t decode_tokens = 0;
+    std::array<uint16_t, MAX_LAYERS> unique{};
+};
+
+struct hotexpert_state {
+    bool enabled = false;
+    bool decode_only = true;
+    uint64_t interval = 1024;
+    std::string path;
+    int device = 0;
+
+    uint64_t * d_hits = nullptr;
+    uint64_t * d_prefill_hits = nullptr;
+    uint64_t * d_tokens = nullptr;
+    uint64_t * d_prefill_rows = nullptr;
+    uint64_t * d_overlap_hits = nullptr;
+    uint64_t * d_overlap_total = nullptr;
+    int32_t  * d_previous = nullptr;
+
+    std::array<std::atomic<uint64_t>, MAX_LAYERS> host_calls{};
+    std::array<std::atomic<uint64_t>, MAX_LAYERS> expert_weight_bytes{};
+    std::array<std::atomic<uint8_t>,  MAX_LAYERS> registered_weight_kinds{};
+    std::array<std::atomic<int>,      MAX_LAYERS> observed_experts{};
+    std::array<std::atomic<int>,      MAX_LAYERS> observed_top_k{};
+    std::atomic<int> max_layer{-1};
+    std::atomic<uint64_t> snapshot_sequence{0};
+    std::atomic<uint64_t> callback_tokens{0};
+
+    std::array<hotexpert_snapshot, 2> buffers;
+    std::mutex queue_mutex;
+    std::condition_variable queue_cv;
+    std::deque<hotexpert_snapshot *> queue;
+    uint64_t periodic_requests = 0;
+    bool stopping = false;
+    std::thread writer;
+    std::vector<uint64_t> previous_hits;
+    std::vector<hotexpert_window> windows;
+};
+
+std::mutex states_mutex;
+std::array<std::unique_ptr<hotexpert_state>, GGML_CUDA_MAX_DEVICES> states;
+std::atomic<bool> shutdown_registered{false};
+
+constexpr size_t hits_count() {
+    return size_t(MAX_LAYERS) * MAX_EXPERTS;
+}
+
+constexpr size_t snapshot_count() {
+    return hits_count() * 2 + size_t(MAX_LAYERS) * 4;
+}
+
+static int parse_layer(const char * name) {
+    if (!name) {
+        return -1;
+    }
+
+    const char * prefixes[] = { "ffn_moe_topk-", "ffn_moe_selected_experts_l", "blk." };
+    for (const char * prefix : prefixes) {
+        const char * p = std::strstr(name, prefix);
+        if (!p) {
+            continue;
+        }
+        p += std::strlen(prefix);
+        if (*p < '0' || *p > '9') {
+            continue;
+        }
+        int layer = 0;
+        while (*p >= '0' && *p <= '9') {
+            layer = layer * 10 + (*p++ - '0');
+        }
+        return layer < MAX_LAYERS ? layer : -1;
+    }
+    return -1;
+}
+
+static bool env_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("HOTEXPERT_PROFILE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static uint64_t env_interval() {
+    const char * value = std::getenv("HOTEXPERT_PROFILE_INTERVAL");
+    if (!value || !*value) {
+        return 1024;
+    }
+    const uint64_t parsed = std::strtoull(value, nullptr, 10);
+    return parsed ? parsed : 1024;
+}
+
+static std::string env_path() {
+    const char * value = std::getenv("HOTEXPERT_PROFILE_PATH");
+    return value && *value ? value : "/app/share/openclaw_tools/logs/qwen36-hotexpert-profile.json";
+}
+
+static std::string json_escape(const std::string & value) {
+    std::ostringstream out;
+    for (unsigned char c : value) {
+        switch (c) {
+            case '\\': out << "\\\\"; break;
+            case '"':  out << "\\\""; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << int(c) << std::dec;
+                } else {
+                    out << char(c);
+                }
+        }
+    }
+    return out.str();
+}
+
+static std::string process_command_line() {
+    std::ifstream in("/proc/self/cmdline", std::ios::binary);
+    std::string raw((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::replace(raw.begin(), raw.end(), '\0', ' ');
+    return raw;
+}
+
+static std::string process_model_path() {
+    std::ifstream in("/proc/self/cmdline", std::ios::binary);
+    std::string raw((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::string previous;
+    for (size_t begin = 0; begin < raw.size();) {
+        const size_t end = raw.find('\0', begin);
+        const std::string arg = raw.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
+        if (previous == "-m" || previous == "--model") {
+            return arg;
+        }
+        constexpr const char * prefix = "--model=";
+        if (arg.rfind(prefix, 0) == 0) {
+            return arg.substr(std::strlen(prefix));
+        }
+        previous = arg;
+        if (end == std::string::npos) break;
+        begin = end + 1;
+    }
+    return {};
+}
+
+static uint64_t fnv1a(const std::string & value) {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    for (unsigned char c : value) {
+        hash ^= c;
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+static double top_rate(const uint64_t * layer_hits, int n_experts, int n, uint64_t total) {
+    if (!total || n_experts <= 0) {
+        return 0.0;
+    }
+    std::vector<uint64_t> sorted(layer_hits, layer_hits + n_experts);
+    const int take = std::min(n, n_experts);
+    std::partial_sort(sorted.begin(), sorted.begin() + take, sorted.end(), std::greater<uint64_t>());
+    return double(std::accumulate(sorted.begin(), sorted.begin() + take, uint64_t(0))) / double(total);
+}
+
+static void write_json(hotexpert_state & state, const uint64_t * snapshot, uint64_t sequence) {
+    const uint64_t * hits          = snapshot;
+    const uint64_t * prefill_hits  = hits + hits_count();
+    const uint64_t * tokens        = prefill_hits + hits_count();
+    const uint64_t * prefill_rows  = tokens + MAX_LAYERS;
+    const uint64_t * overlap_hits  = prefill_rows + MAX_LAYERS;
+    const uint64_t * overlap_total = overlap_hits + MAX_LAYERS;
+
+    hotexpert_window window;
+    window.sequence = sequence;
+    for (int layer = 0; layer <= state.max_layer.load(); ++layer) {
+        window.decode_tokens = std::max(window.decode_tokens, tokens[layer]);
+        const uint64_t * current = hits + size_t(layer) * MAX_EXPERTS;
+        const uint64_t * previous = state.previous_hits.data() + size_t(layer) * MAX_EXPERTS;
+        for (int expert = 0; expert < MAX_EXPERTS; ++expert) {
+            if (current[expert] > previous[expert]) {
+                window.unique[layer]++;
+            }
+        }
+    }
+    if (state.windows.empty() || state.windows.back().decode_tokens != window.decode_tokens) {
+        state.windows.push_back(window);
+        std::copy(hits, hits + hits_count(), state.previous_hits.begin());
+    } else {
+        window = state.windows.back();
+    }
+
+    const std::string command = process_command_line();
+    const std::string model_path = process_model_path();
+    const std::string architecture = ggml_hotexpert_model_architecture();
+    const int n_layers = state.max_layer.load() + 1;
+    int max_experts = 0;
+    int max_top_k = 0;
+    for (int layer = 0; layer < n_layers; ++layer) {
+        max_experts = std::max(max_experts, state.observed_experts[layer].load());
+        max_top_k = std::max(max_top_k, state.observed_top_k[layer].load());
+    }
+    std::ostringstream fingerprint_source;
+    struct stat model_stat {};
+    const int model_layers = ggml_hotexpert_model_layers();
+    const int model_experts = ggml_hotexpert_model_experts();
+    const int model_top_k = ggml_hotexpert_model_expert_used();
+    fingerprint_source << model_path << "|A=" << architecture
+                       << "|L=" << (model_layers > 0 ? model_layers : n_layers)
+                       << "|E=" << (model_experts > 0 ? model_experts : max_experts)
+                       << "|K=" << (model_top_k > 0 ? model_top_k : max_top_k);
+    if (!model_path.empty() && stat(model_path.c_str(), &model_stat) == 0) {
+        fingerprint_source << "|S=" << model_stat.st_size << "|M=" << model_stat.st_mtime;
+    }
+
+    const std::string tmp_path = state.path + ".tmp";
+    std::ofstream out(tmp_path, std::ios::trunc);
+    if (!out) {
+        GGML_LOG_ERROR("HotExpert profiler: cannot open %s\n", tmp_path.c_str());
+        return;
+    }
+
+    out << "{\n";
+    out << "  \"version\": 2,\n";
+    out << "  \"mode\": \"read_only_gpu_counter\",\n";
+    out << "  \"model_architecture\": \"" << json_escape(architecture.empty() ? "runtime_moe" : architecture) << "\",\n";
+    out << "  \"model_path\": \"" << json_escape(model_path) << "\",\n";
+    out << "  \"model_fingerprint\": \"fnv1a64:" << std::hex << fnv1a(fingerprint_source.str()) << std::dec << "\",\n";
+    out << "  \"command_line\": \"" << json_escape(command) << "\",\n";
+    out << "  \"moe_layers\": " << n_layers << ",\n";
+    out << "  \"experts_per_layer_max\": " << max_experts << ",\n";
+    out << "  \"experts_per_token_max\": " << max_top_k << ",\n";
+    out << "  \"decode_only\": " << (state.decode_only ? "true" : "false") << ",\n";
+    out << "  \"interval\": " << state.interval << ",\n";
+    out << "  \"snapshot_sequence\": " << sequence << ",\n";
+
+    const int slots[] = {4, 8, 12, 16, 24, 32, 48, 64};
+    std::array<double, 8> weighted_rates{};
+    uint64_t total_weight_bytes = 0;
+    for (int layer = 0; layer < n_layers; ++layer) {
+        const int n_experts = state.observed_experts[layer].load();
+        const int top_k = state.observed_top_k[layer].load();
+        const uint64_t * layer_hits = hits + size_t(layer) * MAX_EXPERTS;
+        const uint64_t total = std::accumulate(
+            layer_hits, layer_hits + std::max(n_experts, 0), uint64_t(0));
+        const uint64_t weight = state.expert_weight_bytes[layer].load();
+        if (!total || !weight || !n_experts) {
+            continue;
+        }
+        total_weight_bytes += weight;
+        for (size_t i = 0; i < weighted_rates.size(); ++i) {
+            weighted_rates[i] += top_rate(hits + size_t(layer) * MAX_EXPERTS, n_experts, slots[i], total) * double(weight);
+        }
+    }
+
+    out << "  \"byte_weighted_theoretical_hit_rates\": {";
+    for (size_t i = 0; i < weighted_rates.size(); ++i) {
+        if (i) out << ", ";
+        const double rate = total_weight_bytes ? weighted_rates[i] / double(total_weight_bytes) : 0.0;
+        out << "\"top_" << slots[i] << "\": " << std::fixed << std::setprecision(6) << rate;
+    }
+    out << "},\n";
+
+    out << "  \"windows\": [\n";
+    for (size_t w = 0; w < state.windows.size(); ++w) {
+        if (w) out << ",\n";
+        out << "    {\"sequence\": " << state.windows[w].sequence
+            << ", \"decode_tokens\": " << state.windows[w].decode_tokens
+            << ", \"unique_experts\": [";
+        for (int layer = 0; layer < n_layers; ++layer) {
+            if (layer) out << ", ";
+            out << state.windows[w].unique[layer];
+        }
+        out << "]}";
+    }
+    out << "\n  ],\n";
+
+    out << "  \"layers\": [\n";
+    bool first_layer = true;
+    for (int layer = 0; layer < n_layers; ++layer) {
+        const int n_experts = state.observed_experts[layer].load();
+        const int top_k = state.observed_top_k[layer].load();
+        const uint64_t * layer_hits = hits + size_t(layer) * MAX_EXPERTS;
+        const uint64_t * layer_prefill_hits = prefill_hits + size_t(layer) * MAX_EXPERTS;
+        const uint64_t total = std::accumulate(layer_hits, layer_hits + std::max(n_experts, 0), uint64_t(0));
+        const uint64_t prefill_total = std::accumulate(
+            layer_prefill_hits, layer_prefill_hits + std::max(n_experts, 0), uint64_t(0));
+        const uint64_t decode_total = total - std::min(total, prefill_total);
+        std::vector<uint64_t> layer_decode_hits(std::max(n_experts, 0));
+        for (int expert = 0; expert < n_experts; ++expert) {
+            layer_decode_hits[expert] = layer_hits[expert] - std::min(layer_hits[expert], layer_prefill_hits[expert]);
+        }
+        if (!n_experts || !total) {
+            continue;
+        }
+        int unique = 0;
+        for (int expert = 0; expert < n_experts; ++expert) unique += layer_hits[expert] != 0;
+        if (!first_layer) out << ",\n";
+        first_layer = false;
+        out << "    {\"layer\": " << layer
+            << ", \"decode_tokens\": " << tokens[layer]
+            << ", \"prefill_rows\": " << prefill_rows[layer]
+            << ", \"total_hits\": " << total
+            << ", \"decode_total_hits\": " << decode_total
+            << ", \"prefill_total_hits\": " << prefill_total
+            << ", \"unique_experts\": " << unique
+            << ", \"window_unique_experts\": " << window.unique[layer];
+        for (int slot : slots) {
+            out << ", \"top_" << slot << "_hit_rate\": " << std::fixed << std::setprecision(6)
+                << top_rate(layer_hits, n_experts, slot, total);
+        }
+        out << ", \"decode_top_64_hit_rate\": " << std::fixed << std::setprecision(6)
+            << top_rate(layer_decode_hits.data(), n_experts, 64, decode_total);
+        out << ", \"prefill_top_64_hit_rate\": " << std::fixed << std::setprecision(6)
+            << top_rate(layer_prefill_hits, n_experts, 64, prefill_total);
+        const double overlap = overlap_total[layer] ? double(overlap_hits[layer]) / double(overlap_total[layer]) : 0.0;
+        out << ", \"consecutive_token_overlap\": " << std::fixed << std::setprecision(6) << overlap;
+        out << ", \"expert_weight_bytes\": " << state.expert_weight_bytes[layer].load();
+        out << ", \"expert_hits\": [";
+        for (int expert = 0; expert < n_experts; ++expert) {
+            if (expert) out << ", ";
+            out << layer_hits[expert];
+        }
+        out << "], \"decode_expert_hits\": [";
+        for (int expert = 0; expert < n_experts; ++expert) {
+            if (expert) out << ", ";
+            out << layer_decode_hits[expert];
+        }
+        out << "], \"prefill_expert_hits\": [";
+        for (int expert = 0; expert < n_experts; ++expert) {
+            if (expert) out << ", ";
+            out << layer_prefill_hits[expert];
+        }
+        out << "]}";
+    }
+    out << "\n  ]\n}\n";
+    out.close();
+
+    if (std::rename(tmp_path.c_str(), state.path.c_str()) != 0) {
+        GGML_LOG_ERROR("HotExpert profiler: cannot rename %s to %s\n", tmp_path.c_str(), state.path.c_str());
+        return;
+    }
+    GGML_LOG_INFO("HotExpert profiler: wrote %s at decode token %llu\n",
+        state.path.c_str(), (unsigned long long) window.decode_tokens);
+}
+
+static void writer_loop(hotexpert_state * state) {
+    for (;;) {
+        hotexpert_snapshot * snapshot = nullptr;
+        bool periodic = false;
+        {
+            std::unique_lock<std::mutex> lock(state->queue_mutex);
+            state->queue_cv.wait(lock, [&] {
+                return state->stopping || !state->queue.empty() || state->periodic_requests != 0;
+            });
+            if (state->queue.empty() && state->periodic_requests == 0 && state->stopping) {
+                return;
+            }
+            if (!state->queue.empty()) {
+                snapshot = state->queue.front();
+                state->queue.pop_front();
+            } else if (state->periodic_requests != 0) {
+                --state->periodic_requests;
+                periodic = true;
+            }
+        }
+        if (periodic) {
+            CUDA_CHECK(cudaSetDevice(state->device));
+            std::vector<uint64_t> data(snapshot_count());
+            uint64_t * dst = data.data();
+            CUDA_CHECK(cudaMemcpy(dst, state->d_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            dst += hits_count();
+            CUDA_CHECK(cudaMemcpy(dst, state->d_prefill_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            dst += hits_count();
+            CUDA_CHECK(cudaMemcpy(dst, state->d_tokens, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            dst += MAX_LAYERS;
+            CUDA_CHECK(cudaMemcpy(dst, state->d_prefill_rows, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            dst += MAX_LAYERS;
+            CUDA_CHECK(cudaMemcpy(dst, state->d_overlap_hits, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            dst += MAX_LAYERS;
+            CUDA_CHECK(cudaMemcpy(dst, state->d_overlap_total, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+            write_json(*state, data.data(), ++state->snapshot_sequence);
+            continue;
+        }
+        write_json(*state, snapshot->data, snapshot->sequence);
+        snapshot->busy.store(false, std::memory_order_release);
+    }
+}
+
+static void snapshot_ready(void * user_data) {
+    auto * pair = static_cast<std::pair<hotexpert_state *, hotexpert_snapshot *> *>(user_data);
+    hotexpert_state * state = pair->first;
+    hotexpert_snapshot * snapshot = pair->second;
+    delete pair;
+    {
+        std::lock_guard<std::mutex> lock(state->queue_mutex);
+        state->queue.push_back(snapshot);
+    }
+    state->queue_cv.notify_one();
+}
+
+static void token_ready(void * user_data) {
+    auto * state = static_cast<hotexpert_state *>(user_data);
+    const uint64_t tokens = ++state->callback_tokens;
+    if (tokens % state->interval != 0) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(state->queue_mutex);
+        ++state->periodic_requests;
+    }
+    state->queue_cv.notify_one();
+}
+
+__global__ void record_kernel(
+        const int32_t * ids,
+        uint64_t * hits,
+        uint64_t * prefill_hits,
+        uint64_t * tokens,
+        uint64_t * prefill_rows,
+        uint64_t * overlap_hits,
+        uint64_t * overlap_total,
+        int32_t * previous,
+        int layer,
+        int n_experts,
+        int top_k,
+        int n_rows,
+        bool record_prefill) {
+    const int expert_slot = threadIdx.x;
+    if (n_rows != 1) {
+        if (!record_prefill) return;
+        if (expert_slot == 0) atomicAdd((unsigned long long *) &prefill_rows[layer], (unsigned long long) n_rows);
+    }
+    if (expert_slot >= top_k) return;
+
+    const bool had_previous = n_rows == 1 && previous[size_t(layer) * MAX_TOP_K] >= 0;
+
+    for (int row = 0; row < n_rows; ++row) {
+        // ids physical layout: each row is n_experts wide (nb[1] = n_experts
+        // elements), first top_k entries valid
+        const int id = ids[row * n_experts + expert_slot];
+        if (id < 0 || id >= n_experts) continue;
+        atomicAdd((unsigned long long *) &hits[size_t(layer) * MAX_EXPERTS + id], 1ULL);
+        if (n_rows != 1) {
+            atomicAdd((unsigned long long *) &prefill_hits[size_t(layer) * MAX_EXPERTS + id], 1ULL);
+        }
+        if (n_rows == 1) {
+            const int32_t * prev = previous + size_t(layer) * MAX_TOP_K;
+            for (int j = 0; j < top_k; ++j) {
+                if (prev[j] == id) {
+                    atomicAdd((unsigned long long *) &overlap_hits[layer], 1ULL);
+                    break;
+                }
+            }
+            previous[size_t(layer) * MAX_TOP_K + expert_slot] = id;
+        }
+    }
+    __syncthreads();
+    if (expert_slot == 0 && n_rows == 1) {
+        atomicAdd((unsigned long long *) &tokens[layer], 1ULL);
+        if (had_previous) {
+            atomicAdd((unsigned long long *) &overlap_total[layer], (unsigned long long) top_k);
+        }
+    }
+}
+
+static void shutdown_all();
+
+static hotexpert_state * get_state(int device) {
+    if (!env_enabled() || device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(states_mutex);
+    if (states[device]) {
+        return states[device].get();
+    }
+
+    CUDA_CHECK(cudaSetDevice(device));
+    auto state = std::make_unique<hotexpert_state>();
+    state->enabled = true;
+    state->decode_only = [] {
+        const char * value = std::getenv("HOTEXPERT_PROFILE_DECODE_ONLY");
+        return !value || std::strcmp(value, "0") != 0;
+    }();
+    state->interval = env_interval();
+    state->path = env_path();
+    state->device = device;
+    const int model_layers = ggml_hotexpert_model_layers();
+    if (model_layers > 0 && model_layers <= MAX_LAYERS) {
+        state->max_layer.store(model_layers - 1, std::memory_order_relaxed);
+    }
+    state->previous_hits.resize(hits_count(), 0);
+
+    CUDA_CHECK(cudaMalloc((void **) &state->d_hits, hits_count() * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_prefill_hits, hits_count() * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_tokens, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_prefill_rows, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_overlap_hits, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_overlap_total, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMalloc((void **) &state->d_previous, size_t(MAX_LAYERS) * MAX_TOP_K * sizeof(int32_t)));
+    CUDA_CHECK(cudaMemset(state->d_hits, 0, hits_count() * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_prefill_hits, 0, hits_count() * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_tokens, 0, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_prefill_rows, 0, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_overlap_hits, 0, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_overlap_total, 0, MAX_LAYERS * sizeof(uint64_t)));
+    CUDA_CHECK(cudaMemset(state->d_previous, 0xff, size_t(MAX_LAYERS) * MAX_TOP_K * sizeof(int32_t)));
+
+    for (auto & buffer : state->buffers) {
+        buffer.count = snapshot_count();
+        CUDA_CHECK(cudaMallocHost((void **) &buffer.data, buffer.count * sizeof(uint64_t)));
+    }
+    state->writer = std::thread(writer_loop, state.get());
+    hotexpert_state * result = state.get();
+    states[device] = std::move(state);
+
+    if (!shutdown_registered.exchange(true)) {
+        std::atexit(shutdown_all);
+    }
+    GGML_LOG_INFO("HotExpert profiler: enabled path=%s interval=%llu decode_only=%d\n",
+        result->path.c_str(), (unsigned long long) result->interval, result->decode_only ? 1 : 0);
+    return result;
+}
+
+static void enqueue_snapshot(hotexpert_state & state, cudaStream_t stream) {
+    hotexpert_snapshot * buffer = nullptr;
+    for (auto & candidate : state.buffers) {
+        bool expected = false;
+        if (candidate.busy.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) {
+            buffer = &candidate;
+            break;
+        }
+    }
+    if (!buffer) {
+        GGML_LOG_WARN("HotExpert profiler: snapshot skipped because writer is still busy\n");
+        return;
+    }
+
+    buffer->sequence = ++state.snapshot_sequence;
+    uint64_t * dst = buffer->data;
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    dst += hits_count();
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_prefill_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    dst += hits_count();
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_tokens, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    dst += MAX_LAYERS;
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_prefill_rows, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    dst += MAX_LAYERS;
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_overlap_hits, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    dst += MAX_LAYERS;
+    CUDA_CHECK(cudaMemcpyAsync(dst, state.d_overlap_total, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaLaunchHostFunc(stream, snapshot_ready,
+        new std::pair<hotexpert_state *, hotexpert_snapshot *>(&state, buffer)));
+}
+
+static void shutdown_all() {
+    std::lock_guard<std::mutex> global_lock(states_mutex);
+    for (auto & holder : states) {
+        if (!holder) continue;
+        hotexpert_state & state = *holder;
+        CUDA_CHECK(cudaSetDevice(state.device));
+        CUDA_CHECK(cudaDeviceSynchronize());
+
+        {
+            std::lock_guard<std::mutex> lock(state.queue_mutex);
+            state.stopping = true;
+        }
+        state.queue_cv.notify_one();
+        if (state.writer.joinable()) state.writer.join();
+
+        std::vector<uint64_t> final_snapshot(snapshot_count());
+        uint64_t * dst = final_snapshot.data();
+        CUDA_CHECK(cudaMemcpy(dst, state.d_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        dst += hits_count();
+        CUDA_CHECK(cudaMemcpy(dst, state.d_prefill_hits, hits_count() * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        dst += hits_count();
+        CUDA_CHECK(cudaMemcpy(dst, state.d_tokens, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        dst += MAX_LAYERS;
+        CUDA_CHECK(cudaMemcpy(dst, state.d_prefill_rows, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        dst += MAX_LAYERS;
+        CUDA_CHECK(cudaMemcpy(dst, state.d_overlap_hits, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        dst += MAX_LAYERS;
+        CUDA_CHECK(cudaMemcpy(dst, state.d_overlap_total, MAX_LAYERS * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+        write_json(state, final_snapshot.data(), ++state.snapshot_sequence);
+        CUDA_CHECK(cudaFree(state.d_hits));
+        CUDA_CHECK(cudaFree(state.d_prefill_hits));
+        CUDA_CHECK(cudaFree(state.d_tokens));
+        CUDA_CHECK(cudaFree(state.d_prefill_rows));
+        CUDA_CHECK(cudaFree(state.d_overlap_hits));
+        CUDA_CHECK(cudaFree(state.d_overlap_total));
+        CUDA_CHECK(cudaFree(state.d_previous));
+        for (auto & buffer : state.buffers) CUDA_CHECK(cudaFreeHost(buffer.data));
+    }
+}
