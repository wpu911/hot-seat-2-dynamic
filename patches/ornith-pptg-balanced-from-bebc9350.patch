+
+
+struct q122_v3_stream_windows_cfg {
+    std::array<int, 48> threshold{};
+    int count = 0;
+};
+
+static const q122_v3_stream_windows_cfg & q122_v3_stream_windows() {
+    static const q122_v3_stream_windows_cfg cfg = [] {
+        q122_v3_stream_windows_cfg out;
+        const char * v = std::getenv("Q122_V3_STREAMED_THRESHOLDS");
+        if (!v || !*v) return out;
+        const char * cur = v;
+        int last = -1;
+        while (*cur && out.count < 48) {
+            char * end = nullptr;
+            long x = std::strtol(cur, &end, 10);
+            if (end == cur) break;
+            const int t = std::clamp<int>((int) x, 0, 47);
+            if (t > last) {
+                out.threshold[size_t(out.count++)] = t;
+                last = t;
+            }
+            cur = end;
+            while (*cur == ',' || *cur == ';' || *cur == ' ' || *cur == '\t') ++cur;
+        }
+        if (out.count > 0) {
+            std::fprintf(stderr, "Q122 V3: streamed thresholds=");
+            for (int i = 0; i < out.count; ++i) std::fprintf(stderr, "%s%d", i ? "," : "", out.threshold[size_t(i)]);
+            std::fprintf(stderr, "\\n");
+            std::fflush(stderr);
+        }
+        return out;
+    }();
+    return cfg;
+}
