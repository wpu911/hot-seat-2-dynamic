+// MoE Hot Layer Stats v0:
+// Runtime profiler for fused topk_moe expert ids.
+// It reads selected expert ids from GPU after topk_moe fusion and accumulates:
+//   layer_id -> expert_id -> hits
+// Output:
+//   /app/share/llama_box/config/hot_layers_stats.json
+//
+// This is intentionally a profiler-first implementation. It may add sync overhead.
+// Yes, profiling costs something. Reality continues to be rude.
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <mutex>
+#include <regex>
+#include <string>
+#include <vector>
+#include <utility>
+
+#include "../ggml-cpu/q122-r0-rank.inc"
+
+static std::mutex moe_hot_layer_stats_mutex;
+static std::array<std::array<uint64_t, 1024>, 256> moe_hot_layer_stats_hits{};
+static std::array<uint64_t, 256> moe_hot_layer_stats_total_hits{};
+static std::atomic<uint64_t> moe_hot_layer_stats_calls{0};
+
+static int moe_hot_layer_stats_parse_layer_id(const char * name) {
+    if (!name) {
+        return -1;
+    }
+
+    auto parse_after_prefix = [](const char * p) -> int {
+        if (!p) {
+            return -1;
+        }
+
+        if (*p < '0' || *p > '9') {
+            return -1;
+        }
+
+        int layer = 0;
+        while (*p >= '0' && *p <= '9') {
+            layer = layer * 10 + (*p - '0');
+            ++p;
+        }
+
+        if (layer < 0 || layer >= 256) {
+            return -1;
+        }
+
+        return layer;
+    };
+
+    // Name we set in llama-graph.cpp:
+    //   ffn_moe_selected_experts_l15
+    const char * p = std::strstr(name, "ffn_moe_selected_experts_l");
+    if (p) {
+        p += std::strlen("ffn_moe_selected_experts_l");
+        return parse_after_prefix(p);
+    }
+
+    // Names commonly seen in the fused topk_moe path:
+    //   ffn_moe_topk-15
+    //   ffn_moe_argsort-15
+    p = std::strstr(name, "ffn_moe_topk-");
+    if (p) {
+        p += std::strlen("ffn_moe_topk-");
+        return parse_after_prefix(p);
+    }
+
+    p = std::strstr(name, "ffn_moe_argsort-");
+    if (p) {
+        p += std::strlen("ffn_moe_argsort-");
+        return parse_after_prefix(p);
+    }
+
+    return -1;
+}
+
+
+static int moe_hot_layer_stats_get_expert_count() {
+    const char * env = std::getenv("HOTSEAT_EXPERT_COUNT");
+
+    if (env && *env) {
+        const int v = std::atoi(env);
+        if (v > 0 && v <= 1024) {
+            return v;
+        }
+    }
+
+    // Qwen3.6 35B A3B 当前统计显示 expert id 范围按 256 更合理。
+    // 如果未来换 128/64 experts 的模型，用 HOTSEAT_EXPERT_COUNT 覆盖。
+    return 256;
+}
+
+
+static double moe_hot_layer_stats_layer_score_for_plan(int layer, int expert_count) {
+    const uint64_t total = moe_hot_layer_stats_total_hits[layer];
+
+    if (total == 0) {
+        return -1.0;
+    }
+
+    uint64_t unique = 0;
+    uint64_t top8_hits = 0;
+
+    std::vector<std::pair<int, uint64_t>> experts;
+
+    for (int e = 0; e < 1024; ++e) {
+        const uint64_t h = moe_hot_layer_stats_hits[layer][e];
+
+        if (h == 0) {
+            continue;
+        }
+
+        unique++;
+        experts.push_back({e, h});
+    }
+
+    std::sort(experts.begin(), experts.end(), [](const auto & a, const auto & b) {
+        return a.second > b.second;
+    });
+
+    for (size_t i = 0; i < experts.size() && i < 8; ++i) {
+        top8_hits += experts[i].second;
+    }
+
+    const int expert_count_safe = expert_count > 0 ? expert_count : 256;
+    const double unique_ratio = (double) unique / (double) expert_count_safe;
+    const double top8_ratio = total ? (double) top8_hits / (double) total : 0.0;
+
+    double entropy = 0.0;
+
+    for (const auto & item : experts) {
+        const double p = total ? (double) item.second / (double) total : 0.0;
+
+        if (p > 0.0) {
+            entropy -= p * std::log(p);
+        }
+    }
+
+    const double max_entropy = expert_count_safe > 1 ? std::log((double) expert_count_safe) : 1.0;
+    const double entropy_ratio = max_entropy > 0.0 ? entropy / max_entropy : 0.0;
+    const double breadth_score = 0.50 * unique_ratio + 0.50 * entropy_ratio;
+
+    const double total_score = std::log1p((double) total);
+    const double concentrated_score = top8_ratio * std::log1p((double) top8_hits);
+    const double breadth_component = breadth_score * std::log1p((double) unique);
+
+    return
+        0.35 * total_score +
+        0.30 * concentrated_score +
+        0.35 * breadth_component;
+}
+
+static void moe_hot_layer_stats_write_plan_json_unlocked(const char * stats_path) {
+    const char * enabled = std::getenv("HOTSEAT_LAYER_PLAN_AUTO_ENABLE");
+
+    if (!enabled || std::strcmp(enabled, "1") != 0) {
+        return;
+    }
+
+    const char * path_env = std::getenv("HOTSEAT_LAYER_PLAN_AUTO_PATH");
+    const char * plan_path = path_env && *path_env
+        ? path_env
+        : "/app/share/llama_box/config/hot_layers_plan.json";
+
+    int max_hot_layers = 18;
+
+    const char * max_layers_env = std::getenv("HOTSEAT_LAYER_PLAN_MAX_LAYERS");
+    if (max_layers_env && *max_layers_env) {
+        const int v = std::atoi(max_layers_env);
+        if (v > 0 && v <= 256) {
+            max_hot_layers = v;
+        }
+    }
+
+    const int expert_count = moe_hot_layer_stats_get_expert_count();
+
+    std::vector<std::pair<double, int>> ranked;
+
+    for (int l = 0; l < 256; ++l) {
+        const double score = moe_hot_layer_stats_layer_score_for_plan(l, expert_count);
+
+        if (score >= 0.0) {
+            ranked.push_back({score, l});
+        }
+    }
+
+    std::sort(ranked.begin(), ranked.end(), [](const auto & a, const auto & b) {
+        return a.first > b.first;
+    });
+
+    std::vector<int> selected;
+
+    for (size_t i = 0; i < ranked.size() && (int) selected.size() < max_hot_layers; ++i) {
+        selected.push_back(ranked[i].second);
+    }
+
+    std::sort(selected.begin(), selected.end());
+
+    FILE * fp = std::fopen(plan_path, "w");
+
+    if (!fp) {
+        GGML_LOG_WARN("MoE HotLayerStats: failed to write auto plan to %s\n", plan_path);
+        return;
+    }
+
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp, "  \"version\": 1,\n");
+    std::fprintf(fp, "  \"type\": \"moe_hot_layer_plan\",\n");
+    std::fprintf(fp, "  \"generated_by\": \"MoE HotLayerStats auto plan writer inside ggml-cuda.cu\",\n");
+    std::fprintf(fp, "  \"source\": \"%s\",\n", stats_path ? stats_path : "");
+    std::fprintf(fp, "  \"expert_count\": %d,\n", expert_count);
+    std::fprintf(fp, "  \"max_hot_layers\": %d,\n", max_hot_layers);
+    std::fprintf(fp, "  \"score_formula\": \"0.35*log1p(total_hits)+0.30*top8_ratio*log1p(top8_hits)+0.35*breadth_score*log1p(unique_experts)\",\n");
+
+    std::fprintf(fp, "  \"hot_layer_plan\": [");
+    for (size_t i = 0; i < selected.size(); ++i) {
+        if (i) {
+            std::fprintf(fp, ", ");
+        }
+        std::fprintf(fp, "%d", selected[i]);
+    }
+    std::fprintf(fp, "],\n");
+
+    std::fprintf(fp, "  \"ranked_layers\": [\n");
+
+    for (size_t i = 0; i < ranked.size(); ++i) {
+        const int layer = ranked[i].second;
+        const double score = ranked[i].first;
+        const uint64_t total = moe_hot_layer_stats_total_hits[layer];
+
+        uint64_t unique = 0;
+        uint64_t top1_hits = 0;
+        int top1_expert = -1;
+        uint64_t top8_hits = 0;
+        uint64_t top16_hits = 0;
+        uint64_t top32_hits = 0;
+        uint64_t top64_hits = 0;
+        uint64_t top128_hits = 0;
+
+        std::vector<std::pair<int, uint64_t>> experts;
+
+        for (int e = 0; e < 1024; ++e) {
+            const uint64_t h = moe_hot_layer_stats_hits[layer][e];
+            if (h == 0) {
+                continue;
+            }
+
+            unique++;
+            experts.push_back({e, h});
+
+            if (h > top1_hits) {
+                top1_hits = h;
+                top1_expert = e;
+            }
+        }
+
+        std::sort(experts.begin(), experts.end(), [](const auto & a, const auto & b) {
+            return a.second > b.second;
+        });
+
+        for (size_t k = 0; k < experts.size() && k < 8; ++k) {
+            top8_hits += experts[k].second;
+        }
+
+        const double top1_ratio = total ? (double) top1_hits / (double) total : 0.0;
+        const double top8_ratio = total ? (double) top8_hits / (double) total : 0.0;
+        const double top16_ratio = total ? (double) top16_hits / (double) total : 0.0;
+        const double top32_ratio = total ? (double) top32_hits / (double) total : 0.0;
+        const double top64_ratio = total ? (double) top64_hits / (double) total : 0.0;
+        const double top128_ratio = total ? (double) top128_hits / (double) total : 0.0;
+
+        if (i) {
+            std::fprintf(fp, ",\n");
+        }
+
+        std::fprintf(fp, "    {\n");
+        std::fprintf(fp, "      \"layer\": %d,\n", layer);
+        std::fprintf(fp, "      \"score\": %.6f,\n", score);
+        std::fprintf(fp, "      \"total_hits\": %llu,\n", (unsigned long long) total);
+        std::fprintf(fp, "      \"unique_experts\": %llu,\n", (unsigned long long) unique);
+        std::fprintf(fp, "      \"top1_expert\": %d,\n", top1_expert);
+        std::fprintf(fp, "      \"top1_hits\": %llu,\n", (unsigned long long) top1_hits);
+        std::fprintf(fp, "      \"top1_ratio\": %.6f,\n", top1_ratio);
+        std::fprintf(fp, "      \"top8_hits\": %llu,\n", (unsigned long long) top8_hits);
+        std::fprintf(fp, "      \"top8_ratio\": %.6f\n", top8_ratio);
+        std::fprintf(fp, "    }");
+    }
+
+    std::fprintf(fp, "\n  ]\n");
+    std::fprintf(fp, "}\n");
+
+    std::fclose(fp);
+
+    GGML_LOG_INFO(
+        "MoE HotLayerStats: auto-wrote hot layer plan to %s with %zu selected layers\n",
+        plan_path,
+        selected.size());
+}
