+bool ggml_cuda_hotexpert_runtime_enabled() {
+    static const bool enabled = [] {
+        const runtime_mode mode = env_mode();
+        const bool transit_only = q122_v3_transit_mode();
+        if (mode == MODE_STATIC && !transit_only) {
+            return false;
+        }
+        g_state.mode = mode;
+        g_state.transit_only = transit_only;
+        g_state.enabled = true;
+        {
+            // string-compare (env_int treats "0" as unset -> fallback 1)
+            const char * fs = std::getenv("HOTSEAT_FULL_SHADOW");
+            g_state.full_shadow = !(fs && std::strcmp(fs, "0") == 0);
+        }
+        g_state.slots = env_int("HOTSEAT_EXPERT_SLOTS", SLOTS_PER_BANK);
+        g_state.full_count = env_int("HOTSEAT_FULL_LAYER_COUNT", 10);
+        g_state.v2_profile_enabled = [] {
+            const char * v = std::getenv("HOTSEAT_V2_PROFILE");
+            return v && std::strcmp(v, "1") == 0;
+        }();
+        g_state.v2_profile_capacity = uint64_t(std::clamp(
+            env_int("HOTSEAT_V2_PROFILE_CAPACITY", 2048), 64, 65536));
+        g_state.v2_prefetch_enabled = [] {
+            const char * v = std::getenv("HOTSEAT_V2_PREFETCH");
+            return v && std::strcmp(v, "1") == 0;
+        }();
+        g_state.v2_route_capacity = uint64_t(std::clamp(
+            env_int("HOTSEAT_V2_ROUTE_CAPACITY", 64), 2, 256));
+        g_state.v2_transit_enabled = g_state.v2_prefetch_enabled && [] {
+            const char * v = std::getenv("HOTSEAT_V2_TRANSIT");
+            return !v || std::strcmp(v, "0") != 0;
+        }();
+        g_state.v2_transit_slots = std::clamp(
+            env_int("HOTSEAT_V2_TRANSIT_SLOTS", 2), 1, GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS);
+        g_state.v2_persistent_transit = g_state.v2_transit_enabled && [] {
+            const char * v = std::getenv("HOTSEAT_V2_PERSISTENT_TRANSIT");
+            return v && std::strcmp(v, "1") == 0;
+        }();
+        if (g_state.transit_only) {
+            g_state.v2_profile_enabled = false;
+            g_state.v2_prefetch_enabled = true;
+            g_state.v2_transit_enabled = true;
+            g_state.v2_persistent_transit = true;
+            g_state.v2_transit_slots = std::clamp(
+                env_int("Q122_V3_TRANSIT_SLOTS_PER_BANK", 3), 1, GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS);
+        }
+        g_state.v2_predictor_min_ppm = uint32_t(std::clamp(
+            env_int("HOTSEAT_V2_PREDICTOR_MIN_PPM", 1), 1, 1000000));
+        {
+            const char * predictor = std::getenv("HOTSEAT_V2_PREDICTOR_FILE");
+            if (g_state.v2_transit_enabled && predictor && *predictor) {
+                load_v2_predictor(g_state, predictor);
+            }
+        }
+        {
+            const char * dir = std::getenv("HOTSEAT_V2_PROFILE_DIR");
+            g_state.v2_profile_dir = (dir && *dir)
+                ? dir
+                : "/app/share/llm/Ornith-1.5-35B-A3B-GGUF/hotseat-v2/profile";
+        }
+        std::fprintf(stderr, "HotSeat V2 profiler: env=%s enabled=%s capacity=%llu dir=%s\n",
+            std::getenv("HOTSEAT_V2_PROFILE") ? std::getenv("HOTSEAT_V2_PROFILE") : "<unset>",
+            g_state.v2_profile_enabled ? "yes" : "no",
+            (unsigned long long) g_state.v2_profile_capacity,
+            g_state.v2_profile_dir.c_str());
+        g_state.expert_eval_tokens = env_int("HOTSEAT_EXPERT_EVAL_TOKENS", 4096);
+        g_state.expert_eval_auto = [] {
+            const char * v = std::getenv("HOTSEAT_EXPERT_EVAL_AUTO");
+            return v && std::strcmp(v, "1") == 0;
+        }();
+        g_state.expert_eval_min = env_int("HOTSEAT_EXPERT_EVAL_MIN", 1024);
+        g_state.expert_eval_max = env_int("HOTSEAT_EXPERT_EVAL_MAX", 16384);
+        g_state.expert_eval_safety = env_int("HOTSEAT_EXPERT_EVAL_SAFETY", 2);
+        g_state.rollback_enabled = [] {
+            const char * v = std::getenv("HOTSEAT_DISABLE_ROLLBACK");
+            return !v || std::strcmp(v, "1") != 0;
+        }();
+        g_state.rollback_tps_drop_pct = env_int("HOTSEAT_ROLLBACK_TPS_DROP_PCT", 5);
+        g_state.expert_confirm = env_int("HOTSEAT_EXPERT_CONFIRM_WINDOWS", 2);
+        g_state.expert_ratio = env_double("HOTSEAT_EXPERT_RATIO", 1.25);
+        g_state.expert_max_swap = env_int("HOTSEAT_EXPERT_MAX_SWAP", 8);
+        g_state.layer_eval_requests = env_int("HOTSEAT_LAYER_EVAL_REQUESTS", 8);
+        g_state.layer_eval_prefill_tokens = env_int("HOTSEAT_LAYER_EVAL_PREFILL_TOKENS", 16384);
+        g_state.layer_confirm = env_int("HOTSEAT_LAYER_CONFIRM_WINDOWS", 3);
+        g_state.layer_ratio = env_double("HOTSEAT_LAYER_RATIO", 1.25);
+        g_state.layer_cooldown_requests = env_int("HOTSEAT_LAYER_COOLDOWN_REQUESTS", 8);
+        g_state.bw_bytes_per_ns = env_double("HOTSEAT_STALL_BW_GBPS", 12.0);
+        g_state.ewma_short = env_double("HOTSEAT_RUNTIME_EWMA_SHORT", 0.25);
+        g_state.ewma_long  = env_double("HOTSEAT_RUNTIME_EWMA_LONG", 0.05);
+        g_state.eval_at_request = [] {
+            const char * v = std::getenv("HOTSEAT_EVAL_AT_REQUEST");
+            return !v || std::strcmp(v, "0") != 0;
+        }();
+        const char * log_path = std::getenv("HOTSEAT_RUNTIME_LOG");
+        if (log_path && *log_path) {
+            g_state.log_path = log_path;
+            g_state.log_file = std::fopen(log_path, "a");
+            if (!g_state.log_file) {
+                GGML_LOG_WARN("HotExpert runtime: cannot open log %s, using stderr\n", log_path);
+            }
+        }
+        const char * profile = std::getenv("HOTSEAT_RUNTIME_PROFILE");
+        if (!profile || !*profile) {
+            profile = std::getenv("HOTEXPERT_CACHE_PROFILE");
+        }
+        if (!profile || !*profile) {
+            // fingerprint-scoped auto pick, same layout as the writer side;
+            // when the descriptor is not yet available (e.g. a fully host-
+            // resident model never registers GPU tensors), fall back to the
+            // most recently written profile in the directory
+            const char * dir = std::getenv("HOTSEAT_AUTO_PROFILE_DIR");
+            const std::string d = (dir && *dir) ? dir : "/app/share/openclaw_tools/hotexpert-profiles";
+            std::string fp = "runtime";
+            hotseat_model_descriptor desc;
+            if (ggml_cuda_hotexpert_descriptor_build(desc)) {
+                fp = desc.fingerprint;
+                g_state.profile_path = d + "/" + fp + ".profile.json";
+            } else {
+                // pick the newest *.profile.json in the directory
+                std::string newest;
+                int64_t newest_mtime = -1;
+                std::string pattern = d + "/*.profile.json";
+                glob_t gb;
+                if (::glob(pattern.c_str(), 0, nullptr, &gb) == 0) {
+                    for (size_t i = 0; i < gb.gl_pathc; ++i) {
+                        struct stat st;
+                        if (::stat(gb.gl_pathv[i], &st) == 0 && st.st_mtime > newest_mtime) {
+                            newest_mtime = (int64_t) st.st_mtime;
+                            newest = gb.gl_pathv[i];
+                        }
+                    }
+                    ::globfree(&gb);
+                }
+                if (!newest.empty()) {
+                    g_state.profile_path = newest;
+                } else {
+                    g_state.profile_path = d + "/" + fp + ".profile.json";
+                }
+            }
+            profile = g_state.profile_path.c_str();
+        }
+        {
+            // expected fingerprint for profile validation (empty when the
+            // descriptor is not available yet -> validation skipped)
+            hotseat_model_descriptor dsc;
+            if (ggml_cuda_hotexpert_descriptor_build(dsc)) {
+                g_state.expected_fingerprint = dsc.fingerprint;
+            }
+        }
+        const std::string profile_fp_guard = g_state.transit_only ? std::string() : g_state.expected_fingerprint;
+        if (!load_profile(g_state, profile, profile_fp_guard)) {
+            // profile is a prior-knowledge hint only; the runtime falls back
+            // to EWMA-driven planning, so a missing/incompatible profile must
+            // not disable the runtime (it only loses the initial ranking)
+            GGML_LOG_WARN("HotExpert runtime: profile unavailable, using EWMA-driven planning\n");
+        }
+        // enabled line carries only real configuration state, never foreign
+        // profile values; the actual per-layer layout is printed after the
+        // plan is applied (initialized + layer audit + bank audit)
+        std::fprintf(stderr, "HotExpert runtime: enabled mode=%s full_shadow=%s\n",
+            g_state.transit_only ? "q122-v3-transit-only" :
+                (mode == MODE_DYNAMIC_HYBRID ? "dynamic-hybrid" : "dynamic-experts"),
+            g_state.full_shadow ? "on" : "off");
+        std::fflush(stderr);
+        return true;
+    }();
+    return enabled;
+}
+
+bool ggml_cuda_hotexpert_runtime_hybrid() {
+    return ggml_cuda_hotexpert_runtime_enabled() && g_state.hybrid;
+}
+
+void ggml_cuda_hotexpert_runtime_maybe_invalidate_graph(
+        ggml_backend_cuda_context & ctx,
+        const ggml_cgraph *         graph) {
+#ifdef USE_CUDA_GRAPH
+    if (!g_state.enabled || !g_state.initialized) {
+        return;
+    }
+    if (!g_state.commit_happened.exchange(false, std::memory_order_acq_rel)) {
+        return;
+    }
+    // A commit can land on any graph boundary (prefill or decode). Invalidate
+    // every cached executable so the next decode re-captures with the new
+    // expert pointer tables, regardless of which graph carried the commit.
+    int invalidated = 0;
+    for (auto & kv : ctx.cuda_graphs) {
+        ggml_cuda_graph * cached = kv.second.get();
+        if (cached && cached->instance) {
+            CUDA_CHECK(cudaGraphExecDestroy(cached->instance));
+            cached->instance = nullptr;
+            invalidated++;
+        }
+    }
+    GGML_LOG_INFO("HotExpert runtime: invalidated %d captured graph(s) for re-capture\n", invalidated);
+#else
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(graph);
+#endif
+}
+
+void ggml_cuda_hotexpert_runtime_register_weight(const ggml_tensor * weight) {
+    // unconditional read-only collection for the model descriptor probe
+    ggml_cuda_hotexpert_descriptor_collect(weight);
+    if (!ggml_cuda_hotexpert_runtime_enabled() || !weight || !weight->data) {
+        return;
+    }
+    const int layer = parse_layer(weight->name);
+    const int kind  = tensor_kind(weight->name);
+    if (layer < 0 || kind < 0 || kind >= MAX_TENSORS) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_state.reg_mutex);
+    layer_t & L = g_state.layers[layer];
+    tensor_slot & t = L.tensors[kind];
+    if (t.host_ptr) {
+        return;
+    }
+    t.host_ptr   = weight->data;
+    t.stride     = weight->nb[2];
+    t.n_experts  = int(weight->ne[2]);
+    t.bytes      = ggml_nbytes(weight);
+    if (t.n_experts <= 0 || t.n_experts > MAX_EXPERTS) {
+        t.host_ptr = nullptr;
+        return;
+    }
+    L.registered = true;
+    g_state.registry[weight->data] = {layer, kind};
+}
+
+void ggml_cuda_hotexpert_runtime_prepare_graph(
+        ggml_backend_cuda_context & ctx,
+        const ggml_cgraph *         graph) {
+    if (!ggml_cuda_hotexpert_runtime_enabled()) {
+        return;
+    }
+
+    if (!g_state.initialized) {
+        int max_layer = -1;
+        for (int i = 0; i < graph->n_nodes; ++i) {
+            max_layer = std::max(max_layer, parse_layer(graph->nodes[i]->name));
+        }
+        int registered = 0;
+        for (int layer = 0; layer <= max_layer && layer < MAX_LAYERS; ++layer) {
+            for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                if (g_state.layers[layer].tensors[kind].host_ptr) ++registered;
+            }
+        }
+
+        const int model_layers = ggml_hotexpert_model_layers();
+        const int expected = model_layers > 0 ? model_layers : (max_layer + 1);
+        int split_layers = 0;
+        int split_registered = 0;
+        if (g_state.transit_only) {
+            for (int layer = 0; layer < expected && layer < MAX_LAYERS; ++layer) {
+                if (!q122_v3_split_layer(layer)) continue;
+                ++split_layers;
+                for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                    if (g_state.layers[layer].tensors[kind].host_ptr) ++split_registered;
+                }
+            }
+        }
+
+        // Dynamic runtime waits for the full model. Q122 V3 owns only the
+        // configured R1 split layers, so 16*3 expert tensors are sufficient.
+        const bool registry_ready = g_state.transit_only
+            ? (split_layers > 0 && split_registered >= split_layers * 3)
+            : (max_layer >= 0 && registered >= expected * 3);
+        if (registry_ready) {
+            g_state.device = ctx.device;
+            const bool ok = g_state.transit_only
+                ? initialize_transit_only(g_state)
+                : initialize_runtime(g_state);
+            if (ok) g_state.initialized = true;
+        }
+        return;
+    }
+
+    if (g_state.transit_only) {
+        bool is_prefill = false;
+        for (int i = 0; i < graph->n_nodes; ++i) {
+            const ggml_tensor * node = graph->nodes[i];
+            if (node->op == GGML_OP_MUL_MAT_ID && node->src[1] && node->src[1]->ne[2] > 1) {
+                is_prefill = true;
+                break;
+            }
+        }
+        if (is_prefill) {
+            // P1 is decode-only. Prefill never consumes Transit, but V6 collects
+            // routing frequencies. Start one accumulation per request and keep it
+            // across the server's 2K prefill chunks.
+            if (g_state.v3_prefill_adapt && !g_state.v3_prefill_collecting) {
+                ggml_hotexpert_q122_adaptive_reset();
+                g_state.v3_prefill_pending = false;
+                g_state.v3_prefill_collecting = true;
+            }
+            ggml_hotexpert_v3_transit_reset();
+            return;
+        }
+
+        if (g_state.v3_prefill_adapt && g_state.v3_prefill_collecting) {
+            bool seed_ok = true;
+            if (g_state.v3_prefill_pending && g_state.d_prefill) {
+                CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+                std::vector<uint64_t> prefill_hits(size_t(MAX_LAYERS) * MAX_EXPERTS);
+                CUDA_CHECK(cudaMemcpy(prefill_hits.data(), g_state.d_prefill,
+                    prefill_hits.size() * sizeof(uint64_t), cudaMemcpyDeviceToHost));
+                seed_ok = ggml_cuda_hotexpert_cache_seed_prefill(
+                    prefill_hits.data(), g_state.n_layers, g_state.n_experts, MAX_EXPERTS);
+                CUDA_CHECK(cudaMemset(g_state.d_prefill, 0, prefill_hits.size() * sizeof(uint64_t)));
+                if (g_state.d_prefill_rows) CUDA_CHECK(cudaMemset(g_state.d_prefill_rows, 0, size_t(MAX_LAYERS) * sizeof(uint64_t)));
+                g_state.v3_prefill_pending = false;
+            } else {
+                // Q122 hybrid fallback: MMID route ids were accumulated on CPU.
+                seed_ok = ggml_cuda_hotexpert_cache_seed_adaptive_counts(g_state.n_layers, g_state.n_experts);
+            }
+            if (!seed_ok) GGML_LOG_WARN("Q122 PREFILL_SEED: cache seed failed; retaining prior resident set\n");
+            g_state.v3_prefill_collecting = false;
+        }
+
+        // The previous token's complete CPU route predicts this token. The
+        // first decode has no prior route and therefore remains pure R1.
+        const uint64_t source = ggml_hotexpert_v3_route_latest();
+        if (source != UINT64_MAX) {
+            const uint64_t target = source + 1;
+            // Graph turnover is a safe ownership boundary: the previous decode
+            // graph is complete and the next one has not launched. Adaptive
+            // Borrow may rewrite a few resident slices here without racing MMVQ.
+            if (!ggml_cuda_hotexpert_cache_adapt(target)) {
+                GGML_LOG_WARN("Q122 ADAPT: planner failed at token %llu; keeping prior Borrow set\n",
+                    (unsigned long long) target);
+            }
+            if (g_state.v3_committed_target_token.load(std::memory_order_acquire) != target) {
+                if (g_state.v3_staged_target_token.load(std::memory_order_acquire) != target) {
+                    // Worker normally stages during the previous token tail. If
+                    // graph turnover wins the race, enqueue here as a safe fallback.
+                    q122_v3_stage_cpu_route_async(g_state, source, target);
+                }
+                q122_v3_commit_staged_route(g_state, target);
+            } else {
+                ggml_hotexpert_v3_set_current_token(target);
+            }
+        }
+        return;
+    }
+
+    // ---- stage J2: physical VRAM low-water monitoring + measured sizing ----
+    // Sampling is unconditional: both measure-only runs and arena runs keep
+    // updating the low-water mark so the profile always carries the true
+    // post-stress low-water for the next sizing decision.
+    {
+        size_t f0 = 0, t0 = 0;
+        if (hipMemGetInfo(&f0, &t0) == hipSuccess) {
+            const uint64_t cur = uint64_t(f0);
+            if (g_state.arena_min_free_seen == 0 || cur < g_state.arena_min_free_seen) {
+                g_state.arena_min_free_seen = cur;
+            }
+            if (g_state.arena_enabled && g_state.arena.valid() &&
+                cur < g_state.arena_target_free_bytes &&
+                !g_state.arena_frozen.load(std::memory_order_relaxed)) {
+                g_state.arena_frozen.store(true, std::memory_order_relaxed);
+                GGML_LOG_WARN("HotExpert arena: low-water breach (free %llu MiB < %llu MiB); capacity frozen\n",
+                    (unsigned long long) (cur >> 20),
+                    (unsigned long long) (g_state.arena_target_free_bytes >> 20));
+            }
+        }
+    }
+    if (g_state.arena_enabled && !g_state.arena.valid()) {
+        // Sizing source: a previous full-stress run's measured low-water.
+        // Never size from the current run's mid-flight sample - the real
+        // low point comes later, under real traffic.
+        const char * apply_profile = std::getenv("HOTSEAT_ARENA_APPLY_PROFILE");
+        if (!apply_profile) {
+            GGML_LOG_INFO("HotExpert arena: measure mode (no apply profile); "
+                          "tracking low-water only, capacity off\n");
+            g_state.arena_enabled = false;
+        } else {
+            const uint64_t measured = read_profile_low_water(apply_profile);
+            const uint64_t page_bytes = uint64_t(env_int("HOTSEAT_ARENA_PAGE_MB", 2)) << 20;
+            const uint64_t grow_step = uint64_t(env_int("HOTSEAT_ARENA_GROW_STEP_MB", 256)) << 20;
+            const uint64_t jitter = uint64_t(env_int("HOTSEAT_ARENA_JITTER_MB", 256)) << 20;
+            const uint64_t budget = g_state.arena_target_free_bytes + jitter;
+            if (measured > budget) {
+                uint64_t arena_bytes = ((measured - budget) / grow_step) * grow_step;
+                if (arena_bytes >= (256u << 20)) {
+                    if (!g_state.arena.init(arena_bytes, page_bytes, "runtime-arena")) {
+                        GGML_LOG_WARN("HotExpert arena: allocation failed; dynamic capacity disabled\n");
+                        g_state.arena_enabled = false;
+                    } else {
+                        GGML_LOG_INFO("HotExpert arena: reserved %llu MiB = measured low-water %llu MiB"
+                                      " - target %llu MiB - jitter %llu MiB\n",
+                            (unsigned long long) (arena_bytes >> 20),
+                            (unsigned long long) (measured >> 20),
+                            (unsigned long long) (g_state.arena_target_free_bytes >> 20),
+                            (unsigned long long) (jitter >> 20));
+                        restore_runtime_snapshot_arena(g_state);
+                    }
+                } else {
+                    GGML_LOG_WARN("HotExpert arena: measured low-water %llu MiB leaves"
+                                  " <256 MiB arena; capacity disabled\n",
+                        (unsigned long long) (measured >> 20));
+                    g_state.arena_enabled = false;
+                }
+            } else {
+                GGML_LOG_WARN("HotExpert arena: measured low-water %llu MiB <= target+jitter;"
+                              " capacity disabled\n",
+                    (unsigned long long) (measured >> 20));
+                g_state.arena_enabled = false;
+            }
+        }
+    }
+    // ---- J5: rollback to the previous stable generation ----
+    if (g_state.rollback_requested.exchange(false, std::memory_order_acq_rel)) {
+        if (g_state.previous_map) {
+            g_state.current_map = std::move(g_state.previous_map);
+            g_state.arena_frozen.store(true, std::memory_order_relaxed);
+            GGML_LOG_WARN("HotExpert runtime: rolled back to previous generation; arena frozen\n");
+            std::lock_guard<std::mutex> lock(g_state.log_mutex);
+            FILE * out = g_state.log_file ? g_state.log_file : stderr;
+            std::fprintf(out,
+                "{\"ts\":%lld,\"event\":\"rollback\",\"generation\":%llu,\"reason\":\"%s\"}\n",
+                (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::system_clock::now().time_since_epoch()).count(),
+                (unsigned long long) (g_state.current_map ? g_state.current_map->generation : 0),
+                g_state.disable_reason.c_str());
+            std::fflush(out);
+        }
+    }
+
+    // ---- commit a pending swap at this safe boundary ----
+    if (g_state.commit_pending.load(std::memory_order_acquire)) {
+        CUDA_CHECK(cudaSetDevice(g_state.device));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        CUDA_CHECK(cudaStreamWaitEvent(ctx.stream(), g_state.ready_event, 0));
+        // flip committed buffers: the pending map references the free buffers
+        for (int layer = 0; layer < g_state.n_layers; ++layer) {
+            for (int kind = 0; kind < MAX_TENSORS; ++kind) {
+                tensor_slot & t = g_state.layers[layer].tensors[kind];
+                if (t.host_ptr) t.committed_buf = 1 - t.committed_buf;
+            }
+        }
+        if (g_state.current_map) {
+            g_state.previous_map = std::move(g_state.current_map);
+        }
+        g_state.current_map = std::move(g_state.pending_map);
+        g_state.commit_pending.store(false, std::memory_order_release);
+        g_state.commit_applied.store(true, std::memory_order_release);
+        g_state.commit_happened.store(true, std::memory_order_release);
+        g_state.commit_cv.notify_one();
+        GGML_LOG_INFO("HotExpert runtime: committed generation %llu\n",
+            (unsigned long long) (g_state.current_map ? g_state.current_map->generation : 0));
+    }
+
+    // ---- request / token accounting ----
+    const uint64_t decode = g_state.decode_tokens.load(std::memory_order_acquire);
+    bool is_prefill = false;
+    int64_t prefill_rows = 0;
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        const ggml_tensor * node = graph->nodes[i];
+        if (node->op == GGML_OP_MUL_MAT_ID && node->src[1] && node->src[1]->ne[2] > 1) {
+            is_prefill = true;
+            prefill_rows = std::max(prefill_rows, node->src[1]->ne[2]);
+            break;
+        }
+    }
+    if (is_prefill) {
+        g_state.prefill_tokens.fetch_add(uint64_t(prefill_rows), std::memory_order_relaxed);
+        if (decode > g_state.last_eval_decode.load(std::memory_order_acquire)) {
+            g_state.requests.fetch_add(1, std::memory_order_relaxed);
+            if (g_state.full_cooldown > 0) {
+                g_state.full_cooldown--;
+            }
+            if (g_state.eval_at_request &&
+                !g_state.eval_requested.exchange(true, std::memory_order_acq_rel)) {
+                g_state.worker_cv.notify_one();
+            }
+        }
+    }
+
+    // ---- evaluation triggers ----
+    const uint64_t prefill_total = g_state.prefill_tokens.load(std::memory_order_acquire);
+    const uint64_t requests_total = g_state.requests.load(std::memory_order_acquire);
+    if (decode - g_state.last_eval_decode.load(std::memory_order_acquire) >=
+            uint64_t(g_state.expert_eval_tokens) ||
+        prefill_total - g_state.last_eval_prefill.load(std::memory_order_acquire) >=
+            uint64_t(g_state.layer_eval_prefill_tokens) ||
+        requests_total - g_state.last_eval_requests.load(std::memory_order_acquire) >=
+            uint64_t(g_state.layer_eval_requests)) {
+        if (!g_state.eval_requested.exchange(true, std::memory_order_acq_rel)) {
+            g_state.worker_cv.notify_one();
+        }
+    }
+}
+
+const void * const * ggml_cuda_hotexpert_runtime_get_table(
+        const ggml_tensor * tensor,
+        cudaStream_t        stream) {
+    GGML_UNUSED(stream);
+    if (g_state.transit_only) {
+        return nullptr;
+    }
+    if (!ggml_cuda_hotexpert_runtime_enabled() || !g_state.initialized || !tensor || !tensor->data) {
+        return nullptr;
+    }
+    int layer = -1, kind = -1;
+    if (!tensor_registry_find(tensor->data, layer, kind)) {
+        return nullptr;
+    }
+    if (g_state.disabled.load(std::memory_order_relaxed)) {
+        return nullptr;   // circuit breaker tripped: pure original path
+    }
+    const layer_t & L = g_state.layers[layer];
+    if (L.full && !g_state.hybrid) {
+        return nullptr;
+    }
+    if (L.slots == 0) {
+        return nullptr;   // host-only layers keep the pure original path
+    }
+    static const bool disable_tables = std::getenv("HOTSEAT_RUNTIME_DISABLE_TABLES") != nullptr;
+    if (disable_tables) {
+        return nullptr;
+    }
+    const map_t * map = g_state.current_map.get();
+    if (!map || layer >= int(map->tables.size())) {
+        return nullptr;
+    }
+    return static_cast<const void * const *>(map->tables[layer][kind]);
+}
+
+void ggml_cuda_hotexpert_runtime_profile_mmvq(
+        const ggml_tensor * tensor,
+        ggml_cuda_mm_fusion_args_device & fusion) {
+    if ((!g_state.v2_profile_enabled && !g_state.v2_prefetch_enabled) ||
+        !g_state.initialized || !tensor || !tensor->data) {
+        return;
+    }
+    int layer = -1;
+    int kind = -1;
+    if (!tensor_registry_find(tensor->data, layer, kind) || layer < 0 || layer >= g_state.n_layers ||
+        kind < 0 || kind >= GGML_HOTEXPERT_V2_PROFILE_KINDS) {
+        return;
+    }
+
+    if (g_state.v2_profile_enabled && g_state.d_v2_records && g_state.d_v2_current_token) {
+        fusion.hotexpert_v2_current_token = g_state.d_v2_current_token;
+        fusion.hotexpert_v2_records = g_state.d_v2_records;
+        fusion.hotexpert_v2_resident_bits = g_state.d_resident;
+        fusion.hotexpert_v2_capacity = uint32_t(g_state.v2_profile_capacity);
+        fusion.hotexpert_v2_n_layers = uint32_t(g_state.n_layers);
+        fusion.hotexpert_v2_layer = uint32_t(layer);
+        fusion.hotexpert_v2_kind = uint32_t(kind);
+    }
+
+    if (g_state.v2_prefetch_enabled && g_state.d_v2_current_token && g_state.d_v2_transit_meta &&
+        layer < int(g_state.h_v2_transit_meta.size())) {
+        fusion.hotexpert_v2_current_token = g_state.d_v2_current_token;
+        fusion.hotexpert_v2_transit_meta = g_state.d_v2_transit_meta + layer;
+        fusion.hotexpert_v2_kind = uint32_t(kind);
+        fusion.hotexpert_v2_transit_slots = uint32_t(
+            q122_v3_layer_transit_slots(g_state, layer));
+        fusion.hotexpert_v2_gate_kind = UINT32_MAX;
+        if (fusion.gate) {
+            int gate_layer = -1, gate_kind = -1;
+            if (tensor_registry_find(fusion.gate, gate_layer, gate_kind) && gate_layer == layer &&
+                gate_kind >= 0 && gate_kind < GGML_HOTEXPERT_V2_PROFILE_KINDS) {
+                fusion.hotexpert_v2_gate_kind = uint32_t(gate_kind);
+            }
+        }
+    }
+}
+
+const void * ggml_cuda_hotexpert_runtime_get_full_bank(const ggml_tensor * tensor) {
+    if (!ggml_cuda_hotexpert_runtime_enabled() || !g_state.initialized || !g_state.hybrid || !tensor || !tensor->data) {
+        return nullptr;
+    }
+    if (g_state.disabled.load(std::memory_order_relaxed)) {
+        return nullptr;
+    }
+    int layer = -1, kind = -1;
+    if (!tensor_registry_find(tensor->data, layer, kind)) {
+        return nullptr;
+    }
+    const layer_t & L = g_state.layers[layer];
+    if (L.arena_full && g_state.arena.valid()) {
+        return static_cast<const char *>(g_state.arena.base()) + L.arena_full_offsets[kind];
+    }
+    if (!L.full) {
+        return nullptr;
+    }
+    const map_t * map = g_state.current_map.get();
+    if (!map || layer >= int(map->full_bases.size())) {
+        return nullptr;
+    }
+    return map->full_bases[layer][kind];
+}
+
+
+__global__ static void q122_v7_record_router_topk_kernel(
+        const int32_t * ids,
+        uint64_t * hits,
+        int layer,
+        int k,
+        int nrows,
+        int n_experts) {
+    const int idx = int(blockIdx.x) * int(blockDim.x) + int(threadIdx.x);
+    const int total = k * nrows;
+    if (idx >= total) return;
+    const int e = ids[idx];
+    if (e >= 0 && e < n_experts) {
+        atomicAdd((unsigned long long *) &hits[size_t(layer) * MAX_EXPERTS + size_t(e)], 1ULL);
+    }
+}
+
+
+
+bool ggml_cuda_hotexpert_runtime_get_prefill_counter(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * ids,
+        int n_rows,
+        uint64_t ** hits,
+        int * layer_out,
+        int * stride_out) {
+    if (hits) *hits = nullptr;
+    if (layer_out) *layer_out = -1;
+    if (stride_out) *stride_out = MAX_EXPERTS;
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_PREFILL");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (!enabled || !ids || n_rows <= 1) return false;
+    const int layer = parse_layer(ids->name);
+    if (layer < 0 || layer >= MAX_LAYERS) return false;
+
+    if (!g_state.d_prefill) {
+        g_state.device = ctx.device;
+        CUDA_CHECK(cudaSetDevice(g_state.device));
+        CUDA_CHECK(cudaMalloc(&g_state.d_prefill, size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+        CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill, 0,
+            size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t), ctx.stream()));
+        g_state.v3_prefill_adapt = true;
+        std::fprintf(stderr,
+            "Q122 V7.3 TOPK_MOE_INLINE: counters %.1fKiB first_layer=%d rows=%d\n",
+            double(size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)) / 1024.0,
+            layer, n_rows);
+        std::fflush(stderr);
+    }
+    // V7.5 recent-prefill mode: for large prompt ubatches, keep only the
+    // most recent ubatch routing distribution. Generation routing is usually
+    // much closer to the prompt tail than to an equal-weight average over the
+    // entire document. Clearing at layer 0 is ordered on the same ROCm stream,
+    // before that ubatch's ARGSORT kernels start accumulating.
+    static const bool recent_only = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_PREFILL_RECENT_ONLY");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (recent_only && layer == 0 && n_rows >= 512) {
+        CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill, 0,
+            size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t), ctx.stream()));
+        static uint64_t resets = 0;
+        ++resets;
+        std::fprintf(stderr, "Q122 V7.5 PREFILL_RECENT: reset=%llu rows=%d\n",
+            (unsigned long long) resets, n_rows);
+        std::fflush(stderr);
+    }
+
+    g_state.v3_prefill_pending = true;
+    if (hits) *hits = g_state.d_prefill;
+    if (layer_out) *layer_out = layer;
+    if (stride_out) *stride_out = MAX_EXPERTS;
+    return true;
+}
+
+__global__ static void q122_v71_record_router_argsort_kernel(
+        const int32_t * ids,
+        uint64_t * hits,
+        int layer,
+        int row_stride,
+        int k,
+        int nrows,
+        int n_experts) {
+    const int idx = int(blockIdx.x) * int(blockDim.x) + int(threadIdx.x);
+    const int total = k * nrows;
+    if (idx >= total) return;
+    const int row = idx / k;
+    const int col = idx - row * k;
+    const int e = ids[row * row_stride + col];
+    if (e >= 0 && e < n_experts) {
+        atomicAdd((unsigned long long *) &hits[size_t(layer) * MAX_EXPERTS + size_t(e)], 1ULL);
+    }
+}
+
+void ggml_cuda_hotexpert_runtime_record_router_argsort(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * argsort) {
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_PREFILL");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (!enabled || !argsort || !argsort->data || argsort->type != GGML_TYPE_I32) return;
+    const char * prefix = "ffn_moe_argsort-";
+    if (std::strncmp(argsort->name, prefix, std::strlen(prefix)) != 0) return;
+    const int layer = parse_layer(argsort->name);
+    if (layer < 0 || layer >= MAX_LAYERS) return;
+    const int row_stride = int(argsort->ne[0]);
+    const int nrows = int(ggml_nrows(argsort));
+    const int k_model = ggml_hotexpert_model_expert_used();
+    const int k = k_model > 0 ? std::min(k_model, MAX_TOP_K) : 8;
+    if (row_stride < k || nrows <= 1) return; // prefill only
+    const int model_experts = ggml_hotexpert_model_experts();
+    const int n_experts = model_experts > 0 ? std::min(model_experts, MAX_EXPERTS) : row_stride;
+
+    if (!g_state.d_prefill) {
+        g_state.device = ctx.device;
+        CUDA_CHECK(cudaSetDevice(g_state.device));
+        CUDA_CHECK(cudaMalloc(&g_state.d_prefill, size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+        CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill, 0,
+            size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t), ctx.stream()));
+        g_state.v3_prefill_adapt = true;
+        std::fprintf(stderr,
+            "Q122 V7.1 ROUTER_ARGSORT: lazy counters %.1fKiB first_layer=%d rows=%d stride=%d k=%d\n",
+            double(size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)) / 1024.0,
+            layer, nrows, row_stride, k);
+        std::fflush(stderr);
+    }
+    g_state.v3_prefill_pending = true;
+    const int total = k * nrows;
+    const int threads = 256;
+    const int blocks = (total + threads - 1) / threads;
+    q122_v71_record_router_argsort_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+        (const int32_t *) argsort->data, g_state.d_prefill,
+        layer, row_stride, k, nrows, n_experts);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_hotexpert_runtime_record_router_topk(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * topk) {
+    static const bool enabled = [] {
+        const char * v = std::getenv("Q122_ADAPTIVE_PREFILL");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    if (!enabled || !topk || !topk->data || topk->type != GGML_TYPE_I32) return;
+
+    // Only the tensor explicitly named by build_moe_ffn is authoritative.
+    const char * prefix = "ffn_moe_selected_experts_l";
+    if (std::strncmp(topk->name, prefix, std::strlen(prefix)) != 0) return;
+    const int layer = parse_layer(topk->name);
+    if (layer < 0 || layer >= MAX_LAYERS) return;
+    const int k = int(topk->ne[0]);
+    const int nrows = int(ggml_nrows(topk));
+    if (k <= 0 || k > MAX_TOP_K || nrows <= 1) return; // prefill only
+
+    const int model_experts = ggml_hotexpert_model_experts();
+    const int n_experts = model_experts > 0 ? std::min(model_experts, MAX_EXPERTS) : MAX_EXPERTS;
+
+    // This hook executes before Transit runtime registration on long prompt
+    // prefill. Lazily allocate only the 2-D hit table and preserve it through
+    // initialize_transit_only(). One allocation per process, no per-token D2H.
+    if (!g_state.d_prefill) {
+        g_state.device = ctx.device;
+        CUDA_CHECK(cudaSetDevice(g_state.device));
+        CUDA_CHECK(cudaMalloc(&g_state.d_prefill, size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+        CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill, 0,
+            size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t), ctx.stream()));
+        g_state.v3_prefill_adapt = true;
+        std::fprintf(stderr, "Q122 V7 ROUTER_TOPK: lazy counters %.1fKiB first_layer=%d rows=%d k=%d\n",
+            double(size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)) / 1024.0,
+            layer, nrows, k);
+        std::fflush(stderr);
+    }
+
+    g_state.v3_prefill_pending = true;
+    const int total = k * nrows;
+    const int threads = 256;
+    const int blocks = (total + threads - 1) / threads;
+    q122_v7_record_router_topk_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+        (const int32_t *) topk->data, g_state.d_prefill, layer, k, nrows, n_experts);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_hotexpert_runtime_record_decode(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor *         ids,
+        int                         n_experts,
+        int                         n_expert_used,
+        int                         n_rows) {
+    if (g_state.transit_only) {
+        // V7.3 accounts prefill inline inside fused topk_moe_cuda itself.
+        // Keep this callback decode-inert in transit-only mode to avoid double counting.
+        return;
+    }
+    if (!ggml_cuda_hotexpert_runtime_enabled() || !g_state.initialized || !ids || !ids->data ||
+        n_experts <= 0 || n_experts > MAX_EXPERTS || n_expert_used <= 0 || n_expert_used > MAX_TOP_K) {
+        return;
+    }
+    const int layer = parse_layer(ids->name);
+    if (layer < 0 || layer >= g_state.n_layers) {
+        return;
+    }
+    static const bool disable_record = std::getenv("HOTSEAT_RUNTIME_DISABLE_RECORD") != nullptr;
+    if (disable_record) {
+        return;
+    }
+    const ggml_cuda_kernel_launch_params launch_params(
+        dim3(1, 1, 1), dim3(n_expert_used, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(runtime_record_kernel, launch_params,
+        (const int32_t *) ids->data,
+        g_state.d_hits, g_state.d_prefill, g_state.d_miss, g_state.d_prefill_rows,
+        g_state.d_resident,
+        g_state.d_v2_records, g_state.d_v2_routes, g_state.d_v2_route_latest,
+        g_state.d_v2_transit_meta, g_state.v2_transit_enabled ? g_state.v2_transit_slots : 0,
+        g_state.d_v2_token_count, g_state.d_v2_current_token,
+        g_state.v2_profile_capacity, g_state.v2_route_capacity,
+        g_state.current_map ? g_state.current_map->generation : 0,
+        g_state.n_layers,
+        layer, n_experts, n_expert_used, n_rows, false);
+
+    if (n_rows == 1 && layer == g_state.n_layers - 1) {
+        CUDA_CHECK(cudaLaunchHostFunc(ctx.stream(), token_callback, &g_state));
+    }
+}
+
+void ggml_cuda_hotexpert_runtime_record_prefill(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor *         ids,
+        int                         n_experts,
+        int                         n_expert_used,
+        int                         n_rows) {
+    if (g_state.transit_only) {
+        const char * pv = std::getenv("Q122_ADAPTIVE_PREFILL");
+        const bool prefill_enabled = pv && std::strcmp(pv, "1") == 0;
+        if (!prefill_enabled || !ids || !ids->data || n_rows <= 1 ||
+            n_experts <= 0 || n_experts > MAX_EXPERTS || n_expert_used <= 0 || n_expert_used > MAX_TOP_K) return;
+        const int model_layers = ggml_hotexpert_model_layers();
+        const int layers = model_layers > 0 ? model_layers : MAX_LAYERS;
+        const int layer = parse_layer(ids->name);
+        if (layer < 0 || layer >= layers || layer >= MAX_LAYERS) return;
+
+        // Q122 registration often completes only after prompt prefill. Allocate
+        // tiny route counters lazily on the actual MMQ path, before runtime init.
+        if (!g_state.d_prefill) {
+            g_state.device = ctx.device;
+            CUDA_CHECK(cudaSetDevice(g_state.device));
+            CUDA_CHECK(cudaMalloc(&g_state.d_prefill, size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)));
+            CUDA_CHECK(cudaMalloc(&g_state.d_prefill_rows, size_t(MAX_LAYERS) * sizeof(uint64_t)));
+            CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill, 0, size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t), ctx.stream()));
+            CUDA_CHECK(cudaMemsetAsync(g_state.d_prefill_rows, 0, size_t(MAX_LAYERS) * sizeof(uint64_t), ctx.stream()));
+            g_state.v3_prefill_adapt = true;
+            std::fprintf(stderr, "Q122 PREFILL_SEED: lazy pre-init GPU counters %.1fKiB\n",
+                double(size_t(MAX_LAYERS) * MAX_EXPERTS * sizeof(uint64_t)) / 1024.0);
+        }
+        g_state.v3_prefill_pending = true;
+        const ggml_cuda_kernel_launch_params launch_params(
+            dim3(1, 1, 1), dim3(n_expert_used, 1, 1), 0, ctx.stream());
+        ggml_cuda_kernel_launch(runtime_record_kernel, launch_params,
+            (const int32_t *) ids->data,
+            nullptr, g_state.d_prefill, nullptr, g_state.d_prefill_rows, nullptr,
+            nullptr, nullptr, nullptr, nullptr, 0, nullptr, nullptr, 0, 0, 0, layers,
+            layer, n_experts, n_expert_used, n_rows, true);
+        return;
+    }
+    if (!ggml_cuda_hotexpert_runtime_enabled() || !g_state.initialized || !ids || !ids->data || n_rows <= 1 ||
+        n_experts <= 0 || n_experts > MAX_EXPERTS || n_expert_used <= 0 || n_expert_used > MAX_TOP_K) {
+        return;
+    }
+    const int layer = parse_layer(ids->name);
+    if (layer < 0 || layer >= g_state.n_layers) {
+        return;
+    }
+    static const bool disable_record = std::getenv("HOTSEAT_RUNTIME_DISABLE_RECORD") != nullptr;
+    if (disable_record) {
+        return;
+    }
+    const ggml_cuda_kernel_launch_params launch_params(
+        dim3(1, 1, 1), dim3(n_expert_used, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(runtime_record_kernel, launch_params,
+        (const int32_t *) ids->data,
+        g_state.d_hits, g_state.d_prefill, g_state.d_miss, g_state.d_prefill_rows,
+        g_state.d_resident,
+        nullptr, nullptr, nullptr, nullptr, 0, nullptr, nullptr, 0, 0, 0, g_state.n_layers,
+        layer, n_experts, n_expert_used, n_rows, true);
+}
diff --git a/ggml/src/ggml-cuda/hotexpert-runtime.cuh b/ggml/src/ggml-cuda/hotexpert-runtime.cuh
new file mode 100644
index 000000000..745225091
--- /dev/null
+++ b/ggml/src/ggml-cuda/hotexpert-runtime.cuh
@@ -0,0 +1,141 @@
+#pragma once
+
+#include "common.cuh"
+
+struct ggml_tensor;
+
+constexpr int GGML_HOTEXPERT_V2_PROFILE_TOP_K  = 8;
+constexpr int GGML_HOTEXPERT_V2_PROFILE_KINDS  = 4;
+constexpr int GGML_HOTEXPERT_V2_PROFILE_MAX_EXPERTS = 1024;
+
+constexpr int GGML_HOTEXPERT_V2_TRANSIT_BANKS = 2;
+constexpr int GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS = 8;
+
+// Fixed-address device metadata for Stage-2 predictive transit.  H2D copies
+// land in the preallocated ptrs[][][] regions; a publish kernel writes the
+// expert ids and only then atomically exposes ready_token.  Decode therefore
+// either sees a complete transit generation or falls back to the original
+// resident/ROCm_Host pointer table.
+struct ggml_hotexpert_v2_transit_meta {
+    uint64_t ready_token[GGML_HOTEXPERT_V2_TRANSIT_BANKS] = { UINT64_MAX, UINT64_MAX };
+    int32_t expert_ids[GGML_HOTEXPERT_V2_TRANSIT_BANKS][GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS] = {};
+    const void * ptrs[GGML_HOTEXPERT_V2_TRANSIT_BANKS][GGML_HOTEXPERT_V2_PROFILE_KINDS][GGML_HOTEXPERT_V2_TRANSIT_MAX_SLOTS] = {};
+};
+
+// Compact per-token/per-layer ring record. Routing is written by the existing
+// 8-thread HotExpert record kernel. MMVQ contributes representative-block
+// clock samples without adding per-layer events or stream synchronization.
+struct ggml_hotexpert_v2_layer_record {
+    uint64_t generation = 0;
+    uint64_t mmvq_cycles[GGML_HOTEXPERT_V2_PROFILE_KINDS] = {};
+    uint64_t host_cycles[GGML_HOTEXPERT_V2_PROFILE_KINDS] = {};
+    uint64_t resident_cycles[GGML_HOTEXPERT_V2_PROFILE_KINDS] = {};
+    int32_t  expert_ids[GGML_HOTEXPERT_V2_PROFILE_TOP_K] = {};
+    uint32_t resident_mask = 0;
+    uint32_t route_count = 0;
+};
+
+// ============================================================================
+// Runtime dynamic HotSeat / Hot Expert adjustment (llama.cpp-b10235-hotexpert)
+//
+// Modes (env HOTSEAT_RUNTIME_MODE):
+//   static           : fully inert; existing static HotSeat + HotExpert cache
+//                      (HOTEXPERT_CACHE=1) behavior is preserved unchanged.
+//   dynamic-experts  : the HotSeat full layers stay fixed (device tensors).
+//                      The Top-64 expert sets of the remaining host layers are
+//                      adjusted at runtime from decode routing profiles.
