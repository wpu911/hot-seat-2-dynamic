+// Qwen3.5-122B Resident/Miss Split R0 upper-bound experiment.
+// Q122_R0_SKIP_SLOTS=N pretends the long-profile top-N experts are already
+// computed by a zero-cost GPU resident path. CPU MMID skips them and clears
+// their output slice. This intentionally changes model output and is disabled
+// by default; it exists only in the isolated q122 worktree.
+#include "q122-r0-rank.inc"
+
+static atomic_ullong q122_r0_rows_total = 0;
+static atomic_ullong q122_r0_rows_skipped = 0;
+
+static int q122_r0_skip_slots(void) {
+    static int initialized = 0;
+    static int slots = 0;
+    if (!initialized) {
+        const char * v = getenv("Q122_R0_SKIP_SLOTS");
+        if (v && *v) {
+            slots = atoi(v);
+            if (slots < 0) slots = 0;
+            if (slots > 32) slots = 32;
+        }
+        initialized = 1;
+    }
+    return slots;
+}
+
+static int q122_r0_parse_layer(const char * name) {
+    if (!name) return -1;
+    const char * p = strstr(name, "blk.");
+    if (!p) return -1;
+    p += 4;
+    if (*p < '0' || *p > '9') return -1;
+    int layer = 0;
+    while (*p >= '0' && *p <= '9') layer = layer * 10 + (*p++ - '0');
+    return layer >= 0 && layer < 48 ? layer : -1;
+}
+
+static atomic_int q122_r1_layers_state = 0;
+static bool q122_r1_layers_mask[48] = { false };
+static bool q122_r1_active_cached = false;
+
+static void q122_r1_layers_init(void) {
+    int state = atomic_load_explicit(&q122_r1_layers_state, memory_order_acquire);
+    if (state == 2) return;
+    int expected = 0;
+    if (atomic_compare_exchange_strong_explicit(&q122_r1_layers_state, &expected, 1, memory_order_acq_rel, memory_order_acquire)) {
+        const char * enabled = getenv("Q122_R1");
+        q122_r1_active_cached = enabled && strcmp(enabled, "1") == 0;
+        if (q122_r1_active_cached) {
+            const char * list = getenv("Q122_R1_SPLIT_LAYERS");
+            if (list && *list) {
+                const char * p = list;
+                while (*p) {
+                    while (*p == ' ' || *p == ',') ++p;
+                    if (!*p) break;
+                    char * end = NULL;
+                    long layer = strtol(p, &end, 10);
+                    if (end == p) break;
+                    if (layer >= 0 && layer < 48) q122_r1_layers_mask[layer] = true;
+                    p = end;
+                }
+            } else {
+                const char * v = getenv("Q122_R1_SPLIT_LAYER");
+                int layer = (v && *v) ? atoi(v) : 3;
+                if (layer >= 0 && layer < 48) q122_r1_layers_mask[layer] = true;
+            }
+        }
+        atomic_store_explicit(&q122_r1_layers_state, 2, memory_order_release);
+    } else {
+        while (atomic_load_explicit(&q122_r1_layers_state, memory_order_acquire) != 2) { }
+    }
+}
+
+static bool q122_r1_active(void) {
+    q122_r1_layers_init();
+    return q122_r1_active_cached;
+}
+
+static bool q122_r1_layer_enabled(int layer) {
+    q122_r1_layers_init();
+    return q122_r1_active_cached && layer >= 0 && layer < 48 && q122_r1_layers_mask[layer];
+}
+
+static bool q122_r0_is_resident(const struct ggml_tensor * tensor, int expert) {
+    const int slots = q122_r0_skip_slots();
+    if (slots <= 0 || !tensor || expert < 0 || expert >= 256) return false;
+    const int layer = q122_r0_parse_layer(tensor->name);
+    if (layer < 0) return false;
+    if (q122_r1_active() && !q122_r1_layer_enabled(layer)) return false;
+    if (!strstr(tensor->name, "ffn_") || !strstr(tensor->name, "_exps")) return false;
+    for (int i = 0; i < slots; ++i) if (q122_r0_rank[layer][i] == expert) return true;
+    return false;
+}
+
+static void q122_r0_report(void) {
+    const uint64_t total = atomic_load_explicit(&q122_r0_rows_total, memory_order_relaxed);
+    const uint64_t skipped = atomic_load_explicit(&q122_r0_rows_skipped, memory_order_relaxed);
+    if (q122_r0_skip_slots() > 0) {
+        fprintf(stderr, "Q122 R0 summary: slots=%d rows_total=%llu rows_skipped=%llu skip_pct=%.2f\n",
+            q122_r0_skip_slots(), (unsigned long long) total, (unsigned long long) skipped,
+            total ? 100.0 * (double) skipped / (double) total : 0.0);
+    }
+}
+
+static void q122_r0_init_once(void) {
+    static atomic_bool done = false;
+    if (q122_r0_skip_slots() <= 0) return;
+    bool expected = false;
+    if (atomic_compare_exchange_strong_explicit(&done, &expected, true, memory_order_relaxed, memory_order_relaxed)) {
+        atexit(q122_r0_report);
+        fprintf(stderr, "Q122 R0: CPU MMID resident-skip enabled slots=%d\n", q122_r0_skip_slots());
+    }
+}
+
 struct mmid_row_mapping {
